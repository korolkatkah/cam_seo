{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "redirects": [
    { "source": "/studio-directory/best-studios", "destination": "/studio-directory/glow-models", "permanent": true },
    { "source": "/ro/studio-directory/best-studios", "destination": "/ro/studio-directory/glow-models", "permanent": true },
    { "source": "/ru/studio-directory/best-studios", "destination": "/ru/studio-directory/glow-models", "permanent": true },
    { "source": "/studio-directory/charm-studio", "destination": "/studio-directory/glow-models", "permanent": true },
    { "source": "/ro/studio-directory/charm-studio", "destination": "/ro/studio-directory/glow-models", "permanent": true },
    { "source": "/ru/studio-directory/charm-studio", "destination": "/ru/studio-directory/glow-models", "permanent": true },
    { "source": "/studio-directory/studio-20", "destination": "/studio-directory/glow-models", "permanent": true },
    { "source": "/ro/studio-directory/studio-20", "destination": "/ro/studio-directory/glow-models", "permanent": true },
    { "source": "/ru/studio-directory/studio-20", "destination": "/ru/studio-directory/glow-models", "permanent": true },
    { "source": "/studio-directory/missjoy-models", "destination": "/studio-directory/glow-models", "permanent": true },
    { "source": "/ro/studio-directory/missjoy-models", "destination": "/ro/studio-directory/glow-models", "permanent": true },
    { "source": "/ru/studio-directory/missjoy-models", "destination": "/ru/studio-directory/glow-models", "permanent": true },
    { "source": "/studio-directory/belle-studio", "destination": "/studio-directory/glow-models", "permanent": true },
    { "source": "/ro/studio-directory/belle-studio", "destination": "/ro/studio-directory/glow-models", "permanent": true },
    { "source": "/ru/studio-directory/belle-studio", "destination": "/ru/studio-directory/glow-models", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "ewo.cam" }], "destination": "https://www.ewohub.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.ewo.cam" }], "destination": "https://www.ewohub.com/:path*", "permanent": true },
    { "source": "/stripchat_promo", "destination": "/stripchat-promo", "permanent": true },
    { "source": "/ro/stripchat_promo", "destination": "/ro/stripchat-promo", "permanent": true },
    { "source": "/ru/stripchat_promo", "destination": "/ru/stripchat-promo", "permanent": true },
    { "source": "/de", "destination": "/", "permanent": true },
    { "source": "/de/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/es", "destination": "/", "permanent": true },
    { "source": "/es/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/uk", "destination": "/", "permanent": true },
    { "source": "/uk/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/fr", "destination": "/", "permanent": true },
    { "source": "/fr/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/pt", "destination": "/", "permanent": true },
    { "source": "/pt/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/", "has": [{ "type": "header", "key": "accept-language", "value": "^ro" }], "destination": "/ro", "permanent": false },
    { "source": "/", "has": [{ "type": "header", "key": "accept-language", "value": "^ru" }], "destination": "/ru", "permanent": false }
  ],
  "rewrites": [
    { "source": "/go", "destination": "/api/go" }
  ],
  "headers": [
    { "source": "/data/model-widgets.json", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
