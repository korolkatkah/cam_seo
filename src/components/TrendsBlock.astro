const t = STR[lang] ?? STR.en;

const LOCALE_MAP: Record<string, string> = {
  en: 'en-US', de: 'de-DE', es: 'es-ES', ro: 'ro-RO', uk: 'uk-UA', ru: 'ru-RU',
};
const headingDate = new Intl.DateTimeFormat(LOCALE_MAP[lang] ?? 'en-US', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(trends.generated_at ? new Date(trends.generated_at) : new Date());

const hasData = trends.best_hours_utc?.length > 0 || trends.top_tags?.length > 0;
const hoursMap = new Map((trends.best_hours_utc ?? []).map((h: { hour: number; score: number }) => [h.hour, h.score]));
const hours24 = Array.from({ length: 24 }, (_, i) => ({ hour: i, score: hoursMap.get(i) ?? 0 }));
const maxScore24 = Math.max(1, ...hours24.map(h => h.score));
const topTags = (trends.top_tags ?? []).slice(0, 6);
const topTitles = (trends.top_titles ?? []).slice(0, 6);
const topPatterns = (trends.economy?.top_patterns ?? []).slice(0, 10);
---

<section class="trends-block">
  <div class="trends-inner">
