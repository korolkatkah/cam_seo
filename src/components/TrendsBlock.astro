      <span class="trends-eyebrow"><span class="live-dot"></span>{t.eyebrow}</span>
      <h2 class="trends-heading">{t.heading} — {headingDate}</h2>
      <p class="trends-sub">{t.sub}</p>
      <p class="trends-update-freq">{t.updateFreq}</p>
      <div class="platform-tabs" role="tablist">
        <button type="button" class="platform-tab is-active" data-platform="cb" role="tab" aria-selected="true">{t.platformCb}</button>
        <button type="button" class="platform-tab" data-platform="sc" role="tab" aria-selected="false">{t.platformSc}</button>
      </div>
    </div>

    <div class="platform-panel" data-panel="cb">
      {!hasData && (
        <p class="trends-empty">{t.noData}</p>
      )}

      {hasData && (
        <>
        <div class="trends-card trends-card-wide">
          <h3 class="trends-card-title">{t.hoursTitle}</h3>
          <p class="hours-caption">{t.hoursCaption}</p>
          <p class="hours-local-note" data-hours-local-note hidden>{t.hoursLocalNote}</p>
          <div class="hours-legend" data-hours-legend hidden>
            <span class="hours-legend-high">■ {t.hoursLegendHigh}</span>
            <span class="hours-legend-mid">■ {t.hoursLegendMid}</span>
            <span class="hours-legend-low">■ {t.hoursLegendLow}</span>
          </div>
          <ul class="hours-list" id="hours-list">
            {hours24.map((h: { hour: number; score: number }) => {
              const pct = Math.round((h.score / maxScore24) * 100);
              const cls = h.score >= maxScore24 * 0.9 ? 'is-peak' : h.score >= maxScore24 * 0.75 ? 'is-mid' : 'is-low';
              return (
                <li class={`hours-row ${cls}`} data-utc-hour={h.hour} data-score={h.score}>
                  <span class="hours-range">{String(h.hour).padStart(2, '0')}:00–{String((h.hour + 1) % 24).padStart(2, '0')}:00 UTC</span>
                  <span class="hours-bar-track">
                    <span class="hours-bar-fill" style={`width:${pct}%`}></span>
                  </span>
                  <span class="hours-score">{h.score} <small>{t.hoursUnit}</small></span>
                </li>
              );
            })}
          </ul>
          <p class="hours-yesterday-note" hidden>{t.hoursNowNote}</p>
          <div class="hours-history-wrap" hidden
               data-yesterday-above={t.hoursYesterdayAbove}
               data-yesterday-below={t.hoursYesterdayBelow}>
            <button class="hours-history-btn" aria-expanded="false">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><polyline points="12 7 12 12 15 15"/></svg>
              <span>{t.hoursHistoryBtn}</span>
              <svg class="hist-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="hours-history-panel" hidden>
              <p class="hours-history-label" data-history-label={t.hoursHistoryLabel}></p>
              <ul class="hours-list hours-list--history"></ul>
            </div>
          </div>
        </div>

        <div class="trends-card trends-card-wide">
          <h3 class="trends-card-title">{t.tagsTitle}</h3>
          <p class="tags-caption">{t.tagsCaption}</p>
          <p class="tags-section-label">{t.tagsHotLabel}</p>
          <div class="tag-grid">
            {topTags.slice(0, 6).map((tag: { tag: string; avg_users: number; rooms: number }) => (
              <div class="tag-cell tag-cell--hot">
                <span class="tag-hot-badge">{t.tagsHotBadge}</span>
                <span class="tag-cell-name">#{tag.tag}</span>
                <span class="tag-cell-stats">~{tag.avg_users} {t.hoursUnit.split(' / ')[0]} · {tag.rooms} {t.tagsRoomsUnit}</span>
              </div>
            ))}
          </div>
          <p class="tags-section-label tags-section-label--rest">{t.tagsRestLabel}</p>
          <div class="tag-grid">
            {topTags.slice(6, 9).map((tag: { tag: string; avg_users: number; rooms: number }) => (
              <div class="tag-cell">
                <span class="tag-cell-name">#{tag.tag}</span>
                <span class="tag-cell-stats">~{tag.avg_users} {t.hoursUnit.split(' / ')[0]} · {tag.rooms} {t.tagsRoomsUnit}</span>
              </div>
            ))}
          </div>
          {topTags.length > 9 && (
            <>
              <button class="tags-more-btn" data-show={t.tagsShowMore} data-hide={t.tagsHide} aria-expanded="false">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                <span>{t.tagsShowMore} ({topTags.length - 9})</span>
              </button>
              <div class="tags-more-panel" hidden>
                <div class="tag-grid">
                  {topTags.slice(9).map((tag: { tag: string; avg_users: number; rooms: number }) => (
                    <div class="tag-cell">
                      <span class="tag-cell-name">#{tag.tag}</span>
                      <span class="tag-cell-stats">~{tag.avg_users} {t.hoursUnit.split(' / ')[0]} · {tag.rooms} {t.tagsRoomsUnit}</span>
                    </div>
                  ))}
                </div>
              </div>
            </>
          )}
        </div>

        {topTitles.length > 0 && (
          <div class="trends-card trends-card-wide">
            <h3 class="trends-card-title">{t.titlesTitle}</h3>
            <p class="titles-caption">{t.titlesCaption}</p>
            <ol class="titles-list">
              {topTitles.map((tt: { avg_users: number; subject: string }) => (
                <li class="titles-row">
                  <span class="titles-viewers">~{tt.avg_users} <small>{t.viewersWord}</small></span>
                  <span class="titles-subject">{tt.subject}</span>
                </li>
              ))}
            </ol>
          </div>
        )}

        {(trends.economy?.goal_median || topPatterns.length > 0) && (
          <div class="trends-card trends-card-wide">
            <h3 class="trends-card-title">{t.pricesTitle}</h3>
            <p class="prices-caption">{t.pricesCaption}</p>
            {trends.economy?.goal_median && (
              <p class="price-summary">
                {t.goalPriceLabel}: <strong>~{trends.economy.goal_median} {t.tkUnit}</strong>
                {trends.economy.goal_p25 && trends.economy.goal_p75 && (
                  <span class="price-range"> ({t.rangeWord} {trends.economy.goal_p25}–{trends.economy.goal_p75} {t.tkUnit})</span>
                )}
              </p>
            )}
            {topPatterns.length > 0 && (
              <>
                <p class="price-by-category-label">{t.patternsLabel}</p>
                <ul class="price-list">
                  {topPatterns.map((p: { value: number; count: number }) => (
                    <li class="price-row">
                      <span class="price-tag">~{p.value} {t.tkUnit}</span>
                      <span class="price-dots"></span>
                      <span class="price-value">{p.count} {t.modelsWord}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
