        )}

        </>
      )}
    </div>

    <div class="platform-panel" data-panel="sc" hidden>
      <p class="trends-empty">{t.stripchatSoon}</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.trends-block').forEach((block) => {
    const tabs = block.querySelectorAll<HTMLButtonElement>('.platform-tab');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const platform = tab.dataset.platform;
        tabs.forEach((tb) => {
          tb.classList.toggle('is-active', tb === tab);
          tb.setAttribute('aria-selected', tb === tab ? 'true' : 'false');
        });
        block.querySelectorAll<HTMLElement>('.platform-panel').forEach((panel) => {
          panel.hidden = panel.dataset.panel !== platform;
        });
      });
    });
  });

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  const tzOffsetMin = new Date().getTimezoneOffset();
  const localNowHour = new Date().getHours();

  document.querySelectorAll<HTMLElement>('.trends-block').forEach((block) => {
    const list = block.querySelector<HTMLElement>('.hours-list');
    if (!list) return;

    const rows = Array.from(list.querySelectorAll<HTMLElement>('.hours-row[data-utc-hour]'));
    const historyRows: HTMLElement[] = [];
    let nowRow: HTMLElement | null = null;
    // map localStartHour → row
    const rowByLocal = new Map<number, HTMLElement>();

    rows.forEach((row) => {
      const utcHour = Number(row.dataset.utcHour);
      if (Number.isNaN(utcHour)) return;
      const startTotal = (((utcHour * 60 - tzOffsetMin) % 1440) + 1440) % 1440;
      const endTotal = (startTotal + 60) % 1440;
      const fmt = (m: number) => `${pad(Math.floor(m / 60))}:${pad(m % 60)}`;
      const localStartHour = Math.floor(startTotal / 60);

      const rangeEl = row.querySelector<HTMLElement>('.hours-range');
      if (rangeEl) rangeEl.textContent = `${fmt(startTotal)}–${fmt(endTotal)}`;

      rowByLocal.set(localStartHour, row);

      if (localStartHour === localNowHour) {
        nowRow = row;
        row.classList.add('is-current');
        if (rangeEl) rangeEl.innerHTML += ' <span class="now-badge">now</span>';
      }
    });

    // Visible: now + next 2 hours. Everything else → history
    rows.forEach((row) => {
      const utcHour = Number(row.dataset.utcHour);
      if (Number.isNaN(utcHour)) return;
      const startTotal = (((utcHour * 60 - tzOffsetMin) % 1440) + 1440) % 1440;
      const localStartHour = Math.floor(startTotal / 60);
      const diff = (localStartHour - localNowHour + 24) % 24;
      if (diff > 2) historyRows.push(row);
    });

    // Insert "now note" right after current row
    if (nowRow) {
      const nowNote = block.querySelector<HTMLElement>('.hours-yesterday-note');
      if (nowNote) {
        nowNote.hidden = false;
        (nowRow as HTMLElement).after(nowNote);
      }
    }

    // Move non-visible rows into history panel
    const historyWrap = block.querySelector<HTMLElement>('.hours-history-wrap');
    const historyPanel = block.querySelector<HTMLElement>('.hours-history-panel');
    const historyList = block.querySelector<HTMLElement>('.hours-list--history');
    const historyLabelEl = block.querySelector<HTMLElement>('[data-history-label]');

    if (historyRows.length > 0 && historyWrap && historyPanel && historyList && historyLabelEl) {
      historyRows.forEach(r => historyList.appendChild(r));
      if (historyLabelEl) historyLabelEl.textContent = historyLabelEl.dataset.historyLabel ?? '';
      historyWrap.hidden = false;

      // Insert now-dup separator between past and future rows
      if (nowRow) {
        const yesterdayAbove = historyWrap.dataset.yesterdayAbove ?? '↑ yesterday';
        const yesterdayBelow = historyWrap.dataset.yesterdayBelow ?? '↓ yesterday';
        let insertBefore: Element | null = null;
        for (const child of Array.from(historyList.children)) {
          const el = child as HTMLElement;
          const utcH = Number(el.dataset.utcHour);
          if (Number.isNaN(utcH)) continue;
          const startMin = (((utcH * 60 - tzOffsetMin) % 1440) + 1440) % 1440;
          const localH = Math.floor(startMin / 60);
          if (localH > localNowHour + 2) { insertBefore = child; break; }
        }
        const sepAbove = document.createElement('div');
        sepAbove.className = 'hours-now-sep';
        sepAbove.textContent = yesterdayAbove;
        const nowDup = document.createElement('div');
        nowDup.className = 'hours-now-dup';
        const clone = (nowRow as HTMLElement).cloneNode(true) as HTMLElement;
        nowDup.appendChild(clone);
        const sepBelow = document.createElement('div');
        sepBelow.className = 'hours-now-sep';
        sepBelow.textContent = yesterdayBelow;
        if (insertBefore) {
          historyList.insertBefore(sepAbove, insertBefore);
          historyList.insertBefore(nowDup, insertBefore);
          historyList.insertBefore(sepBelow, insertBefore);
        } else {
          historyList.appendChild(sepAbove);
          historyList.appendChild(nowDup);
          historyList.appendChild(sepBelow);
        }

        // Also append clones of now+1 and now+2 after the separator
        rows.forEach((row) => {
          const utcH = Number(row.dataset.utcHour);
          if (Number.isNaN(utcH)) return;
          const startMin = (((utcH * 60 - tzOffsetMin) % 1440) + 1440) % 1440;
          const localH = Math.floor(startMin / 60);
          const d = (localH - localNowHour + 24) % 24;
          if (d === 1 || d === 2) {
            historyList.appendChild((row as HTMLElement).cloneNode(true) as HTMLElement);
          }
        });
      }

      const histBtn = historyWrap.querySelector<HTMLButtonElement>('.hours-history-btn');
      if (histBtn) {
        histBtn.addEventListener('click', () => {
          const open = historyPanel.hidden;
          historyPanel.hidden = !open;
          histBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          const chev = histBtn.querySelector<HTMLElement>('.hist-chevron');
          if (chev) chev.style.transform = open ? 'rotate(180deg)' : '';
        });
      }
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.tags-more-btn').forEach((btn) => {
    const panel = btn.nextElementSibling as HTMLElement;
    const labelEl = btn.querySelector('span')!;
    btn.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      labelEl.textContent = open ? btn.dataset.hide! : `${btn.dataset.show} (${panel.querySelectorAll('.tag-cell').length})`;
    });
  });

  document.querySelectorAll<HTMLElement>('[data-hours-local-note]').forEach((el) => {
    el.hidden = false;
  });
  document.querySelectorAll<HTMLElement>('[data-hours-legend]').forEach((el) => {
    el.hidden = false;
  });
</script>

