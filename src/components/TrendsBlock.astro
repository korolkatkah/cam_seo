const t = STR[lang] ?? STR.en;

const LOCALE_MAP: Record<string, string> = {
  en: 'en-US', de: 'de-DE', es: 'es-ES', ro: 'ro-RO', uk: 'uk-UA', ru: 'ru-RU',
};
const headingDate = new Intl.DateTimeFormat(LOCALE_MAP[lang] ?? 'en-US', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(trends.generated_at ? new Date(trends.generated_at) : new Date());

const hasData = trends.best_hours_utc?.length > 0 || trends.top_tags?.length > 0;
const hoursMap = new Map((trends.best_hours_utc ?? []).map((h: { hour: number; score: number }) => [h.hour, h.score]));
const hours24 = Array.from({ length: 24 }, (_, i) => ({ hour: i, score: hoursMap.get(i) ?? 0 }));
const maxScore24 = Math.max(1, ...hours24.map(h => h.score));
const topTags = (trends.top_tags ?? []).slice(0, 30);
const topTitles = (trends.top_titles ?? []).slice(0, 6);
const topPatterns = (trends.economy?.top_patterns ?? []).slice(0, 10);
---

<section class="trends-block">
  <div class="trends-inner">
    <div class="trends-head">
      <span class="trends-eyebrow"><span class="live-dot"></span>{t.eyebrow}</span>
      <h2 class="trends-heading">{t.heading} — {headingDate}</h2>
      <p class="trends-sub">{t.sub}</p>
      <p class="trends-update-freq">{t.updateFreq}</p>
      <div class="platform-tabs" role="tablist">
        <button type="button" class="platform-tab is-active" data-platform="cb" role="tab" aria-selected="true">{t.platformCb}</button>
        <button type="button" class="platform-tab" data-platform="sc" role="tab" aria-selected="false">{t.platformSc}</button>
      </div>
    </div>

    <div class="platform-panel" data-panel="cb">
      {!hasData && (
        <p class="trends-empty">{t.noData}</p>
      )}

      {hasData && (
        <>
        <div class="trends-card trends-card-wide">
          <h3 class="trends-card-title">{t.hoursTitle}</h3>
          <p class="hours-caption">{t.hoursCaption}</p>
          <p class="hours-local-note" data-hours-local-note hidden>{t.hoursLocalNote}</p>
          <ul class="hours-list" id="hours-list">
            {hours24.map((h: { hour: number; score: number }) => {
              const pct = Math.round((h.score / maxScore24) * 100);
              const cls = h.score >= maxScore24 * 0.9 ? 'is-peak' : h.score >= maxScore24 * 0.75 ? 'is-mid' : 'is-low';
              return (
                <li class={`hours-row ${cls}`} data-utc-hour={h.hour}>
                  <span class="hours-range">{String(h.hour).padStart(2, '0')}:00–{String((h.hour + 1) % 24).padStart(2, '0')}:00 UTC</span>
                  <span class="hours-bar-track">
                    <span class="hours-bar-fill" style={`width:${pct}%`}></span>
                  </span>
                  <span class="hours-score">{h.score} <small>{t.hoursUnit}</small></span>
                </li>
              );
            })}
          </ul>
        </div>

        <div class="trends-card trends-card-wide">
          <h3 class="trends-card-title">{t.tagsTitle}</h3>
          <p class="tags-caption">{t.tagsCaption}</p>
          <div class="tag-grid">
            {topTags.map((tag: { tag: string; avg_users: number; rooms: number }) => (
              <div class="tag-cell">
                <span class="tag-cell-name">#{tag.tag}</span>
                <span class="tag-cell-stats">~{tag.avg_users} {t.hoursUnit.split(' / ')[0]} · {tag.rooms} {t.tagsRoomsUnit}</span>
              </div>
            ))}
          </div>
        </div>

        {topTitles.length > 0 && (
          <div class="trends-card trends-card-wide">
            <h3 class="trends-card-title">{t.titlesTitle}</h3>
            <p class="titles-caption">{t.titlesCaption}</p>
            <ol class="titles-list">
              {topTitles.map((tt: { avg_users: number; subject: string }) => (
                <li class="titles-row">
                  <span class="titles-viewers">~{tt.avg_users} <small>{t.viewersWord}</small></span>
                  <span class="titles-subject">{tt.subject}</span>
                </li>
              ))}
            </ol>
          </div>
        )}

        {(trends.economy?.goal_median || topPatterns.length > 0) && (
          <div class="trends-card trends-card-wide">
            <h3 class="trends-card-title">{t.pricesTitle}</h3>
            <p class="prices-caption">{t.pricesCaption}</p>
            {trends.economy?.goal_median && (
              <p class="price-summary">
                {t.goalPriceLabel}: <strong>~{trends.economy.goal_median} {t.tkUnit}</strong>
                {trends.economy.goal_p25 && trends.economy.goal_p75 && (
                  <span class="price-range"> ({t.rangeWord} {trends.economy.goal_p25}–{trends.economy.goal_p75} {t.tkUnit})</span>
                )}
              </p>
            )}
            {topPatterns.length > 0 && (
              <>
                <p class="price-by-category-label">{t.patternsLabel}</p>
                <ul class="price-list">
                  {topPatterns.map((p: { value: number; count: number }) => (
                    <li class="price-row">
                      <span class="price-tag">~{p.value} {t.tkUnit}</span>
                      <span class="price-dots"></span>
                      <span class="price-value">{p.count} {t.modelsWord}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        )}

        </>
      )}
    </div>

    <div class="platform-panel" data-panel="sc" hidden>
      <p class="trends-empty">{t.stripchatSoon}</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.trends-block').forEach((block) => {
    const tabs = block.querySelectorAll<HTMLButtonElement>('.platform-tab');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const platform = tab.dataset.platform;
        tabs.forEach((tb) => {
          tb.classList.toggle('is-active', tb === tab);
          tb.setAttribute('aria-selected', tb === tab ? 'true' : 'false');
        });
        block.querySelectorAll<HTMLElement>('.platform-panel').forEach((panel) => {
          panel.hidden = panel.dataset.panel !== platform;
        });
      });
    });
  });

  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  const tzOffsetMin = new Date().getTimezoneOffset();
  const localNowHour = new Date().getHours();

  document.querySelectorAll<HTMLElement>('.hours-row[data-utc-hour]').forEach((row) => {
    const utcHour = Number(row.dataset.utcHour);
    if (Number.isNaN(utcHour)) return;
    const startTotal = (((utcHour * 60 - tzOffsetMin) % 1440) + 1440) % 1440;
    const endTotal = (startTotal + 60) % 1440;
    const fmt = (totalMin: number) => `${pad(Math.floor(totalMin / 60))}:${pad(totalMin % 60)}`;
    const localStartHour = Math.floor(startTotal / 60);

    const rangeEl = row.querySelector<HTMLElement>('.hours-range');
    if (rangeEl) rangeEl.textContent = `${fmt(startTotal)}–${fmt(endTotal)}`;

    if (localStartHour === localNowHour) {
      row.classList.add('is-current');
      if (rangeEl) rangeEl.innerHTML += '<span class="now-badge">now</span>';
      const note = document.createElement('div');
      note.className = 'hours-yesterday-note';
      note.textContent = '↓ data from yesterday at this hour';
      row.after(note);
    }
  });

  document.querySelectorAll<HTMLElement>('[data-hours-local-note]').forEach((el) => {
    el.hidden = false;
  });
</script>

<style>
  .trends-block {
    padding: 3rem clamp(1.25rem, 4vw, 2rem) 3.5rem;
    position: relative;
  }
  .trends-inner {
    max-width: 1000px;
    margin-inline: auto;
  }
  .trends-head { text-align: center; margin-bottom: 2rem; }
  .trends-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(232,121,160,0.1); border: 1px solid rgba(232,121,160,0.22);
    color: #e879a0; font-size: 11px; font-weight: 600; letter-spacing: 0.01em;
    padding: 4px 12px; border-radius: 99px; margin-bottom: 14px;
  }
  .live-dot {
    width: 7px; height: 7px; background: #34d399; border-radius: 50%;
    animation: trends-pulse 2s infinite; flex-shrink: 0;
  }
  @keyframes trends-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.4)} }
  .trends-heading {
    font-family: 'Josefin Sans', system-ui, sans-serif;
    font-weight: 700; font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    color: #f0eeff; margin-bottom: 0.6rem; letter-spacing: -0.01em;
  }
  .trends-sub { color: #94a3b8; font-size: 0.9375rem; max-width: 46ch; margin-inline: auto; }
  .trends-update-freq { color: #64748b; font-size: 0.75rem; font-weight: 600; margin-top: 0.5rem; }

  .platform-tabs {
    display: inline-flex; gap: 0.25rem; margin-top: 1.25rem;
    background: rgba(255,255,255,0.03); border: 1px solid rgba(232,121,160,0.12);
    border-radius: 99px; padding: 4px;
  }
  .platform-tab {
    font-family: 'Josefin Sans', system-ui, sans-serif;
    font-size: 0.8125rem; font-weight: 700;
    color: #64748b; background: transparent; border: none;
    padding: 0.45rem 1.1rem; border-radius: 99px; cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .platform-tab:hover { color: #cbd5e1; }
  .platform-tab.is-active {
    color: #fff; background: linear-gradient(135deg, #be185d, #e879a0);
  }
  .trends-empty { text-align: center; color: #64748b; font-size: 0.9375rem; padding: 1rem 0; }

  .trends-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(232,121,160,0.12);
    border-radius: 16px;
    padding: 1.5rem;
  }
  .trends-card-title {
    font-family: 'Josefin Sans', system-ui, sans-serif;
    font-style: italic; font-weight: 700; font-size: 1.05rem;
    color: #f0eeff; margin-bottom: 1rem;
  }

  .hours-caption { font-size: 0.75rem; color: #64748b; margin-bottom: 0.85rem; }
  .hours-local-note { font-size: 0.75rem; color: #e879a0; font-weight: 600; margin: -0.5rem 0 0.85rem; font-style: italic; }
  .hours-list { list-style: none; display: flex; flex-direction: column; gap: 5px; }
  .hours-row { display: grid; grid-template-columns: 110px 1fr auto; align-items: center; gap: 0.75rem; }
  .hours-range { font-size: 0.8125rem; color: #94a3b8; font-weight: 600; white-space: nowrap; }
  .hours-bar-track {
    height: 22px; border-radius: 6px; background: rgba(255,255,255,0.05); overflow: hidden;
  }
  .hours-bar-fill {
    display: block; height: 100%; border-radius: 6px;
    background: #6366f1; opacity: 0.7;
  }
  .hours-score { font-size: 0.75rem; color: #94a3b8; font-weight: 600; white-space: nowrap; min-width: 90px; text-align: right; }
  .hours-score small { color: #475569; }

  .hours-row.is-mid .hours-bar-fill { background: #f472b6; opacity: 1; }
  .hours-row.is-mid .hours-range { color: #f472b6; }
  .hours-row.is-mid .hours-score { color: #f472b6; }

  .hours-row.is-peak .hours-bar-fill { background: #34d399; opacity: 1; }
  .hours-row.is-peak .hours-range { color: #34d399; }
  .hours-row.is-peak .hours-score { color: #34d399; }

  .hours-row.is-current { position: relative; }
  .hours-row.is-current .hours-bar-track { outline: 2px solid #fbbf24; outline-offset: -1px; border-radius: 6px; }
  .hours-row.is-current .hours-range { color: #fbbf24; }
  .hours-row.is-current .hours-score { color: #fbbf24; }
  .now-badge {
    font-size: 10px; background: rgba(251,191,36,0.15); color: #fbbf24;
    border: 1px solid rgba(251,191,36,0.3);
    padding: 1px 6px; border-radius: 99px; margin-left: 5px; vertical-align: middle;
  }
  .hours-yesterday-note {
    font-size: 11px; color: #475569; font-style: italic;
    padding-left: 122px; margin-top: -2px; margin-bottom: 3px;
  }

  .trends-card-wide { margin-top: 1rem; }

  .titles-caption { font-size: 0.75rem; color: #64748b; margin-bottom: 0.85rem; }
  .titles-list { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; }
  .titles-row {
    display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 0.5rem 0.75rem;
    padding-bottom: 0.65rem; border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .titles-row:last-child { border-bottom: none; padding-bottom: 0; }
  .titles-viewers {
    font-size: 0.75rem; font-weight: 700; color: #e879a0; white-space: nowrap;
  }
  .titles-viewers small { color: #64748b; font-weight: 600; }
  .titles-subject { font-size: 0.875rem; color: #cbd5e1; line-height: 1.5; }

  .prices-caption { font-size: 0.75rem; color: #64748b; margin-bottom: 0.85rem; }
