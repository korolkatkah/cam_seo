  },
  fr: {
    h1: 'Recherche en Direct et Classement',
    lead: 'Étudie n’importe quel nom d’utilisateur pour son statut en direct, compare deux salons côte à côte, ou vérifie qui a dominé le classement chaque heure aujourd’hui.',
    tabSearch: 'Recherche et Comparaison', tabLeaderboard: 'Classement du Jour',
    searchLabel: 'Rechercher par nom d’utilisateur', searchPlaceholder: 'nom d’utilisateur', searchBtn: 'Rechercher',
    compareTitle: 'Comparer deux modèles', compareAPlaceholder: 'Utilisateur Modèle A', compareBPlaceholder: 'Utilisateur Modèle B', compareBtn: 'Comparer',
    onlineWord: 'En ligne', privateWord: 'Show privé', publicWord: 'Show public', viewersWord: 'spectateurs',
    notFound: 'Actuellement hors ligne dans les données publiques d’aujourd’hui',
    enterUsername: 'Entrez un nom d’utilisateur ci-dessus pour vérifier son statut en direct',
    leaderboardTitle: 'Salons les plus populaires aujourd’hui', hourlyTitle: 'Qui a mené le trafic chaque heure',
    hourCol: 'Heure (votre fuseau)', leaderCol: 'Leader', viewersCol: 'Spectateurs',
    showMore: 'Afficher plus', hide: 'Masquer',
    comingSoon: 'L’index en direct démarre bientôt — revenez plus tard.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
  pt: {
    h1: 'Busca ao Vivo e Ranking',
    lead: 'Busque qualquer nome de usuário para ver o status ao vivo, compare duas salas lado a lado, ou confira quem liderou o ranking a cada hora hoje.',
    tabSearch: 'Busca e Comparação', tabLeaderboard: 'Ranking de Hoje',
    searchLabel: 'Buscar por nome de usuário', searchPlaceholder: 'nome de usuário', searchBtn: 'Buscar',
    compareTitle: 'Comparar dois modelos', compareAPlaceholder: 'Usuário Modelo A', compareBPlaceholder: 'Usuário Modelo B', compareBtn: 'Comparar',
    onlineWord: 'Online', privateWord: 'Show privado', publicWord: 'Show público', viewersWord: 'espectadores',
    notFound: 'No momento não está online nos dados públicos de hoje',
    enterUsername: 'Digite um nome de usuário acima para verificar o status ao vivo',
    leaderboardTitle: 'Salas em destaque hoje', hourlyTitle: 'Quem liderou o tráfego a cada hora',
    hourCol: 'Hora (seu fuso)', leaderCol: 'Líder', viewersCol: 'Espectadores',
    showMore: 'Mostrar mais', hide: 'Ocultar',
    comingSoon: 'O índice ao vivo começa em breve — volte mais tarde.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
};
const t = STR[lang] ?? STR.en;

const hasCbIndex = (cbLive.live_index?.length ?? 0) > 0;
const hasScIndex = (scLive.live_index?.length ?? 0) > 0;
const hasCbBoard = (cbLive.top_rooms_today?.length ?? 0) > 0 || (cbLive.hourly_leaders?.length ?? 0) > 0;
const hasScBoard = (scLive.top_rooms_today?.length ?? 0) > 0 || (scLive.hourly_leaders?.length ?? 0) > 0;

// Escape "<" so this can't break out of the <script> tag it's embedded in —
// room subjects/usernames come from public platform data, not our own copy.
const cbLiveJson = JSON.stringify(cbLive).replace(/</g, '\\u003c');
const scLiveJson = JSON.stringify(scLive).replace(/</g, '\\u003c');
---

<section class="llt-hero">
  <div class="llt-hero-inner">
    <h1 class="llt-h1">{t.h1}</h1>
    <p class="llt-lead">{t.lead}</p>
  </div>
</section>

<section class="llt-block">
  <div class="llt-inner">
    <div class="llt-maintabs" role="tablist">
      <button type="button" class="llt-maintab is-active" data-llt-maintab="search" role="tab" aria-selected="true">{t.tabSearch}</button>
      <button type="button" class="llt-maintab" data-llt-maintab="board" role="tab" aria-selected="false">{t.tabLeaderboard}</button>
    </div>

    <div class="llt-mainpanel" data-llt-mainpanel="search">
      <div class="llt-card">
        <label class="llt-label" for="llt-search-input">{t.searchLabel}</label>
        <div class="llt-search-row">
          <input id="llt-search-input" type="text" class="llt-input" placeholder={t.searchPlaceholder} autocomplete="off" />
          <button type="button" class="llt-btn" data-llt-search-btn>{t.searchBtn}</button>
        </div>
        <div class="llt-results" data-llt-search-results>
          <p class="llt-hint">{t.enterUsername}</p>
        </div>
      </div>

      <div class="llt-card">
        <p class="llt-label">{t.compareTitle}</p>
        <div class="llt-compare-row">
          <input type="text" class="llt-input" data-llt-compare-a placeholder={t.compareAPlaceholder} autocomplete="off" />
          <input type="text" class="llt-input" data-llt-compare-b placeholder={t.compareBPlaceholder} autocomplete="off" />
          <button type="button" class="llt-btn" data-llt-compare-btn>{t.compareBtn}</button>
        </div>
        <div class="llt-compare-results" data-llt-compare-results></div>
      </div>
    </div>

    <div class="llt-mainpanel" data-llt-mainpanel="board" hidden>
      {(['cb', 'sc'] as const).map((platform) => {
        const hasBoard = platform === 'cb' ? hasCbBoard : hasScBoard;
        const label = platform === 'cb' ? t.platformCb : t.platformSc;
        const data = platform === 'cb' ? cbLive : scLive;
        const topRooms = data.top_rooms_today ?? [];
        return (
          <div class="llt-card">
            <h3 class="llt-card-title">{label} — {t.leaderboardTitle}</h3>
            {!hasBoard && <p class="llt-hint">{t.comingSoon}</p>}
            {hasBoard && (
              <>
                <ol class="llt-board-list" data-llt-board-list={platform}>
                  {topRooms.slice(0, 20).map((r: { username: string; avg_users: number; subject?: string }, i: number) => (
                    <li class="llt-board-row">
                      <span class="llt-board-rank">{i + 1}</span>
                      <span class="llt-board-user">{r.username}</span>
                      <span class="llt-board-num">~{r.avg_users.toLocaleString()} <small>{t.viewersWord}</small></span>
                      {r.subject && <span class="llt-board-subject">{r.subject}</span>}
                    </li>
                  ))}
                </ol>
                {topRooms.length > 20 && (
                  <>
                    <button class="llt-more-btn" data-show={t.showMore} data-hide={t.hide} aria-expanded="false">
                      <span>{t.showMore} ({topRooms.length - 20})</span>
                    </button>
                    <ol class="llt-board-list llt-board-list--more" start={21} hidden>
                      {topRooms.slice(20, 100).map((r: { username: string; avg_users: number; subject?: string }, i: number) => (
                        <li class="llt-board-row">
                          <span class="llt-board-rank">{i + 21}</span>
                          <span class="llt-board-user">{r.username}</span>
                          <span class="llt-board-num">~{r.avg_users.toLocaleString()} <small>{t.viewersWord}</small></span>
                          {r.subject && <span class="llt-board-subject">{r.subject}</span>}
                        </li>
                      ))}
                    </ol>
                  </>
                )}
              </>
            )}
          </div>
        );
      })}

      {(['cb', 'sc'] as const).map((platform) => {
        const data = platform === 'cb' ? cbLive : scLive;
        const label = platform === 'cb' ? t.platformCb : t.platformSc;
        const hours = data.hourly_leaders ?? [];
        if (hours.length === 0) return null;
        return (
          <div class="llt-card">
            <h3 class="llt-card-title">{label} — {t.hourlyTitle}</h3>
            <table class="llt-hourly-table" data-llt-hourly-table={platform}>
              <thead>
                <tr><th>{t.hourCol}</th><th>{t.leaderCol}</th><th>{t.viewersCol}</th></tr>
              </thead>
              <tbody>
                {hours.map((h: { hour: number; username: string; viewers: number }) => (
                  <tr data-utc-hour={h.hour}>
                    <td class="llt-hour-cell">{String(h.hour).padStart(2, '0')}:00 UTC</td>
                    <td>{h.username}</td>
                    <td>{h.viewers.toLocaleString()}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script type="application/json" id="llt-cb-data" set:html={cbLiveJson} />
<script type="application/json" id="llt-sc-data" set:html={scLiveJson} />

<script define:vars={{ t: { onlineWord: t.onlineWord, privateWord: t.privateWord, publicWord: t.publicWord, viewersWord: t.viewersWord, notFound: t.notFound, platformCb: t.platformCb, platformSc: t.platformSc } }}>
  function pad(n) { return String(n).padStart(2, '0'); }

  function readJson(id) {
    const el = document.getElementById(id);
    if (!el) return null;
    try { return JSON.parse(el.textContent || 'null'); } catch { return null; }
  }
  const cbData = readJson('llt-cb-data');
  const scData = readJson('llt-sc-data');

  function findMatches(query) {
    const q = query.trim().toLowerCase();
    if (!q) return [];
    const out = [];
    for (const [platform, data, label] of [['cb', cbData, t.platformCb], ['sc', scData, t.platformSc]]) {
      const idx = data?.live_index ?? [];
      for (const r of idx) {
        if (r.username && r.username.toLowerCase().includes(q)) {
          out.push({ platform, label, ...r });
        }
      }
    }
    return out.slice(0, 12);
  }

  function findExact(username, platform) {
    const q = username.trim().toLowerCase();
    if (!q) return null;
    const data = platform === 'cb' ? cbData : scData;
    const idx = data?.live_index ?? [];
    return idx.find((r) => r.username && r.username.toLowerCase() === q) ?? null;
  }

  function renderCard(r) {
    const statusWord = r.private === true ? t.privateWord : (r.private === false ? t.publicWord : t.onlineWord);
    const div = document.createElement('div');
    div.className = 'llt-result-card';
    div.innerHTML = `
      <span class="llt-result-platform">${r.label}</span>
      <span class="llt-result-user">${r.username}</span>
      <span class="llt-result-status">${statusWord}</span>
      <span class="llt-result-viewers">~${(r.viewers ?? 0).toLocaleString()} ${t.viewersWord}</span>
    `;
    return div;
  }

  document.querySelectorAll('[data-llt-maintab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.lltMaintab;
      document.querySelectorAll('[data-llt-maintab]').forEach((tb) => {
        tb.classList.toggle('is-active', tb === tab);
        tb.setAttribute('aria-selected', tb === tab ? 'true' : 'false');
      });
      document.querySelectorAll('[data-llt-mainpanel]').forEach((panel) => {
        panel.hidden = panel.dataset.lltMainpanel !== target;
      });
    });
  });

  const searchInput = document.getElementById('llt-search-input');
  const searchResults = document.querySelector('[data-llt-search-results]');
  const searchBtn = document.querySelector('[data-llt-search-btn]');
  function runSearch() {
    if (!searchInput || !searchResults) return;
    const matches = findMatches(searchInput.value);
    searchResults.innerHTML = '';
    if (!searchInput.value.trim()) return;
    if (matches.length === 0) {
      const p = document.createElement('p');
      p.className = 'llt-hint';
      p.textContent = t.notFound;
      searchResults.appendChild(p);
      return;
    }
    matches.forEach((r) => searchResults.appendChild(renderCard(r)));
  }
  searchBtn?.addEventListener('click', runSearch);
  searchInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') runSearch(); });

  const compareBtn = document.querySelector('[data-llt-compare-btn]');
  const compareA = document.querySelector('[data-llt-compare-a]');
  const compareB = document.querySelector('[data-llt-compare-b]');
  const compareResults = document.querySelector('[data-llt-compare-results]');
  compareBtn?.addEventListener('click', () => {
    if (!compareResults) return;
    compareResults.innerHTML = '';
    [compareA, compareB].forEach((input) => {
      if (!input || !input.value.trim()) return;
      const cb = findExact(input.value, 'cb');
      const sc = findExact(input.value, 'sc');
      if (cb) compareResults.appendChild(renderCard({ ...cb, platform: 'cb', label: t.platformCb }));
      if (sc) compareResults.appendChild(renderCard({ ...sc, platform: 'sc', label: t.platformSc }));
      if (!cb && !sc) {
        const p = document.createElement('p');
        p.className = 'llt-hint';
        p.textContent = `${input.value} — ${t.notFound}`;
        compareResults.appendChild(p);
      }
    });
  });

  document.querySelectorAll('.llt-more-btn').forEach((btn) => {
    const list = btn.nextElementSibling;
    const labelEl = btn.querySelector('span');
    btn.addEventListener('click', () => {
      const open = list.hidden;
      list.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (labelEl) labelEl.textContent = open ? btn.dataset.hide : `${btn.dataset.show} (${list.querySelectorAll('.llt-board-row').length})`;
    });
  });

  const tzOffsetMin = new Date().getTimezoneOffset();
  document.querySelectorAll('[data-llt-hourly-table]').forEach((table) => {
    table.querySelectorAll('tr[data-utc-hour]').forEach((row) => {
      const utcHour = Number(row.dataset.utcHour);
      if (Number.isNaN(utcHour)) return;
      const startTotal = (((utcHour * 60 - tzOffsetMin) % 1440) + 1440) % 1440;
      const fmt = (m) => `${pad(Math.floor(m / 60))}:${pad(m % 60)}`;
      const cell = row.querySelector('.llt-hour-cell');
      if (cell) cell.textContent = fmt(startTotal);
    });
  });
</script>

<style>
  .llt-hero { padding: 3rem clamp(1.25rem, 4vw, 2rem) 1rem; text-align: center; }
  .llt-hero-inner { max-width: 700px; margin-inline: auto; }
  .llt-h1 {
    font-family: 'Josefin Sans', system-ui, sans-serif; font-weight: 700; font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.5rem); color: var(--fg); margin-bottom: 0.75rem;
  }
  .llt-lead { color: var(--fg-muted); font-size: 1rem; line-height: 1.6; }

  .llt-block { padding: 1rem clamp(1.25rem, 4vw, 2rem) 3.5rem; }
  .llt-inner { max-width: 900px; margin-inline: auto; }

  .llt-maintabs {
    display: inline-flex; gap: 0.25rem; margin-bottom: 1.5rem;
    background: var(--card-bg); border: 1px solid var(--border);
    border-radius: 99px; padding: 4px;
  }
  .llt-maintab {
    font-family: 'Josefin Sans', system-ui, sans-serif; font-size: 0.8125rem; font-weight: 700;
    color: var(--fg-muted); background: transparent; border: none;
    padding: 0.5rem 1.2rem; border-radius: 99px; cursor: pointer;
  }
  .llt-maintab.is-active { color: var(--btn-fg); background: var(--btn-bg); }

  .llt-card {
    background: var(--bg-raised); border: 1px solid var(--border); border-radius: 16px;
    padding: 1.5rem; margin-bottom: 1rem;
  }
  .llt-card-title { font-weight: 700; font-size: 1.125rem; color: var(--fg); margin-bottom: 1rem; }
  .llt-label { display: block; font-size: 0.8125rem; font-weight: 700; color: var(--fg); margin-bottom: 0.6rem; }
  .llt-search-row, .llt-compare-row { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .llt-input {
    flex: 1 1 180px; padding: 0.7rem 0.9rem; border-radius: 10px;
    border: 1px solid var(--border); background: var(--bg); color: var(--fg); font-size: 0.9375rem;
  }
  .llt-btn {
    background: var(--btn-bg); color: var(--btn-fg); border: none; border-radius: 10px;
    padding: 0.7rem 1.3rem; font-weight: 700; font-size: 0.875rem; cursor: pointer;
  }
