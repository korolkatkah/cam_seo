---
import cbLive from '../data/cb-live.json';
import scLive from '../data/sc-live.json';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

const STR: Record<string, Record<string, string>> = {
  en: {
    h1: "Today's Leaderboard",
    lead: "See today's top rooms and who led the traffic each hour — Chaturbate & Stripchat, updated automatically.",
    boardNavLabel: 'Jump to section',
    leaderboardTitle: 'Top rooms today', hourlyTitle: 'Who led the traffic each hour',
    hourCol: 'Hour (your time)', leaderCol: 'Leader', viewersCol: 'Viewers', viewersWord: 'viewers',
    showMore: 'Show more', hide: 'Hide',
    comingSoon: 'Live index starting soon — check back shortly.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
  de: {
    h1: 'Heutige Bestenliste',
    lead: 'Sieh die Top-Räume heute und wer in jeder Stunde die Charts anführte — Chaturbate & Stripchat, automatisch aktualisiert.',
    boardNavLabel: 'Zu Abschnitt springen',
    leaderboardTitle: 'Top-Räume heute', hourlyTitle: 'Wer lag in jeder Stunde vorne',
    hourCol: 'Stunde (deine Zeit)', leaderCol: 'Spitzenreiter', viewersCol: 'Zuschauer', viewersWord: 'Zuschauer',
    showMore: 'Mehr anzeigen', hide: 'Ausblenden',
    comingSoon: 'Live-Index startet in Kürze — schau bald wieder vorbei.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
  es: {
    h1: 'Ranking de Hoy',
    lead: 'Mira las salas top de hoy y quién lideró el tráfico cada hora — Chaturbate y Stripchat, actualizado automáticamente.',
    boardNavLabel: 'Ir a sección',
    leaderboardTitle: 'Salas top de hoy', hourlyTitle: 'Quién lideró el tráfico cada hora',
    hourCol: 'Hora (tu zona horaria)', leaderCol: 'Líder', viewersCol: 'Espectadores', viewersWord: 'espectadores',
    showMore: 'Mostrar más', hide: 'Ocultar',
    comingSoon: 'El índice en vivo empieza pronto — vuelve más tarde.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
  ro: {
    h1: 'Clasamentul de Azi',
    lead: 'Vezi camerele de top de azi și cine a condus traficul în fiecare oră — Chaturbate și Stripchat, actualizat automat.',
    boardNavLabel: 'Sari la secțiune',
    leaderboardTitle: 'Camerele de top azi', hourlyTitle: 'Cine a condus traficul în fiecare oră',
    hourCol: 'Ora (fusul tău)', leaderCol: 'Lider', viewersCol: 'Spectatori', viewersWord: 'spectatori',
    showMore: 'Arată mai multe', hide: 'Ascunde',
    comingSoon: 'Indexul live pornește în curând — revino mai târziu.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
  uk: {
    h1: 'Сьогоднішній рейтинг',
    lead: 'Дивись топ-кімнати сьогодні і хто лідирував за трафіком щогодини — Chaturbate і Stripchat, оновлюється автоматично.',
    boardNavLabel: 'Перейти до розділу',
    leaderboardTitle: 'Топ-кімнати сьогодні', hourlyTitle: 'Хто лідирував за трафіком щогодини',
    hourCol: 'Година (твій час)', leaderCol: 'Лідер', viewersCol: 'Глядачів', viewersWord: 'глядачів',
    showMore: 'Показати більше', hide: 'Сховати',
    comingSoon: 'Живий індекс скоро запуститься — заглядай пізніше.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
  ru: {
    h1: 'Рейтинг сегодня',
    lead: 'Смотри топ-комнаты сегодня и кто лидировал по трафику каждый час — Chaturbate и Stripchat, обновляется автоматически.',
    boardNavLabel: 'Перейти к разделу',
    leaderboardTitle: 'Топ-комнаты сегодня', hourlyTitle: 'Кто лидировал по трафику каждый час',
    hourCol: 'Час (ваше время)', leaderCol: 'Лидер', viewersCol: 'Зрителей', viewersWord: 'зрителей',
    showMore: 'Показать ещё', hide: 'Скрыть',
    comingSoon: 'Живой индекс скоро запустится — загляните позже.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
  fr: {
    h1: 'Classement du Jour',
    lead: 'Découvre les meilleurs salons du jour et qui a mené le trafic chaque heure — Chaturbate et Stripchat, mis à jour automatiquement.',
    boardNavLabel: 'Aller à la section',
    leaderboardTitle: 'Salons les plus populaires aujourd’hui', hourlyTitle: 'Qui a mené le trafic chaque heure',
    hourCol: 'Heure (votre fuseau)', leaderCol: 'Leader', viewersCol: 'Spectateurs', viewersWord: 'spectateurs',
    showMore: 'Afficher plus', hide: 'Masquer',
    comingSoon: 'L’index en direct démarre bientôt — revenez plus tard.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
  pt: {
    h1: 'Ranking de Hoje',
    lead: 'Veja as salas em destaque hoje e quem liderou o tráfego a cada hora — Chaturbate e Stripchat, atualizado automaticamente.',
    boardNavLabel: 'Ir para a seção',
    leaderboardTitle: 'Salas em destaque hoje', hourlyTitle: 'Quem liderou o tráfego a cada hora',
    hourCol: 'Hora (seu fuso)', leaderCol: 'Líder', viewersCol: 'Espectadores', viewersWord: 'espectadores',
    showMore: 'Mostrar mais', hide: 'Ocultar',
    comingSoon: 'O índice ao vivo começa em breve — volte mais tarde.',
    platformCb: 'Chaturbate', platformSc: 'Stripchat',
  },
};
const t = STR[lang] ?? STR.en;

const hasCbBoard = (cbLive.top_rooms_today?.length ?? 0) > 0 || (cbLive.hourly_leaders?.length ?? 0) > 0;
const hasScBoard = (scLive.top_rooms_today?.length ?? 0) > 0 || (scLive.hourly_leaders?.length ?? 0) > 0;
const hasCbHourly = (cbLive.hourly_leaders?.length ?? 0) > 0;
const hasScHourly = (scLive.hourly_leaders?.length ?? 0) > 0;
const boardSections = [
  { id: 'llt-rooms-cb', label: `${t.platformCb} — ${t.leaderboardTitle}` },
  { id: 'llt-rooms-sc', label: `${t.platformSc} — ${t.leaderboardTitle}` },
  ...(hasCbHourly ? [{ id: 'llt-hourly-cb', label: `${t.platformCb} — ${t.hourlyTitle}` }] : []),
  ...(hasScHourly ? [{ id: 'llt-hourly-sc', label: `${t.platformSc} — ${t.hourlyTitle}` }] : []),
];
---

<section class="llt-hero">
  <div class="llt-hero-inner">
    <h1 class="llt-h1">{t.h1}</h1>
    <p class="llt-lead">{t.lead}</p>
  </div>
</section>

<section class="llt-block">
  <div class="llt-inner">
    {boardSections.length > 0 && (
      <nav class="llt-board-nav" aria-label={t.boardNavLabel}>
        {boardSections.map((s) => (
          <a href={`#${s.id}`} class="llt-board-nav__link" data-llt-board-nav-link>{s.label}</a>
        ))}
      </nav>
    )}

    {(['cb', 'sc'] as const).map((platform) => {
      const hasBoard = platform === 'cb' ? hasCbBoard : hasScBoard;
      const label = platform === 'cb' ? t.platformCb : t.platformSc;
      const data = platform === 'cb' ? cbLive : scLive;
      const topRooms = data.top_rooms_today ?? [];
      return (
        <div class="llt-card" id={`llt-rooms-${platform}`}>
          <h2 class="llt-card-title">{label} — {t.leaderboardTitle}</h2>
          {!hasBoard && <p class="llt-hint">{t.comingSoon}</p>}
          {hasBoard && (
            <>
              <ol class="llt-board-list" data-llt-board-list={platform}>
                {topRooms.slice(0, 20).map((r: { username: string; avg_users: number; subject?: string }, i: number) => (
                  <li class="llt-board-row">
                    <span class="llt-board-rank">{i + 1}</span>
                    <span class="llt-board-user">{r.username}</span>
                    <span class="llt-board-num">~{r.avg_users.toLocaleString()} <small>{t.viewersWord}</small></span>
                    {r.subject && <span class="llt-board-subject">{r.subject}</span>}
                  </li>
                ))}
              </ol>
              {topRooms.length > 20 && (
                <>
                  <button class="llt-more-btn" data-show={t.showMore} data-hide={t.hide} aria-expanded="false">
                    <span>{t.showMore} ({topRooms.length - 20})</span>
                  </button>
                  <ol class="llt-board-list llt-board-list--more" start={21} hidden>
                    {topRooms.slice(20, 100).map((r: { username: string; avg_users: number; subject?: string }, i: number) => (
                      <li class="llt-board-row">
                        <span class="llt-board-rank">{i + 21}</span>
                        <span class="llt-board-user">{r.username}</span>
                        <span class="llt-board-num">~{r.avg_users.toLocaleString()} <small>{t.viewersWord}</small></span>
                        {r.subject && <span class="llt-board-subject">{r.subject}</span>}
                      </li>
                    ))}
                  </ol>
                </>
              )}
            </>
          )}
        </div>
      );
    })}

    {(['cb', 'sc'] as const).map((platform) => {
      const data = platform === 'cb' ? cbLive : scLive;
      const label = platform === 'cb' ? t.platformCb : t.platformSc;
      const hours = data.hourly_leaders ?? [];
      if (hours.length === 0) return null;
      return (
        <div class="llt-card" id={`llt-hourly-${platform}`}>
          <h2 class="llt-card-title">{label} — {t.hourlyTitle}</h2>
          <table class="llt-hourly-table" data-llt-hourly-table={platform}>
            <thead>
              <tr><th>{t.hourCol}</th><th>{t.leaderCol}</th><th>{t.viewersCol}</th></tr>
            </thead>
            <tbody>
              {hours.map((h: { hour: number; username: string; viewers: number }) => (
                <tr data-utc-hour={h.hour}>
                  <td class="llt-hour-cell">{String(h.hour).padStart(2, '0')}:00 UTC</td>
                  <td>{h.username}</td>
                  <td>{h.viewers.toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    })}
  </div>
</section>

<script>
  function pad(n: number): string {
    return String(n).padStart(2, '0');
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-llt-board-nav-link]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const id = link.getAttribute('href')?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      e.preventDefault();
      const top = target.getBoundingClientRect().top + window.scrollY - 100;
      window.scrollTo({ top, behavior: 'smooth' });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.llt-more-btn').forEach((btn) => {
    const list = btn.nextElementSibling as HTMLElement;
    const labelEl = btn.querySelector('span');
    btn.addEventListener('click', () => {
      const open = list.hidden;
      list.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (labelEl) labelEl.textContent = open ? btn.dataset.hide! : `${btn.dataset.show} (${list.querySelectorAll('.llt-board-row').length})`;
    });
  });

  const tzOffsetMin = new Date().getTimezoneOffset();
  document.querySelectorAll<HTMLElement>('[data-llt-hourly-table]').forEach((table) => {
    table.querySelectorAll<HTMLElement>('tr[data-utc-hour]').forEach((row) => {
      const utcHour = Number(row.dataset.utcHour);
      if (Number.isNaN(utcHour)) return;
      const startTotal = (((utcHour * 60 - tzOffsetMin) % 1440) + 1440) % 1440;
      const fmt = (m: number) => `${pad(Math.floor(m / 60))}:${pad(m % 60)}`;
      const cell = row.querySelector<HTMLElement>('.llt-hour-cell');
      if (cell) cell.textContent = fmt(startTotal);
    });
  });
</script>

<style>
  .llt-hero { padding: 3rem clamp(1.25rem, 4vw, 2rem) 1rem; text-align: center; }
  .llt-hero-inner { max-width: 700px; margin-inline: auto; }
  .llt-h1 {
    font-family: 'Josefin Sans', system-ui, sans-serif; font-weight: 700; font-style: italic;
    font-size: clamp(1.75rem, 4vw, 2.5rem); color: var(--fg); margin-bottom: 0.75rem;
  }
  .llt-lead { color: var(--fg-muted); font-size: 1rem; line-height: 1.6; }

  .llt-block { padding: 1rem clamp(1.25rem, 4vw, 2rem) 3.5rem; }
  .llt-inner { max-width: 900px; margin-inline: auto; }

  .llt-board-nav {
    position: sticky; top: 88px; z-index: 4;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
    background: var(--bg); border: 1px solid var(--border); border-radius: 12px;
    padding: 0.6rem; margin-bottom: 1rem;
  }
  .llt-board-nav__link {
    font-size: 0.75rem; font-weight: 700; color: var(--fg-muted);
    background: var(--card-bg); border: 1px solid var(--border); border-radius: 99px;
    padding: 0.4rem 0.85rem; text-decoration: none; white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .llt-board-nav__link:hover { color: var(--fg); border-color: var(--fg-faint); }

  .llt-card {
    background: var(--bg-raised); border: 1px solid var(--border); border-radius: 16px;
    padding: 1.5rem; margin-bottom: 1rem; scroll-margin-top: 100px;
  }
  .llt-card-title { font-weight: 700; font-size: 1.125rem; color: var(--fg); margin-bottom: 1rem; }
  .llt-hint { color: var(--fg-faint); font-size: 0.875rem; margin-top: 0.75rem; }

  .llt-board-row {
    display: grid; grid-template-columns: 1.5rem auto auto 1fr; align-items: center; gap: 0.6rem;
    background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; padding: 0.6rem 0.9rem;
    font-size: 0.875rem;
  }
  .llt-board-user { font-weight: 700; color: var(--fg); }
  .llt-board-num { font-weight: 700; color: #16a34a; white-space: nowrap; }
  .llt-board-num small { color: var(--fg-muted); font-weight: 600; }

  .llt-board-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .llt-board-rank { color: var(--fg-faint); font-weight: 700; font-size: 0.75rem; }
  .llt-board-subject {
    grid-column: 1 / -1; color: var(--fg-muted); font-size: 0.8125rem; line-height: 1.4;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .llt-more-btn {
    display: flex; align-items: center; width: 100%; margin-top: 0.6rem;
    background: rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.12); border-radius: 10px;
    padding: 0.6rem 1rem; cursor: pointer; font-size: 0.8125rem; font-weight: 600; color: var(--fg);
  }
  .llt-board-list--more { margin-top: 0.4rem; }

  .llt-hourly-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
  .llt-hourly-table th {
    text-align: left; color: var(--fg-faint); font-weight: 700; font-size: 0.6875rem;
    text-transform: uppercase; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border);
  }
  .llt-hourly-table td { padding: 0.45rem 0.5rem; border-bottom: 1px solid var(--border); color: var(--fg-muted); }
  .llt-hourly-table td:nth-child(2) { color: var(--fg); font-weight: 700; }
</style>
