---
interface HreflangEntry {
  lang: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  noindex?: boolean;
  hreflang?: HreflangEntry[];
  lang?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  noindex = false,
  hreflang = [],
  lang = 'en',
} = Astro.props;

const siteName = 'EWO';

const langLabels: Record<string, string> = {
  en: 'English',
  de: 'Deutsch',
  ro: 'Română',
  uk: 'Українська',
  ru: 'Русский',
  es: 'Español',
};

const langPrefix = lang === 'en' ? '' : `/${lang}`;

const navLabels: Record<string, {models: string, studios: string, blog: string, about: string}> = {
  en: { models: 'For Models', studios: 'For Studios', blog: 'Blog', about: 'About' },
  de: { models: 'Für Models', studios: 'Für Studios', blog: 'Blog', about: 'Über uns' },
  es: { models: 'Para Modelos', studios: 'Para Estudios', blog: 'Blog', about: 'Nosotros' },
  ro: { models: 'Pentru Modele', studios: 'Pentru Studiouri', blog: 'Blog', about: 'Despre noi' },
  uk: { models: 'Для Моделей', studios: 'Для Студій', blog: 'Блог', about: 'Про нас' },
  ru: { models: 'Для Моделей', studios: 'Для Студий', blog: 'Блог', about: 'О нас' },
};
const nl = navLabels[lang] ?? navLabels.en;

const ctaLabels: Record<string, string> = {
  en: 'Get Started', de: 'Loslegen', es: 'Comenzar',
  ro: 'Începe', uk: 'Почати', ru: 'Начать',
};

const nav = [
  { href: `${langPrefix}/for-models`, label: nl.models },
  { href: `${langPrefix}/studio-traffic`, label: nl.studios },
  { href: `${langPrefix}/blog`, label: nl.blog },
  { href: `${langPrefix}/about`, label: nl.about },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6H89TM92EZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-6H89TM92EZ');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {hreflang.map(({ lang: l, url }) => (
      <link rel="alternate" hreflang={l} href={url} />
    ))}
    {hreflang.length > 0 && <link rel="alternate" hreflang="x-default" href={hreflang.find(h => h.lang === 'en')?.url ?? canonicalUrl} />}
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@1,300;1,400;1,600;1,700&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-inner">
        <a href="/" class="logo" aria-label="EWO home">
          <img src="/logo.svg" alt="EWO" class="logo-img">
          <span class="logo-ewo">EWO</span><span class="logo-cam">.cam</span>
        </a>
        <ul class="nav-links" role="list">
          {nav.map(({ href, label }) => (
            <li><a href={href} class="nav-link">{label}</a></li>
          ))}
        </ul>
        {hreflang.length > 1 && (
          <div class="lang-dropdown">
            <button class="lang-drop-btn" aria-expanded="false" aria-haspopup="true" id="lang-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              <span>{langLabels[lang] ?? lang}</span>
              <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="lang-menu" role="listbox" id="lang-menu">
              {hreflang.map(({ lang: l, url }) => (
                <li>
                  <a href={url} class={`lang-opt${l === lang ? ' lang-opt--active' : ''}`} hreflang={l}>
                    {langLabels[l] ?? l}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <a href={`${langPrefix}/about#contact`} class="btn-nav">{ctaLabels[lang] ?? 'Get Started'}</a>
      </nav>
    </header>


    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/logo.svg" alt="EWO" class="logo-img">
            <span class="logo-ewo">EWO</span><span class="logo-cam">.cam</span>
          </div>
          <p class="footer-tagline">Legitimate audience growth for webcam models & studios worldwide.</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <div class="footer-col">
            <p class="footer-col-title">Services</p>
            <ul role="list">
              <li><a href="/for-models">For Models</a></li>
              <li><a href="/studio-traffic">Studio Traffic</a></li>
              <li><a href="/new-model-growth">New Model Growth</a></li>
              <li><a href="/studio-scaling">Studio Scaling</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Resources</p>
            <ul role="list">
              <li><a href="/model-promotion">Model Promotion</a></li>
              <li><a href="/why-low-viewers-webcam">Why Low Viewers</a></li>
              <li><a href="/how-cam-algorithm-ranks-rooms">Algorithm Guide</a></li>
              <li><a href="/webcam-model-income-guide">Income Guide</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Regions</p>
            <ul role="list">
              <li><a href="/model-promotion-usa">USA</a></li>
              <li><a href="/model-promotion-germany">Germany</a></li>
              <li><a href="/model-promotion-romania">Romania</a></li>
              <li><a href="/model-promotion-ukraine">Ukraine</a></li>
              <li><a href="/model-promotion-colombia">Colombia</a></li>
              <li><a href="/model-promotion-spain">Spain</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} EWO.cam · All rights reserved</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ── Design Tokens ── */
  :root {
    --bg:        #060918;
    --bg-raised: #0d1030;
    --bg-subtle: #080b1e;
    --border:    rgba(255,255,255,0.07);
    --fg:        #f0eeff;
    --fg-muted:  #94a3b8;
    --fg-faint:  #475569;
    --accent:    #818cf8;
    --accent-hover: #a78bfa;
    --accent-dim:   rgba(99,102,241,0.15);

    --font-heading: 'Josefin Sans', system-ui, sans-serif;
    --font-body:    'Nunito', system-ui, sans-serif;

    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --transition: 180ms ease;

    --container: 1200px;
    --container-text: 720px;
  }

  /* ── Reset ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 16px; scroll-behavior: smooth; color-scheme: dark; }
  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--fg);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }
  main { flex: 1; }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  ul { list-style: none; }
  button { cursor: pointer; font-family: inherit; }

  /* ── Typography ── */
  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); }
  h2 { font-size: clamp(1.75rem, 3vw, 2.75rem); }
  h3 { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 600; }
  p  { color: var(--fg-muted); line-height: 1.75; max-width: 65ch; }

  /* ── Layout helpers ── */
  .container {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }
  .section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .divider {
    border: none;
    border-top: 1px solid var(--border);
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-family: var(--font-heading);
    font-size: .9375rem;
    font-weight: 700;
    letter-spacing: .01em;
    padding: .75rem 1.75rem;
    border-radius: var(--radius-md);
    transition: opacity var(--transition), transform var(--transition), box-shadow var(--transition);
    cursor: pointer;
    border: none;
    white-space: nowrap;
    min-height: 48px;
  }
  .btn-primary {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
  }
  .btn-primary:hover {
    opacity: 0.9;
    box-shadow: 0 0 24px rgba(99,102,241,.4);
  }
  .btn-ghost {
    background: transparent;
    color: var(--fg-muted);
    border: 1px solid var(--border);
  }
  .btn-ghost:hover {
    border-color: rgba(129,140,248,0.3);
    background: rgba(129,140,248,0.05);
    color: var(--fg);
  }
  .btn-nav {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading);
    font-size: .875rem;
    font-weight: 700;
    padding: .5rem 1.25rem;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #fff;
    transition: opacity var(--transition), box-shadow var(--transition);
    min-height: 40px;
  }
  .btn-nav:hover {
    opacity: 0.9;
    box-shadow: 0 0 16px rgba(99,102,241,.4);
  }

  /* ── Header ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6,9,24,.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .nav-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-shrink: 0;
    text-decoration: none;
  }
  .logo-img { width: 32px; height: 32px; }
  .logo-ewo {
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    background: linear-gradient(135deg, #a78bfa, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .logo-cam {
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: rgba(255,255,255,0.4);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: .25rem;
    margin-left: auto;
  }
  .nav-link {
    font-family: var(--font-heading);
    font-size: .9rem;
    font-weight: 600;
    color: var(--fg-muted);
    padding: .5rem .875rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }
  .nav-link:hover {
    color: var(--fg);
    background: rgba(129,140,248,0.08);
  }
  @media (max-width: 640px) {
    .nav-links { display: none; }
    .nav-inner { gap: 1rem; }
  }

  /* ── Cards ── */
  .card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--radius-lg);
    padding: 2rem;
    backdrop-filter: blur(12px);
    transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
  }
  .card:hover {
    border-color: rgba(129,140,248,0.3);
    background: rgba(129,140,248,0.05);
    box-shadow: 0 4px 32px rgba(0,0,0,.4);
  }

  /* ── Accent text ── */
  .text-accent { color: var(--accent); }
  .text-muted  { color: var(--fg-muted); }

  /* ── Footer ── */
  .site-footer {
    border-top: 1px solid rgba(255,255,255,0.05);
    background: var(--bg-subtle);
  }
  .footer-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: 4rem clamp(1.25rem, 4vw, 2rem) 3rem;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: .75rem;
  }
  .footer-tagline { color: var(--fg-faint); font-size: .875rem; margin-top: .25rem; max-width: 24ch; font-weight: 600; }
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .footer-col-title {
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 1rem;
    max-width: none;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: .5rem; }
  .footer-col a {
    font-size: .875rem;
    font-weight: 600;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .footer-col a:hover { color: var(--fg); }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.05);
    padding: 1.25rem clamp(1.25rem, 4vw, 2rem);
    text-align: center;
  }
  .footer-bottom p { font-size: .8125rem; color: var(--fg-faint); max-width: none; font-weight: 600; }

  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .footer-nav { grid-template-columns: 1fr; }
  }

  /* ── Language Switcher ── */
  .lang-switcher {
    background: rgba(13,16,48,0.8);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .lang-switcher-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    height: 40px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .lang-switcher-label {
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    white-space: nowrap;
  }
  .lang-list {
    display: flex;
    align-items: center;
    gap: .25rem;
    list-style: none;
  }
  .lang-link {
    font-family: var(--font-heading);
    font-size: .8125rem;
    font-weight: 500;
    color: var(--fg-muted);
    padding: .25rem .625rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-link:hover {
    color: var(--fg);
    background: rgba(255,255,255,.05);
  }
  .lang-link--active {
    color: #a78bfa;
    border-color: rgba(129,140,248,.35);
    background: rgba(99,102,241,0.15);
  }
  .lang-link--active:hover {
    background: rgba(99,102,241,0.15);
  }

  /* ── Language Dropdown ── */
  .lang-dropdown { position: relative; }
  .lang-drop-btn {
    display: flex; align-items: center; gap: .4rem;
    font-family: var(--font-heading); font-size: .8125rem; font-weight: 600;
    color: var(--fg-muted); background: transparent;
    border: 1px solid var(--border);
    padding: .45rem .875rem; border-radius: var(--radius-sm);
    cursor: pointer; transition: color var(--transition), border-color var(--transition), background var(--transition);
    white-space: nowrap;
  }
  .lang-drop-btn:hover,
  .lang-drop-btn[aria-expanded="true"] {
    color: var(--fg); border-color: rgba(129,140,248,.35);
    background: rgba(129,140,248,0.08);
  }
  .lang-drop-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }
  .chevron { transition: transform var(--transition); }
  .lang-menu {
    position: absolute; right: 0; top: calc(100% + .5rem);
    background: var(--bg-raised); border: 1px solid var(--border);
    border-radius: var(--radius-md); padding: .4rem;
    min-width: 155px; z-index: 200;
    display: none; flex-direction: column; gap: .15rem;
    box-shadow: 0 8px 32px rgba(0,0,0,.5);
  }
  .lang-menu.is-open { display: flex; }
  .lang-opt {
    display: block; padding: .5rem .875rem; border-radius: var(--radius-sm);
    font-family: var(--font-heading); font-size: .875rem; font-weight: 600;
    color: var(--fg-muted); transition: background var(--transition), color var(--transition);
  }
  .lang-opt:hover { background: rgba(129,140,248,0.08); color: var(--fg); }
  .lang-opt--active { color: var(--accent); }
  @media (max-width: 640px) { .lang-drop-btn span { display: none; } }

  /* ── Page / hero images ── */
  .page-hero-image {
    margin: 0 0 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    overflow: hidden;
  }
  .page-hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .hero-image {
    margin-top: 2.5rem;
    max-width: 640px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    overflow: hidden;
  }
  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Focus ── */
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('lang-btn');
    var menu = document.getElementById('lang-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = menu.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function () {
      menu.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    });
    document.querySelectorAll('.lang-opt').forEach(function (a) {
      a.addEventListener('click', function () {
        try { localStorage.setItem('ewo-lang-set', '1'); } catch (e) {}
      });
    });
  })();
</script>
