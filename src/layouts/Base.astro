---
interface HreflangEntry {
  lang: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  noindex?: boolean;
  hreflang?: HreflangEntry[];
  lang?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  noindex = false,
  hreflang = [],
  lang = 'en',
  bodyClass = '',
} = Astro.props;

const siteName = 'EWO';

const langLabels: Record<string, string> = {
  en: 'English',
  de: 'Deutsch',
  ro: 'Română',
  uk: 'Українська',
  ru: 'Русский',
  es: 'Español',
};

const langPrefix = lang === 'en' ? '' : `/${lang}`;

const navLabels: Record<string, {models: string, studios: string, analytics: string, blog: string, guides: string}> = {
  en: { models: 'For Models', studios: 'For Studios', analytics: 'Live Analytics', blog: 'Blog', guides: 'Guides' },
  de: { models: 'Für Models', studios: 'Für Studios', analytics: 'Live-Analysen', blog: 'Blog', guides: 'Guides' },
  es: { models: 'Para Modelos', studios: 'Para Estudios', analytics: 'Analíticas Live', blog: 'Blog', guides: 'Guías' },
  ro: { models: 'Pentru Modele', studios: 'Pentru Studiouri', analytics: 'Analize Live', blog: 'Blog', guides: 'Ghiduri' },
  uk: { models: 'Для Моделей', studios: 'Для Студій', analytics: 'Жива Аналітика', blog: 'Блог', guides: 'Гайди' },
  ru: { models: 'Для Моделей', studios: 'Для Студий', analytics: 'Живая Аналитика', blog: 'Блог', guides: 'Гайды' },
};
const nl = navLabels[lang] ?? navLabels.en;

const ctaLabels: Record<string, string> = {
  en: 'Get Started', de: 'Loslegen', es: 'Comenzar',
  ro: 'Începe', uk: 'Почати', ru: 'Начать',
};

const menuLabels: Record<string, string> = {
  en: 'Menu', de: 'Menü', es: 'Menú', ro: 'Meniu', uk: 'Меню', ru: 'Меню',
};

const nav = [
  { href: `${langPrefix}/for-models`, label: nl.models },
  { href: `${langPrefix}/studio-traffic`, label: nl.studios },
  { href: `${langPrefix}/chaturbate-analytics`, label: nl.analytics },
  { href: `${langPrefix}/resources`, label: nl.guides },
  { href: `${langPrefix}/blog`, label: nl.blog },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6H89TM92EZ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-6H89TM92EZ');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {hreflang.map(({ lang: l, url }) => (
      <link rel="alternate" hreflang={l} href={url} />
    ))}
    {hreflang.length > 0 && <link rel="alternate" hreflang="x-default" href={hreflang.find(h => h.lang === 'en')?.url ?? canonicalUrl} />}
    <slot name="head" />

    <!-- Organization schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "EWOhub",
      "url": "https://ewohub.com",
      "logo": "https://ewohub.com/logo-neon.png",
      "sameAs": ["https://t.me/+tBjfmjh9vHo1YzQy"]
    })} />

    <!-- WebSite schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "EWOhub",
      "url": "https://ewohub.com"
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@1,300;1,400;1,600;1,700&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <nav class="nav-inner">
        <a href="/" class="logo" aria-label="EWO home">
          <img src="/logo-neon.png" alt="EWO" class="logo-img">
          <span class="logo-ewo">EWO<span class="logo-hub">hub</span></span>
        </a>
        <ul class="nav-links" role="list">
          {nav.map(({ href, label }) => (
            <li><a href={href} class="nav-link">{label}</a></li>
          ))}
        </ul>
        {hreflang.length > 1 && (
          <div class="lang-dropdown">
            <button class="lang-drop-btn" aria-expanded="false" aria-haspopup="true" id="lang-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              <span>{langLabels[lang] ?? lang}</span>
              <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul class="lang-menu" role="listbox" id="lang-menu">
              {hreflang.map(({ lang: l, url }) => (
                <li>
                  <a href={url} class={`lang-opt${l === lang ? ' lang-opt--active' : ''}`} hreflang={l}>
                    {langLabels[l] ?? l}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <a href="https://t.me/+tBjfmjh9vHo1YzQy" target="_blank" rel="noopener" class="btn-nav">{ctaLabels[lang] ?? 'Get Started'}</a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label={menuLabels[lang] ?? 'Menu'}>
          <svg class="mobile-menu-icon mobile-menu-icon--open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg class="mobile-menu-icon mobile-menu-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </nav>

      <div class="mobile-menu" id="mobile-menu">
        <ul class="mobile-nav-links" role="list">
          {nav.map(({ href, label }) => (
            <li><a href={href} class="mobile-nav-link">{label}</a></li>
          ))}
        </ul>
        {hreflang.length > 1 && (
          <ul class="mobile-lang-list" role="list">
            {hreflang.filter(h => h.lang !== 'x-default').map(({ lang: l, url }) => (
              <li>
                <a href={url} class={`mobile-lang-link${l === lang ? ' mobile-lang-link--active' : ''}`} hreflang={l}>
                  {langLabels[l] ?? l}
                </a>
              </li>
            ))}
          </ul>
        )}
        <a href="https://t.me/+tBjfmjh9vHo1YzQy" target="_blank" rel="noopener" class="btn btn-primary mobile-menu-cta">{ctaLabels[lang] ?? 'Get Started'}</a>
      </div>
    </header>


    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/logo-neon.png" alt="EWO" class="logo-img">
            <span class="logo-ewo">EWO<span class="logo-hub">hub</span></span>
          </div>
          <p class="footer-tagline">Legitimate audience growth for webcam models & studios worldwide.</p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <div class="footer-col">
            <p class="footer-col-title">Services</p>
            <ul role="list">
              <li><a href="/for-models">For Models</a></li>
              <li><a href="/studio-traffic">Studio Traffic</a></li>
              <li><a href="/new-model-growth">New Model Growth</a></li>
              <li><a href="/studio-scaling">Studio Scaling</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Resources</p>
            <ul role="list">
              <li><a href="/model-promotion">Model Promotion</a></li>
              <li><a href="/why-low-viewers-webcam">Why Low Viewers</a></li>
              <li><a href="/how-cam-algorithm-ranks-rooms">Algorithm Guide</a></li>
              <li><a href="/webcam-model-income-guide">Income Guide</a></li>
              <li><a href="/resources">Resources</a></li>
              <li><a href="/blog">Blog</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Regions</p>
            <ul role="list">
              <li><a href="/model-promotion-usa">USA</a></li>
              <li><a href="/model-promotion-germany">Germany</a></li>
              <li><a href="/model-promotion-romania">Romania</a></li>
              <li><a href="/model-promotion-ukraine">Ukraine</a></li>
              <li><a href="/model-promotion-colombia">Colombia</a></li>
              <li><a href="/model-promotion-spain">Spain</a></li>
            </ul>
          </div>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} EWOhub · All rights reserved</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ── Design Tokens ── */
  :root {
    --bg:        #0f0609;
    --bg-raised: #190812;
    --bg-subtle: #0a0407;
    --border:    rgba(232,121,160,0.1);
    --fg:        #fce7f3;
    --fg-muted:  #d1a0b8;
    --fg-faint:  #9b7389;
    --accent:    #e879a0;
    --accent-hover: #f0a0bc;
    --accent-dim:   rgba(232,121,160,0.12);

    --font-heading: 'Josefin Sans', system-ui, sans-serif;
    --font-body:    'Nunito', system-ui, sans-serif;

    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --transition: 180ms ease;

    --container: 1200px;
    --container-text: 720px;
  }

  /* ── Reset ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-size: 16px; scroll-behavior: smooth; color-scheme: dark; }
  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--fg);
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }
  main { flex: 1; }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  ul { list-style: none; }
  button { cursor: pointer; font-family: inherit; }

  /* ── Typography ── */
  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: normal;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  h1 { font-size: clamp(2.5rem, 5vw, 4.5rem); }
  h2 { font-size: clamp(1.75rem, 3vw, 2.75rem); }
  h3 { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 600; }
  p  { color: var(--fg-muted); line-height: 1.75; max-width: 65ch; }

  /* ── Layout helpers ── */
  .container {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }
  .section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .divider {
    border: none;
    border-top: 1px solid var(--border);
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-family: var(--font-heading);
    font-size: .9375rem;
    font-weight: 700;
    letter-spacing: .01em;
    padding: .75rem 1.75rem;
    border-radius: var(--radius-md);
    transition: opacity var(--transition), transform var(--transition), box-shadow var(--transition);
    cursor: pointer;
    border: none;
    white-space: nowrap;
    min-height: 48px;
  }
  .btn-primary {
    background: linear-gradient(135deg, #be185d, #e879a0);
    color: #fff;
  }
  .btn-primary:hover {
    opacity: 0.9;
    box-shadow: 0 0 24px rgba(232,121,160,.4);
  }
  .btn-ghost {
    background: transparent;
    color: var(--fg-muted);
    border: 1px solid var(--border);
  }
  .btn-ghost:hover {
    border-color: rgba(232,121,160,0.3);
    background: rgba(232,121,160,0.05);
    color: var(--fg);
  }
  .btn-nav {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading);
    font-size: .875rem;
    font-weight: 700;
    padding: .5rem 1.25rem;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #be185d, #e879a0);
    color: #fff;
    transition: opacity var(--transition), box-shadow var(--transition);
    min-height: 40px;
  }
  .btn-nav:hover {
    opacity: 0.9;
    box-shadow: 0 0 16px rgba(232,121,160,.4);
  }

  /* ── Header ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15,6,9,.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(232,121,160,0.08);
  }
  .nav-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-shrink: 0;
    text-decoration: none;
  }
  .logo-img { width: 32px; height: 32px; mix-blend-mode: screen; }
  .logo-ewo {
    font-family: 'Nunito', sans-serif;
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    background: linear-gradient(135deg, #fce7f3, #e879a0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .logo-hub {
    font-weight: 500;
    opacity: 0.55;
    letter-spacing: 0;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: .25rem;
    margin-left: auto;
  }
  .nav-link {
    font-family: var(--font-heading);
    font-size: .9rem;
    font-weight: 600;
    color: var(--fg-muted);
    padding: .5rem .875rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }
  .nav-link:hover {
    color: var(--fg);
    background: rgba(232,121,160,0.08);
  }
  @media (max-width: 640px) {
    .nav-links { display: none; }
    .nav-inner { gap: 1rem; }
  }

  /* ── Mobile menu ── */
  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    flex-shrink: 0;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }
  .mobile-menu-btn:hover {
    color: var(--fg);
    border-color: rgba(232,121,160,.35);
    background: rgba(232,121,160,0.08);
  }
  .mobile-menu-icon--close { display: none; }
  .mobile-menu-btn[aria-expanded="true"] .mobile-menu-icon--open { display: none; }
  .mobile-menu-btn[aria-expanded="true"] .mobile-menu-icon--close { display: block; }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
    max-width: var(--container);
    margin-inline: auto;
    padding: 1.25rem clamp(1.25rem, 4vw, 2rem) 1.75rem;
    border-top: 1px solid rgba(232,121,160,0.08);
  }
  .mobile-menu.is-open { display: flex; }

  .mobile-nav-links { display: flex; flex-direction: column; gap: .25rem; }
  .mobile-nav-link {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--fg);
    padding: .75rem .5rem;
    border-radius: var(--radius-sm);
    transition: color var(--transition), background var(--transition);
  }
  .mobile-nav-link:hover { color: var(--accent); background: rgba(232,121,160,0.06); }

  .mobile-lang-list {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(232,121,160,0.08);
  }
  .mobile-lang-link {
    font-family: var(--font-heading);
    font-size: .8125rem;
    font-weight: 600;
    color: var(--fg-muted);
    padding: .4rem .875rem;
    border-radius: 99px;
    border: 1px solid var(--border);
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }
  .mobile-lang-link:hover { color: var(--fg); border-color: rgba(232,121,160,.3); }
  .mobile-lang-link--active { color: var(--accent); border-color: rgba(232,121,160,.4); background: rgba(232,121,160,0.1); }

  .mobile-menu-cta { width: 100%; justify-content: center; }

  @media (max-width: 640px) {
    .mobile-menu-btn { display: flex; }
  }
  @media (min-width: 641px) {
    .mobile-menu { display: none !important; }
  }

  /* ── Cards ── */
  .card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: var(--radius-lg);
    padding: 2rem;
    backdrop-filter: blur(12px);
    transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
  }
  .card:hover {
    border-color: rgba(232,121,160,0.3);
    background: rgba(232,121,160,0.05);
    box-shadow: 0 4px 32px rgba(0,0,0,.4);
  }

  /* ── Accent text ── */
  .text-accent { color: var(--accent); }
  .text-muted  { color: var(--fg-muted); }

  /* ── Footer ── */
  .site-footer {
    border-top: 1px solid rgba(232,121,160,0.08);
    background: var(--bg-subtle);
  }
  .footer-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: 4rem clamp(1.25rem, 4vw, 2rem) 3rem;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: .75rem;
  }
  .footer-tagline { color: var(--fg-faint); font-size: .875rem; margin-top: .25rem; max-width: 24ch; font-weight: 600; }
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .footer-col-title {
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 1rem;
    max-width: none;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: .5rem; }
  .footer-col a {
    font-size: .875rem;
    font-weight: 600;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .footer-col a:hover { color: var(--fg); }
  .footer-bottom {
    border-top: 1px solid rgba(232,121,160,0.08);
    padding: 1.25rem clamp(1.25rem, 4vw, 2rem);
    text-align: center;
  }
  .footer-bottom p { font-size: .8125rem; color: var(--fg-faint); max-width: none; font-weight: 600; }

  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .footer-nav { grid-template-columns: 1fr; }
  }

  /* ── Language Switcher ── */
  .lang-switcher {
    background: rgba(25,8,18,0.8);
    border-bottom: 1px solid rgba(232,121,160,0.06);
  }
  .lang-switcher-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    height: 40px;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .lang-switcher-label {
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    white-space: nowrap;
  }
  .lang-list {
    display: flex;
    align-items: center;
    gap: .25rem;
    list-style: none;
  }
  .lang-link {
    font-family: var(--font-heading);
    font-size: .8125rem;
    font-weight: 500;
    color: var(--fg-muted);
    padding: .25rem .625rem;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-link:hover {
    color: var(--fg);
