---
import Base from '@/layouts/Base.astro';
import LiveLookupTool from '@/components/LiveLookupTool.astro';
const site = 'https://www.ewohub.com';
const slug = 'live-model-lookup';
---
<Base
  title="Búsqueda de Modelos en Vivo y Ranking — Chaturbate y Stripchat"
  description="Busca el estado en vivo por nombre de usuario, compara dos modelos lado a lado, o mira quién lideró el tráfico cada hora hoy en Chaturbate y Stripchat. Actualizado automáticamente, sin necesidad de iniciar sesión."
  lang="es"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>
  <LiveLookupTool lang="es" />
</Base>
