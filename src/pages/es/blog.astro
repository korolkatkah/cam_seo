---
import Base from '@/layouts/Base.astro';
const site = 'https://www.ewohub.com';

const filterAllLabel = 'Todos';
const dateLocale = 'es-ES';
function fmtDate(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}

const articles = [
