---
import Base from '@/layouts/Base.astro';
const site = 'https://ewo.cam';

const articles = [
  {
    href: '/es/model-promotion',
    title: 'Servicios de Promoción para Modelos',
    desc: 'Cómo funciona nuestro servicio de marketing y crecimiento de audiencia para modelos webcam que ya transmiten.',
    tag: 'Promoción',
    mins: '6 min',
  },
  {
    href: '/es/why-low-viewers-webcam',
    title: 'Por qué tu sala webcam tiene pocos espectadores',
    desc: '8 razones reales por las que tu conteo de espectadores es bajo y qué hacer con cada una.',
    tag: 'Crecimiento',
    mins: '8 min',
  },
  {
    href: '/es/how-cam-algorithm-ranks-rooms',
    title: 'Cómo los algoritmos cam clasifican las salas',
    desc: 'Qué determina realmente tu visibilidad en plataformas cam y cómo trabajar con eso.',
    tag: 'Algoritmo',
    mins: '6 min',
  },
  {
    href: '/es/stripscore-cam-rank-explained',
    title: '¿Qué es el Stripscore? Cam Rank explicado',
    desc: 'Stripscore, cam rank, room rank — qué significan estos términos y cómo difiere el concepto entre Chaturbate, Stripchat, BongaCams y LiveJasmin.',
    tag: 'Algoritmo',
    mins: '5 min',
  },
  {
    href: '/es/best-streaming-times-by-region',
    title: 'Mejores horarios de streaming por región',
    desc: 'Datos de horas pico por región para maximizar tu audiencia en cada sesión.',
    tag: 'Estrategia',
    mins: '5 min',
  },
  {
    href: '/es/webcam-model-income-guide',
    title: 'Guía de ingresos para modelos webcam',
    desc: 'Un desglose claro de cómo funcionan las ganancias webcam, qué afecta tus ingresos y cómo crecer.',
    tag: 'Ingresos',
    mins: '10 min',
  },
  {
    href: '/es/webcam-earnings-by-platform',
    title: 'Ganancias webcam por plataforma',
    desc: 'Chaturbate vs. Stripchat vs. BongaCams vs. LiveJasmin — tasas de pago reales, valor del token y qué plataforma paga realmente más.',
    tag: 'Ingresos',
    mins: '8 min',
  },
  {
    href: '/es/new-model-growth',
    title: 'Estrategia de crecimiento para modelos nuevas',
    desc: 'Cómo construir tu primera audiencia consistente desde cero como modelo webcam nueva.',
    tag: 'Principiante',
    mins: '7 min',
  },
  {
    href: '/es/platforms-we-work-with',
    title: 'Plataformas con las que trabajamos',
    desc: 'Qué diferencia a Chaturbate, Stripchat, LiveJasmin y BongaCams — y cómo se adapta nuestra estrategia a cada una.',
    tag: 'Plataformas',
    mins: '8 min',
  },
  {
    href: '/es/stripchat_promo',
    title: 'Reseña de Stripchat Traffic Bot',
    desc: 'Una reseña honesta de Stripchat_traffic_bot: cómo funciona, cuánto cuesta y cómo sacarle el máximo provecho.',
    tag: 'Reseña',
    mins: '6 min',
  },
];
---

<Base
  title="Blog — Guías de crecimiento webcam y estrategias"
  description="Guías expertas para modelos webcam y estudios. Aprende cómo funcionan los algoritmos cam, cómo hacer crecer tu audiencia y maximizar tus ganancias."
  lang="es"
  hreflang={[
    { lang: 'en', url: `${site}/blog` },
    { lang: 'de', url: `${site}/de/blog` },
    { lang: 'es', url: `${site}/es/blog` },
    { lang: 'ro', url: `${site}/ro/blog` },
    { lang: 'uk', url: `${site}/uk/blog` },
    { lang: 'ru', url: `${site}/ru/blog` },
  ]}
>
  <article>
    <div class="container page-top">
      <div class="blog-header">
        <p class="eyebrow">Blog</p>
        <h1>Guías y Estrategias</h1>
        <p class="lead">Conocimiento práctico para modelos webcam y estudios que quieren crecer — sin tráfico falso ni atajos.</p>
      </div>

      <div class="blog-grid">
        {articles.map(({ href, title, desc, tag, mins }) => (
          <a href={href} class="blog-card">
            <div class="blog-card-meta">
              <span class="blog-tag">{tag}</span>
              <span class="blog-mins">{mins}</span>
            </div>
            <h2>{title}</h2>
            <p>{desc}</p>
            <span class="blog-read">Leer artículo →</span>
          </a>
        ))}
      </div>
    </div>
  </article>
</Base>

<style>
  .page-top { padding-block: clamp(4rem, 8vw, 7rem); }
  .blog-header { max-width: 54ch; margin-bottom: 3.5rem; }
  .eyebrow { font-family: var(--font-heading); font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .75rem; max-width: none; }
  .lead { font-size: 1.0625rem; color: var(--fg-muted); line-height: 1.75; margin-top: .75rem; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
  .blog-card {
    display: flex; flex-direction: column; gap: .75rem;
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07);
    border-radius: var(--radius-lg); padding: 1.75rem 2rem;
    text-decoration: none; transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
  }
  .blog-card:hover { border-color: rgba(129,140,248,.3); background: rgba(129,140,248,.05); box-shadow: 0 4px 32px rgba(0,0,0,.4); }
  .blog-card-meta { display: flex; align-items: center; gap: .75rem; }
  .blog-tag { font-family: var(--font-heading); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); background: rgba(99,102,241,.15); border: 1px solid rgba(129,140,248,.25); padding: .2rem .6rem; border-radius: 100px; }
  .blog-mins { font-size: .8rem; color: var(--fg-faint); font-weight: 600; }
  .blog-card h2 { font-size: clamp(1.1rem, 2vw, 1.3rem); font-weight: 700; line-height: 1.25; color: var(--fg); margin: 0; }
  .blog-card p { font-size: .9375rem; color: var(--fg-muted); line-height: 1.65; margin: 0; }
  .blog-read { font-family: var(--font-heading); font-size: .875rem; font-weight: 600; color: var(--accent); margin-top: auto; padding-top: .25rem; }
</style>
