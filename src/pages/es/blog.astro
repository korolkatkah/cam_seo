    date: '2026-07-27',
  },
  {
    href: '/es/stripchat-model-news-studio-admin',
    title: 'Model News para Studio Admins: qué cambió realmente',
    desc: 'La actualización de enero de 2026 de Stripchat dio a Studio Admin acceso a Model News, extendió la ventana de promoción para modelos nuevas y dividió los concursos por categoría.',
    tag: 'Stripchat',
    mins: '7 min',
    date: '2026-07-27',
  },
  {
    href: '/es/how-to-choose-a-webcam-studio',
    title: 'Cómo elegir un estudio webcam: repartos, contratos y señales de alerta',
    desc: 'Qué determina realmente un buen contrato con un estudio — cómo se calcula el reparto, cláusulas de exclusividad, deducciones, métodos de pago y las señales que predicen un mal trato.',
    tag: 'Estudios',
    mins: '9 min',
    date: '2026-07-24',
  },
];

const tags = [...new Set(articles.map(a => a.tag))];
---

<Base
  title="Blog — Guías de crecimiento webcam y estrategias"
  description="Guías expertas para modelos webcam y estudios. Aprende cómo funcionan los algoritmos cam, cómo hacer crecer tu audiencia y maximizar tus ganancias."
  lang="es"
  hreflang={[
    { lang: 'en', url: `${site}/blog` },
    { lang: 'de', url: `${site}/de/blog` },
    { lang: 'es', url: `${site}/es/blog` },
    { lang: 'ro', url: `${site}/ro/blog` },
    { lang: 'uk', url: `${site}/uk/blog` },
    { lang: 'ru', url: `${site}/ru/blog` },
    { lang: 'fr', url: `${site}/fr/blog` },
    { lang: 'pt', url: `${site}/pt/blog` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Blog</span>
      </div>
      <h1 class="art-title">Guías y <span class="art-grad">Estrategias</span></h1>
      <p class="art-lead">Conocimiento práctico para modelos webcam y estudios que quieren crecer — sin tráfico falso ni atajos.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="blog-filter-bar" role="group" aria-label="Filter articles by category">
        <button class="blog-filter-btn is-active" data-filter="all">{filterAllLabel}</button>
        {tags.map(tag => (
          <button class="blog-filter-btn" data-filter={tag}>{tag}</button>
        ))}
      </div>
      <div class="related-grid" id="blog-grid">
        {articles.map(({ href, title, desc, tag, mins, date }) => (
          <a href={href} class="related-card" data-tag={tag}>
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
              <span class="art-tag">{mins}</span>
            </div>
            <h3>{title}</h3>
            <p>{desc}</p>
            <time class="card-date" datetime={date}>{fmtDate(date)}</time>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>

<script>
  (function () {
    var buttons = document.querySelectorAll('.blog-filter-btn');
    var cards = document.querySelectorAll('#blog-grid .related-card');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var filter = btn.dataset.filter;
        cards.forEach(function (card) {
          if (filter === 'all' || card.dataset.tag === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  })();
</script>
