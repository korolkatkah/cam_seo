---
import Base from '@/layouts/Base.astro';
import { studioDirectory, countryNames, factLabels, experienceYearsUnit, payoutLabels, perkLabels, reviewWord, type Studio, type CountryKey } from '@/data/studios';

const locales = ['de', 'es', 'ro', 'uk', 'ru', 'fr', 'pt'];

export function getStaticPaths() {
  const localeList = ['de', 'es', 'ro', 'uk', 'ru', 'fr', 'pt'];
  const paths: { params: { locale: string; slug: string }; props: { studio: Studio; countryKey: CountryKey; siblings: Studio[] } }[] = [];
  for (const locale of localeList) {
    for (const entry of studioDirectory) {
      for (const studio of entry.studios) {
        paths.push({
          params: { locale, slug: studio.slug },
          props: { studio, countryKey: entry.key, siblings: entry.studios.filter((s) => s.slug !== studio.slug) },
        });
      }
    }
  }
  return paths;
}

const { studio, countryKey, siblings } = Astro.props as { studio: Studio; countryKey: CountryKey; siblings: Studio[] };
const site = 'https://www.ewohub.com';
const lang = Astro.params.locale as string;
const slug = studio.slug;
const countryName = countryNames[countryKey][lang];
const metaDescription = studio.about[lang].length > 155 ? `${studio.about[lang].slice(0, 152)}...` : studio.about[lang];

const backLabel: Record<string, string> = {
  de: '← Alle Studios in {c}', es: '← Todos los estudios en {c}', ro: '← Toate studiourile din {c}',
  uk: '← Усі студії в {c}', ru: '← Все студии в {c}', fr: '← Tous les studios en {c}', pt: '← Todos os estúdios em {c}',
};
const websiteLabel: Record<string, string> = {
  de: 'Offizielle Website besuchen →', es: 'Visitar sitio web oficial →', ro: 'Vizitează site-ul oficial →',
  uk: 'Відвідати офіційний сайт →', ru: 'Посетить официальный сайт →', fr: 'Visiter le site officiel →', pt: 'Visitar site oficial →',
};
const disclaimerTpl: Record<string, string> = {
  de: 'Diese Angaben stammen von der eigenen Website von {n} und aus öffentlichen Quellen — nicht von EWO verifiziert und können sich ändern. Lies vor der Unterschrift bei jedem Studio unsere <a href="/de/how-to-choose-a-webcam-studio">Warnsignal-Checkliste für Studios</a>. Betreibst du dieses Studio und hast etwas Falsches oder Veraltetes entdeckt? <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Schreib uns auf Telegram</a>.',
  es: 'Estos detalles provienen del propio sitio web de {n} y de fuentes públicas — no verificados por EWO, y pueden cambiar. Antes de firmar con cualquier estudio, lee nuestra <a href="/es/how-to-choose-a-webcam-studio">lista de señales de alerta para estudios</a>. ¿Diriges este estudio y detectaste algo incorrecto o desactualizado? <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Escríbenos por Telegram</a>.',
  ro: 'Aceste detalii provin de pe site-ul propriu al {n} și din surse publice — neverificate de EWO și pot fi modificate. Înainte să semnezi cu orice studio, citește <a href="/ro/how-to-choose-a-webcam-studio">lista noastră de semnale de alarmă pentru studiouri</a>. Conduci acest studio și ai observat ceva greșit sau învechit? <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Scrie-ne pe Telegram</a>.',
  uk: 'Ці дані взяті з власного сайту {n} та публічних джерел — не перевірені EWO і можуть змінюватися. Перш ніж підписувати договір з будь-якою студією, прочитайте наш <a href="/uk/how-to-choose-a-webcam-studio">чекліст тривожних сигналів для студій</a>. Керуєте цією студією і помітили щось неправильне чи застаріле? <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Напишіть нам в Telegram</a>.',
  ru: 'Эти данные взяты с собственного сайта {n} и из публичных источников — не проверены EWO и могут меняться. Перед тем как подписывать договор с любой студией, прочитайте наш <a href="/ru/how-to-choose-a-webcam-studio">чек-лист тревожных сигналов для студий</a>. Управляете этой студией и заметили что-то неверное или устаревшее? <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Напишите нам в Telegram</a>.',
  fr: "Ces informations proviennent du site officiel de {n} et de sources publiques — non vérifiées par EWO, et sujettes à changement. Avant de signer avec un studio, lisez notre <a href=\"/fr/how-to-choose-a-webcam-studio\">liste de signaux d'alerte pour les studios</a>. Vous gérez ce studio et avez repéré une erreur ou une info obsolète ? <a href=\"https://t.me/ewo_agency\" target=\"_blank\" rel=\"noopener noreferrer\">Écrivez-nous sur Telegram</a>.",
  pt: 'Esses detalhes vêm do próprio site da {n} e de fontes públicas — não verificados pela EWO, e sujeitos a mudanças. Antes de assinar com qualquer estúdio, leia nossa <a href="/pt/how-to-choose-a-webcam-studio">lista de sinais de alerta para estúdios</a>. Administra este estúdio e percebeu algo errado ou desatualizado? <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Fale conosco no Telegram</a>.',
};
const ctaHeading: Record<string, string> = {
  de: 'Brauchst du eine zweite Meinung, bevor du unterschreibst?', es: '¿Quieres una segunda opinión antes de firmar?',
  ro: 'Vrei o a doua opinie înainte să semnezi?', uk: 'Потрібна друга думка перед підписанням?',
  ru: 'Нужно второе мнение перед подписанием?', fr: "Besoin d'un second avis avant de signer ?", pt: 'Quer uma segunda opinião antes de assinar?',
};
const ctaParagraph: Record<string, string> = {
  de: 'Sag unserem Support-Team dein Land und deine Situation — wir helfen dir, ein Studio-Angebot einzuschätzen, oder besprechen unabhängiges Streaming mit EWO als Traffic-Treiber.',
  es: 'Cuéntale a nuestro equipo de soporte tu país y tu situación — te ayudaremos a evaluar una oferta de estudio, o a hablar sobre transmitir de forma independiente con EWO llevando tu tráfico.',
  ro: 'Spune-i echipei noastre de suport țara și situația ta — te ajutăm să evaluezi o ofertă de studio sau discutăm despre streaming independent cu EWO aducându-ți trafic.',
  uk: 'Розкажіть нашій команді підтримки свою країну й ситуацію — ми допоможемо оцінити пропозицію студії або обговоримо незалежний стрімінг з EWO, що приводить трафік.',
  ru: 'Расскажите нашей команде поддержки свою страну и ситуацию — мы поможем оценить предложение студии или обсудим независимый стриминг с EWO, который приводит трафик.',
  fr: "Indiquez à notre équipe support votre pays et votre situation — nous vous aiderons à évaluer une offre de studio, ou à envisager le streaming indépendant avec EWO qui vous apporte du trafic.",
  pt: 'Conte para nossa equipe de suporte seu país e sua situação — vamos ajudar você a avaliar uma oferta de estúdio, ou conversar sobre transmitir de forma independente com a EWO trazendo tráfego.',
};
const ctaPrimary: Record<string, string> = {
  de: 'Support kontaktieren →', es: 'Hablar con Soporte →', ro: 'Vorbește cu Suportul →', uk: 'Написати в Підтримку →',
  ru: 'Написать в Поддержку →', fr: 'Contacter le Support →', pt: 'Falar com o Suporte →',
};
const ctaGhost: Record<string, string> = {
  de: 'Warnsignal-Checkliste lesen', es: 'Leer la lista de señales de alerta', ro: 'Citește lista de semnale de alarmă',
  uk: 'Прочитати чекліст тривожних сигналів', ru: 'Прочитать чек-лист тревожных сигналов',
  fr: "Lire la liste des signaux d'alerte", pt: 'Ler a lista de sinais de alerta',
};
const moreStudiosTpl: Record<string, string> = {
  de: 'Weitere Studios in {c}', es: 'Más Estudios en {c}', ro: 'Mai Multe Studiouri din {c}',
  uk: 'Більше Студій у {c}', ru: 'Больше Студий в {c}', fr: 'Plus de Studios en {c}', pt: 'Mais Estúdios em {c}',
};
const fullCatalogLabel: Record<string, string> = {
  de: 'Kompletter Studio-Katalog', es: 'Catálogo Completo de Estudios', ro: 'Catalog Complet de Studiouri',
  uk: 'Повний Каталог Студій', ru: 'Полный Каталог Студий', fr: 'Catalogue Complet des Studios', pt: 'Catálogo Completo de Estúdios',
};

const backHref = `/${lang}/studio-directory`;
const disclaimerHtml = disclaimerTpl[lang].replace('{n}', studio.name);

// Russian and Ukrainian need locative case ("in Romania" -> "в Румынии") that
// differs from the nominative form used elsewhere (e.g. "Romania" itself).
const locativeCountry: Record<string, Record<CountryKey, string>> = {
  ru: { romania: 'Румынии', ukraine: 'Украине', spain: 'Испании', russia: 'России', usa: 'США', germany: 'Германии', france: 'Франции' },
  uk: { romania: 'Румунії', ukraine: 'Україні', spain: 'Іспанії', russia: 'Росії', usa: 'США', germany: 'Німеччині', france: 'Франції' },
};
const countryNameInPhrase = locativeCountry[lang]?.[countryKey] ?? countryName;
---

<Base
  title={`${studio.name} — ${reviewWord[lang]} (${countryName})`}
  description={metaDescription}
  lang={lang}
  hreflang={[
    { lang: 'en', url: `${site}/studio-directory/${slug}` },
    { lang: 'de', url: `${site}/de/studio-directory/${slug}` },
    { lang: 'es', url: `${site}/es/studio-directory/${slug}` },
    { lang: 'ro', url: `${site}/ro/studio-directory/${slug}` },
    { lang: 'uk', url: `${site}/uk/studio-directory/${slug}` },
    { lang: 'ru', url: `${site}/ru/studio-directory/${slug}` },
    { lang: 'fr', url: `${site}/fr/studio-directory/${slug}` },
    { lang: 'pt', url: `${site}/pt/studio-directory/${slug}` },
  ]}
>

  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag art-tag--blue">{countryName}</span>
      </div>
      <h1 class="art-title">{studio.name}</h1>
      <p class="art-lead">{studio.city}</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">

      <p style="margin-bottom:1.5rem;font-size:.9rem;">
        <a href={backHref}>{backLabel[lang].replace('{c}', countryNameInPhrase)}</a>
      </p>

      <p class="art-intro">{studio.about[lang]}</p>

      {studio.facts && (
        <div style="margin:2rem 0;">
          <div class="glass-card">
            <div style="font-size:.9rem;color:var(--fg-muted);line-height:2;">
              {studio.facts.earnings && <div><strong style="color:var(--fg);">{factLabels.earnings[lang]}:</strong> {studio.facts.earnings}</div>}
              {studio.facts.experienceYears && <div><strong style="color:var(--fg);">{factLabels.experience[lang]}:</strong> {studio.facts.experienceYears}+ {experienceYearsUnit[lang]}</div>}
              {studio.facts.rooms && <div><strong style="color:var(--fg);">{factLabels.rooms[lang]}:</strong> {studio.facts.rooms}</div>}
              {studio.facts.models && <div><strong style="color:var(--fg);">{factLabels.models[lang]}:</strong> {studio.facts.models}</div>}
              {studio.facts.platforms && <div><strong style="color:var(--fg);">{factLabels.platforms[lang]}:</strong> {studio.facts.platforms.join(', ')}</div>}
              {studio.facts.payout && <div><strong style="color:var(--fg);">{factLabels.payout[lang]}:</strong> {payoutLabels[studio.facts.payout][lang]}</div>}
              {studio.facts.locations && studio.facts.locations.length > 1 && <div><strong style="color:var(--fg);">{factLabels.locations[lang]}:</strong> {studio.facts.locations.join(', ')}</div>}
              {studio.facts.address && <div><strong style="color:var(--fg);">{factLabels.address[lang]}:</strong> {studio.facts.address}</div>}
              {studio.facts.phone && <div><strong style="color:var(--fg);">{factLabels.phone[lang]}:</strong> {studio.facts.phone}</div>}
              {studio.facts.email && <div><strong style="color:var(--fg);">{factLabels.email[lang]}:</strong> {studio.facts.email}</div>}
              {studio.facts.hours && <div><strong style="color:var(--fg);">{factLabels.hours[lang]}:</strong> {studio.facts.hours}</div>}
            </div>
            {studio.facts.perks && studio.facts.perks.length > 0 && (
              <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1rem;">
                {studio.facts.perks.map((p) => (
                  <span style="font-size:.78rem;font-weight:600;background:rgba(0,0,0,0.05);border:1px solid rgba(0,0,0,0.1);color:var(--fg-muted);padding:.25rem .65rem;border-radius:999px;">{perkLabels[p][lang]}</span>
                ))}
              </div>
            )}
            <a href={studio.website} target="_blank" rel="noopener noreferrer nofollow" style="display:inline-block;margin-top:1.25rem;font-size:.9rem;font-weight:600;color:var(--fg);">{websiteLabel[lang]}</a>
          </div>
        </div>
      )}

      <div style="margin:2rem 0;">
        <div class="highlight-box">
          <p set:html={disclaimerHtml} />
        </div>
      </div>

      <section class="art-cta section">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Models</span>
          <h2>{ctaHeading[lang]}</h2>
          <p>{ctaParagraph[lang]}</p>
          <div class="art-cta__actions">
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" class="art-cta__btn art-cta__btn--primary">{ctaPrimary[lang]}</a>
            <a href={`/${lang}/how-to-choose-a-webcam-studio`} class="art-cta__btn art-cta__btn--ghost">{ctaGhost[lang]}</a>
          </div>
        </div>
      </section>

      {siblings.length > 0 && (
        <div style="margin:2rem 0;">
          <h2>{moreStudiosTpl[lang].replace('{c}', countryNameInPhrase)}</h2>
          <div class="related-grid">
            {siblings.map((s) => (
              <a href={`/${lang}/studio-directory/${s.slug}`} class="related-card">
                <span class="related-card__icon">🎬</span>
                <span>{s.name}</span>
              </a>
            ))}
            <a href={backHref} class="related-card">
              <span class="related-card__icon">📋</span>
              <span>{fullCatalogLabel[lang]}</span>
            </a>
          </div>
        </div>
      )}

    </div>
  </div>

</Base>
