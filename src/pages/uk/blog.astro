    mins: '6 хв',
  },
  {
    href: '/uk/stripchat-vr-shows-worth-it',
    title: 'VR-шоу на Stripchat: чи варте обладнання того?',
    desc: 'Реальна вартість VR-камери, чотири цифри для перевірки перед покупкою, і як студіям варто думати про обладнання спільної кімнати.',
    tag: 'Stripchat',
    mins: '7 хв',
  },
  {
    href: '/uk/stripchat-model-news-studio-admin',
    title: 'Model News для Studio Admin: що насправді змінилось',
    desc: 'Оновлення Stripchat у січні 2026 дало Studio Admin доступ до Model News, продовжило вікно просування для нових моделей і розділило конкурси за категоріями.',
    tag: 'Stripchat',
    mins: '7 хв',
  },
  {
    href: '/uk/how-to-choose-a-webcam-studio',
    title: 'Як обрати вебкам-студію: відсотки, контракти та тривожні сигнали',
    desc: 'Що насправді визначає хорошу угоду зі студією — як рахується відсоток, умови ексклюзивності, відрахування, способи виплат і сигнали, що передвіщають погану угоду.',
    tag: 'Студії',
    mins: '9 хв',
  },
];

const tags = [...new Set(articles.map(a => a.tag))];
---

<Base
  title="Блог — Гіди з вебкам-зростання та стратегії"
  description="Експертні гіди для вебкам-моделей і студій. Дізнайся, як працюють кам-алгоритми, як нарощувати аудиторію та максимізувати заробіток."
  lang="uk"
  hreflang={[
    { lang: 'en', url: `${site}/blog` },
    { lang: 'de', url: `${site}/de/blog` },
    { lang: 'es', url: `${site}/es/blog` },
    { lang: 'ro', url: `${site}/ro/blog` },
    { lang: 'uk', url: `${site}/uk/blog` },
    { lang: 'ru', url: `${site}/ru/blog` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Блог</span>
      </div>
      <h1 class="art-title">Гіди та <span class="art-grad">стратегії</span></h1>
      <p class="art-lead">Практичні знання для вебкам-моделей і студій, які хочуть рости — без фейкового трафіку та обхідних шляхів.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="blog-filter-bar" role="group" aria-label="Filter articles by category">
        <button class="blog-filter-btn is-active" data-filter="all">{filterAllLabel}</button>
        {tags.map(tag => (
          <button class="blog-filter-btn" data-filter={tag}>{tag}</button>
        ))}
      </div>
      <div class="related-grid" id="blog-grid">
        {articles.map(({ href, title, desc, tag, mins }) => (
          <a href={href} class="related-card" data-tag={tag}>
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
              <span class="art-tag">{mins}</span>
            </div>
            <h3>{title}</h3>
            <p>{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>

<script>
  (function () {
    var buttons = document.querySelectorAll('.blog-filter-btn');
    var cards = document.querySelectorAll('#blog-grid .related-card');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var filter = btn.dataset.filter;
        cards.forEach(function (card) {
          if (filter === 'all' || card.dataset.tag === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  })();
</script>
