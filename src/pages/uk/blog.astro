---
import Base from '@/layouts/Base.astro';
const site = 'https://ewo.cam';

const articles = [
  {
    href: '/uk/model-promotion',
    title: 'Послуги з Просування Моделей',
    desc: 'Як працює наш сервіс маркетингу та зростання аудиторії для вебкам-моделей, які вже стримлять.',
    tag: 'Просування',
    mins: '6 хв',
  },
  {
    href: '/uk/why-low-viewers-webcam',
    title: 'Чому у твоїй вебкам-кімнаті мало глядачів',
    desc: '8 реальних причин низького числа глядачів і що саме робити з кожною з них.',
    tag: 'Зростання',
    mins: '8 хв',
  },
  {
    href: '/uk/how-cam-algorithm-ranks-rooms',
    title: 'Як кам-алгоритми ранжують кімнати',
    desc: 'Що насправді визначає твою видимість на кам-платформах і як з цим працювати.',
    tag: 'Алгоритм',
    mins: '6 хв',
  },
  {
    href: '/uk/best-streaming-times-by-region',
    title: 'Кращий час для стримінгу по регіонах',
    desc: 'Дані про пікові години по регіонах — максимізуй охоплення аудиторії на кожній сесії.',
    tag: 'Стратегія',
    mins: '5 хв',
  },
  {
    href: '/uk/webcam-model-income-guide',
    title: 'Гід по доходам вебкам-моделі',
    desc: 'Чіткий розбір того, як працюють вебкам-заробітки, що впливає на твій дохід і як його збільшити.',
    tag: 'Дохід',
    mins: '10 хв',
  },
  {
    href: '/uk/webcam-earnings-by-platform',
    title: 'Заробіток на вебкамі по платформах',
    desc: 'Chaturbate vs. Stripchat vs. BongaCams vs. LiveJasmin — реальні ставки виплат, вартість токена і яка платформа насправді платить більше.',
    tag: 'Дохід',
    mins: '8 хв',
  },
  {
    href: '/uk/new-model-growth',
    title: 'Стратегія зростання для нових моделей',
    desc: 'Як побудувати свою першу стабільну аудиторію з нуля як нова вебкам-модель.',
    tag: 'Початківець',
    mins: '7 хв',
  },
  {
    href: '/uk/platforms-we-work-with',
    title: 'Платформи, з якими ми працюємо',
    desc: 'Що відрізняє Chaturbate, Stripchat, LiveJasmin та BongaCams — і як наша стратегія адаптується під кожну з них.',
    tag: 'Платформи',
    mins: '8 хв',
  },
  {
    href: '/uk/stripchat_promo',
    title: 'Огляд Stripchat Traffic Bot',
    desc: 'Чесний огляд Stripchat_traffic_bot: як він працює, скільки коштує і як отримати максимум.',
    tag: 'Огляд',
    mins: '6 хв',
  },
];
---

<Base
  title="Блог — Гіди з вебкам-зростання та стратегії"
  description="Експертні гіди для вебкам-моделей і студій. Дізнайся, як працюють кам-алгоритми, як нарощувати аудиторію та максимізувати заробіток."
  lang="uk"
  hreflang={[
    { lang: 'en', url: `${site}/blog` },
    { lang: 'de', url: `${site}/de/blog` },
    { lang: 'es', url: `${site}/es/blog` },
    { lang: 'ro', url: `${site}/ro/blog` },
    { lang: 'uk', url: `${site}/uk/blog` },
    { lang: 'ru', url: `${site}/ru/blog` },
  ]}
>
  <article>
    <div class="container page-top">
      <div class="blog-header">
        <p class="eyebrow">Блог</p>
        <h1>Гіди та стратегії</h1>
        <p class="lead">Практичні знання для вебкам-моделей і студій, які хочуть рости — без фейкового трафіку та обхідних шляхів.</p>
      </div>

      <div class="blog-grid">
        {articles.map(({ href, title, desc, tag, mins }) => (
          <a href={href} class="blog-card">
            <div class="blog-card-meta">
              <span class="blog-tag">{tag}</span>
              <span class="blog-mins">{mins}</span>
            </div>
            <h2>{title}</h2>
            <p>{desc}</p>
            <span class="blog-read">Читати статтю →</span>
          </a>
        ))}
      </div>
    </div>
  </article>
</Base>

<style>
  .page-top { padding-block: clamp(4rem, 8vw, 7rem); }
  .blog-header { max-width: 54ch; margin-bottom: 3.5rem; }
  .eyebrow { font-family: var(--font-heading); font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .75rem; max-width: none; }
  .lead { font-size: 1.0625rem; color: var(--fg-muted); line-height: 1.75; margin-top: .75rem; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
  .blog-card {
    display: flex; flex-direction: column; gap: .75rem;
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07);
    border-radius: var(--radius-lg); padding: 1.75rem 2rem;
    text-decoration: none; transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
  }
  .blog-card:hover { border-color: rgba(129,140,248,.3); background: rgba(129,140,248,.05); box-shadow: 0 4px 32px rgba(0,0,0,.4); }
  .blog-card-meta { display: flex; align-items: center; gap: .75rem; }
  .blog-tag { font-family: var(--font-heading); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); background: rgba(99,102,241,.15); border: 1px solid rgba(129,140,248,.25); padding: .2rem .6rem; border-radius: 100px; }
  .blog-mins { font-size: .8rem; color: var(--fg-faint); font-weight: 600; }
  .blog-card h2 { font-size: clamp(1.1rem, 2vw, 1.3rem); font-weight: 700; line-height: 1.25; color: var(--fg); margin: 0; }
  .blog-card p { font-size: .9375rem; color: var(--fg-muted); line-height: 1.65; margin: 0; }
  .blog-read { font-family: var(--font-heading); font-size: .875rem; font-weight: 600; color: var(--accent); margin-top: auto; padding-top: .25rem; }
</style>
