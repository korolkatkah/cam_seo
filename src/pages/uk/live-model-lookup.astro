---
import Base from '@/layouts/Base.astro';
import LiveLookupTool from '@/components/LiveLookupTool.astro';
const site = 'https://www.ewohub.com';
const slug = 'live-model-lookup';
---
<Base
  title="Живий пошук моделей і рейтинг — Chaturbate і Stripchat"
  description="Шукай живий статус за ніком, порівнюй дві моделі поруч або дивись, хто лідирував за трафіком щогодини сьогодні на Chaturbate і Stripchat. Оновлюється автоматично, без реєстрації."
  lang="uk"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>
  <LiveLookupTool lang="uk" />
</Base>
