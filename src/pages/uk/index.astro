---
import Base from '@/layouts/Base.astro';
import TrendsBlock from '@/components/TrendsBlock.astro';
import LiveIndicator from '@/components/LiveIndicator.astro';
const site = 'https://ewo.cam';
const title = 'Платформа Просування для Вебкам-Моделей і Студій';
const description = 'EWO — глобальний сервіс для вебкам-моделей і студій. Зростання трафіку, просування та повний менеджмент. 1000+ клієнтів, 10+ років досвіду, 20+ країн.';
const hreflang = [
  { lang: 'en', url: `${site}/` },
  { lang: 'de', url: `${site}/de` },
  { lang: 'es', url: `${site}/es` },
  { lang: 'ro', url: `${site}/ro` },
  { lang: 'uk', url: `${site}/uk` },
  { lang: 'ru', url: `${site}/ru` },
];
---
<Base title={title} description={description} lang="uk" hreflang={hreflang}>
  <Fragment slot="head">
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              night: '#060918',
              'night-2': '#0d1030',
              indigo: { 400: '#818cf8', 500: '#6366f1', 600: '#4f46e5' },
              violet: { 400: '#a78bfa', 500: '#8b5cf6' },
            },
            fontFamily: { sans: ['Nunito', 'Inter', 'system-ui', 'sans-serif'] },
          }
        }
      }
    </script>
    <style>
      .glow-orb { position:absolute; border-radius:50%; filter:blur(80px); pointer-events:none; opacity:0.3; }

      .card-glass {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        backdrop-filter: blur(12px);
        transition: border-color 0.3s, background 0.3s;
      }
      .card-glass:hover { border-color: rgba(129,140,248,0.3); background: rgba(129,140,248,0.05); }

      .btn-primary {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        transition: opacity 0.2s, transform 0.2s;
        min-height: 48px; display: inline-flex; align-items: center; justify-content: center;
      }
      .btn-primary:active { opacity: 0.85; transform: scale(0.98); }

      .btn-ghost {
        border: 1px solid rgba(255,255,255,0.12);
        transition: border-color 0.2s, background 0.2s;
        min-height: 48px; display: inline-flex; align-items: center; justify-content: center;
      }
      .btn-ghost:active { background: rgba(129,140,248,0.08); }

      .stat-num { background: linear-gradient(135deg, #818cf8, #a78bfa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

      .hero-grid-line {
        position:absolute; inset:0;
        background-image: linear-gradient(rgba(129,140,248,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(129,140,248,0.04) 1px, transparent 1px);
        background-size: 60px 60px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 100%);
      }

      .tag-pill {
        background: rgba(99,102,241,0.15); border: 1px solid rgba(99,102,241,0.3);
        color: #a5b4fc; font-size: 11px; padding: 4px 12px;
        border-radius: 99px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600;
      }

      .live-dot { width:7px; height:7px; background:#34d399; border-radius:50%; animation:pulse-dot 2s infinite; flex-shrink:0; }
      @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.4)} }

      .avatar-placeholder { background: linear-gradient(135deg,#1e1b4b,#312e81); border: 1px solid rgba(129,140,248,0.2); display:flex; align-items:center; justify-content:center; }

      .divider { height:1px; background:linear-gradient(90deg,transparent,rgba(129,140,248,0.2),transparent); }

      .features-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
      @media (min-width: 640px) { .features-grid { grid-template-columns: 1fr 1fr; } }
      @media (min-width: 1024px) { .features-grid { grid-template-columns: 1fr 1fr 1fr; } }

      .heading-xl { font-family:'Josefin Sans',sans-serif; font-weight:700; font-style:italic; font-size:clamp(40px,10vw,88px); line-height:1.05; letter-spacing:-0.01em; color:#f0eeff; }
      .heading-lg { font-family:'Josefin Sans',sans-serif; font-weight:700; font-style:italic; font-size:clamp(26px,5vw,44px); color:#f0eeff; letter-spacing:-0.01em; }
      .grad-text { background:linear-gradient(135deg,#a78bfa 0%,#6366f1 60%,#818cf8 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

      .section-pad { padding: 64px 20px; }
      @media (min-width: 768px) { .section-pad { padding: 96px 24px; } }

      .cta-box { padding: 40px 24px; }
      @media (min-width: 768px) { .cta-box { padding: 56px 48px; } }

      body { background: #060918; }
    </style>
  </Fragment>

  <!-- HERO -->
  <section class="relative min-h-[85dvh] flex items-center justify-center overflow-hidden">
    <div class="hero-grid-line"></div>
    <div class="glow-orb w-80 h-80 bg-indigo-600 top-10 left-0 -translate-x-1/3"></div>
    <div class="glow-orb w-72 h-72 bg-violet-600 top-20 right-0 translate-x-1/3"></div>
    <div class="glow-orb w-64 h-64 bg-indigo-800 bottom-0 left-1/2 -translate-x-1/2 opacity-20"></div>

    <svg class="absolute top-20 right-6 opacity-15 hidden sm:block" width="100" height="100" viewBox="0 0 120 120" fill="none">
      <circle cx="60" cy="60" r="50" stroke="#818cf8" stroke-width="1" stroke-dasharray="4 8"/>
      <circle cx="60" cy="60" r="30" stroke="#a78bfa" stroke-width="0.5" stroke-dasharray="2 6"/>
      <line x1="60" y1="10" x2="60" y2="110" stroke="#818cf8" stroke-width="0.5" opacity="0.5"/>
      <line x1="10" y1="60" x2="110" y2="60" stroke="#818cf8" stroke-width="0.5" opacity="0.5"/>
    </svg>

    <div class="relative z-10 text-center px-5 max-w-4xl mx-auto w-full py-16">
      <div class="tag-pill mb-5 sm:mb-7">
        <span class="live-dot"></span>
        Глобальний сервіс для вебкам-моделей і студій
      </div>

      <h1 class="heading-xl mb-5 sm:mb-6">
        ТРАФІК. МЕНЕДЖМЕНТ.<br>
        <span class="grad-text">ДЛЯ ВЕБКАМ-МОДЕЛЕЙ.</span>
      </h1>

      <p class="text-base sm:text-lg text-slate-400 mb-8 max-w-md mx-auto leading-relaxed font-light">
        EWO — глобальний сервіс для вебкам-моделей і студій. Ми займаємося зростанням аудиторії, просуванням та повним менеджментом — для незалежних моделей та мульти-модельних студій по всьому світу.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-sm sm:max-w-none mx-auto">
        <a href="/uk/for-models" class="btn-primary px-7 py-3.5 rounded-2xl text-white font-bold text-base w-full sm:w-auto">
          Для Моделей →
        </a>
        <a href="/uk/studio-traffic" class="btn-ghost px-7 py-3.5 rounded-2xl text-slate-300 font-semibold text-base flex items-center gap-2 justify-center w-full sm:w-auto">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2"/><path d="M6.5 5.5l4 2.5-4 2.5V5.5z" fill="currentColor"/></svg>
          Для Студій
        </a>
      </div>

      <div class="mt-4 flex justify-center">
        <LiveIndicator lang="uk" />
      </div>

      <div class="mt-10 flex items-center justify-center gap-2 flex-wrap">
        <div class="flex -space-x-2">
          <div class="w-8 h-8 rounded-full avatar-placeholder"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div>
          <div class="w-8 h-8 rounded-full avatar-placeholder" style="background:linear-gradient(135deg,#2d1b69,#4c1d95)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div>
          <div class="w-8 h-8 rounded-full avatar-placeholder" style="background:linear-gradient(135deg,#1e3a5f,#1e40af)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div>
          <div class="w-8 h-8 rounded-full avatar-placeholder" style="background:linear-gradient(135deg,#3b0764,#6b21a8)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div>
        </div>
        <span class="text-sm text-slate-500">Нам довіряють <span class="text-slate-300 font-semibold">1000+</span> моделей і студій</span>
      </div>
    </div>
  </section>

  <TrendsBlock lang="uk" />

  <div class="divider"></div>

  <!-- POPULAR SERVICES -->
  <section class="section-pad relative">
    <div class="max-w-6xl mx-auto px-5 sm:px-6">
      <div class="text-center mb-10 px-1">
        <div class="tag-pill mb-4">Популярні послуги</div>
        <h2 class="heading-lg mb-3">У тренді зараз</h2>
        <p class="text-slate-500 text-sm sm:text-base max-w-lg mx-auto">Послуга просування, про яку наші клієнти запитують найбільше цього місяця.</p>
      </div>

      <a href="/uk/stripchat_promo" class="card-glass rounded-2xl overflow-hidden flex flex-col md:flex-row items-stretch" style="text-decoration:none;">
        <div class="md:w-2/5 shrink-0" style="min-height:220px;">
          <img src="/images/stripchat-traffic-promo-banner.webp" alt="Stripchat traffic promo — отримай більше глядачів і підвищ свій stripscore" class="w-full h-full object-cover" loading="lazy">
        </div>
        <div class="p-6 sm:p-8 flex flex-col justify-center md:w-3/5">
          <span class="tag-pill mb-4 w-fit">Stripchat</span>
          <h3 class="text-white font-bold text-xl sm:text-2xl mb-3">Stripchat Traffic Promo</h3>
          <p class="text-slate-500 text-sm sm:text-base leading-relaxed mb-5">Розмісти свою кімнату в категорії Popular на Stripchat, підвищ свій stripscore і отримай реальних глядачів. Подивись, як працює просування, ціни та план дій, щоб отримати максимум.</p>
          <span class="text-indigo-400 text-sm font-semibold inline-flex items-center gap-1">Читати повний огляд →</span>
        </div>
      </a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- WHY EWO -->
  <section class="section-pad relative">
    <div class="glow-orb w-72 h-72 bg-violet-700 top-1/2 left-0 -translate-y-1/2 opacity-20"></div>
    <div class="max-w-6xl mx-auto px-5 sm:px-6">
      <div class="text-center mb-10">
        <div class="tag-pill mb-4">Чому EWO</div>
        <h2 class="heading-lg mb-3">Десятиліття результатів на 20+ ринках.</h2>
        <p class="text-slate-500 text-sm sm:text-base max-w-lg mx-auto">Ми працюємо у вебкам-індустрії ще з тих часів, коли більшість нинішніх платформ не існувала. Цей досвід безпосередньо перетворюється на стратегії, що працюють.</p>
      </div>

      <div class="features-grid">
        <div class="card-glass rounded-2xl p-5 sm:p-7">
          <div class="w-11 h-11 rounded-xl bg-indigo-500/15 border border-indigo-400/20 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2l2.5 5 5.5.8-4 3.9.9 5.5L10 14.7l-4.9 2.5.9-5.5L2 7.8l5.5-.8L10 2z" stroke="#818cf8" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2 text-base">Лише Легітимне Зростання</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Без ботів, без накруток, без ризику для твого акаунту. Реальна аудиторія, яка повертається і дає чайові.</p>
        </div>
        <div class="card-glass rounded-2xl p-5 sm:p-7">
          <div class="w-11 h-11 rounded-xl bg-violet-500/15 border border-violet-400/20 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="#a78bfa" stroke-width="1.5"/><path d="M10 6v4l3 3" stroke="#a78bfa" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2 text-base">10+ Років Досвіду</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Понад десятиліття у вебкам-індустрії — ми знаємо, що працює, і що призводить до блокування акаунтів.</p>
        </div>
        <div class="card-glass rounded-2xl p-5 sm:p-7">
          <div class="w-11 h-11 rounded-xl bg-indigo-500/15 border border-indigo-400/20 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 18s-7-4.5-7-9a7 7 0 0114 0c0 4.5-7 9-7 9z" stroke="#818cf8" stroke-width="1.5"/><circle cx="10" cy="9" r="2" stroke="#818cf8" stroke-width="1.5"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2 text-base">20+ Країн</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Наші клієнти моделі та студії з 20+ країн.</p>
        </div>
        <div class="card-glass rounded-2xl p-5 sm:p-7">
          <div class="w-11 h-11 rounded-xl bg-violet-500/15 border border-violet-400/20 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="14" height="14" rx="3" stroke="#a78bfa" stroke-width="1.5"/><path d="M7 10h6M10 7v6" stroke="#a78bfa" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2 text-base">Усі Основні Платформи</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Chaturbate, Stripchat, BongaCams, LiveJasmin та ще 8+ — де б ти не стримила, ми знаємо алгоритм.</p>
        </div>
        <div class="card-glass rounded-2xl p-5 sm:p-7">
          <div class="w-11 h-11 rounded-xl bg-indigo-500/15 border border-indigo-400/20 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="5" width="16" height="11" rx="2" stroke="#818cf8" stroke-width="1.5"/><path d="M14 5V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v1" stroke="#818cf8" stroke-width="1.5"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2 text-base">Команда Повного Циклу</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Стратегія, виконання й аналітика — ми беремо на себе все, щоб ти могла зосередитись на стримінгу.</p>
        </div>
        <div class="card-glass rounded-2xl p-5 sm:p-7">
          <div class="w-11 h-11 rounded-xl bg-violet-500/15 border border-violet-400/20 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="#a78bfa" stroke-width="1.5"/><path d="M7 10l2 2 4-4" stroke="#a78bfa" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h3 class="text-white font-bold mb-2 text-base">Накопичувальні Результати</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Реальна аудиторія, яка залишається — глядачі, що повертаються, дають чайові й з часом стають відданими фанатами.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-pad relative">
    <div class="glow-orb w-80 h-80 bg-indigo-600 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-25"></div>
    <div class="max-w-2xl mx-auto px-5 sm:px-6 text-center relative z-10">
      <div class="card-glass rounded-3xl cta-box border border-indigo-500/15">
        <svg class="mx-auto mb-6 opacity-30" width="52" height="52" viewBox="0 0 60 60" fill="none">
          <circle cx="30" cy="30" r="25" stroke="#818cf8" stroke-width="1" stroke-dasharray="4 6"/>
          <circle cx="30" cy="30" r="12" stroke="#a78bfa" stroke-width="0.8"/>
          <circle cx="30" cy="30" r="4" fill="#818cf8"/>
        </svg>
        <h2 class="heading-lg mb-4">Готова рости?</h2>
        <p class="text-slate-400 mb-8 text-sm sm:text-base max-w-sm mx-auto">Розкажи нам, де ти зараз і куди хочеш потрапити. Ми побудуємо план.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://t.me/+tBjfmjh9vHo1YzQy" target="_blank" rel="noopener" class="btn-primary px-7 py-3.5 rounded-2xl text-white font-bold w-full sm:w-auto">Зв'язатися</a>
          <a href="/uk/platforms-we-work-with" class="btn-ghost px-7 py-3.5 rounded-2xl text-slate-300 font-semibold w-full sm:w-auto">Платформи, з Якими Ми Працюємо</a>
        </div>
      </div>
    </div>
  </section>
</Base>
