  description="EWO — це сервіс просування для вебкам-моделей та студій. Ми допомагаємо зростати з реальною аудиторією — без ботів, без фейкових переглядів."
  lang="uk"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
