---
import Base from '@/layouts/Base.astro';
const site = 'https://ewohub.com';
const slug = 'resources';

// На цій сторінці з'являються тільки статті з category: 'guides'.
// Все інше живе на /blog — ця сторінка виключно кураторська стрічка Гайдів.
const articles = [
  {
    href: '/uk/stripchat-first-14-days-guide',
    title: 'Твої перші 14 днів на Stripchat',
    desc: 'Покроково: реєстрація, налаштування профілю і як вичавити максимум із 14-денного вікна видимості "New".',
    tag: 'Stripchat',
    category: 'guides',
  },
].filter(a => a.category === 'guides');
---
<Base
  title="Гайди — Покрокові гайди для вебкам-моделей"
  description="Практичні покрокові гайди для вебкам-моделей — реєстрація, механіка платформи і як почати правильно."
  lang="uk"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Безкоштовні ресурси</span>
      </div>
      <h1 class="art-title">Покрокові <span class="art-grad">гайди</span></h1>
      <p class="art-lead">Практичні покрокові гайди для вебкам-моделей — без води, без апселу.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="related-grid">
        {articles.map(({ href, title, desc, tag }) => (
          <a href={href} class="glass-card" style="text-decoration:none;display:flex;flex-direction:column;gap:.625rem;">
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
            </div>
            <h3 style="font-size:1.1rem;font-weight:700;margin:0;">{title}</h3>
            <p style="margin:0;font-size:.9375rem;">{desc}</p>
            <span style="font-size:.875rem;font-weight:600;color:var(--accent);margin-top:auto;">Читати статтю →</span>
          </a>
        ))}
      </div>

      <section class="art-cta" style="margin-top:4rem;">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Шукаєте щось інше?</span>
          <h2>Перегляньте повний каталог статей</h2>
          <p>Розбір доходів, порівняння платформ, глибокі розбори алгоритмів та інше — у блозі.</p>
          <div class="art-cta__actions">
            <a href="/uk/blog" class="art-cta__btn--primary btn btn-primary">Перейти в блог →</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>
