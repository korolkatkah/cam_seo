---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Webcam Model Promotion Services"
  description="Professional audience growth and promotion services for webcam models. SEO, social media strategy, and platform optimization — no shortcuts, just sustainable results."
>

  <!-- ── PAGE HERO ── -->
  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">For Models</p>
      <h1>Model Promotion<br /><span class="text-accent">Services</span></h1>
      <p class="hero-sub">
        Sustainable audience growth for independent performers — built on legitimate
        digital marketing, not tricks. Real viewers who stay, tip, and come back.
      </p>
      <a href="/about#contact" class="btn btn-primary">Start Growing →</a>
    </div>
  </section>

  <hr class="divider" />

  <!-- ── SERVICES ── -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">What's included</p>
        <h2>Everything you need<br />to grow an audience.</h2>
      </div>
      <div class="services-list">

        <div class="service-item">
          <div class="service-item-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </div>
          <div class="service-item-body">
            <h3>Profile & Discoverability Optimization</h3>
            <p>
              Your profile is your storefront. We audit and optimize your bio, tags, preview images,
              and category selection to ensure you appear in the right searches and attract the right audience.
              Most models are invisible not because they're bad — their profile just doesn't work for them.
            </p>
          </div>
        </div>

        <div class="service-item">
          <div class="service-item-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          </div>
          <div class="service-item-body">
            <h3>Streaming Schedule Strategy</h3>
            <p>
              Timing matters more than most models realize. We analyze platform traffic patterns by region
              and help you build a schedule that puts you in front of the largest relevant audience.
              Streaming at the wrong time means competing for a fraction of available viewers.
            </p>
          </div>
        </div>

        <div class="service-item">
          <div class="service-item-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-2.5 2.5-5 3c-1.5-3-4-4-7-3C6 5.5 3 9 4 13c2 7 10 9 14 5"/><path d="M12 12c-2 2-4 2-6 0"/></svg>
          </div>
          <div class="service-item-body">
            <h3>Social Media Growth</h3>
            <p>
              Off-platform presence drives loyal fans. We create content strategies for Twitter/X,
              Reddit, and other platforms that funnel consistent traffic back to your live streams.
              Models with an off-platform following have a traffic floor that platform-only models don't.
            </p>
          </div>
        </div>

        <div class="service-item">
          <div class="service-item-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div class="service-item-body">
            <h3>Income Strategy</h3>
            <p>
              Viewer count is vanity; income is what matters. We help you understand the difference between
              high-viewer rooms with low tips and smaller rooms with loyal, high-value fans — and build
              toward the latter. Includes multi-revenue-stream planning for long-term stability.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- ── NEW MODEL CALLOUT ── -->
  <section class="section">
    <div class="container callout-grid">
      <div class="callout-text">
        <p class="eyebrow">Starting from zero</p>
        <h2>New model?<br />We have a program for that.</h2>
        <p>
          Getting your first consistent audience is the hardest part. Our 30-day new model program
          gives you a structured plan to build initial momentum — compressing months of trial-and-error
          into a focused first month.
        </p>
        <a href="/new-model-growth" class="btn btn-ghost" style="margin-top: 1.5rem;">New Model Growth Program →</a>
      </div>
      <div class="callout-aside">
        <div class="timeline">
          <div class="tl-item">
            <span class="tl-week">Week 1</span>
            <span class="tl-label">Foundation — profile, tags, category</span>
          </div>
          <div class="tl-item">
            <span class="tl-week">Week 2</span>
            <span class="tl-label">Schedule & social presence</span>
          </div>
          <div class="tl-item">
            <span class="tl-week">Week 3</span>
            <span class="tl-label">Audience activation & loyalty</span>
          </div>
          <div class="tl-item">
            <span class="tl-week">Week 4</span>
            <span class="tl-label">Analytics & ongoing playbook</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- ── WHY LEGITIMATE ── -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Our philosophy</p>
        <h2>Why legitimate<br />growth is the only growth.</h2>
        <p>
          Fake viewers and bot traffic get accounts banned and waste money. Every platform detects
          manipulation with increasing sophistication. Our approach focuses entirely on real audiences —
          viewers who stay, tip, and return. This takes longer, but the results compound over time
          and your account stays safe.
        </p>
      </div>
      <div class="compare-grid">
        <div class="compare-col">
          <p class="compare-label compare-label-bad">Shortcuts</p>
          <ul class="compare-list">
            <li>Fake viewer counts</li>
            <li>Bot traffic services</li>
            <li>Account manipulation</li>
            <li>Bought followers</li>
          </ul>
          <p class="compare-outcome compare-outcome-bad">Result: account ban, wasted money, no real audience</p>
        </div>
        <div class="compare-col compare-col-good">
          <p class="compare-label compare-label-good">EWO approach</p>
          <ul class="compare-list compare-list-good">
            <li>Platform optimization</li>
            <li>Schedule strategy</li>
            <li>Social media presence</li>
            <li>Community building</li>
          </ul>
          <p class="compare-outcome compare-outcome-good">Result: loyal fans, sustainable income, safe account</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- ── GEO ── -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Regions</p>
        <h2>Location-specific<br />strategies.</h2>
        <p>Different markets have different peak hours, content preferences, and platform dynamics. We tailor strategies to your target audience's geography.</p>
      </div>
      <div class="geo-grid">
        <a href="/model-promotion-usa" class="geo-card card">
          <span class="geo-flag">🇺🇸</span>
          <div>
            <p class="geo-name">United States</p>
            <p class="geo-desc">Largest market, highest average spend, English-language strategy</p>
          </div>
          <span class="card-link" aria-label="Model promotion USA">→</span>
        </a>
        <a href="/model-promotion-germany" class="geo-card card">
          <span class="geo-flag">🇩🇪</span>
          <div>
            <p class="geo-name">Germany</p>
            <p class="geo-desc">High-loyalty DACH audience, CET scheduling, German language tips</p>
          </div>
          <span class="card-link" aria-label="Model promotion Germany">→</span>
        </a>
        <a href="/model-promotion-romania" class="geo-card card">
          <span class="geo-flag">🇷🇴</span>
          <div>
            <p class="geo-name">Romania</p>
            <p class="geo-desc">High model supply, Western audience targeting, studio competition</p>
          </div>
          <span class="card-link" aria-label="Model promotion Romania">→</span>
        </a>
        <a href="/model-promotion-ukraine" class="geo-card card">
          <span class="geo-flag">🇺🇦</span>
          <div>
            <p class="geo-name">Ukraine</p>
            <p class="geo-desc">International audience strategy, European prime time optimization</p>
          </div>
          <span class="card-link" aria-label="Model promotion Ukraine">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta-band">
    <div class="container">
      <h2>Ready to start?</h2>
      <p>Contact us to discuss your goals. We'll review your current situation and put together a plan before we take you on as a client.</p>
      <a href="/about#contact" class="btn btn-primary" style="margin-top: .5rem;">Get in Touch →</a>
    </div>
  </section>

</Base>

<style>
  .page-hero { padding-block: clamp(4rem, 10vw, 7rem); }
  .hero-sub {
    font-size: 1.125rem;
    color: var(--fg-muted);
    max-width: 50ch;
    margin: 1.25rem 0 2rem;
  }

  .section-header { margin-bottom: 3rem; max-width: 54ch; }
  .eyebrow {
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: .75rem;
    max-width: none;
  }
  .section-header h2 { margin-bottom: 1rem; }

  /* Services list */
  .services-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .service-item {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 0;
    padding: 2rem 2rem 2rem 0;
    border-bottom: 1px solid var(--border);
    transition: background var(--transition);
  }
  .service-item:last-child { border-bottom: none; }
  .service-item:hover { background: var(--bg-raised); }
  .service-item-icon {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: .2rem;
    color: var(--accent);
    flex-shrink: 0;
  }
  .service-item-body { display: flex; flex-direction: column; gap: .625rem; }
  .service-item-body h3 { font-size: 1.125rem; }

  /* Callout */
  .callout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .timeline {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .tl-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.125rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .tl-item:last-child { border-bottom: none; }
  .tl-week {
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 600;
    color: var(--accent);
    width: 56px;
    flex-shrink: 0;
    letter-spacing: .04em;
  }
  .tl-label { font-size: .9375rem; color: var(--fg-muted); }

  /* Compare */
  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    max-width: 800px;
  }
  .compare-col {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .compare-col-good { border-color: rgba(217,119,6,.3); }
  .compare-label {
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    max-width: none;
  }
  .compare-label-bad  { color: var(--fg-faint); }
  .compare-label-good { color: var(--accent); }
  .compare-list { display: flex; flex-direction: column; gap: .5rem; }
  .compare-list li {
    font-size: .9375rem;
    color: var(--fg-muted);
    padding-left: 1.125rem;
    position: relative;
  }
  .compare-list li::before {
    content: '×';
    position: absolute;
    left: 0;
    color: var(--fg-faint);
  }
  .compare-list-good li::before { content: '✓'; color: var(--accent); }
  .compare-outcome {
    font-size: .875rem;
    border-radius: var(--radius-sm);
    padding: .75rem 1rem;
    margin-top: auto;
    max-width: none;
  }
  .compare-outcome-bad  { background: rgba(255,255,255,.04); color: var(--fg-faint); }
  .compare-outcome-good { background: var(--accent-dim); color: var(--accent); }

  /* Geo */
  .geo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .geo-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }
  .geo-flag { font-size: 1.75rem; flex-shrink: 0; line-height: 1; }
  .geo-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--fg);
    margin-bottom: .25rem;
    max-width: none;
  }
  .geo-desc { font-size: .8125rem; color: var(--fg-muted); max-width: none; }
  .geo-card .card-link {
    margin-left: auto;
    font-size: 1.1rem;
    color: var(--fg-faint);
    transition: color var(--transition);
  }
  .geo-card:hover .card-link { color: var(--accent); }

  /* CTA band (same as homepage) */
  .cta-band {
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
    padding-block: clamp(4rem, 8vw, 6rem);
    text-align: center;
  }
  .cta-band .container { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .cta-band h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .cta-band p { max-width: 46ch; }

  @media (max-width: 768px) {
    .callout-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .compare-grid { grid-template-columns: 1fr; }
    .service-item { grid-template-columns: 48px 1fr; }
  }
</style>
