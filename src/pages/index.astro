---
import Base from '@/layouts/Base.astro';
const site = 'https://ewo.cam';
---

<Base
  title="Webcam Model & Studio Global Service — Traffic, Promotion, Management"
  description="EWO is a global webcam service for models and studios. Traffic growth, promotion, and full management. 1000+ clients, 10+ years experience, 20+ countries."
  lang="en"
  hreflang={[
    { lang: 'en', url: `${site}/` },
    { lang: 'de', url: `${site}/de` },
    { lang: 'es', url: `${site}/es` },
    { lang: 'ro', url: `${site}/ro` },
    { lang: 'uk', url: `${site}/uk` },
    { lang: 'ru', url: `${site}/ru` },
  ]}
>

  <!-- HERO -->
  <section class="hero section">
    <div class="container">
      <div class="hero-eyebrow">
        <span class="badge">Global Webcam Service</span>
      </div>
      <h1 class="hero-headline">
        Traffic. Promotion.<br />
        <em class="hero-accent">Management.</em>
      </h1>
      <p class="hero-sub">
        EWO is a global service for webcam models and studios. We handle audience growth,
        promotion, and full management — for independent performers and multi-model studios
        worldwide.
      </p>
      <div class="hero-actions">
        <a href="/model-promotion" class="btn btn-primary">For Models</a>
        <a href="/studio-traffic" class="btn btn-ghost">For Studios</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">1000+</span>
          <span class="stat-label">Models & Studios</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">10+</span>
          <span class="stat-label">Years on market</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">20+</span>
          <span class="stat-label">Countries</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">What we do</p>
        <h2>Three services.<br />One global team.</h2>
        <p>Whether you're starting out or scaling a studio, EWO has a solution built for your stage.</p>
      </div>
      <div class="cards-grid-3">
        <a href="/studio-traffic" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Traffic Growth</h3>
          <p>Viewer growth strategy for models and studios — scheduling, regional targeting, platform optimization.</p>
          <span class="card-link">Learn more <span aria-hidden="true">→</span></span>
        </a>
        <a href="/model-promotion" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>Promotion</h3>
          <p>Profile optimization, off-platform presence, social growth, and SEO for cam profiles.</p>
          <span class="card-link">Learn more <span aria-hidden="true">→</span></span>
        </a>
        <a href="/studio-scaling" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <h3>Management</h3>
          <p>Full-service management for studios: roster coordination, compliance, scaling systems, and analytics.</p>
          <span class="card-link">Learn more <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- TRUST -->
  <section class="section trust-section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Why EWO</p>
        <h2>A decade of results<br />across 20+ markets.</h2>
        <p>We've been in the webcam industry since before most current platforms existed. That experience translates directly into strategies that work.</p>
      </div>
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-num">1000+</span>
          <h3>Models & Studios</h3>
          <p>More than 1000 models and studios have worked with EWO to grow their audiences.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">10+</span>
          <h3>Years on Market</h3>
          <p>Over a decade in the webcam industry — we know what works and what gets accounts banned.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">20+</span>
          <h3>Countries</h3>
          <p>Our clients stream from 20+ countries targeting viewers across all major global markets.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">0</span>
          <h3>Fake Viewers</h3>
          <p>We work exclusively with legitimate audience growth. No bots, no inflated numbers, no risk to your account.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Our approach</p>
        <h2>Legitimate growth,<br />compounding results.</h2>
        <p>Shortcuts get accounts banned. We build real audiences that stay — viewers who return, tip, and become loyal fans.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">01</span>
          <h3>Audit & Strategy</h3>
          <p>We review your current profile, streaming schedule, and audience data to identify the highest-leverage improvements.</p>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <h3>Platform Optimization</h3>
          <p>Profile, tags, category, and preview optimization — ensuring you appear in the right searches and convert browsers into viewers.</p>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <h3>Audience Development</h3>
          <p>Off-platform social presence, scheduling strategy, and engagement techniques that build a loyal returning fan base.</p>
        </div>
        <div class="step">
          <span class="step-num">04</span>
          <h3>Measure & Iterate</h3>
          <p>Regular performance review against real metrics — viewer retention, return rate, income growth — not vanity numbers.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- RESOURCES -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Free resources</p>
        <h2>Understand the game<br />before you play it.</h2>
      </div>
      <div class="cards-grid-3">
        <a href="/why-low-viewers-webcam" class="card resource-card">
          <h3>Why Your Room Has Low Viewers</h3>
          <p>8 fixable reasons models struggle with visibility — and what to do about each.</p>
          <span class="card-link">Read <span aria-hidden="true">→</span></span>
        </a>
        <a href="/how-cam-algorithm-ranks-rooms" class="card resource-card">
          <h3>How Cam Algorithms Rank Rooms</h3>
          <p>What signals platforms weight and how to work with the algorithm, not against it.</p>
          <span class="card-link">Read <span aria-hidden="true">→</span></span>
        </a>
        <a href="/best-streaming-times-by-region" class="card resource-card">
          <h3>Best Streaming Times by Region</h3>
          <p>Peak viewer hours for USA, Germany, UK, Eastern Europe and more.</p>
          <span class="card-link">Read <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="container">
      <h2>Ready to grow?</h2>
      <p>Tell us where you are and where you want to go. We'll build the plan.</p>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
        <a href="/platforms-we-work-with" class="btn btn-ghost">Platforms We Work With</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero { padding-block: clamp(5rem, 12vw, 9rem); }
  .hero-eyebrow { margin-bottom: 1.75rem; }
  .badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid rgba(217,119,6,.3);
    background: var(--accent-dim);
    padding: .35rem .875rem;
    border-radius: 100px;
  }
  .hero-headline {
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  .hero-accent { font-style: normal; color: var(--accent); }
  .hero-sub {
    font-size: 1.125rem;
    color: var(--fg-muted);
    max-width: 46ch;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 4rem; }
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .stat { display: flex; flex-direction: column; gap: .2rem; }
  .stat-number { font-family: var(--font-heading); font-size: 1.75rem; font-weight: 700; color: var(--fg); line-height: 1; }
  .stat-label { font-size: .8rem; color: var(--fg-faint); letter-spacing: .04em; }
  .stat-divider { width: 1px; height: 2.5rem; background: var(--border); }

  .section-header { margin-bottom: 3.5rem; max-width: 54ch; }
  .eyebrow {
    font-family: var(--font-heading);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: .75rem;
    max-width: none;
  }
  .section-header h2 { margin-bottom: 1rem; }
  .section-header p { font-size: 1.0625rem; }

  .cards-grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem; }
  .cards-grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }

  .service-card { display: flex; flex-direction: column; gap: 1rem; text-decoration: none; }
  .service-icon {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md);
    background: var(--accent-dim);
    color: var(--accent);
    flex-shrink: 0;
  }
  .service-card h3 { margin-top: .25rem; }
  .card-link {
    font-family: var(--font-heading);
    font-size: .875rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    transition: gap var(--transition);
  }
  .service-card:hover .card-link { gap: .6rem; }

  .trust-section {}
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .trust-item { display: flex; flex-direction: column; gap: .5rem; }
  .trust-num {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .trust-item h3 { margin-top: .25rem; }

  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem 3rem; }
  .step { display: flex; flex-direction: column; gap: .75rem; }
  .step-num { font-family: var(--font-heading); font-size: .8125rem; font-weight: 600; letter-spacing: .1em; color: var(--accent); }

  .resource-card { display: flex; flex-direction: column; gap: .75rem; text-decoration: none; }
  .resource-card h3 { font-size: 1.125rem; }
  .resource-card:hover .card-link { gap: .6rem; }

  .cta-band {
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-block: clamp(4rem, 8vw, 6rem);
    text-align: center;
  }
  .cta-band .container { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .cta-band h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .cta-band p { max-width: 40ch; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: .5rem; }
</style>
