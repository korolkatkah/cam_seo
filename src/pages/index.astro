---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Webcam Model & Studio Promotion"
  description="EWO helps webcam models and studios grow their audience through legitimate digital marketing — SEO, social, and platform optimization."
>
  <section style="padding: 4rem 0;">
    <h1>Grow Your Webcam Audience — Legitimately</h1>
    <p style="font-size: 1.2rem; max-width: 640px;">
      EWO provides digital marketing services for independent webcam models and studios.
      We focus on sustainable audience growth through SEO, content strategy, and platform best practices.
    </p>
    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
      <a href="/model-promotion" style="padding: 0.75rem 1.5rem; background: #111; color: #fff; text-decoration: none; border-radius: 6px;">For Models</a>
      <a href="/studio-traffic" style="padding: 0.75rem 1.5rem; border: 2px solid #111; text-decoration: none; border-radius: 6px;">For Studios</a>
    </div>
  </section>

  <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 2rem;">
    <div style="padding: 1.5rem; border: 1px solid #eee; border-radius: 8px;">
      <h3>Model Promotion</h3>
      <p>Profile optimization, discoverability strategies, and audience growth for independent performers.</p>
      <a href="/model-promotion">Learn more →</a>
    </div>
    <div style="padding: 1.5rem; border: 1px solid #eee; border-radius: 8px;">
      <h3>Studio Traffic Growth</h3>
      <p>Multi-model traffic strategies, scheduling optimization, and regional audience targeting for studios.</p>
      <a href="/studio-traffic">Learn more →</a>
    </div>
    <div style="padding: 1.5rem; border: 1px solid #eee; border-radius: 8px;">
      <h3>Platform Algorithm Guide</h3>
      <p>Understand how cam platforms rank rooms and what you can do to improve your visibility.</p>
      <a href="/how-cam-algorithm-ranks-rooms">Learn more →</a>
    </div>
  </section>
</Base>
