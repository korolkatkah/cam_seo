---
import Base from '@/layouts/Base.astro';
import LiveLookupTool from '@/components/LiveLookupTool.astro';
const site = 'https://www.ewohub.com';
const slug = 'live-model-lookup';
---
<Base
  title="Busca de Modelos ao Vivo e Ranking — Chaturbate e Stripchat"
  description="Busque o status ao vivo por nome de usuário, compare dois modelos lado a lado, ou veja quem liderou o tráfego a cada hora hoje no Chaturbate e Stripchat. Atualizado automaticamente, sem necessidade de login."
  lang="pt"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>
  <LiveLookupTool lang="pt" />
</Base>
