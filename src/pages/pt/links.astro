---
const site = 'https://www.ewohub.com';
const lang = 'pt';
const path = '/pt/links';
const title = 'EWOMODELS | Traffic & Management for Webcam Models';
const description = 'Top agency for webcam models: traffic promotion, management and analytics. Join EWOMODELS on Telegram.';
const hreflang = [
  { lang: 'en', url: `${site}/links` },
  { lang: 'de', url: `${site}/de/links` },
  { lang: 'es', url: `${site}/es/links` },
  { lang: 'ro', url: `${site}/ro/links` },
  { lang: 'uk', url: `${site}/uk/links` },
  { lang: 'ru', url: `${site}/ru/links` },
  { lang: 'fr', url: `${site}/fr/links` },
  { lang: 'pt', url: `${site}/pt/links` },
];
const langLabels: Record<string, string> = {
  en: 'English', de: 'Deutsch', ro: 'Română', uk: 'Українська',
  ru: 'Русский', es: 'Español', fr: 'Français', pt: 'Português',
};
const heading = 'EWOMODELS';
const subLine1 = 'Traffic. Management.';
const subLine2 = 'For webcam models.';
const btnJobs = 'Top Agency for models';
const btnTelegram = 'Traffic for webcam';
const btnTools = 'Analytics for webcam';
const btnPromo = 'Stripchat promotion';
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6H89TM92EZ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    var ewoRef = '';
    try {
      var q = new URLSearchParams(location.search).get('ref');
      if (q) {
        ewoRef = q.toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 32);
        if (ewoRef) sessionStorage.setItem('ewo-ref', ewoRef);
      }
      if (!ewoRef) ewoRef = sessionStorage.getItem('ewo-ref') || '';
    } catch (e) {}
    window.ewoRef = ewoRef;
    if (!window.__ewoRedirect) {
      gtag('js', new Date());
      gtag('config', 'G-6H89TM92EZ', ewoRef ? { ref: ewoRef } : {});
    }
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${site}${path}`} />
  {hreflang.map(({ lang: l, url }) => (
    <link rel="alternate" hreflang={l} href={url} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${site}/links`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={`${site}${path}`} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://www.ewohub.com/logo-neon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#0f0e0c" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    @property --ang { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
    :root {
      --bg: #0f0e0c;
      --fg: #f3e9d6;
      --fg-strong: #fff3dc;
      --muted: #a79c88;
      --line: rgba(255,226,180,0.22);
      --font-heading: 'Josefin Sans', system-ui, sans-serif;
      --font-body: 'Nunito', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: radial-gradient(70% 42% at 50% 30%, rgba(255,206,140,0.2), transparent 72%), #0f0e0c;
      color: var(--fg);
      font-family: var(--font-body);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4.5rem 1.25rem 2.5rem;
    }
    .wrap { max-width: 400px; width: 100%; text-align: center; }

    .halo { position: relative; width: 220px; height: 220px; margin: 0 auto; filter: drop-shadow(0 0 22px rgba(255,204,140,0.5)); }
    .ring {
      position: absolute; inset: 0; border-radius: 50%;
      background: conic-gradient(from var(--ang), #fffaf0, #ffd6a0 24%, #fff4dc 50%, #ffdfb0 76%, #fffaf0);
      -webkit-mask: radial-gradient(circle, transparent 61%, #000 62%);
      mask: radial-gradient(circle, transparent 61%, #000 62%);
      animation: spin 10s linear infinite;
    }
    .cat { position: absolute; inset: 0; margin: auto; width: 100px; height: 118px; }
    @keyframes spin { to { --ang: 360deg; } }

    .brand { font-family: var(--font-heading); font-weight: 600; font-size: 1.5rem; letter-spacing: 0.2em; padding-left: 0.2em; color: var(--fg-strong); margin: 1.75rem 0 0.4rem; }
    .sub { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.08em; line-height: 1.7; margin: 0 0 1.9rem; }

    .links { display: flex; flex-direction: column; gap: 0.75rem; }
    .strip {
      display: flex; align-items: center; justify-content: center; gap: 0.6rem;
      padding: 0.95rem 1rem; border-radius: 14px;
      font-weight: 800; font-size: 0.95rem; text-decoration: none; color: #f6ecd9;
      background: rgba(255,240,214,0.06); border: 1px solid var(--line);
      transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .strip:hover { transform: translateY(-2px); background: rgba(255,240,214,0.11); border-color: rgba(255,226,180,0.4); }
    .strip.lit {
      background: linear-gradient(180deg, #fff7e6, #ffdfae); color: #1b1408; border-color: #fff1d2;
      padding: 1.15rem 1rem; font-size: 1.02rem;
      box-shadow: 0 0 34px rgba(255,206,140,0.42), 0 1px 0 #fff inset;
    }
    .strip.lit:hover { background: linear-gradient(180deg, #fffaf0, #ffe6bd); }
    .strip:focus-visible, .lang-drop-btn:focus-visible, .lang-opt:focus-visible { outline: 2px solid #ffdfae; outline-offset: 3px; }
    .ico { width: 20px; height: 20px; flex: none; }

    .lang-dropdown { position: fixed; top: 1rem; right: 1rem; z-index: 200; }
    .lang-drop-btn {
      display: flex; align-items: center; gap: 0.4rem;
      font-family: var(--font-heading); font-size: 0.8125rem; font-weight: 600;
      color: #d8c9ad; background: rgba(15,14,12,0.6); border: 1px solid rgba(255,226,180,0.24);
      padding: 0.45rem 0.875rem; border-radius: 6px; cursor: pointer; white-space: nowrap;
      transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
    }
    .lang-drop-btn:hover, .lang-drop-btn[aria-expanded="true"] { color: var(--fg-strong); border-color: rgba(255,226,180,0.45); background: rgba(255,240,214,0.08); }
    .lang-drop-btn[aria-expanded="true"] .chevron { transform: rotate(180deg); }
    .chevron { transition: transform 180ms ease; }
    .lang-menu {
      position: absolute; right: 0; top: calc(100% + 0.5rem);
      background: #1a1814; border: 1px solid rgba(255,226,180,0.18);
      border-radius: 12px; padding: 0.4rem; margin: 0; list-style: none; min-width: 155px;
      display: none; flex-direction: column; gap: 0.15rem;
      box-shadow: 0 12px 36px rgba(0,0,0,0.5);
    }
    .lang-menu.is-open { display: flex; }
    .lang-opt {
      display: block; padding: 0.5rem 0.875rem; border-radius: 6px;
      font-family: var(--font-heading); font-size: 0.875rem; font-weight: 600;
      color: #b9ab90; text-decoration: none; transition: background 180ms ease, color 180ms ease;
    }
    .lang-opt:hover { background: rgba(255,240,214,0.08); color: var(--fg-strong); }
    .lang-opt--active { color: var(--fg-strong); }

    @media (prefers-reduced-motion: reduce) {
      .ring { animation: none; }
      .strip { transition: none; }
    }
  </style>
</head>
<body>
  <div class="lang-dropdown">
    <button class="lang-drop-btn" aria-expanded="false" aria-haspopup="true" id="lang-btn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      <span>{langLabels[lang] ?? lang}</span>
      <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <ul class="lang-menu" role="listbox" id="lang-menu">
      {hreflang.map(({ lang: l, url }) => (
        <li>
          <a href={url} class={`lang-opt${l === lang ? ' lang-opt--active' : ''}`} hreflang={l}>{langLabels[l] ?? l}</a>
        </li>
      ))}
    </ul>
  </div>

  <main class="wrap">
    <div class="halo">
      <div class="ring" aria-hidden="true"></div>
      <svg class="cat" viewBox="40 36 120 140" role="img" aria-label="EWO"><path d="M55 130C55 152 74 168 100 168C126 168 145 152 145 130L145 95C145 88 140 82 133 80L120 48L108 78C105 77 102 76 100 76C98 76 95 77 92 78L80 48L67 80C60 82 55 88 55 95Z" fill="none" stroke="#ffeccb" stroke-width="7" stroke-linejoin="round" stroke-linecap="round"/></svg>
    </div>
    <h1 class="brand">{heading}</h1>
    <p class="sub">{subLine1}<br>{subLine2}</p>
    <div class="links">
      <a class="strip lit" data-link="agency" href="https://t.me/ewomodels" target="_blank" rel="noopener">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.6a3.5 3.5 0 010 6.8M18.2 14.4c2 .7 3.3 2.5 3.3 5.6"/></svg>
        {btnJobs}
      </a>
      <a class="strip" data-link="traffic" href="https://t.me/webcam_ewo/76" target="_blank" rel="noopener">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg>
        {btnTelegram}
      </a>
      <a class="strip" data-link="analytics" href="https://www.ewohub.com/" target="_blank" rel="noopener">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="20" x2="6" y2="11"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="14"/></svg>
        {btnTools}
      </a>
      <a class="strip" data-link="promo" href="https://t.me/Stripchat_traffic_bot" target="_blank" rel="noopener">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11v2a1 1 0 001 1h2l5 4V6L6 10H4a1 1 0 00-1 1z"/><path d="M15.5 8.5a5 5 0 010 7"/><path d="M18.5 5.5a9 9 0 010 13"/></svg>
        {btnPromo}
      </a>
    </div>
  </main>

  <script is:inline>
    (function () {
      var btn = document.getElementById('lang-btn');
      var menu = document.getElementById('lang-menu');
      if (!btn || !menu) return;
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = menu.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('click', function () {
        menu.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
      });
      document.querySelectorAll('.lang-opt').forEach(function (a) {
        a.addEventListener('click', function () {
          try { localStorage.setItem('ewo-lang-set', '1'); } catch (e) {}
          if (window.ewoRef) {
            try {
              var u = new URL(a.href);
              u.searchParams.set('ref', window.ewoRef);
              a.href = u.toString();
            } catch (e) {}
          }
        });
      });
      var TRACK_URL = 'https://worker-cabinet-production.up.railway.app/public/track';
      function send(payload) {
        try {
          fetch(TRACK_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain' },
            body: JSON.stringify(payload),
            keepalive: true,
            credentials: 'omit'
          }).catch(function () {});
        } catch (e) {}
      }
      var ref = window.ewoRef || 'direct';
      var lang = document.documentElement.lang;
      if (!window.__ewoRedirect) {
        var seen = '';
        try { seen = sessionStorage.getItem('ewo-visit') || ''; } catch (e) {}
        if (seen !== ref) {
          send({ event: 'visit', ref: ref, lang: lang });
          try { sessionStorage.setItem('ewo-visit', ref); } catch (e) {}
        }
      }
      function track(a) {
        var name = a.getAttribute('data-link');
        send({ event: 'click', ref: ref, link_name: name, lang: lang });
        if (typeof gtag !== 'function') return;
        gtag('event', 'link_click', {
          link_name: name,
          link_url: a.href,
          ref: ref,
          page_lang: lang
        });
      }
      document.querySelectorAll('.strip[data-link]').forEach(function (a) {
        a.addEventListener('click', function () { track(a); });
        a.addEventListener('auxclick', function () { track(a); });
      });
    })();
  </script>
</body>
</html>
