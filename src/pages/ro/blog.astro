---
import Base from '@/layouts/Base.astro';
const site = 'https://ewo.cam';

const articles = [
  {
    href: '/ro/model-promotion',
    title: 'Servicii de Promovare pentru Modele',
    desc: 'Cum funcționează serviciul nostru de marketing și creștere a audienței pentru modele webcam care transmit deja.',
    tag: 'Promovare',
    mins: '6 min',
  },
  {
    href: '/ro/why-low-viewers-webcam',
    title: 'De ce camera ta webcam are puțini spectatori',
    desc: '8 motive reale pentru care numărul de spectatori este scăzut și ce să faci pentru fiecare.',
    tag: 'Creștere',
    mins: '8 min',
  },
  {
    href: '/ro/how-cam-algorithm-ranks-rooms',
    title: 'Cum clasifică algoritmii cam camerele',
    desc: 'Ce determină cu adevărat vizibilitatea ta pe platformele cam și cum să lucrezi cu asta.',
    tag: 'Algoritm',
    mins: '6 min',
  },
  {
    href: '/ro/best-streaming-times-by-region',
    title: 'Cele mai bune ore de streaming pe regiune',
    desc: 'Date despre orele de vârf pe regiune — maximizează-ți audiența la fiecare sesiune.',
    tag: 'Strategie',
    mins: '5 min',
  },
  {
    href: '/ro/webcam-model-income-guide',
    title: 'Ghidul de venituri pentru modele webcam',
    desc: 'O prezentare clară a modului în care funcționează câștigurile webcam și cum să le crești.',
    tag: 'Venituri',
    mins: '10 min',
  },
  {
    href: '/ro/new-model-growth',
    title: 'Strategie de creștere pentru modele noi',
    desc: 'Cum să-ți construiești prima audiență constantă de la zero ca model webcam nou.',
    tag: 'Începător',
    mins: '7 min',
  },
];
---

<Base
  title="Blog — Ghiduri de creștere webcam și strategii"
  description="Ghiduri de experți pentru modele webcam și studiouri. Află cum funcționează algoritmii cam, cum să-ți crești audiența și să-ți maximizezi câștigurile."
  lang="ro"
  hreflang={[
    { lang: 'en', url: `${site}/blog` },
    { lang: 'de', url: `${site}/de/blog` },
    { lang: 'es', url: `${site}/es/blog` },
    { lang: 'ro', url: `${site}/ro/blog` },
    { lang: 'uk', url: `${site}/uk/blog` },
    { lang: 'ru', url: `${site}/ru/blog` },
  ]}
>
  <article>
    <div class="container page-top">
      <div class="blog-header">
        <p class="eyebrow">Blog</p>
        <h1>Ghiduri și Strategii</h1>
        <p class="lead">Cunoștințe practice pentru modele webcam și studiouri care vor să crească — fără trafic fals sau scurtături.</p>
      </div>

      <div class="blog-grid">
        {articles.map(({ href, title, desc, tag, mins }) => (
          <a href={href} class="blog-card">
            <div class="blog-card-meta">
              <span class="blog-tag">{tag}</span>
              <span class="blog-mins">{mins}</span>
            </div>
            <h2>{title}</h2>
            <p>{desc}</p>
            <span class="blog-read">Citește articolul →</span>
          </a>
        ))}
      </div>
    </div>
  </article>
</Base>

<style>
  .page-top { padding-block: clamp(4rem, 8vw, 7rem); }
  .blog-header { max-width: 54ch; margin-bottom: 3.5rem; }
  .eyebrow { font-family: var(--font-heading); font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .75rem; max-width: none; }
  .lead { font-size: 1.0625rem; color: var(--fg-muted); line-height: 1.75; margin-top: .75rem; }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
  .blog-card {
    display: flex; flex-direction: column; gap: .75rem;
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07);
    border-radius: var(--radius-lg); padding: 1.75rem 2rem;
    text-decoration: none; transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
  }
  .blog-card:hover { border-color: rgba(129,140,248,.3); background: rgba(129,140,248,.05); box-shadow: 0 4px 32px rgba(0,0,0,.4); }
  .blog-card-meta { display: flex; align-items: center; gap: .75rem; }
  .blog-tag { font-family: var(--font-heading); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); background: rgba(99,102,241,.15); border: 1px solid rgba(129,140,248,.25); padding: .2rem .6rem; border-radius: 100px; }
  .blog-mins { font-size: .8rem; color: var(--fg-faint); font-weight: 600; }
  .blog-card h2 { font-size: clamp(1.1rem, 2vw, 1.3rem); font-weight: 700; line-height: 1.25; color: var(--fg); margin: 0; }
  .blog-card p { font-size: .9375rem; color: var(--fg-muted); line-height: 1.65; margin: 0; }
  .blog-read { font-family: var(--font-heading); font-size: .875rem; font-weight: 600; color: var(--accent); margin-top: auto; padding-top: .25rem; }
</style>
