---
import Base from '@/layouts/Base.astro';
const site = 'https://ewo.cam';
---

<Base
  title="Serviciu Global Webcam — Trafic, Promovare, Management"
  description="EWO este un serviciu global pentru modele webcam și studiouri. Creștere trafic, promovare și management complet. 1000+ clienți, 10+ ani experiență, 20+ țări."
  lang="ro"
  hreflang={[
    { lang: 'en', url: `${site}/` },
    { lang: 'de', url: `${site}/de` },
    { lang: 'es', url: `${site}/es` },
    { lang: 'ro', url: `${site}/ro` },
    { lang: 'uk', url: `${site}/uk` },
    { lang: 'ru', url: `${site}/ru` },
  ]}
>

  <section class="hero section">
    <div class="container">
      <div class="hero-eyebrow">
        <span class="badge">Serviciu Global Webcam</span>
      </div>
      <h1 class="hero-headline">
        Trafic. Promovare.<br />
        <em class="hero-accent">Management.</em>
      </h1>
      <p class="hero-sub">
        EWO este un serviciu global pentru modele webcam și studiouri. Gestionăm creșterea audienței,
        promovarea și managementul complet — pentru performeri independenți și studiouri multi-model
        din întreaga lume.
      </p>
      <div class="hero-actions">
        <a href="/ro/for-models" class="btn btn-primary">Pentru Modele</a>
        <a href="/ro/studio-traffic" class="btn btn-ghost">Pentru Studiouri</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">1000+</span>
          <span class="stat-label">Modele & Studiouri</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">10+</span>
          <span class="stat-label">Ani pe piață</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">20+</span>
          <span class="stat-label">Țări</span>
        </div>
      </div>

      <figure class="hero-image">
        <img src="/images/hero-webcam-model-studio-promotion-agency.svg" alt="Ilustrație a panoului unei agenții globale de promovare pentru modele și studiouri webcam" width="640" height="360" loading="eager" />
      </figure>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Ce facem</p>
        <h2>Trei servicii.<br />O echipă globală.</h2>
        <p>Fie că ești la început sau scalezi un studio, EWO are o soluție pentru etapa ta.</p>
      </div>
      <div class="cards-grid-3">
        <a href="/ro/studio-traffic" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Creștere Trafic</h3>
          <p>Strategie de creștere a spectatorilor pentru modele și studiouri — programare, targeting regional, optimizare platformă.</p>
          <span class="card-link">Află mai mult <span aria-hidden="true">→</span></span>
        </a>
        <a href="/ro/model-promotion" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>Promovare</h3>
          <p>Optimizare profil, prezență off-platform, creștere pe social media și SEO pentru profiluri cam.</p>
          <span class="card-link">Află mai mult <span aria-hidden="true">→</span></span>
        </a>
        <a href="/ro/studio-scaling" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <h3>Management</h3>
          <p>Management complet pentru studiouri: coordonare roster, conformitate, sisteme de scalare și analiză.</p>
          <span class="card-link">Află mai mult <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">De ce EWO</p>
        <h2>Un deceniu de rezultate<br />în 20+ piețe.</h2>
        <p>Suntem în industria webcam de înainte ca majoritatea platformelor actuale să existe. Această experiență se traduce direct în strategii care funcționează.</p>
      </div>
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-num">1000+</span>
          <h3>Modele & Studiouri</h3>
          <p>Peste 1000 de modele și studiouri au colaborat cu EWO pentru a-și crește audiențele.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">10+</span>
          <h3>Ani pe Piață</h3>
          <p>Peste un deceniu în industria webcam — știm ce funcționează și ce duce la suspendarea conturilor.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">20+</span>
          <h3>Țări</h3>
          <p>Clienții noștri transmit din 20+ țări, ajungând la spectatori din toate piețele globale majore.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">0</span>
          <h3>Spectatori Falși</h3>
          <p>Lucrăm exclusiv cu creștere legitimă a audienței. Fără boți, fără cifre umflate, fără risc pentru contul tău.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Abordarea noastră</p>
        <h2>Creștere legitimă,<br />rezultate durabile.</h2>
        <p>Scurtăturile duc la suspendarea conturilor. Construim audiențe reale care rămân — spectatori care revin, dau tips și devin fani loiali.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">01</span>
          <h3>Audit & Strategie</h3>
          <p>Analizăm profilul tău actual, programul de streaming și datele de audiență pentru a identifica îmbunătățirile cu cel mai mare impact.</p>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <h3>Optimizare Platformă</h3>
          <p>Profil, tag-uri, categorie și optimizare previzualizare — pentru a apărea în căutările corecte și a converti vizitatorii în spectatori.</p>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <h3>Dezvoltare Audiență</h3>
          <p>Prezență socială off-platform, strategie de programare și tehnici de engagement care construiesc o bază de fani loiali.</p>
        </div>
        <div class="step">
          <span class="step-num">04</span>
          <h3>Măsurare & Iterare</h3>
          <p>Revizuire regulată a performanței cu metrici reale — retenție spectatori, rată de revenire, creștere venituri.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Resurse gratuite</p>
        <h2>Înțelege jocul<br />înainte să-l joci.</h2>
      </div>
      <div class="cards-grid-3">
        <a href="/ro/why-low-viewers-webcam" class="card resource-card">
          <h3>De ce camera ta are puțini spectatori</h3>
          <p>8 motive rezolvabile pentru care modelele au probleme cu vizibilitatea — și ce să faci în fiecare caz.</p>
          <span class="card-link">Citește <span aria-hidden="true">→</span></span>
        </a>
        <a href="/ro/how-cam-algorithm-ranks-rooms" class="card resource-card">
          <h3>Cum algoritmul cam clasifică camerele</h3>
          <p>Ce semnale cântăresc platformele și cum să lucrezi cu algoritmul, nu împotriva lui.</p>
          <span class="card-link">Citește <span aria-hidden="true">→</span></span>
        </a>
        <a href="/ro/best-streaming-times-by-region" class="card resource-card">
          <h3>Cele mai bune ore de streaming pe regiune</h3>
          <p>Orele de vârf pentru SUA, Germania, Marea Britanie, Europa de Est și altele.</p>
          <span class="card-link">Citește <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Platforme</p>
        <h2>Toate platformele webcam majore.<br />O singură echipă.</h2>
        <p>EWO lucrează cu modele și studiouri pe toate platformele webcam de top — indiferent unde transmiți, cunoaștem algoritmii, regulile și ce determină creșterea reală acolo.</p>
      </div>
      <div class="platforms-grid">
        <div class="platform-card"><span class="platform-rank">#1</span><div class="platform-info"><strong>Chaturbate</strong><span>Cea mai mare platformă cam gratuită la nivel global. Model bazat pe tips, trafic organic masiv.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#2</span><div class="platform-info"><strong>Stripchat</strong><span>Platformă cu creștere rapidă cu camere VR și sistem de tokeni. Bază puternică în UE și SUA.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#3</span><div class="platform-info"><strong>BongaCams</strong><span>Dominantă în Europa de Est, în creștere la nivel mondial. Volum mare de tips de la spectatori fideli.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#4</span><div class="platform-info"><strong>LiveJasmin</strong><span>Platformă premium de show-uri private. Membri cu cheltuieli mari, standarde de calitate stricte.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#5</span><div class="platform-info"><strong>MyFreeCams</strong><span>Focalizată pe SUA, exclusiv pentru femei. Cultură comunitară puternică și spectatori loiali.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#6</span><div class="platform-info"><strong>Cam4</strong><span>Audiență globală, politică de conținut inclusivă. Bazată pe tokeni cu comunitate LGBTQ+ puternică.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#7</span><div class="platform-info"><strong>CamSoda</strong><span>Trafic puternic din SUA cu instrumente bune de descoperire — ideal pentru modele noi.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#8</span><div class="platform-info"><strong>Flirt4Free</strong><span>Model premium privat cu unele dintre cele mai mari rate de plată din industrie.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#9</span><div class="platform-info"><strong>xLoveCam</strong><span>Focalizată pe Europa. Audiențe puternice francofone și hispanofone, prezență crescândă în UK.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#10</span><div class="platform-info"><strong>ImLive</strong><span>Focus pe show-uri private cu programe de loialitate. Câștiguri consistente pentru modele.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#11</span><div class="platform-info"><strong>Streamate</strong><span>Model de abonament și plată pe minut. Trafic stabil din SUA pentru programe regulate.</span></div></div>
        <div class="platform-card"><span class="platform-rank">#12</span><div class="platform-info"><strong>Cams.com</strong><span>Platformă de nișă cu funcții de fan club și abonamente club.</span></div></div>
      </div>
      <p class="platforms-note">Nu-ți vezi platforma? <a href="/ro/contact">Contactează-ne</a> — lucrăm cu toate platformele majore de live streaming.</p>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Gata să crești?</h2>
      <p>Spune-ne unde ești și unde vrei să ajungi. Vom construi planul.</p>
      <div class="cta-actions">
        <a href="/ro/contact" class="btn btn-primary">Contactează-ne</a>
        <a href="/ro/platforms-we-work-with" class="btn btn-ghost">Platforme</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero{padding-block:clamp(5rem,12vw,9rem)}.hero-eyebrow{margin-bottom:1.75rem}.badge{display:inline-block;font-family:var(--font-heading);font-size:.75rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);border:1px solid rgba(217,119,6,.3);background:var(--accent-dim);padding:.35rem .875rem;border-radius:100px}.hero-headline{font-size:clamp(3rem,7vw,5.5rem);font-weight:700;line-height:1.05;letter-spacing:-0.03em;margin-bottom:1.5rem}.hero-accent{font-style:normal;color:var(--accent)}.hero-sub{font-size:1.125rem;color:var(--fg-muted);max-width:46ch;line-height:1.7;margin-bottom:2.5rem}.hero-actions{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:4rem}.hero-stats{display:flex;align-items:center;gap:2rem;padding-top:2rem;border-top:1px solid var(--border);flex-wrap:wrap}.stat{display:flex;flex-direction:column;gap:.2rem}.stat-number{font-family:var(--font-heading);font-size:1.75rem;font-weight:700;color:var(--fg);line-height:1}.stat-label{font-size:.8rem;color:var(--fg-faint);letter-spacing:.04em}.stat-divider{width:1px;height:2.5rem;background:var(--border)}.section-header{margin-bottom:3.5rem;max-width:54ch}.eyebrow{font-family:var(--font-heading);font-size:.75rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:.75rem;max-width:none}.section-header h2{margin-bottom:1rem}.section-header p{font-size:1.0625rem}.cards-grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem}.service-card{display:flex;flex-direction:column;gap:1rem;text-decoration:none}.service-icon{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-md);background:var(--accent-dim);color:var(--accent);flex-shrink:0}.service-card h3{margin-top:.25rem}.card-link{font-family:var(--font-heading);font-size:.875rem;font-weight:600;color:var(--accent);margin-top:auto;display:inline-flex;align-items:center;gap:.35rem;transition:gap var(--transition)}.service-card:hover .card-link{gap:.6rem}.trust-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2rem}.trust-item{display:flex;flex-direction:column;gap:.5rem}.trust-num{font-family:var(--font-heading);font-size:3rem;font-weight:700;color:var(--accent);line-height:1;letter-spacing:-0.03em}.trust-item h3{margin-top:.25rem}.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2rem 3rem}.step{display:flex;flex-direction:column;gap:.75rem}.step-num{font-family:var(--font-heading);font-size:.8125rem;font-weight:600;letter-spacing:.1em;color:var(--accent)}.resource-card{display:flex;flex-direction:column;gap:.75rem;text-decoration:none}.resource-card h3{font-size:1.125rem}.resource-card:hover .card-link{gap:.6rem}.cta-band{background:var(--bg-raised);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding-block:clamp(4rem,8vw,6rem);text-align:center}.cta-band .container{display:flex;flex-direction:column;align-items:center;gap:1.25rem}.cta-band h2{font-size:clamp(2rem,4vw,3rem)}.cta-band p{max-width:40ch}.cta-actions{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;margin-top:.5rem}
  .platforms-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem}.platform-card{display:flex;align-items:flex-start;gap:1rem;background:var(--bg-raised);border:1px solid var(--border);border-radius:var(--radius-md);padding:1.25rem 1.5rem;transition:border-color var(--transition)}.platform-card:hover{border-color:rgba(217,119,6,.3)}.platform-rank{font-family:var(--font-heading);font-size:.75rem;font-weight:700;color:var(--accent);min-width:2.5rem;padding-top:.15rem;letter-spacing:.04em}.platform-info{display:flex;flex-direction:column;gap:.3rem}.platform-info strong{color:var(--fg);font-weight:600;font-size:1rem}.platform-info span{font-size:.875rem;color:var(--fg-muted);line-height:1.5;max-width:none}.platforms-note{margin-top:2rem;font-size:.9375rem;color:var(--fg-muted)}.platforms-note a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
</style>
