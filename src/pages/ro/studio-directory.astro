---
import Base from '@/layouts/Base.astro';
import { studioDirectory, countryNames, factLabels, experienceYearsUnit, payoutLabels, perkLabels, fullReviewLabel } from '@/data/studios';
const site = 'https://www.ewohub.com';
const slug = 'studio-directory';
const lang = 'ro';
---

<Base
  title="Catalog de Studiouri Webcam pe Țări"
  description="Un catalog verificat de studiouri webcam pe țări — doar adrese reale și site-uri active. Cere ajutorul suportului EWO pe Telegram pentru a alege studioul potrivit."
  lang={lang}
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>

  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag art-tag--blue">Catalog</span>
      </div>
      <h1 class="art-title">Catalog de Studiouri Webcam <span class="art-grad">pe Țări</span></h1>
      <p class="art-lead">
        O listă în continuă creștere de studiouri webcam pe care am reușit să le verificăm independent
        — o adresă reală, un site activ deținut chiar de studio, nu doar o listare pe agregatorul
        altcuiva. Organizat pe țări, se extinde în timp.
      </p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">

      <section class="section" style="margin-bottom:0;">
        <div style="position:relative;border-radius:20px;overflow:hidden;min-height:280px;box-shadow:0 12px 34px rgba(88,28,135,.28);">
          <img src="/images/studio-catalog-banner.png" alt="Not sure where to sign? Get matched with a top-rated studio" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 22%;display:block;" loading="lazy">
          <div style="position:absolute;inset:0;background:linear-gradient(90deg, rgba(10,6,20,.82) 0%, rgba(10,6,20,.55) 42%, rgba(10,6,20,.1) 75%);"></div>
          <div style="position:relative;min-height:280px;display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem;padding:2rem 2.25rem;">
            <div style="flex:1 1 320px;">
              <span style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.18);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.35rem .8rem;border-radius:999px;margin-bottom:.9rem;">✨ Potrivire Gratuită cu un Studio</span>
              <h2 style="font-size:1.5rem;font-weight:700;color:#fff;margin-bottom:.5rem;line-height:1.25;">Obține un contract cu un studio de top și câștigă de la $3000 în prima lună</h2>
              <p style="font-size:.9rem;color:rgba(255,255,255,.92);margin:0;line-height:1.6;max-width:520px;">Scrie-i EWO pe Telegram — te ajutăm să alegi cel mai bun studio pentru țara și obiectivele tale, gratuit.</p>
            </div>
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" style="flex-shrink:0;display:inline-flex;align-items:center;gap:.5rem;background:#fff;color:#7c3aed;font-weight:700;font-size:.92rem;padding:.8rem 1.5rem;border-radius:10px;white-space:nowrap;text-decoration:none;">Scrie pe Telegram →</a>
          </div>
        </div>
      </section>

      <p class="art-intro">
        Studiourile listate aici sunt adunate din surse publice — site-uri oficiale ale studiourilor,
        acoperire din industrie și pagini proprii ale studiourilor — și reflectă ce publică fiecare
        studio despre sine, nu o recomandare din partea EWO. Acoperirea începe acolo unde cultura de
        studio este cel mai ușor de verificat și se va extinde în timp.
      </p>

      <div style="display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:2rem;">
        {studioDirectory.map((entry) => (
          <a href={`#${entry.key}`} class="blog-filter-btn">{countryNames[entry.key][lang]}</a>
        ))}
      </div>

      {studioDirectory.map((entry) => (
        <section class="section" id={entry.key}>
          <h2>{countryNames[entry.key][lang]}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-top:1.25rem;">
            {entry.studios.map((s) => (
              <div class="glass-card">
                <h3 style="font-size:1.05rem;font-weight:700;margin-bottom:.25rem;"><a href={`/ro/studio-directory/${s.slug}`} style="color:var(--fg);text-decoration:none;">{s.name}</a></h3>
                <p style="font-size:.8rem;color:var(--fg-faint);margin-bottom:.625rem;">{s.city}</p>
                <p style="font-size:.875rem;color:var(--fg-muted);line-height:1.6;margin-bottom:.875rem;">{s.blurb[lang]}</p>
                {s.facts && (
                  <div style="font-size:.78rem;color:var(--fg-muted);line-height:1.9;margin-bottom:.75rem;">
                    {s.facts.earnings && <div><strong style="color:var(--fg);">{factLabels.earnings[lang]}:</strong> {s.facts.earnings}</div>}
                    {s.facts.experienceYears && <div><strong style="color:var(--fg);">{factLabels.experience[lang]}:</strong> {s.facts.experienceYears}+ {experienceYearsUnit[lang]}</div>}
                    {s.facts.rooms && <div><strong style="color:var(--fg);">{factLabels.rooms[lang]}:</strong> {s.facts.rooms}</div>}
                    {s.facts.models && <div><strong style="color:var(--fg);">{factLabels.models[lang]}:</strong> {s.facts.models}</div>}
                    {s.facts.platforms && <div><strong style="color:var(--fg);">{factLabels.platforms[lang]}:</strong> {s.facts.platforms.join(', ')}</div>}
                    {s.facts.payout && <div><strong style="color:var(--fg);">{factLabels.payout[lang]}:</strong> {payoutLabels[s.facts.payout][lang]}</div>}
                    {s.facts.locations && s.facts.locations.length > 1 && <div><strong style="color:var(--fg);">{factLabels.locations[lang]}:</strong> {s.facts.locations.join(', ')}</div>}
                  </div>
                )}
                {s.facts?.perks && s.facts.perks.length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:.875rem;">
                    {s.facts.perks.map((p) => (
                      <span style="font-size:.72rem;font-weight:600;background:rgba(0,0,0,0.05);border:1px solid rgba(0,0,0,0.1);color:var(--fg-muted);padding:.2rem .55rem;border-radius:999px;">{perkLabels[p][lang]}</span>
                    ))}
                  </div>
                )}
                <a href={`/ro/studio-directory/${s.slug}`} style="font-size:.85rem;font-weight:600;color:var(--fg);">{fullReviewLabel[lang]}</a>
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="section">
        <div class="highlight-box">
          <p>
            Înainte să semnezi cu orice studio — inclusiv cele listate aici — citește
            <a href="/ro/how-to-choose-a-webcam-studio">lista noastră de semnale de alarmă pentru
            studiouri</a>. Detaliile se schimbă des și sunt afirmațiile studioului, neverificate de EWO.
            Conduci un studio și vrei să fii listat, corectat sau eliminat?
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Contactează-ne pe Telegram</a>.
          </p>
        </div>
      </section>

      <section class="art-cta section">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Modele</span>
          <h2>Vrei o a doua opinie înainte să semnezi?</h2>
          <p>Spune-i echipei noastre de suport țara și situația ta — te ajutăm să evaluezi o ofertă de studio sau discutăm despre streaming independent cu EWO aducându-ți trafic.</p>
          <div class="art-cta__actions">
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" class="art-cta__btn art-cta__btn--primary">Vorbește cu Suportul →</a>
            <a href="/ro/how-to-choose-a-webcam-studio" class="art-cta__btn art-cta__btn--ghost">Citește lista de semnale de alarmă</a>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Articole Similare</h2>
        <div class="related-grid">
          <a href="/ro/how-to-choose-a-webcam-studio" class="related-card">
            <span class="related-card__icon">🚩</span>
            <span>Cum Alegi un Studio Webcam</span>
          </a>
          <a href="/ro/studio-scaling" class="related-card">
            <span class="related-card__icon">📈</span>
            <span>Extindere Studiouri</span>
          </a>
          <a href="/ro/studio-traffic" class="related-card">
            <span class="related-card__icon">🖥️</span>
            <span>Analiză Trafic pentru Studiouri</span>
          </a>
          <a href="/ro/webcam-model-income-guide" class="related-card">
            <span class="related-card__icon">💰</span>
            <span>Ghid de Venituri pentru Modele</span>
          </a>
          <a href="/ro/for-models" class="related-card">
            <span class="related-card__icon">🎯</span>
            <span>Lucrează ca Model cu EWO</span>
          </a>
        </div>
      </section>

    </div>
  </div>

</Base>
