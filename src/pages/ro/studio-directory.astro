---
import Base from '@/layouts/Base.astro';
import { studioDirectory, countryNames } from '@/data/studios';
const site = 'https://www.ewohub.com';
const slug = 'studio-directory';
const lang = 'ro';
---

<Base
  title="Catalog de Studiouri Webcam pe Țări"
  description="Un catalog verificat de studiouri webcam pe țări — doar adrese reale și site-uri active. Cere ajutorul suportului EWO pe Telegram pentru a alege studioul potrivit."
  lang={lang}
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>

  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag art-tag--blue">Catalog</span>
      </div>
      <h1 class="art-title">Catalog de Studiouri Webcam <span class="art-grad">pe Țări</span></h1>
      <p class="art-lead">
        O listă în continuă creștere de studiouri webcam pe care am reușit să le verificăm independent
        — o adresă reală, un site activ deținut chiar de studio, nu doar o listare pe agregatorul
        altcuiva. Organizat pe țări, se extinde în timp.
      </p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">

      <section class="section" style="margin-bottom:0;">
        <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" style="display:block;border-radius:20px;overflow:hidden;aspect-ratio:3.6/1;">
          <img src="/images/studio-catalog-banner.png" alt="Not sure where to sign? Get matched with a top-rated studio" style="width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block;" loading="lazy">
        </a>
      </section>

      <p class="art-intro">
        Studiourile listate aici sunt adunate din surse publice — site-uri oficiale ale studiourilor,
        acoperire din industrie și pagini proprii ale studiourilor — și reflectă ce publică fiecare
        studio despre sine, nu o recomandare din partea EWO. Acoperirea începe acolo unde cultura de
        studio este cel mai ușor de verificat și se va extinde în timp.
      </p>

      {studioDirectory.map((entry) => (
        <section class="section" id={entry.key}>
          <h2>{countryNames[entry.key][lang]}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-top:1.25rem;">
            {entry.studios.map((s) => (
              <div class="glass-card">
                <h3 style="font-size:1.05rem;font-weight:700;color:var(--fg);margin-bottom:.25rem;">{s.name}</h3>
                <p style="font-size:.8rem;color:var(--fg-faint);margin-bottom:.625rem;">{s.city}</p>
                <p style="font-size:.875rem;color:var(--fg-muted);line-height:1.6;margin-bottom:.875rem;">{s.blurb[lang]}</p>
                <a href={s.website} target="_blank" rel="noopener noreferrer nofollow" style="font-size:.85rem;font-weight:600;color:var(--fg);">Visit website →</a>
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="section">
        <div class="highlight-box">
          <p>
            Înainte să semnezi cu orice studio — inclusiv cele listate aici — citește
            <a href="/ro/how-to-choose-a-webcam-studio">lista noastră de semnale de alarmă pentru
            studiouri</a>. Detaliile se schimbă des și sunt afirmațiile studioului, neverificate de EWO.
            Conduci un studio și vrei să fii listat, corectat sau eliminat?
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Contactează-ne pe Telegram</a>.
          </p>
        </div>
      </section>

      <section class="art-cta section">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Modele</span>
          <h2>Vrei o a doua opinie înainte să semnezi?</h2>
          <p>Spune-i echipei noastre de suport țara și situația ta — te ajutăm să evaluezi o ofertă de studio sau discutăm despre streaming independent cu EWO aducându-ți trafic.</p>
          <div class="art-cta__actions">
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" class="art-cta__btn art-cta__btn--primary">Vorbește cu Suportul →</a>
            <a href="/ro/how-to-choose-a-webcam-studio" class="art-cta__btn art-cta__btn--ghost">Citește lista de semnale de alarmă</a>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Articole Similare</h2>
        <div class="related-grid">
          <a href="/ro/how-to-choose-a-webcam-studio" class="related-card">
            <span class="related-card__icon">🚩</span>
            <span>Cum Alegi un Studio Webcam</span>
          </a>
          <a href="/ro/studio-scaling" class="related-card">
            <span class="related-card__icon">📈</span>
            <span>Extindere Studiouri</span>
          </a>
          <a href="/ro/studio-traffic" class="related-card">
            <span class="related-card__icon">🖥️</span>
            <span>Analiză Trafic pentru Studiouri</span>
          </a>
          <a href="/ro/webcam-model-income-guide" class="related-card">
            <span class="related-card__icon">💰</span>
            <span>Ghid de Venituri pentru Modele</span>
          </a>
          <a href="/ro/for-models" class="related-card">
            <span class="related-card__icon">🎯</span>
            <span>Lucrează ca Model cu EWO</span>
          </a>
        </div>
      </section>

    </div>
  </div>

</Base>
