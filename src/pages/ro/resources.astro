---
import Base from '@/layouts/Base.astro';
const site = 'https://ewohub.com';
const slug = 'resources';

// Doar articolele cu category: 'guides' apar pe această pagină.
// Restul trăiește pe /blog — această pagină este exclusiv feed-ul curat de Ghiduri.
const articles = [
  {
    href: '/ro/stripchat-first-14-days-guide',
    title: 'Primele tale 14 zile pe Stripchat',
    desc: 'Pas cu pas: înregistrare, construirea profilului și cum să profiți la maximum de fereastra de vizibilitate "New" de 14 zile.',
    tag: 'Stripchat',
    category: 'guides',
  },
].filter(a => a.category === 'guides');

const filterAllLabel = 'Toate';
const tags = [...new Set(articles.map(a => a.tag))];
---
<Base
  title="Ghiduri — Ghiduri pas cu pas pentru modele webcam"
  description="Ghiduri practice, pas cu pas, pentru modele webcam — înregistrare, mecanica platformei și cum să începi corect."
  lang="ro"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Resurse gratuite</span>
      </div>
      <h1 class="art-title">Ghiduri <span class="art-grad">pas cu pas</span></h1>
      <p class="art-lead">Ghiduri practice, pas cu pas, pentru modele webcam — fără umplutură, fără upsell.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="blog-filter-bar" role="group" aria-label="Filter guides by category">
        <button class="blog-filter-btn is-active" data-filter="all">{filterAllLabel}</button>
        {tags.map(tag => (
          <button class="blog-filter-btn" data-filter={tag}>{tag}</button>
        ))}
      </div>
      <div class="related-grid" id="resources-grid">
        {articles.map(({ href, title, desc, tag }) => (
          <a href={href} class="glass-card" data-tag={tag} style="text-decoration:none;display:flex;flex-direction:column;gap:.625rem;">
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
            </div>
            <h3 style="font-size:1.1rem;font-weight:700;margin:0;">{title}</h3>
            <p style="margin:0;font-size:.9375rem;">{desc}</p>
            <span style="font-size:.875rem;font-weight:600;color:var(--accent);margin-top:auto;">Citește articolul →</span>
          </a>
        ))}
      </div>

      <section class="art-cta" style="margin-top:4rem;">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Cauți altceva?</span>
          <h2>Răsfoiește catalogul complet de articole</h2>
          <p>Analize de venituri, comparații de platforme, detalieri de algoritmi și multe altele — pe blog.</p>
          <div class="art-cta__actions">
            <a href="/ro/blog" class="art-cta__btn--primary btn btn-primary">Vezi blogul →</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  (function () {
    var buttons = document.querySelectorAll('.blog-filter-btn');
    var cards = document.querySelectorAll('#resources-grid .glass-card');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var filter = btn.dataset.filter;
        cards.forEach(function (card) {
          if (filter === 'all' || card.dataset.tag === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  })();
</script>

