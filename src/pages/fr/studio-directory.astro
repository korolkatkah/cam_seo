---
import Base from '@/layouts/Base.astro';
import { studioDirectory, countryNames } from '@/data/studios';
const site = 'https://www.ewohub.com';
const slug = 'studio-directory';
const lang = 'fr';
---

<Base
  title="Répertoire des Studios Webcam par Pays"
  description="Un répertoire vérifié de studios webcam par pays — uniquement des adresses réelles et des sites actifs. Laissez le support EWO vous aider à choisir le bon studio."
  lang={lang}
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>

  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag art-tag--blue">Répertoire</span>
      </div>
      <h1 class="art-title">Répertoire des Studios Webcam <span class="art-grad">par Pays</span></h1>
      <p class="art-lead">
        Une liste, en croissance continue, de studios webcam que nous avons pu vérifier de façon
        indépendante — une adresse réelle, un site actif appartenant au studio lui-même, pas seulement
        une fiche sur l'agrégateur de quelqu'un d'autre. Organisée par pays, elle s'étoffe avec le temps.
      </p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">

      <section class="section" style="margin-bottom:0;">
        <a href="/contact" style="display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem;text-decoration:none;border-radius:16px;padding:1.75rem 2rem;background:linear-gradient(135deg,#7c3aed,#ec4899 55%,#f59e0b);box-shadow:0 10px 30px rgba(124,58,237,.25);">
          <div style="flex:1 1 320px;">
            <p style="font-size:.75rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.85);margin-bottom:.5rem;">Not sure where to sign?</p>
            <h2 style="font-size:1.4rem;font-weight:700;color:#fff;margin-bottom:.5rem;">Get matched with a top-rated studio</h2>
            <p style="font-size:.9rem;color:rgba(255,255,255,.92);margin:0;line-height:1.6;">Talk to our support team — we'll help you pick the right studio for your country and goals, free of charge.</p>
          </div>
          <span style="flex-shrink:0;background:#fff;color:#7c3aed;font-weight:700;font-size:.9rem;padding:.75rem 1.5rem;border-radius:10px;white-space:nowrap;">Talk to Support →</span>
        </a>
      </section>

      <p class="art-intro">
        Les studios listés ici proviennent de sources publiques — sites officiels des studios,
        couverture du secteur et pages propres à chaque studio — et reflètent ce que chaque studio
        publie sur lui-même, pas une recommandation d'EWO. La couverture commence là où la culture de
        studio est la plus vérifiable et s'élargira avec le temps.
      </p>

      {studioDirectory.map((entry) => (
        <section class="section" id={entry.key}>
          <h2>{countryNames[entry.key][lang]}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-top:1.25rem;">
            {entry.studios.map((s) => (
              <div class="glass-card">
                <h3 style="font-size:1.05rem;font-weight:700;color:var(--fg);margin-bottom:.25rem;">{s.name}</h3>
                <p style="font-size:.8rem;color:var(--fg-faint);margin-bottom:.625rem;">{s.city}</p>
                <p style="font-size:.875rem;color:var(--fg-muted);line-height:1.6;margin-bottom:.875rem;">{s.blurb}</p>
                <a href={s.website} target="_blank" rel="noopener noreferrer nofollow" style="font-size:.85rem;font-weight:600;color:var(--fg);">Visit website →</a>
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="section">
        <div class="highlight-box">
          <p>
            Avant de signer avec un studio — y compris ceux listés ici — lisez notre
            <a href="/fr/how-to-choose-a-webcam-studio">liste de signaux d'alerte pour les studios</a>.
            Les détails changent souvent et reflètent les propres affirmations du studio, non vérifiées
            par EWO. Vous gérez un studio et souhaitez être listé, corrigé ou retiré ?
            <a href="/fr/contact">Contactez-nous</a>.
          </p>
        </div>
      </section>

      <section class="art-cta section">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Modèles</span>
          <h2>Besoin d'un second avis avant de signer ?</h2>
          <p>Indiquez à notre équipe support votre pays et votre situation — nous vous aiderons à évaluer une offre de studio, ou à envisager le streaming indépendant avec EWO qui vous apporte du trafic.</p>
          <div class="art-cta__actions">
            <a href="/fr/contact" class="art-cta__btn art-cta__btn--primary">Contacter le Support →</a>
            <a href="/fr/how-to-choose-a-webcam-studio" class="art-cta__btn art-cta__btn--ghost">Lire la liste des signaux d'alerte</a>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Articles Similaires</h2>
        <div class="related-grid">
          <a href="/fr/how-to-choose-a-webcam-studio" class="related-card">
            <span class="related-card__icon">🚩</span>
            <span>Comment Choisir un Studio Webcam</span>
          </a>
          <a href="/fr/studio-scaling" class="related-card">
            <span class="related-card__icon">📈</span>
            <span>Extension de Studio</span>
          </a>
          <a href="/fr/studio-traffic" class="related-card">
            <span class="related-card__icon">🖥️</span>
            <span>Analytique de Trafic pour Studios</span>
          </a>
          <a href="/fr/webcam-model-income-guide" class="related-card">
            <span class="related-card__icon">💰</span>
            <span>Guide des Revenus pour Modèles</span>
          </a>
          <a href="/fr/for-models" class="related-card">
            <span class="related-card__icon">🎯</span>
            <span>Travailler comme Modèle avec EWO</span>
          </a>
        </div>
      </section>

    </div>
  </div>

</Base>
