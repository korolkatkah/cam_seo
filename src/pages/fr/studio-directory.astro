---
import Base from '@/layouts/Base.astro';
import { studioDirectory, countryNames, factLabels, experienceYearsUnit, payoutLabels, perkLabels } from '@/data/studios';
const site = 'https://www.ewohub.com';
const slug = 'studio-directory';
const lang = 'fr';
---

<Base
  title="Catalogue des Studios Webcam par Pays"
  description="Un catalogue vérifié de studios webcam par pays — uniquement des adresses réelles et des sites actifs. Laissez le support EWO sur Telegram vous aider à choisir le bon studio."
  lang={lang}
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>

  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag art-tag--blue">Catalogue</span>
      </div>
      <h1 class="art-title">Catalogue des Studios Webcam <span class="art-grad">par Pays</span></h1>
      <p class="art-lead">
        Une liste, en croissance continue, de studios webcam que nous avons pu vérifier de façon
        indépendante — une adresse réelle, un site actif appartenant au studio lui-même, pas seulement
        une fiche sur l'agrégateur de quelqu'un d'autre. Organisée par pays, elle s'étoffe avec le temps.
      </p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">

      <section class="section" style="margin-bottom:0;">
        <div style="position:relative;border-radius:20px;overflow:hidden;min-height:280px;box-shadow:0 12px 34px rgba(88,28,135,.28);">
          <img src="/images/studio-catalog-banner.png" alt="Not sure where to sign? Get matched with a top-rated studio" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 22%;display:block;" loading="lazy">
          <div style="position:absolute;inset:0;background:linear-gradient(90deg, rgba(10,6,20,.82) 0%, rgba(10,6,20,.55) 42%, rgba(10,6,20,.1) 75%);"></div>
          <div style="position:relative;min-height:280px;display:flex;flex-wrap:wrap;align-items:center;gap:1.5rem;padding:2rem 2.25rem;">
            <div style="flex:1 1 320px;">
              <span style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.18);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:.35rem .8rem;border-radius:999px;margin-bottom:.9rem;">✨ Mise en Relation Studio Gratuite</span>
              <h2 style="font-size:1.5rem;font-weight:700;color:#fff;margin-bottom:.5rem;line-height:1.25;">Obtiens un contrat avec un studio top et gagne dès $3000 le premier mois</h2>
              <p style="font-size:.9rem;color:rgba(255,255,255,.92);margin:0;line-height:1.6;max-width:520px;">Écris à EWO sur Telegram — on t'aide à choisir le meilleur studio pour ton pays et tes objectifs, gratuitement.</p>
            </div>
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" style="flex-shrink:0;display:inline-flex;align-items:center;gap:.5rem;background:#fff;color:#7c3aed;font-weight:700;font-size:.92rem;padding:.8rem 1.5rem;border-radius:10px;white-space:nowrap;text-decoration:none;">Discuter sur Telegram →</a>
          </div>
        </div>
      </section>

      <p class="art-intro">
        Les studios listés ici proviennent de sources publiques — sites officiels des studios,
        couverture du secteur et pages propres à chaque studio — et reflètent ce que chaque studio
        publie sur lui-même, pas une recommandation d'EWO. La couverture commence là où la culture de
        studio est la plus vérifiable et s'élargira avec le temps.
      </p>

      {studioDirectory.map((entry) => (
        <section class="section" id={entry.key}>
          <h2>{countryNames[entry.key][lang]}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-top:1.25rem;">
            {entry.studios.map((s) => (
              <div class="glass-card">
                <h3 style="font-size:1.05rem;font-weight:700;margin-bottom:.25rem;"><a href={`/fr/studio-directory/${s.slug}`} style="color:var(--fg);text-decoration:none;">{s.name}</a></h3>
                <p style="font-size:.8rem;color:var(--fg-faint);margin-bottom:.625rem;">{s.city}</p>
                <p style="font-size:.875rem;color:var(--fg-muted);line-height:1.6;margin-bottom:.875rem;">{s.blurb[lang]}</p>
                {s.facts && (
                  <div style="font-size:.78rem;color:var(--fg-muted);line-height:1.9;margin-bottom:.75rem;">
                    {s.facts.earnings && <div><strong style="color:var(--fg);">{factLabels.earnings[lang]}:</strong> {s.facts.earnings}</div>}
                    {s.facts.experienceYears && <div><strong style="color:var(--fg);">{factLabels.experience[lang]}:</strong> {s.facts.experienceYears}+ {experienceYearsUnit[lang]}</div>}
                    {s.facts.rooms && <div><strong style="color:var(--fg);">{factLabels.rooms[lang]}:</strong> {s.facts.rooms}</div>}
                    {s.facts.models && <div><strong style="color:var(--fg);">{factLabels.models[lang]}:</strong> {s.facts.models}</div>}
                    {s.facts.platforms && <div><strong style="color:var(--fg);">{factLabels.platforms[lang]}:</strong> {s.facts.platforms.join(', ')}</div>}
                    {s.facts.payout && <div><strong style="color:var(--fg);">{factLabels.payout[lang]}:</strong> {payoutLabels[s.facts.payout][lang]}</div>}
                    {s.facts.locations && s.facts.locations.length > 1 && <div><strong style="color:var(--fg);">{factLabels.locations[lang]}:</strong> {s.facts.locations.join(', ')}</div>}
                  </div>
                )}
                {s.facts?.perks && s.facts.perks.length > 0 && (
                  <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:.875rem;">
                    {s.facts.perks.map((p) => (
                      <span style="font-size:.72rem;font-weight:600;background:rgba(0,0,0,0.05);border:1px solid rgba(0,0,0,0.1);color:var(--fg-muted);padding:.2rem .55rem;border-radius:999px;">{perkLabels[p][lang]}</span>
                    ))}
                  </div>
                )}
                <a href={s.website} target="_blank" rel="noopener noreferrer nofollow" style="font-size:.85rem;font-weight:600;color:var(--fg);">Visit website →</a>
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="section">
        <div class="highlight-box">
          <p>
            Avant de signer avec un studio — y compris ceux listés ici — lisez notre
            <a href="/fr/how-to-choose-a-webcam-studio">liste de signaux d'alerte pour les studios</a>.
            Les détails changent souvent et reflètent les propres affirmations du studio, non vérifiées
            par EWO. Vous gérez un studio et souhaitez être listé, corrigé ou retiré ?
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Contactez-nous sur Telegram</a>.
          </p>
        </div>
      </section>

      <section class="art-cta section">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Modèles</span>
          <h2>Besoin d'un second avis avant de signer ?</h2>
          <p>Indiquez à notre équipe support votre pays et votre situation — nous vous aiderons à évaluer une offre de studio, ou à envisager le streaming indépendant avec EWO qui vous apporte du trafic.</p>
          <div class="art-cta__actions">
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" class="art-cta__btn art-cta__btn--primary">Contacter le Support →</a>
            <a href="/fr/how-to-choose-a-webcam-studio" class="art-cta__btn art-cta__btn--ghost">Lire la liste des signaux d'alerte</a>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Articles Similaires</h2>
        <div class="related-grid">
          <a href="/fr/how-to-choose-a-webcam-studio" class="related-card">
            <span class="related-card__icon">🚩</span>
            <span>Comment Choisir un Studio Webcam</span>
          </a>
          <a href="/fr/studio-scaling" class="related-card">
            <span class="related-card__icon">📈</span>
            <span>Extension de Studio</span>
          </a>
          <a href="/fr/studio-traffic" class="related-card">
            <span class="related-card__icon">🖥️</span>
            <span>Analytique de Trafic pour Studios</span>
          </a>
          <a href="/fr/webcam-model-income-guide" class="related-card">
            <span class="related-card__icon">💰</span>
            <span>Guide des Revenus pour Modèles</span>
          </a>
          <a href="/fr/for-models" class="related-card">
            <span class="related-card__icon">🎯</span>
            <span>Travailler comme Modèle avec EWO</span>
          </a>
        </div>
      </section>

    </div>
  </div>

</Base>
