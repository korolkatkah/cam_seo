---
import Base from '@/layouts/Base.astro';
import LiveLookupTool from '@/components/LiveLookupTool.astro';
const site = 'https://www.ewohub.com';
const slug = 'live-model-lookup';
---
<Base
  title="Recherche de Modèles en Direct et Classement — Chaturbate et Stripchat"
  description="Recherche le statut en direct par nom d'utilisateur, compare deux modèles côte à côte, ou découvre qui a mené le trafic chaque heure aujourd'hui sur Chaturbate et Stripchat. Mis à jour automatiquement, sans connexion requise."
  lang="fr"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>
  <LiveLookupTool lang="fr" />
</Base>
