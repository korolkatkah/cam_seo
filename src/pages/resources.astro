---
import Base from '@/layouts/Base.astro';
const site = 'https://ewohub.com';
const slug = 'resources';

// Only articles tagged category: 'guides' appear on this page.
// Everything else lives on /blog — this page is the curated Guides feed only.
const articles = [
  {
    href: '/stripchat-first-14-days-guide',
    title: 'Your First 14 Days on Stripchat',
    desc: "Step-by-step: registration, profile setup, and how to make the most of the 14-day 'New' visibility window.",
    tag: 'Stripchat',
    category: 'guides',
  },
].filter(a => a.category === 'guides');
---

<Base
  title="Guides — Step-by-Step Webcam Model Guides"
  description="Practical, step-by-step guides for webcam models — registration, platform mechanics, and how to get started the right way."
  lang="en"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Free resources</span>
      </div>
      <h1 class="art-title">Step-by-Step <span class="art-grad">Guides</span></h1>
      <p class="art-lead">Practical, step-by-step guides for webcam models — no fluff, no upsell.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="related-grid">
        {articles.map(({ href, title, desc, tag }) => (
          <a href={href} class="glass-card" style="text-decoration:none;display:flex;flex-direction:column;gap:.625rem;">
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
            </div>
            <h3 style="font-size:1.1rem;font-weight:700;margin:0;">{title}</h3>
            <p style="margin:0;font-size:.9375rem;">{desc}</p>
            <span style="font-size:.875rem;font-weight:600;color:var(--accent);margin-top:auto;">Read article →</span>
          </a>
        ))}
      </div>

      <section class="art-cta" style="margin-top:4rem;">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Looking for Something Else?</span>
          <h2>Browse the Full Article Catalog</h2>
          <p>Income breakdowns, platform comparisons, algorithm deep-dives, and more live on the blog.</p>
          <div class="art-cta__actions">
            <a href="/blog" class="art-cta__btn--primary btn btn-primary">Visit the blog →</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>
