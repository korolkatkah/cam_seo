<Base
  title="Why Your Webcam Room Has Low Viewers — 8 Real Reasons (and Fixes)"
  description="Low viewer counts on cam platforms are frustrating but almost always fixable. Here are the 8 most common reasons webcam models get low viewers — and what to do about each one."
  lang="en"
  hreflang={[
    { lang: 'en', url: `${site}/why-low-viewers-webcam` },
    { lang: 'de', url: `${site}/de/why-low-viewers-webcam` },
    { lang: 'es', url: `${site}/es/why-low-viewers-webcam` },
    { lang: 'ro', url: `${site}/ro/why-low-viewers-webcam` },
    { lang: 'uk', url: `${site}/uk/why-low-viewers-webcam` },
    { lang: 'ru', url: `${site}/ru/why-low-viewers-webcam` },
