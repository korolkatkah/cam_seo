---
import Base from '@/layouts/Base.astro';
const site = 'https://www.ewohub.com';
const slug = 'contact';
---

<Base
  title="Contact EWO"
  description="Get in touch with EWO for a free profile audit and discussion of your audience growth goals."
  lang="en"
  hreflang={[
    { lang: 'en', url: `${site}/contact` },
    { lang: 'de', url: `${site}/de/contact` },
    { lang: 'es', url: `${site}/es/contact` },
    { lang: 'ro', url: `${site}/ro/contact` },
    { lang: 'uk', url: `${site}/uk/contact` },
    { lang: 'ru', url: `${site}/ru/contact` },
    { lang: 'fr', url: `${site}/fr/contact` },
    { lang: 'pt', url: `${site}/pt/contact` },
  ]}
>

<div class="art-hero">
  <div class="art-orb art-orb--1"></div>
  <div class="art-orb art-orb--2"></div>
  <div class="art-grid"></div>
  <div class="art-hero__inner container">
    <div class="art-meta">
      <span class="art-tag art-tag--green"><span class="dot-green"></span>Free Audit</span>
      <span class="art-tag">Response within 48h</span>
    </div>
    <h1 class="art-title">Get in <span class="art-grad">Touch</span></h1>
    <p class="art-lead">Tell us where you are and where you want to go. We'll review your current situation and put together a plan before we take you on as a client.</p>
  </div>
</div>

<div class="art-body">
  <div class="container">

    <div class="glass-card">
      <h2>What to Expect</h2>
      <ul>
        <li>Free profile audit — we review your current setup before any commitment</li>
        <li>Response within 48 hours</li>
        <li>No hard sell — if we can't genuinely help, we'll tell you</li>
      </ul>
    </div>

    <div class="glass-card">
      <h2>What to Include in Your Message</h2>
      <p>To give you a useful answer, it helps to know:</p>
      <ul>
        <li><strong>Current platform:</strong> Which platform are you streaming on right now? (Chaturbate, Stripchat, LiveJasmin, etc.)</li>
        <li><strong>Streaming hours:</strong> How many hours per week are you currently streaming?</li>
        <li><strong>Target market:</strong> Which region do you want to prioritize for traffic and viewers? (USA, Germany, UK, etc.)</li>
        <li><strong>Current situation:</strong> How long have you been active, and what does your current viewer count look like?</li>
        <li><strong>Goals:</strong> What do you want to achieve in the next 3–6 months?</li>
        <li><strong>For studios:</strong> How many models do you currently have, and which platforms are they promoting on?</li>
      </ul>
    </div>

    <div class="glass-card">
      <h2>Reach Out</h2>
      <p>Message us on Telegram: <a href="https://t.me/+tBjfmjh9vHo1YzQy" target="_blank" rel="noopener">t.me/+tBjfmjh9vHo1YzQy</a></p>
    </div>

    <div class="art-cta">
      <div class="art-cta__orb"></div>
      <div class="art-cta__inner">
        <div class="art-cta__badge">Ready?</div>
        <h2>Ready for the first step?</h2>
        <p>Message us now — the sooner you start, the sooner you'll see results.</p>
        <div class="art-cta__actions">
          <a href="https://t.me/+tBjfmjh9vHo1YzQy" target="_blank" rel="noopener" class="art-cta__btn art-cta__btn--primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 2L2 9l7 4 2 7 10-18z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Open Telegram →
          </a>
        </div>
      </div>
    </div>

    <section class="related-section">
      <h2>Related Articles</h2>
      <div class="related-grid">
        <a href="/model-promotion" class="related-card">
          <div class="related-card__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <p>Model Promotion Services</p>
          <span>Read →</span>
        </a>
        <a href="/studio-traffic" class="related-card">
          <div class="related-card__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
          <p>Studio Traffic</p>
          <span>Read →</span>
        </a>
        <a href="/new-model-growth" class="related-card">
          <div class="related-card__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <p>New Model Growth</p>
          <span>Read →</span>
        </a>
        <a href="/studio-scaling" class="related-card">
          <div class="related-card__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
          <p>Studio Scaling</p>
          <span>Read →</span>
        </a>
        <a href="/about" class="related-card">
          <div class="related-card__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
          <p>About EWO</p>
          <span>Read →</span>
        </a>
        <a href="/platforms-we-work-with" class="related-card">
          <div class="related-card__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
          <p>Platforms We Work With</p>
          <span>Read →</span>
        </a>
      </div>
    </section>

  </div>
</div>

</Base>
