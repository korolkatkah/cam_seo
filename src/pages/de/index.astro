---
import Base from '@/layouts/Base.astro';
const site = 'https://ewo.cam';
---

<Base
  title="Globaler Webcam-Service — Traffic, Promotion, Management"
  description="EWO ist ein globaler Service für Webcam-Models und Studios. Traffic-Wachstum, Promotion und vollständiges Management. 1000+ Kunden, 10+ Jahre Erfahrung, 20+ Länder."
  lang="de"
  hreflang={[
    { lang: 'en', url: `${site}/` },
    { lang: 'de', url: `${site}/de` },
    { lang: 'es', url: `${site}/es` },
    { lang: 'ro', url: `${site}/ro` },
    { lang: 'uk', url: `${site}/uk` },
    { lang: 'ru', url: `${site}/ru` },
  ]}
>

  <section class="hero section">
    <div class="container">
      <div class="hero-eyebrow">
        <span class="badge">Globaler Webcam-Service</span>
      </div>
      <h1 class="hero-headline">
        Traffic. Promotion.<br />
        <em class="hero-accent">Management.</em>
      </h1>
      <p class="hero-sub">
        EWO ist ein globaler Service für Webcam-Models und Studios. Wir übernehmen Zielgruppen-Wachstum,
        Promotion und vollständiges Management — für unabhängige Models und Multi-Model-Studios weltweit.
      </p>
      <div class="hero-actions">
        <a href="/de/model-promotion" class="btn btn-primary">Für Models</a>
        <a href="/de/studio-traffic" class="btn btn-ghost">Für Studios</a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number">1000+</span>
          <span class="stat-label">Models & Studios</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">10+</span>
          <span class="stat-label">Jahre Erfahrung</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-number">20+</span>
          <span class="stat-label">Länder</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Was wir tun</p>
        <h2>Drei Services.<br />Ein globales Team.</h2>
        <p>Ob du gerade anfängst oder ein Studio skalierst — EWO hat eine Lösung für deine Phase.</p>
      </div>
      <div class="cards-grid-3">
        <a href="/de/studio-traffic" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Traffic-Wachstum</h3>
          <p>Zuschauer-Wachstumsstrategie für Models und Studios — Planung, regionales Targeting, Plattform-Optimierung.</p>
          <span class="card-link">Mehr erfahren <span aria-hidden="true">→</span></span>
        </a>
        <a href="/de/model-promotion" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <h3>Promotion</h3>
          <p>Profil-Optimierung, Off-Platform-Präsenz, Social-Wachstum und SEO für Cam-Profile.</p>
          <span class="card-link">Mehr erfahren <span aria-hidden="true">→</span></span>
        </a>
        <a href="/de/studio-scaling" class="card service-card">
          <div class="service-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <h3>Management</h3>
          <p>Vollständiges Management für Studios: Roster-Koordination, Compliance, Skalierungssysteme und Analytics.</p>
          <span class="card-link">Mehr erfahren <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Warum EWO</p>
        <h2>Ein Jahrzehnt Ergebnisse<br />in 20+ Märkten.</h2>
        <p>Wir sind in der Webcam-Branche tätig, seit bevor die meisten aktuellen Plattformen existierten. Diese Erfahrung schlägt sich direkt in funktionierenden Strategien nieder.</p>
      </div>
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-num">1000+</span>
          <h3>Models & Studios</h3>
          <p>Mehr als 1000 Models und Studios haben mit EWO zusammengearbeitet, um ihre Zielgruppen zu vergrößern.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">10+</span>
          <h3>Jahre Erfahrung</h3>
          <p>Über ein Jahrzehnt in der Webcam-Branche — wir wissen, was funktioniert und was Accounts sperren lässt.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">20+</span>
          <h3>Länder</h3>
          <p>Unsere Kunden streamen aus 20+ Ländern und erreichen Zuschauer auf allen wichtigen globalen Märkten.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">0</span>
          <h3>Fake-Zuschauer</h3>
          <p>Wir arbeiten ausschließlich mit legitimem Zielgruppen-Wachstum. Keine Bots, keine aufgeblähten Zahlen.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Unser Ansatz</p>
        <h2>Legitimes Wachstum,<br />nachhaltige Ergebnisse.</h2>
        <p>Abkürzungen führen zu Account-Sperren. Wir bauen echte Zielgruppen auf — Zuschauer, die zurückkehren, tippen und treue Fans werden.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">01</span>
          <h3>Audit & Strategie</h3>
          <p>Wir analysieren dein aktuelles Profil, Streaming-Zeitplan und Zielgruppendaten, um die wirkungsvollsten Verbesserungen zu identifizieren.</p>
        </div>
        <div class="step">
          <span class="step-num">02</span>
          <h3>Plattform-Optimierung</h3>
          <p>Profil, Tags, Kategorie und Vorschau-Optimierung — damit du in den richtigen Suchen erscheinst und Browser in Zuschauer verwandelst.</p>
        </div>
        <div class="step">
          <span class="step-num">03</span>
          <h3>Zielgruppen-Entwicklung</h3>
          <p>Off-Platform-Social-Präsenz, Scheduling-Strategie und Engagement-Techniken, die eine treue Fan-Basis aufbauen.</p>
        </div>
        <div class="step">
          <span class="step-num">04</span>
          <h3>Messen & Optimieren</h3>
          <p>Regelmäßige Performance-Überprüfung anhand echter Kennzahlen — Zuschauer-Retention, Rückkehrrate, Einkommenswachstum.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Kostenlose Ressourcen</p>
        <h2>Verstehe das Spiel<br />bevor du es spielst.</h2>
      </div>
      <div class="cards-grid-3">
        <a href="/de/why-low-viewers-webcam" class="card resource-card">
          <h3>Warum dein Raum wenige Zuschauer hat</h3>
          <p>8 behebbare Gründe, warum Models mit Sichtbarkeit kämpfen — und was dagegen zu tun ist.</p>
          <span class="card-link">Lesen <span aria-hidden="true">→</span></span>
        </a>
        <a href="/de/how-cam-algorithm-ranks-rooms" class="card resource-card">
          <h3>Wie Cam-Algorithmen Räume bewerten</h3>
          <p>Welche Signale Plattformen gewichten und wie man mit dem Algorithmus arbeitet, nicht dagegen.</p>
          <span class="card-link">Lesen <span aria-hidden="true">→</span></span>
        </a>
        <a href="/de/best-streaming-times-by-region" class="card resource-card">
          <h3>Beste Streaming-Zeiten nach Region</h3>
          <p>Spitzen-Zuschauerstunden für USA, Deutschland, UK, Osteuropa und mehr.</p>
          <span class="card-link">Lesen <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Bereit zu wachsen?</h2>
      <p>Sag uns, wo du bist und wo du hinwillst. Wir bauen den Plan.</p>
      <div class="cta-actions">
        <a href="/de/contact" class="btn btn-primary">Kontakt aufnehmen</a>
        <a href="/de/platforms-we-work-with" class="btn btn-ghost">Plattformen</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero { padding-block: clamp(5rem, 12vw, 9rem); }
  .hero-eyebrow { margin-bottom: 1.75rem; }
  .badge { display: inline-block; font-family: var(--font-heading); font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); border: 1px solid rgba(217,119,6,.3); background: var(--accent-dim); padding: .35rem .875rem; border-radius: 100px; }
  .hero-headline { font-size: clamp(3rem, 7vw, 5.5rem); font-weight: 700; line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 1.5rem; }
  .hero-accent { font-style: normal; color: var(--accent); }
  .hero-sub { font-size: 1.125rem; color: var(--fg-muted); max-width: 46ch; line-height: 1.7; margin-bottom: 2.5rem; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 4rem; }
  .hero-stats { display: flex; align-items: center; gap: 2rem; padding-top: 2rem; border-top: 1px solid var(--border); flex-wrap: wrap; }
  .stat { display: flex; flex-direction: column; gap: .2rem; }
  .stat-number { font-family: var(--font-heading); font-size: 1.75rem; font-weight: 700; color: var(--fg); line-height: 1; }
  .stat-label { font-size: .8rem; color: var(--fg-faint); letter-spacing: .04em; }
  .stat-divider { width: 1px; height: 2.5rem; background: var(--border); }
  .section-header { margin-bottom: 3.5rem; max-width: 54ch; }
  .eyebrow { font-family: var(--font-heading); font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .75rem; max-width: none; }
  .section-header h2 { margin-bottom: 1rem; }
  .section-header p { font-size: 1.0625rem; }
  .cards-grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
  .service-card { display: flex; flex-direction: column; gap: 1rem; text-decoration: none; }
  .service-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-md); background: var(--accent-dim); color: var(--accent); flex-shrink: 0; }
  .service-card h3 { margin-top: .25rem; }
  .card-link { font-family: var(--font-heading); font-size: .875rem; font-weight: 600; color: var(--accent); margin-top: auto; display: inline-flex; align-items: center; gap: .35rem; transition: gap var(--transition); }
  .service-card:hover .card-link { gap: .6rem; }
  .trust-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; }
  .trust-item { display: flex; flex-direction: column; gap: .5rem; }
  .trust-num { font-family: var(--font-heading); font-size: 3rem; font-weight: 700; color: var(--accent); line-height: 1; letter-spacing: -0.03em; }
  .trust-item h3 { margin-top: .25rem; }
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem 3rem; }
  .step { display: flex; flex-direction: column; gap: .75rem; }
  .step-num { font-family: var(--font-heading); font-size: .8125rem; font-weight: 600; letter-spacing: .1em; color: var(--accent); }
  .resource-card { display: flex; flex-direction: column; gap: .75rem; text-decoration: none; }
  .resource-card h3 { font-size: 1.125rem; }
  .resource-card:hover .card-link { gap: .6rem; }
  .cta-band { background: var(--bg-raised); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding-block: clamp(4rem, 8vw, 6rem); text-align: center; }
  .cta-band .container { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; }
  .cta-band h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .cta-band p { max-width: 40ch; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: .5rem; }
</style>
