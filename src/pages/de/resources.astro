---
import Base from '@/layouts/Base.astro';
const site = 'https://ewohub.com';
const slug = 'resources';

// Nur Artikel mit category: 'guides' erscheinen auf dieser Seite.
// Alles andere lebt auf /blog — diese Seite ist ausschließlich der kuratierte Guides-Feed.
const articles = [
  {
    href: '/de/stripchat-first-14-days-guide',
    title: 'Deine ersten 14 Tage auf Stripchat',
    desc: 'Schritt für Schritt: Registrierung, Profilaufbau und wie du das 14-tägige "New"-Sichtbarkeitsfenster optimal nutzt.',
    tag: 'Stripchat',
    category: 'guides',
  },
].filter(a => a.category === 'guides');
---
<Base
  title="Guides — Schritt-für-Schritt-Guides für Webcam-Models"
  description="Praktische, schrittweise Guides für Webcam-Models — Registrierung, Plattform-Mechanik und wie du richtig startest."
  lang="de"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Kostenlose Ressourcen</span>
      </div>
      <h1 class="art-title">Schritt-für-Schritt-<span class="art-grad">Guides</span></h1>
      <p class="art-lead">Praktische, schrittweise Guides für Webcam-Models — kein Schnickschnack, kein Upsell.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="related-grid">
        {articles.map(({ href, title, desc, tag }) => (
          <a href={href} class="glass-card" style="text-decoration:none;display:flex;flex-direction:column;gap:.625rem;">
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
            </div>
            <h3 style="font-size:1.1rem;font-weight:700;margin:0;">{title}</h3>
            <p style="margin:0;font-size:.9375rem;">{desc}</p>
            <span style="font-size:.875rem;font-weight:600;color:var(--accent);margin-top:auto;">Artikel lesen →</span>
          </a>
        ))}
      </div>

      <section class="art-cta" style="margin-top:4rem;">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Suchst du etwas anderes?</span>
          <h2>Den vollständigen Artikelkatalog durchsuchen</h2>
          <p>Einkommensanalysen, Plattformvergleiche, Algorithmus-Deep-Dives und mehr findest du im Blog.</p>
          <div class="art-cta__actions">
            <a href="/de/blog" class="art-cta__btn--primary btn btn-primary">Zum Blog →</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>
