---
import Base from '@/layouts/Base.astro';
import LiveLookupTool from '@/components/LiveLookupTool.astro';
const site = 'https://www.ewohub.com';
const slug = 'live-model-lookup';
---
<Base
  title="Heutige Bestenliste — Chaturbate & Stripchat"
  description="Sieh die Top-Räume heute und wer auf Chaturbate und Stripchat in jeder Stunde vorne lag. Automatisch aktualisiert, keine Anmeldung nötig."
  lang="de"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>
  <LiveLookupTool lang="de" />
</Base>
