    border-bottom: 1px solid var(--bg-subtle);
    white-space: nowrap;
  }
  .targets-table th {
    color: var(--fg-muted);
    font-weight: 600;
    background: var(--bg-raised);
  }
  .targets-table tr:last-child td { border-bottom: none; }
