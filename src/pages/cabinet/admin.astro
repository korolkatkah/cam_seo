---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Admin Panel | EWO"
  description="Assign Instagram outreach tasks to workers and review their reports."
  lang="en"
  noindex={true}
>

<div class="cabinet-wrap container">
  <div class="cabinet-header">
    <h1>Admin Panel</h1>
    <button id="logout-btn" class="ghost-btn">Log out</button>
  </div>

  <p id="denied" class="cabinet-error" hidden>Your account is not an admin.</p>

  <section id="admin-content" hidden>
    <div class="admin-tabs" role="tablist">
      <button class="admin-tab is-active" role="tab" data-tab="main" aria-selected="true">Main</button>
      <button class="admin-tab" role="tab" data-tab="tonplace" aria-selected="false">ton.place</button>
      <button class="admin-tab" role="tab" data-tab="onlyfans" aria-selected="false">OnlyFans</button>
      <button class="admin-tab" role="tab" data-tab="chaturbate" aria-selected="false">Chaturbate</button>
    </div>

    <div data-panel="main">
    <div class="glass-card assign-card">
      <div class="targets-header">
        <h2 class="section-title">Tracking links</h2>
        <button id="refresh-links-btn" class="ghost-btn">Refresh</button>
      </div>
      <p class="bulk-hint">One link per worker for the EWOMODELS mini-landing. Every visit and button click is counted under the worker whose link was opened.</p>
      <div class="targets-table-wrap links-table-wrap">
        <table class="targets-table">
          <thead>
            <tr>
              <th>Worker</th><th>Link</th><th class="num-h">Visits</th><th class="num-h">Agency</th><th class="num-h">Traffic</th><th class="num-h">Analytics</th><th class="num-h">Promo</th><th class="num-h">Photo</th><th class="num-h">Clicks</th><th>Last activity</th><th></th>
            </tr>
          </thead>
          <tbody id="links-body"></tbody>
        </table>
      </div>
      <form id="link-form" class="link-form">
        <label>
          Ref (in the link)
          <input type="text" id="link-ref" required minlength="2" maxlength="32" pattern="[a-zA-Z0-9_\-]{2,32}" placeholder="anna" />
        </label>
        <label>
          Worker name (optional)
          <input type="text" id="link-label" maxlength="255" placeholder="Anna K." />
        </label>
        <button type="submit">Create link</button>
      </form>
      <p id="link-error" class="cabinet-error" hidden></p>
      <p id="link-success" class="cabinet-success" hidden></p>
    </div>

    <div class="glass-card import-card">
      <h2>Instagram targets database</h2>
      <div class="progress" id="import-progress" hidden aria-hidden="true">
        <div class="progress__fill" id="import-progress-fill"></div>
      </div>
      <label class="category-field">
        Category to parse
        <input type="text" id="import-category" placeholder="https://ru.stripchat.com/girls/young" autocomplete="off" spellcheck="false" />
      </label>
      <p class="bulk-hint category-hint">Paste a Stripchat category link (girls, men or trans sections). Leave empty for the default: girls/young (Young 22+).</p>
      <p id="import-category-error" class="cabinet-error" hidden></p>
      <p class="import-status" id="import-status" role="status" aria-live="polite">Idle.</p>
      <div class="import-actions">
        <button id="run-import-btn" class="import-btn">Run import now</button>
        <button id="stop-import-btn" class="import-btn export-btn stop-btn" disabled title="Available while an import is running">Stop import</button>
      </div>

      <div class="schedule-block" style="margin-top:1rem;">
        <div class="schedule-fields">
          <label>
            Every
            <select id="schedule-interval">
              <option value="1">1 hour</option>
              <option value="2">2 hours</option>
              <option value="3">3 hours</option>
              <option value="4">4 hours</option>
              <option value="6">6 hours</option>
              <option value="8">8 hours</option>
              <option value="12">12 hours</option>
              <option value="24">24 hours</option>
            </select>
          </label>
          <label>
            Starting at (Kyiv)
            <select id="schedule-start"></select>
          </label>
        </div>
        <div class="schedule-row">
          <button id="schedule-toggle-btn" class="import-btn export-btn">Enable auto-import</button>
          <p class="import-status" id="schedule-status">Loading...</p>
        </div>
      </div>

      <p class="import-status" id="export-status" style="margin-top:1rem;">Idle.</p>
      <button id="run-export-btn" class="import-btn export-btn">Export to Google Sheet</button>
      <p id="export-link" class="import-status" hidden></p>
    </div>

    </div>

    <div data-panel="onlyfans" hidden>
    <div class="glass-card import-card">
      <div class="targets-header">
        <h2>Local agent</h2>
        <span id="ofa-badge" class="ofa-badge">...</span>
      </div>
      <p class="bulk-hint">OnlyFans blocks server IPs, so parsing and mailing run on your computer: the agent picks up the jobs you start here, sends the requests from your own IP with the cookies in <code>accounts/main.json</code>, and reports back. Start it with <code>of-panel/run_agent.bat</code>; jobs wait in the queue while it is off.</p>
      <p class="import-status" id="ofa-status">Loading...</p>
      <div class="import-actions">
        <button id="ofa-config-btn" class="import-btn export-btn">Download agent_config.json</button>
        <button id="ofa-legacy-btn" class="ghost-btn" hidden>Delete cookies saved on the server</button>
      </div>
      <p class="bulk-hint" style="margin-top:0.5rem;">Put the downloaded file next to <code>of_agent.py</code> (in <code>of-panel</code>). Downloading again issues a new key and the old file stops working.</p>
    </div>

    <div class="glass-card import-card">
      <h2>Parser</h2>
      <p class="bulk-hint">Collects creators from OnlyFans recommendations, walking from each found creator to the next, and saves them to the "onlyfans" sheet of the Google Sheet as it goes.</p>
      <div class="tp-options">
        <label class="category-field">
          New creators per run
          <input type="number" id="ofc-limit" min="1" max="5000" value="300" />
        </label>
      </div>
      <p class="import-status" id="ofc-run-status" role="status" aria-live="polite">Idle.</p>
      <div class="import-actions">
        <button id="ofc-run-btn" class="import-btn">Run parser</button>
        <button id="ofc-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop</button>
        <button id="ofc-sheet-btn" class="ghost-btn">Sync Google Sheet now</button>
      </div>
      <p class="import-status" id="ofc-sheet-status" style="margin-top:0.75rem;"></p>
    </div>

    <div class="glass-card import-card">
      <h2>Mailing</h2>
      <p class="bulk-hint">For each free creator (never paid ones): free subscribe, then a DM, from the saved OnlyFans session. A creator that already got a message is never messaged again; to keep someone out, write anything in their "message" cell in the "onlyfans" sheet. Stops by itself when OnlyFans says the daily limit is reached.</p>
      <label class="category-field">
        Message
        <textarea id="ofs-msg" rows="4" maxlength="4000" placeholder="Hi! ..."></textarea>
      </label>
      <div class="tp-options">
        <label class="category-field">
          Max recipients
          <input type="number" id="ofs-limit" min="1" max="500" value="20" />
        </label>
        <label class="category-field">
          Delay from, sec
          <input type="number" id="ofs-delay-min" min="5" max="900" value="20" />
        </label>
        <label class="category-field">
          Delay to, sec
          <input type="number" id="ofs-delay-max" min="5" max="900" value="60" />
        </label>
        <label class="tp-check"><input type="checkbox" id="ofs-retry" /> Retry failed</label>
      </div>
      <p class="import-status" id="ofs-status" role="status" aria-live="polite">Idle.</p>
      <div class="import-actions">
        <button id="ofs-preview-btn" class="import-btn export-btn">Check recipients</button>
        <button id="ofs-send-btn" class="import-btn">Start mailing</button>
        <button id="ofs-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop</button>
      </div>
      <div class="tp-auto">
        <label class="tp-switch"><input type="checkbox" id="ofs-auto-on" role="switch" /> <span>Auto mode: message new free creators automatically</span></label>
        <p class="bulk-hint">Checks after every parser run and every 30 minutes, with the text and delays above. Waits until the next day after OnlyFans' own daily limit.</p>
        <div class="tp-options">
          <label class="category-field">
            Max per day
            <input type="number" id="ofs-auto-daily" min="1" max="500" value="20" />
          </label>
        </div>
        <p class="import-status" id="ofs-auto-status">Loading...</p>
      </div>
    </div>

    <div class="glass-card import-card">
      <div class="targets-header">
        <h2>Local panel (browser)</h2>
        <button id="of-refresh-btn" class="ghost-btn">Refresh</button>
      </div>
      <p class="bulk-hint">Local panel on this computer (<code>of-panel/run_panel.bat</code>, port 8080). Status is read straight from it, so this block works only on the machine where the panel is running.</p>
      <p class="import-status" id="of-status" role="status" aria-live="polite">Checking...</p>
      <div class="targets-table-wrap" id="of-accounts-wrap" hidden>
        <table class="targets-table">
          <thead>
            <tr><th>Account</th><th>Cookies</th><th>Status</th><th class="num-h">Sent</th><th class="num-h">Errors</th><th></th></tr>
          </thead>
          <tbody id="of-accounts-body"></tbody>
        </table>
      </div>
      <div class="import-actions" style="margin-top:1rem;">
        <a id="of-open-btn" class="import-btn" href="http://localhost:8080" target="_blank" rel="noopener" style="text-decoration:none;">Open panel in new tab</a>
        <button id="of-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop all tasks</button>
        <a class="import-btn export-btn" href="http://localhost:8080/api/download-excel" style="text-decoration:none;">Download Excel</a>
      </div>
    </div>

    <div class="glass-card import-card">
      <h2>Models <span id="of-models-total" class="tp-total"></span></h2>
      <p class="bulk-hint">Models from the panel's database (<code>onlyfans_models.xlsx</code>): which accounts subscribed and whether a message was sent.</p>
      <p class="import-status" id="of-models-status">Loads when the panel is online.</p>
      <div class="targets-table-wrap" id="of-models-wrap" hidden>
        <table class="targets-table">
          <thead><tr><th>Model</th><th>Name</th><th>Subscribed by</th><th>Message</th></tr></thead>
          <tbody id="of-models-body"></tbody>
        </table>
      </div>
    </div>
    </div>

    <div data-panel="chaturbate" hidden>
      <div class="glass-card import-card">
        <h2>Parse online models</h2>
        <p class="bulk-hint">Collects models who are online on Chaturbate right now, through its public room list (no login needed). Known models are not duplicated, only their followers, viewers and tags are refreshed. Run it at different times of day to catch more models.</p>
        <div class="tp-options">
          <label class="category-field">
            Limit
            <input type="number" id="cb-limit" min="1" max="20000" value="1000" />
          </label>
          <label class="category-field">
            Gender
            <select id="cb-gender">
              <option value="">All</option><option value="f" selected>Female</option><option value="m">Male</option>
              <option value="c">Couple</option><option value="t">Trans</option>
            </select>
          </label>
          <label class="category-field">
            Keyword (optional)
            <input type="text" id="cb-query" maxlength="100" placeholder="latina" autocomplete="off" spellcheck="false" />
          </label>
        </div>
        <p class="import-status" id="cb-run-status" role="status" aria-live="polite">Idle.</p>
        <div class="import-actions">
          <button id="cb-run-btn" class="import-btn">Run parser</button>
          <button id="cb-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop</button>
        </div>
      </div>

      <div class="glass-card import-card">
        <h2>Models <span id="cb-total" class="tp-total"></span></h2>
        <div class="tp-options">
          <label class="category-field">
            Search
            <input type="text" id="cb-search" placeholder="name, country, tag" autocomplete="off" spellcheck="false" />
          </label>
          <label class="category-field">
            Gender
            <select id="cb-filter-gender">
              <option value="">All</option><option value="f">Female</option><option value="m">Male</option>
              <option value="c">Couple</option><option value="t">Trans</option>
            </select>
          </label>
          <button id="cb-csv-btn" class="import-btn export-btn">Download CSV</button>
        </div>
        <p class="import-status" id="cb-models-status">Loading...</p>
        <div class="targets-table-wrap" id="cb-models-wrap" hidden>
          <table class="targets-table">
            <thead><tr><th class="num-h">Rank</th><th>Model</th><th class="num-h">Viewers</th><th class="num-h">On air</th><th class="num-h">Followers</th><th>Gender</th><th class="num-h">Age</th><th>Country</th><th>Parsed</th></tr></thead>
            <tbody id="cb-models-body"></tbody>
          </table>
        </div>
        <div class="import-actions" style="margin-top:1rem;">
          <button id="cb-more-btn" class="ghost-btn" hidden>Show more</button>
        </div>
        <p class="bulk-hint">Rank is the model's place in Chaturbate's online list (sorted by popularity) at the moment of parsing, inside the gender/keyword filter the run used. Viewers and On air (hours:minutes since her stream started) are also taken at that moment. Latest parse is on top.</p>
      </div>

      <div class="glass-card import-card">
        <h2>Google Sheet</h2>
        <p class="bulk-hint">Everything the parser collects goes to the "chaturbate" sheet in the same Drive workbook as ton.place: updated during a run (at most once a minute) and right after it ends. Columns you add by hand are kept.</p>
        <div class="tp-sheet">
          <p class="import-status" id="cb-sheet-status">Loading...</p>
          <button id="cb-sheet-btn" class="ghost-btn">Sync Google Sheet now</button>
        </div>
      </div>
    </div>

    <div data-panel="tonplace" hidden>
      <div class="glass-card import-card">
        <h2>ton.place session</h2>
        <p class="bulk-hint">The parser calls the ton.place API as a logged-in user. Open ton.place in a browser where you are logged in, press F12, go to Console, run <code>localStorage.getItem('token')</code> and paste the result here (format <code>userId,token</code>). Paste a fresh one when the parser says the session expired.</p>
        <p class="import-status" id="tp-session-status">Loading...</p>
        <form id="tp-session-form" class="link-form">
          <label>
            Session token
            <input type="password" id="tp-session-input" required autocomplete="off" spellcheck="false" placeholder="1234567,abcdef..." />
          </label>
          <button type="submit">Save</button>
        </form>
        <p id="tp-session-error" class="cabinet-error" hidden></p>
      </div>

      <div class="glass-card import-card">
        <h2>Parse creators</h2>
        <p class="bulk-hint">Collects creator profiles from people search (newest first) and messenger suggestions. Already known profiles are not duplicated.</p>
        <div class="tp-options">
          <label class="category-field">
            Limit per source
            <input type="number" id="tp-limit" min="1" max="5000" value="500" />
          </label>
          <label class="tp-check"><input type="checkbox" id="tp-src-search" checked /> People search</label>
          <label class="tp-check"><input type="checkbox" id="tp-src-im" checked /> Messenger suggestions</label>
        </div>
        <p class="import-status" id="tp-run-status" role="status" aria-live="polite">Idle.</p>
        <div class="import-actions">
          <button id="tp-run-btn" class="import-btn">Run parser</button>
          <button id="tp-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop</button>
        </div>
        <div class="tp-auto">
          <label class="tp-switch"><input type="checkbox" id="tp-sched-on" role="switch" /> <span>Auto mode: run on a schedule</span></label>
          <div class="tp-options">
            <label class="category-field">
              Every
              <select id="tp-sched-every">
                <option value="1">1 hour</option><option value="2">2 hours</option><option value="3">3 hours</option>
                <option value="4">4 hours</option><option value="6">6 hours</option><option value="8">8 hours</option>
                <option value="12">12 hours</option><option value="24" selected>24 hours</option>
              </select>
            </label>
            <label class="category-field">
              Starting at (Kyiv)
              <select id="tp-sched-hour"></select>
            </label>
          </div>
          <p class="import-status" id="tp-sched-status">Loading...</p>
        </div>
      </div>

      <div class="glass-card import-card">
        <h2>Mailing</h2>
        <p class="bulk-hint">Sends a DM from the saved ton.place account to parsed profiles, newest first. A profile that already got a message is never messaged again.</p>
        <label class="category-field">
          Message
          <textarea id="tp-msg" rows="4" maxlength="4000" placeholder="Hi! ..."></textarea>
        </label>
        <div class="tp-ai">
          <label class="tp-check"><input type="checkbox" id="tp-randomize" /> Randomize with ChatGPT: every recipient gets a reworded copy</label>
          <button type="button" id="tp-variants-btn" class="ghost-btn">Show examples</button>
        </div>
        <p class="bulk-hint" id="tp-ai-hint" hidden></p>
        <ol class="tp-variants" id="tp-variants" hidden></ol>
        <div class="tp-options">
          <label class="category-field">
            Max recipients
            <input type="number" id="tp-send-limit" min="1" max="1000" value="50" />
          </label>
          <label class="category-field">
            Delay from, sec
            <input type="number" id="tp-delay-min" min="3" max="600" value="10" />
          </label>
          <label class="category-field">
            Delay to, sec
            <input type="number" id="tp-delay-max" min="3" max="600" value="30" />
          </label>
          <label class="category-field">
            Source
            <select id="tp-send-source">
              <option value="all">All</option>
              <option value="search">People search</option>
              <option value="im">Messenger suggestions</option>
            </select>
          </label>
          <label class="tp-check"><input type="checkbox" id="tp-retry-errors" /> Retry failed</label>
        </div>
        <p class="import-status" id="tp-send-status" role="status" aria-live="polite">Idle.</p>
        <div class="import-actions">
          <button id="tp-preview-btn" class="import-btn export-btn">Check recipients</button>
          <button id="tp-send-btn" class="import-btn">Start mailing</button>
          <button id="tp-send-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop</button>
          <button id="tp-reset-btn" class="import-btn export-btn stop-btn">Reset sent list</button>
        </div>
        <div class="tp-auto">
          <label class="tp-switch"><input type="checkbox" id="tp-auto-on" role="switch" /> <span>Auto mode: message new profiles automatically</span></label>
          <p class="bulk-hint">Checks for profiles nobody messaged yet after every parser run and every 15 minutes, and messages them with the text, delays and source above.</p>
          <div class="tp-options">
            <label class="category-field">
              Max per day
              <input type="number" id="tp-auto-daily" min="1" max="1000" value="50" />
            </label>
          </div>
          <p class="import-status" id="tp-auto-status">Loading...</p>
        </div>
      </div>

      <div class="glass-card import-card">
        <h2>Auto-reply</h2>
        <p class="bulk-hint">When someone the mailing wrote to answers, they get this second message once. Inbox is checked every 5 minutes; profiles marked by hand in the sheet are skipped.</p>
        <label class="category-field">
          Reply message
          <textarea id="tp-reply-msg" rows="4" maxlength="4000" placeholder="Thanks for the answer! ..."></textarea>
        </label>
        <div class="tp-ai">
          <label class="tp-check"><input type="checkbox" id="tp-reply-randomize" /> Randomize with ChatGPT</label>
        </div>
        <div class="tp-options">
          <label class="category-field">
            Delay from, sec
            <input type="number" id="tp-reply-delay-min" min="2" max="600" value="5" />
          </label>
          <label class="category-field">
            Delay to, sec
            <input type="number" id="tp-reply-delay-max" min="2" max="600" value="15" />
          </label>
        </div>
        <p class="import-status" id="tp-reply-status" role="status" aria-live="polite">Loading...</p>
        <div class="import-actions">
          <button id="tp-reply-save-btn" class="import-btn export-btn">Save</button>
          <button id="tp-reply-all-btn" class="import-btn">Reply to all now</button>
        </div>
        <div class="tp-auto">
          <label class="tp-switch"><input type="checkbox" id="tp-reply-on" role="switch" /> <span>Auto mode: check the inbox every 5 minutes and reply</span></label>
        </div>
      </div>

      <div class="glass-card import-card">
        <h2>Google Sheet <span id="tp-total" class="tp-total"></span></h2>
        <p class="bulk-hint">All parsed profiles live in the "tonplace" sheet, updated right after every parsed page and every sent message; each run is logged in the "tonplace_report" sheet. To keep someone out of the mailing, write anything in their "message" cell.</p>
        <div class="tp-sheet">
          <p class="import-status" id="tp-sheet-status">Loading...</p>
          <button id="tp-sheet-btn" class="ghost-btn">Sync Google Sheet now</button>
        </div>
      </div>

      <div class="glass-card import-card">
        <h2>Telegram report</h2>
        <p class="bulk-hint">Once a day the bot sends how many new models were parsed and how many messages were sent that day.</p>
        <label class="tp-switch"><input type="checkbox" id="tp-tg-on" role="switch" /> <span>Send the daily report</span></label>
        <div class="tp-options">
          <label class="category-field">
            Time (Kyiv)
            <select id="tp-tg-hour"></select>
          </label>
        </div>
        <p class="import-status" id="tp-tg-status">Loading...</p>
        <div class="import-actions">
          <button id="tp-tg-send-btn" class="import-btn export-btn">Send report now</button>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .cabinet-wrap {
    padding: 3rem 1.5rem;
    max-width: 780px;
  }
  .cabinet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .cabinet-header h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--fg);
    margin: 0;
  }
  .ghost-btn {
    font: inherit;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .ghost-btn:hover { color: var(--fg); }
  .cabinet-error { color: #c0392b; font-size: 0.85rem; }

  .admin-tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--bg-subtle);
    margin-bottom: 1.5rem;
  }
  .admin-tab {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1rem;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .admin-tab:hover { color: var(--fg); }
  .admin-tab.is-active { color: var(--fg); border-bottom-color: var(--accent); }
  .tp-options { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1rem; margin-bottom: 0.75rem; }
  .tp-options .category-field { margin: 0; max-width: 160px; }
  .tp-ai { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin: 0.25rem 0 0.75rem; }
  .tp-ai .tp-check { padding-bottom: 0; }
