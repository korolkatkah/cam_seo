---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Admin Panel | EWO"
  description="Assign Instagram outreach tasks to workers and review their reports."
  lang="en"
  noindex={true}
>

<div class="cabinet-wrap container">
  <div class="cabinet-header">
    <h1>Admin Panel</h1>
    <button id="logout-btn" class="ghost-btn">Log out</button>
  </div>

  <p id="denied" class="cabinet-error" hidden>Your account is not an admin.</p>

  <section id="admin-content" hidden>
    <div class="admin-tabs" role="tablist">
      <button class="admin-tab is-active" role="tab" data-tab="main" aria-selected="true">Main</button>
      <button class="admin-tab" role="tab" data-tab="tonplace" aria-selected="false">ton.place</button>
    </div>

    <div data-panel="main">
    <div class="glass-card assign-card">
      <div class="targets-header">
        <h2 class="section-title">Tracking links</h2>
        <button id="refresh-links-btn" class="ghost-btn">Refresh</button>
      </div>
      <p class="bulk-hint">One link per worker for the EWOMODELS mini-landing. Every visit and button click is counted under the worker whose link was opened.</p>
      <div class="targets-table-wrap links-table-wrap">
        <table class="targets-table">
          <thead>
            <tr>
              <th>Worker</th><th>Link</th><th class="num-h">Visits</th><th class="num-h">Agency</th><th class="num-h">Traffic</th><th class="num-h">Analytics</th><th class="num-h">Promo</th><th class="num-h">Photo</th><th class="num-h">Clicks</th><th>Last activity</th><th></th>
            </tr>
          </thead>
          <tbody id="links-body"></tbody>
        </table>
      </div>
      <form id="link-form" class="link-form">
        <label>
          Ref (in the link)
          <input type="text" id="link-ref" required minlength="2" maxlength="32" pattern="[a-zA-Z0-9_\-]{2,32}" placeholder="anna" />
        </label>
        <label>
          Worker name (optional)
          <input type="text" id="link-label" maxlength="255" placeholder="Anna K." />
        </label>
        <button type="submit">Create link</button>
      </form>
      <p id="link-error" class="cabinet-error" hidden></p>
      <p id="link-success" class="cabinet-success" hidden></p>
    </div>

    <div class="glass-card import-card">
      <h2>Instagram targets database</h2>
      <div class="progress" id="import-progress" hidden aria-hidden="true">
        <div class="progress__fill" id="import-progress-fill"></div>
      </div>
      <label class="category-field">
        Category to parse
        <input type="text" id="import-category" placeholder="https://ru.stripchat.com/girls/young" autocomplete="off" spellcheck="false" />
      </label>
      <p class="bulk-hint category-hint">Paste a Stripchat category link (girls, men or trans sections). Leave empty for the default: girls/young (Young 22+).</p>
      <p id="import-category-error" class="cabinet-error" hidden></p>
      <p class="import-status" id="import-status" role="status" aria-live="polite">Idle.</p>
      <div class="import-actions">
        <button id="run-import-btn" class="import-btn">Run import now</button>
        <button id="stop-import-btn" class="import-btn export-btn stop-btn" disabled title="Available while an import is running">Stop import</button>
      </div>

      <div class="schedule-row" style="margin-top:1rem;">
        <button id="schedule-toggle-btn" class="import-btn export-btn">Enable daily auto-import</button>
        <p class="import-status" id="schedule-status">Loading...</p>
      </div>

      <p class="import-status" id="export-status" style="margin-top:1rem;">Idle.</p>
      <button id="run-export-btn" class="import-btn export-btn">Export to Google Sheet</button>
      <p id="export-link" class="import-status" hidden></p>
    </div>

    <div class="glass-card import-card">
      <div class="targets-header">
        <h2>OnlyFans panel</h2>
        <button id="of-refresh-btn" class="ghost-btn">Refresh</button>
      </div>
      <p class="bulk-hint">Local panel on this computer (<code>of-panel/run_panel.bat</code>, port 8080). Status is read straight from it, so this block works only on the machine where the panel is running.</p>
      <p class="import-status" id="of-status" role="status" aria-live="polite">Checking...</p>
      <div class="targets-table-wrap" id="of-accounts-wrap" hidden>
        <table class="targets-table">
          <thead>
            <tr><th>Account</th><th>Cookies</th><th>Status</th><th class="num-h">Sent</th><th class="num-h">Errors</th><th></th></tr>
          </thead>
          <tbody id="of-accounts-body"></tbody>
        </table>
      </div>
      <div class="import-actions" style="margin-top:1rem;">
        <a id="of-open-btn" class="import-btn" href="http://localhost:8080" target="_blank" rel="noopener" style="text-decoration:none;">Open panel in new tab</a>
        <button id="of-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop all tasks</button>
      </div>
    </div>
    </div>

    <div data-panel="tonplace" hidden>
      <div class="glass-card import-card">
        <h2>ton.place session</h2>
        <p class="bulk-hint">The parser calls the ton.place API as a logged-in user. Open ton.place in a browser where you are logged in, press F12, go to Console, run <code>localStorage.getItem('token')</code> and paste the result here (format <code>userId,token</code>). Paste a fresh one when the parser says the session expired.</p>
        <p class="import-status" id="tp-session-status">Loading...</p>
        <form id="tp-session-form" class="link-form">
          <label>
            Session token
            <input type="password" id="tp-session-input" required autocomplete="off" spellcheck="false" placeholder="1234567,abcdef..." />
          </label>
          <button type="submit">Save</button>
        </form>
        <p id="tp-session-error" class="cabinet-error" hidden></p>
      </div>

      <div class="glass-card import-card">
        <h2>Parse creators</h2>
        <p class="bulk-hint">Collects creator profiles from people search (newest first) and messenger suggestions. Already known profiles are not duplicated.</p>
        <div class="tp-options">
          <label class="category-field">
            Limit per source
            <input type="number" id="tp-limit" min="1" max="5000" value="500" />
          </label>
          <label class="tp-check"><input type="checkbox" id="tp-src-search" checked /> People search</label>
          <label class="tp-check"><input type="checkbox" id="tp-src-im" checked /> Messenger suggestions</label>
        </div>
        <p class="import-status" id="tp-run-status" role="status" aria-live="polite">Idle.</p>
        <div class="import-actions">
          <button id="tp-run-btn" class="import-btn">Run parser</button>
          <button id="tp-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop</button>
        </div>
        <div class="tp-auto">
          <label class="tp-switch"><input type="checkbox" id="tp-sched-on" role="switch" /> <span>Auto mode: run on a schedule</span></label>
          <div class="tp-options">
            <label class="category-field">
              Every
              <select id="tp-sched-every">
                <option value="1">1 hour</option><option value="2">2 hours</option><option value="3">3 hours</option>
                <option value="4">4 hours</option><option value="6">6 hours</option><option value="8">8 hours</option>
                <option value="12">12 hours</option><option value="24" selected>24 hours</option>
              </select>
            </label>
            <label class="category-field">
              Starting at (Kyiv)
              <select id="tp-sched-hour"></select>
            </label>
          </div>
          <p class="import-status" id="tp-sched-status">Loading...</p>
        </div>
      </div>

      <div class="glass-card import-card">
        <h2>Mailing</h2>
        <p class="bulk-hint">Sends a DM from the saved ton.place account to parsed profiles, newest first. A profile that already got a message is never messaged again.</p>
        <label class="category-field">
          Message
          <textarea id="tp-msg" rows="4" maxlength="4000" placeholder="Hi! ..."></textarea>
        </label>
        <div class="tp-options">
          <label class="category-field">
            Max recipients
            <input type="number" id="tp-send-limit" min="1" max="1000" value="50" />
          </label>
          <label class="category-field">
            Delay from, sec
            <input type="number" id="tp-delay-min" min="3" max="600" value="10" />
          </label>
          <label class="category-field">
            Delay to, sec
            <input type="number" id="tp-delay-max" min="3" max="600" value="30" />
          </label>
          <label class="category-field">
            Source
            <select id="tp-send-source">
              <option value="all">All</option>
              <option value="search">People search</option>
              <option value="im">Messenger suggestions</option>
            </select>
          </label>
          <label class="tp-check"><input type="checkbox" id="tp-retry-errors" /> Retry failed</label>
        </div>
        <p class="import-status" id="tp-send-status" role="status" aria-live="polite">Idle.</p>
        <div class="import-actions">
          <button id="tp-preview-btn" class="import-btn export-btn">Check recipients</button>
          <button id="tp-send-btn" class="import-btn">Start mailing</button>
          <button id="tp-send-stop-btn" class="import-btn export-btn stop-btn" disabled>Stop</button>
        </div>
        <div class="tp-auto">
          <label class="tp-switch"><input type="checkbox" id="tp-auto-on" role="switch" /> <span>Auto mode: message new profiles automatically</span></label>
          <p class="bulk-hint">Checks for profiles nobody messaged yet after every parser run and every 15 minutes, and messages them with the text, delays and source above.</p>
          <div class="tp-options">
            <label class="category-field">
              Max per day
              <input type="number" id="tp-auto-daily" min="1" max="1000" value="50" />
            </label>
          </div>
          <p class="import-status" id="tp-auto-status">Loading...</p>
        </div>
      </div>

      <div class="glass-card import-card">
        <h2>Google Sheet <span id="tp-total" class="tp-total"></span></h2>
        <p class="bulk-hint">All parsed profiles live in the "tonplace" sheet, updated right after every parsed page and every sent message; each run is logged in the "tonplace_report" sheet. To keep someone out of the mailing, write anything in their "message" cell.</p>
        <div class="tp-sheet">
          <p class="import-status" id="tp-sheet-status">Loading...</p>
          <button id="tp-sheet-btn" class="ghost-btn">Sync Google Sheet now</button>
        </div>
      </div>

      <div class="glass-card import-card">
        <h2>Telegram report</h2>
        <p class="bulk-hint">Once a day the bot sends how many new models were parsed and how many messages were sent that day.</p>
        <label class="tp-switch"><input type="checkbox" id="tp-tg-on" role="switch" /> <span>Send the daily report</span></label>
        <div class="tp-options">
          <label class="category-field">
            Time (Kyiv)
            <select id="tp-tg-hour"></select>
          </label>
        </div>
        <p class="import-status" id="tp-tg-status">Loading...</p>
        <div class="import-actions">
          <button id="tp-tg-send-btn" class="import-btn export-btn">Send report now</button>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .cabinet-wrap {
    padding: 3rem 1.5rem;
    max-width: 780px;
  }
  .cabinet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .cabinet-header h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--fg);
    margin: 0;
  }
  .ghost-btn {
    font: inherit;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .ghost-btn:hover { color: var(--fg); }
  .cabinet-error { color: #c0392b; font-size: 0.85rem; }

  .admin-tabs {
    display: flex;
    gap: 0.25rem;
    border-bottom: 1px solid var(--bg-subtle);
    margin-bottom: 1.5rem;
  }
  .admin-tab {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1rem;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .admin-tab:hover { color: var(--fg); }
  .admin-tab.is-active { color: var(--fg); border-bottom-color: var(--accent); }
  .tp-options { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1rem; margin-bottom: 0.75rem; }
  .tp-options .category-field { margin: 0; max-width: 160px; }
  .tp-check { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; color: var(--fg-muted); padding-bottom: 0.6rem; }
  .tp-total { font-size: 0.85rem; font-weight: 400; color: var(--fg-muted); }
  .category-field textarea,
  .category-field select {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
  }
  .category-field textarea { resize: vertical; min-height: 5rem; }
  :global(.tp-msg-sent) { color: #1e6b34; }
  .tp-auto {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--bg-subtle);
  }
  .tp-auto .import-status { margin: 0; }
  .tp-switch {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--fg);
    cursor: pointer;
    margin-bottom: 0.75rem;
  }
  .tp-switch input {
    appearance: none;
    width: 2.4rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--bg-subtle);
    position: relative;
    cursor: pointer;
    transition: background 0.2s;
    flex-shrink: 0;
    margin: 0;
  }
  .tp-switch input::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s;
  }
  .tp-switch input:checked { background: #1e6b34; }
  .tp-switch input:checked::after { transform: translateX(1.05rem); }
  .tp-switch input:disabled { opacity: 0.5; }
  .tp-sheet { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 0 0 1rem; }
  .tp-sheet .import-status { margin: 0; flex: 1 1 260px; }
  .tp-sheet .import-status a { color: var(--fg); }
  :global(.tp-msg-error) { color: #a12a2a; }
  .cabinet-success { color: #1e6b34; font-size: 0.85rem; }

  .assign-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .assign-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .assign-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .assign-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .assign-form input,
  .assign-form textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
    resize: vertical;
  }
  .assign-form button {
    align-self: flex-start;
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .assign-form button:hover { opacity: 0.85; }
  .bulk-hint {
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin: -0.5rem 0 0.9rem;
  }
  .links-table-wrap { margin-bottom: 1.25rem; }
  /* Rows are built in JS, so their selectors must be :global (Astro scopes styles to the template). */
  .targets-table th.num-h { text-align: right; }
  :global(.targets-table td.num) { text-align: right; font-variant-numeric: tabular-nums; }
  :global(.targets-table td.total) { font-weight: 700; color: var(--fg); }
  :global(.link-cell) { display: flex; align-items: center; gap: 0.5rem; }
  :global(.link-cell code) { font-size: 0.78rem; color: var(--fg-muted); white-space: nowrap; }
  :global(.copy-btn) {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  :global(.copy-btn:hover) { color: var(--fg); }
  .link-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.9rem;
  }
  .link-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    flex: 1 1 180px;
  }
  .link-form input {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
  }
  .link-form button {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .link-form button:hover { opacity: 0.85; }

  .import-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .import-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--fg);
  }
  .import-status {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin: 0 0 1rem;
  }
  .progress {
    height: 8px;
    border-radius: 999px;
    background: var(--bg-subtle);
    overflow: hidden;
    margin: 0 0 0.75rem;
  }
  .progress__fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--accent);
    transition: width 0.6s ease;
  }
  .progress__fill.is-indeterminate {
    width: 35%;
    animation: progress-slide 1.2s ease-in-out infinite alternate;
  }
  @keyframes progress-slide {
    from { margin-left: 0; }
    to { margin-left: 65%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .progress__fill.is-indeterminate { animation: none; margin-left: 0; width: 100%; opacity: 0.4; }
  }
  .import-btn {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .import-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .category-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-bottom: 0.4rem;
  }
  .category-field input {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
  }
  .category-field input:disabled { opacity: 0.6; }
  .category-hint { margin: 0 0 0.75rem; }
  .stop-btn { color: #a12a2a; border-color: rgba(161, 42, 42, 0.35); }
  .schedule-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .schedule-row .import-btn { margin: 0; }
  .schedule-row .import-status { margin: 0; }
  #schedule-toggle-btn.is-on { background: #1e6b34; color: #fff; border-color: transparent; }
  :global(.undo-btn) {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: #a12a2a;
    cursor: pointer;
  }
  .import-btn:hover { opacity: 0.85; }
  .import-btn:disabled { opacity: 0.5; cursor: default; }
  .export-btn {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--bg-subtle);
  }
  #export-link a { color: var(--fg); font-weight: 600; }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--fg);
    margin: 0 0 1rem;
  }
  .targets-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .targets-header .section-title { margin: 0; }
  .targets-table-wrap {
    overflow-x: auto;
    margin-bottom: 2.5rem;
    border: 1px solid var(--bg-subtle);
    border-radius: 12px;
  }
  .targets-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .targets-table th,
  .targets-table td {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--bg-subtle);
    white-space: nowrap;
  }
  .targets-table th {
    color: var(--fg-muted);
    font-weight: 600;
    background: var(--bg-raised);
  }
  .targets-table tr:last-child td { border-bottom: none; }
  .targets-table td.username { font-weight: 600; color: var(--fg); }
  .ig-link { color: var(--fg); font-weight: 600; text-decoration: none; }
  .ig-link:hover { text-decoration: underline; }
  .targets-table td.source a { color: var(--fg-muted); text-decoration: none; }
  .targets-table td.source a:hover { text-decoration: underline; }
</style>

</Base>

<script>
  const API_BASE = 'https://worker-cabinet-production.up.railway.app';
  const token = localStorage.getItem('cabinet_token');
  if (!token) {
    window.location.href = '/cabinet/login';
  }

  const deniedEl = document.getElementById('denied');
  const contentEl = document.getElementById('admin-content');

  document.getElementById('logout-btn').addEventListener('click', () => {
    localStorage.removeItem('cabinet_token');
    window.location.href = '/cabinet/login';
  });

  async function authedFetch(path, options = {}) {
    const res = await fetch(`${API_BASE}${path}`, {
      ...options,
      headers: { ...(options.headers || {}), Authorization: `Bearer ${token}` },
    });
    if (res.status === 401) {
      localStorage.removeItem('cabinet_token');
      window.location.href = '/cabinet/login';
      throw new Error('Session expired');
    }
    return res;
  }

  // --- Instagram targets database + manual import ---

  const importStatusEl = document.getElementById('import-status');
  const runImportBtn = document.getElementById('run-import-btn');
  const stopImportBtn = document.getElementById('stop-import-btn');
  const categoryInput = document.getElementById('import-category');
  const categoryErrorEl = document.getElementById('import-category-error');
  let pollTimer = null;

  try {
    categoryInput.value = localStorage.getItem('import_category') || '';
  } catch {}

  const progressEl = document.getElementById('import-progress');
  const progressFillEl = document.getElementById('import-progress-fill');
  let lastImportState = null;

  function fmtDuration(ms) {
    const total = Math.max(0, Math.round(ms / 1000));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const sec = total % 60;
    if (h) return `${h}h ${m}m`;
    if (m) return `${m}m ${String(sec).padStart(2, '0')}s`;
    return `${sec}s`;
  }

  function setProgress(pct) {
    progressEl.hidden = false;
    if (pct === null) {
      progressFillEl.classList.add('is-indeterminate');
      progressFillEl.style.width = '';
    } else {
      progressFillEl.classList.remove('is-indeterminate');
      progressFillEl.style.width = `${pct}%`;
    }
  }

  function renderImportStatus(state) {
    lastImportState = state;
    stopImportBtn.disabled = !state.running || !!state.stopping;
    stopImportBtn.textContent = state.stopping ? 'Stopping...' : 'Stop import';
    categoryInput.disabled = !!state.running;
    const categoryNote = state.category ? ` · category ${state.category}` : '';
    if (state.running) {
      const p = state.progress || {};
      const elapsed = state.last_started_at ? Date.now() - new Date(state.last_started_at).getTime() : 0;
      if (p.phase === 'checking_profiles' && p.total) {
        const pct = Math.round((p.checked / p.total) * 100);
        setProgress(pct);
        const eta = p.checked >= 10 ? ` · about ${fmtDuration((elapsed / p.checked) * (p.total - p.checked))} left` : '';
        const current = p.current ? ` · checking ${p.current}` : '';
        importStatusEl.textContent =
          `Importing${categoryNote}: ${p.checked} of ${p.total} profiles (${pct}%) · ${p.saved} new · ${p.skipped} skipped · ${fmtDuration(elapsed)} elapsed${eta}${current}`;
      } else if (p.phase === 'fetching_list') {
        setProgress(null);
        importStatusEl.textContent = `Importing${categoryNote}: fetching the model list (page ${p.page || 0} of ${p.pages || '?'}) · ${fmtDuration(elapsed)} elapsed`;
      } else {
        setProgress(null);
        importStatusEl.textContent = `Importing${categoryNote}: starting... · ${fmtDuration(elapsed)} elapsed`;
      }
      if (state.stopping) {
        importStatusEl.textContent = `Stopping after the current profile... ${importStatusEl.textContent}`;
      }
      return;
    }
    progressEl.hidden = true;
    if (state.last_result?.error) {
      importStatusEl.textContent = `Last run failed: ${state.last_result.error}`;
    } else if (state.last_result) {
      const { fetched = 0, saved = 0, skipped = 0, stopped = false } = state.last_result;
      const at = state.last_finished_at ? ` (finished ${new Date(state.last_finished_at).toLocaleString()})` : '';
      const verb = stopped ? 'stopped by you after' : 'checked';
      const lastCategory = state.last_result.category ? ` [${state.last_result.category}]` : '';
      importStatusEl.textContent = `Last run${at}${lastCategory}: ${verb} ${fetched} profiles, ${saved} new, ${skipped} skipped.`;
    } else {
      importStatusEl.textContent = 'Idle. No import has run since the server started.';
    }
  }

  // Keep the elapsed timer moving between the 4-second polls.
  setInterval(() => {
    if (lastImportState?.running) renderImportStatus(lastImportState);
  }, 1000);

  async function pollImportStatus() {
    const res = await authedFetch('/admin/import/status');
    if (!res.ok) return;
    const state = await res.json();
    renderImportStatus(state);
    runImportBtn.disabled = state.running;
    runImportBtn.textContent = state.running ? 'Running...' : 'Run import now';
    // The sheet is refreshed while the import runs, so show its progress too.
    await pollExportStatus();

    if (state.running) {
      if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
    } else if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  // --- Daily auto-import toggle ---

  const scheduleBtn = document.getElementById('schedule-toggle-btn');
  const scheduleStatusEl = document.getElementById('schedule-status');

  function renderSchedule(state) {
    scheduleBtn.classList.toggle('is-on', state.enabled);
    scheduleBtn.textContent = state.enabled ? 'Disable daily auto-import' : 'Enable daily auto-import';
    const time = `${String(state.hour).padStart(2, '0')}:${String(state.minute).padStart(2, '0')} ${state.timezone}`;
    if (state.enabled) {
      const next = state.next_run_at ? ` · next run ${new Date(state.next_run_at).toLocaleString()}` : '';
      scheduleStatusEl.textContent = `On, daily at ${time}${next}.`;
    } else {
      scheduleStatusEl.textContent = `Off. Would run daily at ${time}.`;
    }
  }

  async function loadSchedule() {
    const res = await authedFetch('/admin/schedule');
    if (!res.ok) return;
    renderSchedule(await res.json());
  }

  scheduleBtn.addEventListener('click', async () => {
    scheduleBtn.disabled = true;
    try {
      const wantEnabled = !scheduleBtn.classList.contains('is-on');
      const res = await authedFetch('/admin/schedule/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: wantEnabled }),
      });
      if (res.ok) renderSchedule(await res.json());
    } finally {
      scheduleBtn.disabled = false;
    }
  });

  runImportBtn.addEventListener('click', async () => {
    categoryErrorEl.hidden = true;
    const category = categoryInput.value.trim();
    try {
      localStorage.setItem('import_category', category);
    } catch {}

    runImportBtn.disabled = true;
    runImportBtn.textContent = 'Checking category...';
    try {
      const res = await authedFetch('/admin/import/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category: category || null }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok) {
        // A bad category is refused before anything starts: show why and let the admin fix it.
        categoryErrorEl.textContent = data?.detail || 'Could not start the import.';
        categoryErrorEl.hidden = false;
        runImportBtn.disabled = false;
        runImportBtn.textContent = 'Run import now';
        return;
      }
      renderImportStatus(data);
      runImportBtn.textContent = 'Running...';
      if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
    } catch (err) {
      categoryErrorEl.textContent = err instanceof Error ? err.message : 'Could not start the import.';
      categoryErrorEl.hidden = false;
      runImportBtn.disabled = false;
      runImportBtn.textContent = 'Run import now';
    }
  });

  stopImportBtn.addEventListener('click', async () => {
    if (!confirm('Stop the import? Accounts found so far are kept, the sheet is updated, and you can run it again later.')) return;
    stopImportBtn.disabled = true;
    stopImportBtn.textContent = 'Stopping...';
    try {
      const res = await authedFetch('/admin/import/stop', { method: 'POST' });
      if (res.ok) renderImportStatus(await res.json());
    } catch {
      stopImportBtn.disabled = false;
      stopImportBtn.textContent = 'Stop import';
    }
    if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
  });

  // --- Google Drive export ---

  const exportStatusEl = document.getElementById('export-status');
  const runExportBtn = document.getElementById('run-export-btn');
  const exportLinkEl = document.getElementById('export-link');
  let exportPollTimer = null;

  function formatExportStatus(state) {
    const rows = state.last_result?.rows;
    const last = state.last_result && !state.last_result.error
      ? ` Last update${state.last_finished_at ? ` ${new Date(state.last_finished_at).toLocaleTimeString()}` : ''}${rows != null ? `, ${rows} rows` : ''}${state.last_result.added ? ` (+${state.last_result.added} new)` : ''}${state.last_result.marked ? `, ${state.last_result.marked} marks updated` : ''}.`
      : '';
    if (state.running) return `Sheet: updating...${last}`;
    if (state.last_result?.error) return `Last export failed: ${state.last_result.error}`;
    if (state.last_result) return `Sheet up to date.${last}`;
    return 'Sheet: no export yet.';
  }

  async function pollExportStatus() {
    const res = await authedFetch('/admin/export/status');
    if (!res.ok) return;
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.disabled = state.running;
    runExportBtn.textContent = state.running ? 'Exporting...' : 'Export to Google Sheet';

    if (state.last_result?.web_view_link) {
      exportLinkEl.innerHTML = `<a href="${state.last_result.web_view_link}" target="_blank" rel="noopener">Open spreadsheet →</a>`;
      exportLinkEl.hidden = false;
    }

    if (state.running) {
      if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
    } else if (exportPollTimer) {
      clearInterval(exportPollTimer);
      exportPollTimer = null;
    }
  }

  runExportBtn.addEventListener('click', async () => {
    runExportBtn.disabled = true;
    const res = await authedFetch('/admin/export/run', { method: 'POST' });
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.textContent = 'Exporting...';
    if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
  });

  // --- Tracking links (per-worker /links?ref=... with click counters) ---

  const linksBody = document.getElementById('links-body');

  function textCell(text, className) {
    const td = document.createElement('td');
    if (className) td.className = className;
    td.textContent = text;
    return td;
  }

  async function loadLinks() {
    const res = await authedFetch('/admin/links');
    if (!res.ok) return;
    const data = await res.json();
    linksBody.innerHTML = '';
    for (const item of data.items) {
      const tr = document.createElement('tr');

      const nameTd = document.createElement('td');
      nameTd.className = 'username';
      nameTd.textContent = item.ref === 'direct' ? item.label : item.label ? `${item.label} (${item.ref})` : item.ref;

      const linkTd = document.createElement('td');
      const cell = document.createElement('div');
      cell.className = 'link-cell';
      const code = document.createElement('code');
      code.textContent = item.url.replace('https://', '');
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy-btn';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(item.url);
          copyBtn.textContent = 'Copied';
        } catch {
          copyBtn.textContent = 'Failed';
        }
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
      });
      cell.append(code, copyBtn);
      linkTd.appendChild(cell);

      const actionTd = document.createElement('td');
      if (item.ref !== 'direct') {
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'undo-btn';
        delBtn.textContent = 'Delete';
        delBtn.addEventListener('click', async () => {
          const stats = `${item.visits} visits and ${item.total_clicks} clicks`;
          if (!confirm(`Delete the link "${item.ref}"? Its statistics (${stats}) are deleted too. This cannot be undone.`)) return;
          delBtn.disabled = true;
          const r = await authedFetch(`/admin/links/${encodeURIComponent(item.ref)}`, { method: 'DELETE' });
          if (r.ok) await loadLinks();
          else delBtn.disabled = false;
        });
        actionTd.appendChild(delBtn);
      }

      const last = item.last_event_at ? new Date(item.last_event_at).toLocaleString() : '—';
      tr.append(
        nameTd,
        linkTd,
        textCell(item.visits, 'num'),
        textCell(item.clicks.agency, 'num'),
        textCell(item.clicks.traffic, 'num'),
        textCell(item.clicks.analytics, 'num'),
        textCell(item.clicks.promo ?? 0, 'num'),
        textCell(item.clicks.photo ?? 0, 'num'),
        textCell(item.total_clicks, 'num total'),
        textCell(last),
        actionTd,
      );
      linksBody.appendChild(tr);
    }
  }

  document.getElementById('refresh-links-btn').addEventListener('click', loadLinks);

  document.getElementById('link-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const linkError = document.getElementById('link-error');
    const linkSuccess = document.getElementById('link-success');
    linkError.hidden = true;
    linkSuccess.hidden = true;

    const ref = document.getElementById('link-ref').value;
    const label = document.getElementById('link-label').value || null;

    try {
      const res = await authedFetch('/admin/links', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ref, label }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(typeof data?.detail === 'string' ? data.detail : 'Failed to create link');
      }
      const created = await res.json();
      linkSuccess.textContent = `Created: ${created.url}`;
      linkSuccess.hidden = false;
      document.getElementById('link-form').reset();
      await loadLinks();
    } catch (err) {
      linkError.textContent = err instanceof Error ? err.message : 'Failed to create link';
      linkError.hidden = false;
    }
  });

  // --- OnlyFans panel (local FastAPI app on this machine) ---

  const OF_BASE = 'http://localhost:8080';
  const ofStatusEl = document.getElementById('of-status');
  const ofWrapEl = document.getElementById('of-accounts-wrap');
  const ofBodyEl = document.getElementById('of-accounts-body');
  const ofStopBtn = document.getElementById('of-stop-btn');
  let ofTimer = null;

  function ofCell(text, cls) {
    const td = document.createElement('td');
    if (cls) td.className = cls;
    td.textContent = text;
    return td;
  }

  async function loadOfPanel() {
    clearTimeout(ofTimer);
    try {
      const [accRes, statusRes] = await Promise.all([
        fetch(`${OF_BASE}/api/accounts`),
        fetch(`${OF_BASE}/api/status`),
      ]);
      const { accounts } = await accRes.json();
      const status = await statusRes.json();
      ofStatusEl.textContent = status.running
        ? `Online, task running: ${status.success} sent, ${status.errors} errors of ${status.total}.`
        : `Online, idle. ${accounts.length} account(s).`;
      ofStopBtn.disabled = !status.running;
      ofBodyEl.replaceChildren();
      for (const acc of accounts) {
        const p = acc.progress || {};
        const tr = document.createElement('tr');
        tr.append(
          ofCell(acc.name, 'username'),
          ofCell(acc.has_cookies ? `yes (${acc.cookie_count})` : 'no'),
          ofCell(p.status || 'idle'),
          ofCell(String(p.success ?? 0), 'num'),
          ofCell(String(p.errors ?? 0), 'num'),
        );
        const actionTd = document.createElement('td');
        const btn = document.createElement('button');
        btn.className = 'ghost-btn';
        btn.textContent = 'Open browser';
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            const r = await fetch(`${OF_BASE}/api/accounts/${encodeURIComponent(acc.id)}/open-browser`, { method: 'POST' });
            const data = await r.json();
            btn.textContent = data.ok ? 'Opened' : (data.error || 'Failed');
          } catch {
            btn.textContent = 'Failed';
          }
        });
        actionTd.append(btn);
        tr.append(actionTd);
        ofBodyEl.append(tr);
      }
      ofWrapEl.hidden = accounts.length === 0;
      ofTimer = setTimeout(loadOfPanel, status.running ? 5000 : 30000);
    } catch {
      ofStatusEl.textContent = 'Offline. Start of-panel/run_panel.bat on this computer, then press Refresh.';
      ofWrapEl.hidden = true;
      ofStopBtn.disabled = true;
    }
  }

  document.getElementById('of-refresh-btn').addEventListener('click', loadOfPanel);
  ofStopBtn.addEventListener('click', async () => {
    ofStopBtn.disabled = true;
    try {
      await fetch(`${OF_BASE}/api/stop`, { method: 'POST' });
    } catch {}
    loadOfPanel();
  });

  // --- Tabs ---

  const tabButtons = document.querySelectorAll('.admin-tab');
  const tabPanels = document.querySelectorAll('[data-panel]');
  let tonplaceLoaded = false;

  function showTab(name) {
    if (![...tabButtons].some((b) => b.dataset.tab === name)) name = 'main';
    tabButtons.forEach((b) => {
      const active = b.dataset.tab === name;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-selected', String(active));
    });
    tabPanels.forEach((p) => { p.hidden = p.dataset.panel !== name; });
    if (history.replaceState) history.replaceState(null, '', name === 'main' ? location.pathname : `#${name}`);
    if (name === 'tonplace' && !tonplaceLoaded) {
      tonplaceLoaded = true;
      loadTonplace();
    }
  }
  tabButtons.forEach((b) => b.addEventListener('click', () => showTab(b.dataset.tab)));

  // --- ton.place parser (runs on the worker-cabinet backend) ---

  const tpSessionStatus = document.getElementById('tp-session-status');
  const tpSessionForm = document.getElementById('tp-session-form');
  const tpSessionInput = document.getElementById('tp-session-input');
  const tpSessionError = document.getElementById('tp-session-error');
  const tpRunStatus = document.getElementById('tp-run-status');
  const tpRunBtn = document.getElementById('tp-run-btn');
  const tpStopBtn = document.getElementById('tp-stop-btn');
  const tpTotal = document.getElementById('tp-total');
  let tpPollTimer = null;
  let tpWasRunning = false;

  async function readError(res) {
    try {
      const data = await res.json();
      if (typeof data.detail === 'string') return data.detail;
      if (Array.isArray(data.detail)) return data.detail.map((d) => `${d.loc?.slice(-1)[0]}: ${d.msg}`).join('; ');
      return `HTTP ${res.status}`;
    } catch {
      return `HTTP ${res.status}`;
    }
  }

  function renderTpSession(s) {
    tpSessionStatus.textContent = s.configured
      ? `Session saved for ton.place user ${s.user_id}${s.saved_at ? `, ${new Date(s.saved_at).toLocaleString()}` : ''}.`
      : 'No session saved yet.';
  }

  async function loadTpSession() {
    const res = await authedFetch('/admin/tonplace/session');
    if (res.ok) renderTpSession(await res.json());
  }

  tpSessionForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    tpSessionError.hidden = true;
    const res = await authedFetch('/admin/tonplace/session', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ session: tpSessionInput.value.trim() }),
    });
    if (res.ok) {
      tpSessionInput.value = '';
      renderTpSession(await res.json());
    } else {
      tpSessionError.textContent = await readError(res);
      tpSessionError.hidden = false;
    }
  });

  function renderTpStatus(s) {
    const r = s.last_result;
    if (s.running) {
      const p = s.progress;
      const where = p && p.source
        ? `${p.source === 'im' ? 'messenger suggestions' : 'people search'}, page ${p.pages}, ${p.found} found, ${p.saved || 0} new saved`
        : 'starting';
      const by = s.trigger === 'schedule' ? ' (scheduled)' : '';
      tpRunStatus.textContent = s.stopping ? `Stopping... (${where})` : `Running${by}: ${where}.`;
    } else if (r && r.error) {
      tpRunStatus.textContent = `Last run failed: ${r.error}`;
    } else if (r) {
      const when = s.last_finished_at ? new Date(s.last_finished_at).toLocaleString() : '';
      tpRunStatus.textContent = `${r.stopped ? 'Stopped' : 'Done'} ${when}: ${r.found} found, ${r.added} new, ${r.updated} already known.`;
    } else {
      tpRunStatus.textContent = 'Idle.';
    }
    tpRunBtn.disabled = s.running;
    tpStopBtn.disabled = !s.running || s.stopping;
  }

  async function pollTpStatus() {
    clearTimeout(tpPollTimer);
    const res = await authedFetch('/admin/tonplace/status');
    if (!res.ok) return;
    const s = await res.json();
    renderTpStatus(s);
    if (s.running) {
      tpWasRunning = true;
      tpPollTimer = setTimeout(pollTpStatus, 2000);
    } else if (tpWasRunning) {
      tpWasRunning = false;
      loadTpProfiles();
      loadTpAuto().catch(() => {});
      pollTpSend().catch(() => {});
    } else if (tpSchedOn.checked) {
      // Scheduled runs start by themselves on the server: keep an eye on them.
      tpPollTimer = setTimeout(pollTpStatus, 30000);
    }
  }

  tpRunBtn.addEventListener('click', async () => {
    const sources = [];
    if (document.getElementById('tp-src-search').checked) sources.push('search');
    if (document.getElementById('tp-src-im').checked) sources.push('im');
    const limit = Math.max(1, Math.min(5000, parseInt(document.getElementById('tp-limit').value, 10) || 500));
    tpRunBtn.disabled = true;
    const res = await authedFetch('/admin/tonplace/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ limit, sources }),
    });
    if (!res.ok) {
      tpRunStatus.textContent = await readError(res);
      tpRunBtn.disabled = false;
      return;
    }
    renderTpStatus(await res.json());
    pollTpStatus();
  });

  tpStopBtn.addEventListener('click', async () => {
    tpStopBtn.disabled = true;
    await authedFetch('/admin/tonplace/stop', { method: 'POST' });
    pollTpStatus();
  });

  // Profile counts (the list itself lives in the Google Sheet)
  async function loadTpProfiles() {
    const res = await authedFetch('/admin/tonplace/profiles?limit=1');
    if (!res.ok) return;
    const data = await res.json();
    tpTotal.textContent = `(${data.all_total} profiles, ${data.sent_total} messaged)`;
  }

  // Mailing

  const tpSendStatus = document.getElementById('tp-send-status');
  const tpSendBtn = document.getElementById('tp-send-btn');
  const tpSendStopBtn = document.getElementById('tp-send-stop-btn');
  const tpPreviewBtn = document.getElementById('tp-preview-btn');
  const tpMsg = document.getElementById('tp-msg');
  let tpSendTimer = null;
  let tpSendWasRunning = false;

  try {
    tpMsg.value = localStorage.getItem('tp_message') || '';
  } catch {}
  tpMsg.addEventListener('input', () => {
    try { localStorage.setItem('tp_message', tpMsg.value); } catch {}
  });

  function tpSendPayload() {
    const num = (id, def) => parseFloat(document.getElementById(id).value) || def;
    return {
      message: tpMsg.value.trim(),
      limit: Math.round(num('tp-send-limit', 50)),
      delay_min: num('tp-delay-min', 10),
      delay_max: num('tp-delay-max', 30),
      source: document.getElementById('tp-send-source').value,
      retry_errors: document.getElementById('tp-retry-errors').checked,
    };
  }

  function renderTpSend(s) {
    const r = s.last_result;
    const p = s.progress;
    if (s.running && p) {
      const cur = p.current ? `, now @${p.current}` : '';
      const lastErr = p.last_error ? ` Last error: ${p.last_error}` : '';
      tpSendStatus.textContent = `${s.stopping ? 'Stopping' : s.trigger === 'auto' ? 'Auto-sending' : 'Sending'}: ${p.done} of ${p.total} (${p.sent} sent, ${p.errors} failed${cur}).${lastErr}`;
    } else if (r) {
      const when = s.last_finished_at ? new Date(s.last_finished_at).toLocaleString() : '';
      const head = r.error ? `Stopped with error: ${r.error}` : r.stopped ? 'Stopped' : 'Done';
      const skip = r.skipped ? `, ${r.skipped} skipped (already messaged)` : '';
      tpSendStatus.textContent = `${head} ${when}: ${r.sent} sent, ${r.errors} failed${skip} of ${r.total}.`;
    } else {
      tpSendStatus.textContent = 'Idle.';
    }
    tpSendBtn.disabled = s.running;
    tpPreviewBtn.disabled = s.running;
    tpSendStopBtn.disabled = !s.running || s.stopping;
  }

  async function pollTpSend() {
    clearTimeout(tpSendTimer);
    const res = await authedFetch('/admin/tonplace/send/status');
    if (!res.ok) return;
    const s = await res.json();
    renderTpSend(s);
    if (s.running) {
      tpSendWasRunning = true;
      tpSendTimer = setTimeout(pollTpSend, 3000);
    } else if (tpSendWasRunning) {
      tpSendWasRunning = false;
      loadTpProfiles();
      loadTpAuto().catch(() => {});
    } else if (tpAutoOn.checked) {
      // Auto-mailing can start by itself on the server: keep an eye on it.
      tpSendTimer = setTimeout(pollTpSend, 30000);
    }
  }

  tpPreviewBtn.addEventListener('click', async () => {
    const payload = tpSendPayload();
    if (!payload.message) payload.message = '-';
    const res = await authedFetch('/admin/tonplace/send/preview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      tpSendStatus.textContent = await readError(res);
      return;
    }
    const data = await res.json();
    const names = data.items.slice(0, 10).map((i) => `@${i.username}`).join(', ');
    tpSendStatus.textContent = data.count
      ? `Will message ${data.count} profile(s): ${names}${data.count > 10 ? ', ...' : ''}`
      : 'Nobody left to message with these settings.';
  });

  tpSendBtn.addEventListener('click', async () => {
    const payload = tpSendPayload();
    if (!payload.message) {
      tpSendStatus.textContent = 'Write the message first.';
      tpMsg.focus();
      return;
    }
    if (!confirm(`Send this message to up to ${payload.limit} ton.place profile(s)?`)) return;
    tpSendBtn.disabled = true;
    const res = await authedFetch('/admin/tonplace/send/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      tpSendStatus.textContent = await readError(res);
      tpSendBtn.disabled = false;
      return;
    }
    renderTpSend(await res.json());
    pollTpSend();
  });

  tpSendStopBtn.addEventListener('click', async () => {
    tpSendStopBtn.disabled = true;
    await authedFetch('/admin/tonplace/send/stop', { method: 'POST' });
    pollTpSend();
  });

  // Auto mode: parser schedule

  const tpSchedOn = document.getElementById('tp-sched-on');
  const tpSchedEvery = document.getElementById('tp-sched-every');
  const tpSchedHour = document.getElementById('tp-sched-hour');
  const tpSchedStatus = document.getElementById('tp-sched-status');
  for (let h = 0; h < 24; h++) {
    const o = document.createElement('option');
    o.value = String(h);
    o.textContent = `${String(h).padStart(2, '0')}:00`;
    tpSchedHour.append(o);
  }

  function renderTpSched(s) {
    tpSchedOn.checked = s.enabled;
    tpSchedEvery.value = String(s.every_hours);
    tpSchedHour.value = String(s.start_hour);
    tpSchedStatus.textContent = s.active && s.next_run_at
      ? `On. Next run ${new Date(s.next_run_at).toLocaleString()} (limit ${s.limit}, ${s.sources.join(' + ')}).`
      : 'Off.';
  }

  async function saveTpSched() {
    const sources = [];
    if (document.getElementById('tp-src-search').checked) sources.push('search');
    if (document.getElementById('tp-src-im').checked) sources.push('im');
    tpSchedOn.disabled = true;
    const res = await authedFetch('/admin/tonplace/schedule', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        enabled: tpSchedOn.checked,
        every_hours: parseInt(tpSchedEvery.value, 10),
        start_hour: parseInt(tpSchedHour.value, 10),
        limit: Math.max(1, Math.min(5000, parseInt(document.getElementById('tp-limit').value, 10) || 500)),
        sources,
      }),
    });
    tpSchedOn.disabled = false;
    if (res.ok) {
      renderTpSched(await res.json());
    } else {
      tpSchedStatus.textContent = await readError(res);
      tpSchedOn.checked = !tpSchedOn.checked;
    }
  }

  async function loadTpSched() {
    const res = await authedFetch('/admin/tonplace/schedule');
    if (res.ok) renderTpSched(await res.json());
  }

  tpSchedOn.addEventListener('change', saveTpSched);
  tpSchedEvery.addEventListener('change', () => { if (tpSchedOn.checked) saveTpSched(); });
  tpSchedHour.addEventListener('change', () => { if (tpSchedOn.checked) saveTpSched(); });

  // Auto mode: mailing

  const tpAutoOn = document.getElementById('tp-auto-on');
  const tpAutoDaily = document.getElementById('tp-auto-daily');
  const tpAutoStatus = document.getElementById('tp-auto-status');

  function renderTpAuto(a) {
    tpAutoOn.checked = a.enabled;
    tpAutoDaily.value = String(a.daily_limit);
    if (a.enabled) {
      if (a.message && !tpMsg.value.trim()) tpMsg.value = a.message;
      tpAutoStatus.textContent = `On. Sent today ${a.sent_today} of ${a.daily_limit}, ${a.waiting} new profile(s) waiting. Checks every ${a.check_every_minutes} min.`;
    } else {
      tpAutoStatus.textContent = `Off. ${a.waiting} profile(s) not messaged yet.`;
    }
  }

  async function saveTpAuto() {
    const p = tpSendPayload();
    tpAutoOn.disabled = true;
    const res = await authedFetch('/admin/tonplace/auto-send', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        enabled: tpAutoOn.checked,
        message: p.message,
        daily_limit: Math.max(1, Math.min(1000, parseInt(tpAutoDaily.value, 10) || 50)),
        delay_min: p.delay_min,
        delay_max: p.delay_max,
        source: p.source,
      }),
    });
    tpAutoOn.disabled = false;
    if (res.ok) {
      renderTpAuto(await res.json());
      if (tpAutoOn.checked) setTimeout(pollTpSend, 1500);
    } else {
      tpAutoStatus.textContent = await readError(res);
      tpAutoOn.checked = !tpAutoOn.checked;
    }
  }

  async function loadTpAuto() {
    const res = await authedFetch('/admin/tonplace/auto-send');
    if (res.ok) renderTpAuto(await res.json());
  }

  tpAutoOn.addEventListener('change', () => {
    if (tpAutoOn.checked && !confirm('Turn on auto-mailing? New profiles will be messaged automatically with the text above.')) {
      tpAutoOn.checked = false;
      return;
    }
    saveTpAuto();
  });
  tpAutoDaily.addEventListener('change', () => { if (tpAutoOn.checked) saveTpAuto(); });

  // Google Sheet

  const tpSheetStatus = document.getElementById('tp-sheet-status');
  const tpSheetBtn = document.getElementById('tp-sheet-btn');
  let tpSheetTimer = null;

  function renderTpSheet(s) {
    const r = s.last_result;
    tpSheetStatus.replaceChildren();
    if (s.running) {
      tpSheetStatus.textContent = 'Google Sheet: updating...';
    } else if (r && r.error) {
      tpSheetStatus.textContent = `Google Sheet: last update failed: ${r.error}`;
    } else if (r) {
      const a = document.createElement('a');
      a.href = r.web_view_link;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = 'the sheet';
      tpSheetStatus.append('Open ', a, `, updated ${new Date(s.last_finished_at).toLocaleString()}.`);
      loadTpProfiles().catch(() => {});
    } else {
      tpSheetStatus.textContent = 'Not synced since the last server restart. Press "Sync Google Sheet now" to get the link.';
    }
    tpSheetBtn.disabled = s.running;
  }

  async function pollTpSheet() {
    clearTimeout(tpSheetTimer);
    const res = await authedFetch('/admin/tonplace/sheet/status');
    if (!res.ok) return;
    const s = await res.json();
    renderTpSheet(s);
    tpSheetTimer = setTimeout(pollTpSheet, s.running ? 3000 : 30000);
  }

  tpSheetBtn.addEventListener('click', async () => {
    tpSheetBtn.disabled = true;
    const res = await authedFetch('/admin/tonplace/sheet/sync', { method: 'POST' });
    if (!res.ok) {
      tpSheetStatus.textContent = await readError(res);
      tpSheetBtn.disabled = false;
      return;
    }
    renderTpSheet(await res.json());
    pollTpSheet();
  });

  // Telegram daily report

  const tpTgOn = document.getElementById('tp-tg-on');
  const tpTgHour = document.getElementById('tp-tg-hour');
  const tpTgStatus = document.getElementById('tp-tg-status');
  const tpTgSendBtn = document.getElementById('tp-tg-send-btn');
  for (let h = 0; h < 24; h++) {
    const o = document.createElement('option');
    o.value = String(h);
    o.textContent = `${String(h).padStart(2, '0')}:00`;
    tpTgHour.append(o);
  }

  function renderTpTg(t) {
    tpTgOn.checked = t.enabled;
    tpTgHour.value = String(t.hour);
    if (!t.configured) {
      tpTgStatus.textContent = 'The bot is not connected yet: TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID must be set on the server.';
    } else if (t.enabled && t.next_run_at) {
      tpTgStatus.textContent = `On. Next report ${new Date(t.next_run_at).toLocaleString()}.`;
    } else {
      tpTgStatus.textContent = 'Bot connected. Daily report is off.';
    }
    tpTgOn.disabled = !t.configured;
    tpTgSendBtn.disabled = !t.configured;
  }

  async function saveTpTg() {
    tpTgOn.disabled = true;
    const res = await authedFetch('/admin/tonplace/telegram', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled: tpTgOn.checked, hour: parseInt(tpTgHour.value, 10) }),
    });
    tpTgOn.disabled = false;
    if (res.ok) {
      renderTpTg(await res.json());
    } else {
      tpTgStatus.textContent = await readError(res);
      tpTgOn.checked = !tpTgOn.checked;
    }
  }

  async function loadTpTg() {
    const res = await authedFetch('/admin/tonplace/telegram');
    if (res.ok) renderTpTg(await res.json());
  }

  tpTgOn.addEventListener('change', saveTpTg);
  tpTgHour.addEventListener('change', () => { if (tpTgOn.checked) saveTpTg(); });
  tpTgSendBtn.addEventListener('click', async () => {
    tpTgSendBtn.disabled = true;
    const res = await authedFetch('/admin/tonplace/telegram/send', { method: 'POST' });
    tpTgSendBtn.disabled = false;
    if (res.ok) {
      const { stats } = await res.json();
      tpTgStatus.textContent = `Sent to Telegram: ${stats.new_profiles} new models, ${stats.sent} messages today.`;
    } else {
      tpTgStatus.textContent = await readError(res);
    }
  });

  function loadTonplace() {
    loadTpTg().catch(() => {});
    loadTpSched().catch(() => {});
    loadTpAuto().catch(() => {});
    pollTpSheet().catch(() => {});
    loadTpSession().catch(() => {});
    pollTpStatus().catch(() => {});
    pollTpSend().catch(() => {});
    loadTpProfiles().catch(() => {});
  }

  async function init() {
    try {
      const res = await authedFetch('/auth/me');
      if (!res.ok) throw new Error();
      const me = await res.json();
      if (!me.is_admin) {
        deniedEl.hidden = false;
        return;
      }
      contentEl.hidden = false;
      await loadLinks().catch(() => {});
      await pollImportStatus();
      await pollExportStatus();
      await loadSchedule().catch(() => {});
      loadOfPanel();
      showTab(location.hash.slice(1));
    } catch {
      deniedEl.hidden = false;
    }
  }

  init();
</script>
