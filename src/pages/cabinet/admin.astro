  .ig-link:hover { text-decoration: underline; }
  .targets-table td.source a { color: var(--fg-muted); text-decoration: none; }
  .targets-table td.source a:hover { text-decoration: underline; }
</style>

</Base>

<script>
  const API_BASE = 'https://worker-cabinet-production.up.railway.app';
  const token = localStorage.getItem('cabinet_token');
  if (!token) {
    window.location.href = '/cabinet/login';
  }

  const deniedEl = document.getElementById('denied');
  const contentEl = document.getElementById('admin-content');

  document.getElementById('logout-btn').addEventListener('click', () => {
    localStorage.removeItem('cabinet_token');
    window.location.href = '/cabinet/login';
  });

  async function authedFetch(path, options = {}) {
    const res = await fetch(`${API_BASE}${path}`, {
      ...options,
      headers: { ...(options.headers || {}), Authorization: `Bearer ${token}` },
    });
    if (res.status === 401) {
      localStorage.removeItem('cabinet_token');
      window.location.href = '/cabinet/login';
      throw new Error('Session expired');
    }
    return res;
  }

  // --- Instagram targets database + manual import ---

  const importStatusEl = document.getElementById('import-status');
  const runImportBtn = document.getElementById('run-import-btn');
  const stopImportBtn = document.getElementById('stop-import-btn');
  const categoryInput = document.getElementById('import-category');
  const categoryErrorEl = document.getElementById('import-category-error');
  let pollTimer = null;

  try {
    categoryInput.value = localStorage.getItem('import_category') || '';
  } catch {}

  const progressEl = document.getElementById('import-progress');
  const progressFillEl = document.getElementById('import-progress-fill');
  let lastImportState = null;

  function fmtDuration(ms) {
    const total = Math.max(0, Math.round(ms / 1000));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const sec = total % 60;
    if (h) return `${h}h ${m}m`;
    if (m) return `${m}m ${String(sec).padStart(2, '0')}s`;
    return `${sec}s`;
  }

  function setProgress(pct) {
    progressEl.hidden = false;
    if (pct === null) {
      progressFillEl.classList.add('is-indeterminate');
      progressFillEl.style.width = '';
    } else {
      progressFillEl.classList.remove('is-indeterminate');
      progressFillEl.style.width = `${pct}%`;
    }
  }

  function renderImportStatus(state) {
    lastImportState = state;
    stopImportBtn.disabled = !state.running || !!state.stopping;
    stopImportBtn.textContent = state.stopping ? 'Stopping...' : 'Stop import';
    categoryInput.disabled = !!state.running;
    const categoryNote = state.category ? ` · category ${state.category}` : '';
    if (state.running) {
      const p = state.progress || {};
      const elapsed = state.last_started_at ? Date.now() - new Date(state.last_started_at).getTime() : 0;
      if (p.phase === 'checking_profiles' && p.total) {
        const pct = Math.round((p.checked / p.total) * 100);
        setProgress(pct);
        const eta = p.checked >= 10 ? ` · about ${fmtDuration((elapsed / p.checked) * (p.total - p.checked))} left` : '';
        const current = p.current ? ` · checking ${p.current}` : '';
        importStatusEl.textContent =
          `Importing${categoryNote}: ${p.checked} of ${p.total} profiles (${pct}%) · ${p.saved} new · ${p.skipped} skipped · ${fmtDuration(elapsed)} elapsed${eta}${current}`;
      } else if (p.phase === 'fetching_list') {
        setProgress(null);
        importStatusEl.textContent = `Importing${categoryNote}: fetching the model list (page ${p.page || 0} of ${p.pages || '?'}) · ${fmtDuration(elapsed)} elapsed`;
      } else {
        setProgress(null);
        importStatusEl.textContent = `Importing${categoryNote}: starting... · ${fmtDuration(elapsed)} elapsed`;
      }
      if (state.stopping) {
        importStatusEl.textContent = `Stopping after the current profile... ${importStatusEl.textContent}`;
      }
      return;
    }
    progressEl.hidden = true;
    if (state.last_result?.error) {
      importStatusEl.textContent = `Last run failed: ${state.last_result.error}`;
    } else if (state.last_result) {
      const { fetched = 0, saved = 0, skipped = 0, stopped = false } = state.last_result;
      const at = state.last_finished_at ? ` (finished ${new Date(state.last_finished_at).toLocaleString()})` : '';
      const verb = stopped ? 'stopped by you after' : 'checked';
      const lastCategory = state.last_result.category ? ` [${state.last_result.category}]` : '';
      importStatusEl.textContent = `Last run${at}${lastCategory}: ${verb} ${fetched} profiles, ${saved} new, ${skipped} skipped.`;
    } else {
      importStatusEl.textContent = 'Idle. No import has run since the server started.';
    }
  }

  // Keep the elapsed timer moving between the 4-second polls.
  setInterval(() => {
    if (lastImportState?.running) renderImportStatus(lastImportState);
  }, 1000);

  async function pollImportStatus() {
    const res = await authedFetch('/admin/import/status');
    if (!res.ok) return;
    const state = await res.json();
    renderImportStatus(state);
    runImportBtn.disabled = state.running;
    runImportBtn.textContent = state.running ? 'Running...' : 'Run import now';
    // The sheet is refreshed while the import runs, so show its progress too.
    await pollExportStatus();

    if (state.running) {
      if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
    } else if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  // --- Recurring auto-import (every N hours, starting at HH:00) ---

  const scheduleBtn = document.getElementById('schedule-toggle-btn');
  const scheduleStatusEl = document.getElementById('schedule-status');
  const scheduleIntervalEl = document.getElementById('schedule-interval');
  const scheduleStartEl = document.getElementById('schedule-start');

  for (let h = 0; h < 24; h++) {
    const opt = document.createElement('option');
    opt.value = String(h);
    opt.textContent = `${String(h).padStart(2, '0')}:00`;
    scheduleStartEl.appendChild(opt);
  }

  function renderSchedule(state) {
    scheduleBtn.classList.toggle('is-on', state.enabled);
    scheduleBtn.textContent = state.enabled ? 'Disable auto-import' : 'Enable auto-import';
    scheduleIntervalEl.value = String(state.interval_hours);
    scheduleStartEl.value = String(state.start_hour);
    scheduleIntervalEl.disabled = state.enabled;
    scheduleStartEl.disabled = state.enabled;
    const time = `every ${state.interval_hours}h, starting ${String(state.start_hour).padStart(2, '0')}:${String(state.start_minute).padStart(2, '0')} ${state.timezone}`;
    if (state.enabled) {
      const next = state.next_run_at ? ` · next run ${new Date(state.next_run_at).toLocaleString()}` : '';
      scheduleStatusEl.textContent = `On, ${time}${next}.`;
    } else {
      scheduleStatusEl.textContent = `Off. Would run ${time}.`;
    }
  }

  async function loadSchedule() {
    const res = await authedFetch('/admin/schedule');
    if (!res.ok) return;
    renderSchedule(await res.json());
  }

  scheduleBtn.addEventListener('click', async () => {
    scheduleBtn.disabled = true;
    try {
      const wantEnabled = !scheduleBtn.classList.contains('is-on');
      // Sending the currently-picked interval/start alongside enabling makes
      // sure a value chosen just before clicking "Enable" is the one that's used.
      const res = await authedFetch('/admin/schedule/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          enabled: wantEnabled,
          interval_hours: parseInt(scheduleIntervalEl.value, 10),
          start_hour: parseInt(scheduleStartEl.value, 10),
          start_minute: 0,
        }),
      });
      if (res.ok) renderSchedule(await res.json());
    } finally {
      scheduleBtn.disabled = false;
    }
  });

  runImportBtn.addEventListener('click', async () => {
    categoryErrorEl.hidden = true;
    const category = categoryInput.value.trim();
    try {
      localStorage.setItem('import_category', category);
    } catch {}

    runImportBtn.disabled = true;
    runImportBtn.textContent = 'Checking category...';
    try {
      const res = await authedFetch('/admin/import/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category: category || null }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok) {
        // A bad category is refused before anything starts: show why and let the admin fix it.
        categoryErrorEl.textContent = data?.detail || 'Could not start the import.';
        categoryErrorEl.hidden = false;
        runImportBtn.disabled = false;
        runImportBtn.textContent = 'Run import now';
        return;
      }
      renderImportStatus(data);
      runImportBtn.textContent = 'Running...';
      if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
    } catch (err) {
      categoryErrorEl.textContent = err instanceof Error ? err.message : 'Could not start the import.';
      categoryErrorEl.hidden = false;
      runImportBtn.disabled = false;
      runImportBtn.textContent = 'Run import now';
    }
  });

  stopImportBtn.addEventListener('click', async () => {
    if (!confirm('Stop the import? Accounts found so far are kept, the sheet is updated, and you can run it again later.')) return;
    stopImportBtn.disabled = true;
    stopImportBtn.textContent = 'Stopping...';
    try {
      const res = await authedFetch('/admin/import/stop', { method: 'POST' });
      if (res.ok) renderImportStatus(await res.json());
    } catch {
      stopImportBtn.disabled = false;
      stopImportBtn.textContent = 'Stop import';
    }
    if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
  });

  // --- Google Drive export ---

  const exportStatusEl = document.getElementById('export-status');
  const runExportBtn = document.getElementById('run-export-btn');
  const exportLinkEl = document.getElementById('export-link');
  let exportPollTimer = null;

  function formatExportStatus(state) {
    const rows = state.last_result?.rows;
    const last = state.last_result && !state.last_result.error
      ? ` Last update${state.last_finished_at ? ` ${new Date(state.last_finished_at).toLocaleTimeString()}` : ''}${rows != null ? `, ${rows} rows` : ''}${state.last_result.added ? ` (+${state.last_result.added} new)` : ''}${state.last_result.marked ? `, ${state.last_result.marked} marks updated` : ''}.`
      : '';
    if (state.running) return `Sheet: updating...${last}`;
    if (state.last_result?.error) return `Last export failed: ${state.last_result.error}`;
    if (state.last_result) return `Sheet up to date.${last}`;
    return 'Sheet: no export yet.';
  }

  async function pollExportStatus() {
    const res = await authedFetch('/admin/export/status');
    if (!res.ok) return;
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.disabled = state.running;
    runExportBtn.textContent = state.running ? 'Exporting...' : 'Export to Google Sheet';

    if (state.last_result?.web_view_link) {
      exportLinkEl.innerHTML = `<a href="${state.last_result.web_view_link}" target="_blank" rel="noopener">Open spreadsheet →</a>`;
      exportLinkEl.hidden = false;
    }

    if (state.running) {
      if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
    } else if (exportPollTimer) {
      clearInterval(exportPollTimer);
      exportPollTimer = null;
    }
  }

  runExportBtn.addEventListener('click', async () => {
    runExportBtn.disabled = true;
    const res = await authedFetch('/admin/export/run', { method: 'POST' });
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.textContent = 'Exporting...';
    if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
  });

  // --- Tracking links (per-worker /links?ref=... with click counters) ---

  const linksBody = document.getElementById('links-body');

  function textCell(text, className) {
    const td = document.createElement('td');
    if (className) td.className = className;
    td.textContent = text;
    return td;
  }

  async function loadLinks() {
    const res = await authedFetch('/admin/links');
    if (!res.ok) return;
    const data = await res.json();
    linksBody.innerHTML = '';
    for (const item of data.items) {
      const tr = document.createElement('tr');

      const nameTd = document.createElement('td');
      nameTd.className = 'username';
      nameTd.textContent = item.ref === 'direct' ? item.label : item.label ? `${item.label} (${item.ref})` : item.ref;

      const linkTd = document.createElement('td');
      const cell = document.createElement('div');
      cell.className = 'link-cell';
      const code = document.createElement('code');
      code.textContent = item.url.replace('https://', '');
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy-btn';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(item.url);
          copyBtn.textContent = 'Copied';
        } catch {
          copyBtn.textContent = 'Failed';
        }
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
      });
      cell.append(code, copyBtn);
      linkTd.appendChild(cell);

      const actionTd = document.createElement('td');
      if (item.ref !== 'direct') {
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'undo-btn';
        delBtn.textContent = 'Delete';
        delBtn.addEventListener('click', async () => {
          const stats = `${item.visits} visits and ${item.total_clicks} clicks`;
          if (!confirm(`Delete the link "${item.ref}"? Its statistics (${stats}) are deleted too. This cannot be undone.`)) return;
          delBtn.disabled = true;
          const r = await authedFetch(`/admin/links/${encodeURIComponent(item.ref)}`, { method: 'DELETE' });
          if (r.ok) await loadLinks();
          else delBtn.disabled = false;
        });
        actionTd.appendChild(delBtn);
      }

      const last = item.last_event_at ? new Date(item.last_event_at).toLocaleString() : '—';
      tr.append(
        nameTd,
        linkTd,
        textCell(item.visits, 'num'),
        textCell(item.clicks.agency, 'num'),
        textCell(item.clicks.traffic, 'num'),
        textCell(item.clicks.analytics, 'num'),
        textCell(item.clicks.promo ?? 0, 'num'),
        textCell(item.clicks.photo ?? 0, 'num'),
        textCell(item.total_clicks, 'num total'),
        textCell(last),
        actionTd,
      );
      linksBody.appendChild(tr);
    }
  }

  document.getElementById('refresh-links-btn').addEventListener('click', loadLinks);

  document.getElementById('link-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const linkError = document.getElementById('link-error');
    const linkSuccess = document.getElementById('link-success');
    linkError.hidden = true;
    linkSuccess.hidden = true;

    const ref = document.getElementById('link-ref').value;
    const label = document.getElementById('link-label').value || null;

    try {
      const res = await authedFetch('/admin/links', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ref, label }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(typeof data?.detail === 'string' ? data.detail : 'Failed to create link');
      }
      const created = await res.json();
      linkSuccess.textContent = `Created: ${created.url}`;
      linkSuccess.hidden = false;
      document.getElementById('link-form').reset();
      await loadLinks();
    } catch (err) {
      linkError.textContent = err instanceof Error ? err.message : 'Failed to create link';
      linkError.hidden = false;
    }
  });

  // --- OnlyFans panel (local FastAPI app on this machine) ---

  const OF_BASE = 'http://localhost:8080';
  const ofStatusEl = document.getElementById('of-status');
  const ofWrapEl = document.getElementById('of-accounts-wrap');
  const ofBodyEl = document.getElementById('of-accounts-body');
  const ofStopBtn = document.getElementById('of-stop-btn');
  let ofTimer = null;

  function ofCell(text, cls) {
    const td = document.createElement('td');
    if (cls) td.className = cls;
    td.textContent = text;
    return td;
  }

  async function loadOfPanel() {
    clearTimeout(ofTimer);
    try {
      const [accRes, statusRes] = await Promise.all([
        fetch(`${OF_BASE}/api/accounts`),
        fetch(`${OF_BASE}/api/status`),
      ]);
      const { accounts } = await accRes.json();
      const status = await statusRes.json();
      ofStatusEl.textContent = status.running
        ? `Online, task running: ${status.success} sent, ${status.errors} errors of ${status.total}.`
        : `Online, idle. ${accounts.length} account(s).`;
      ofStopBtn.disabled = !status.running;
      ofBodyEl.replaceChildren();
      for (const acc of accounts) {
        const p = acc.progress || {};
        const tr = document.createElement('tr');
        tr.append(
          ofCell(acc.name, 'username'),
          ofCell(acc.has_cookies ? `yes (${acc.cookie_count})` : 'no'),
          ofCell(p.status || 'idle'),
          ofCell(String(p.success ?? 0), 'num'),
          ofCell(String(p.errors ?? 0), 'num'),
        );
        const actionTd = document.createElement('td');
        const btn = document.createElement('button');
        btn.className = 'ghost-btn';
        btn.textContent = 'Open browser';
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            const r = await fetch(`${OF_BASE}/api/accounts/${encodeURIComponent(acc.id)}/open-browser`, { method: 'POST' });
            const data = await r.json();
            btn.textContent = data.ok ? 'Opened' : (data.error || 'Failed');
          } catch {
            btn.textContent = 'Failed';
          }
        });
        actionTd.append(btn);
        tr.append(actionTd);
        ofBodyEl.append(tr);
      }
      ofWrapEl.hidden = accounts.length === 0;
      ofTimer = setTimeout(loadOfPanel, status.running ? 5000 : 30000);
    } catch {
      ofStatusEl.textContent = 'Offline. Start of-panel/run_panel.bat on this computer, then press Refresh.';
      ofWrapEl.hidden = true;
      ofStopBtn.disabled = true;
    }
  }

  async function loadOfModels() {
    const statusEl = document.getElementById('of-models-status');
    try {
      const res = await fetch(`${OF_BASE}/api/models`);
      const { models, total } = await res.json();
      const body = document.getElementById('of-models-body');
      body.replaceChildren();
      for (const m of models.slice(0, 500)) {
        const tr = document.createElement('tr');
        const linkTd = document.createElement('td');
        linkTd.className = 'username';
        const a = document.createElement('a');
        a.className = 'ig-link';
        a.href = `https://onlyfans.com/${encodeURIComponent(m.username)}`;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = m.username;
        linkTd.append(a);
        tr.append(
          linkTd,
          ofCell(m.display_name || ''),
          ofCell((m.accounts || []).join(', ')),
          ofCell(m.message_sent ? 'sent' : '', m.message_sent ? 'tp-msg-sent' : ''),
        );
        body.append(tr);
      }
      const sent = models.filter((m) => m.message_sent).length;
      document.getElementById('of-models-total').textContent = `(${total}, messaged ${sent})`;
      statusEl.textContent = total > 500 ? 'Showing the first 500. Download Excel for the full list.' : '';
      statusEl.hidden = !statusEl.textContent;
      document.getElementById('of-models-wrap').hidden = total === 0;
    } catch {
      statusEl.hidden = false;
      statusEl.textContent = 'Loads when the panel is online.';
      document.getElementById('of-models-wrap').hidden = true;
    }
  }

  // --- OnlyFans agent + job queue (worker-cabinet backend) ---

  const ofaBadge = document.getElementById('ofa-badge');
  const ofaStatus = document.getElementById('ofa-status');
  const ofaLegacyBtn = document.getElementById('ofa-legacy-btn');
  const ofcRunStatus = document.getElementById('ofc-run-status');
  const ofcRunBtn = document.getElementById('ofc-run-btn');
  const ofcStopBtn = document.getElementById('ofc-stop-btn');
  const ofcSheetStatus = document.getElementById('ofc-sheet-status');
  let ofcTimer = null;
  let ofcLoaded = false;
  let ofMailWasActive = false;

  const jobActive = (j) => j && (j.status === 'pending' || j.status === 'running');

  function renderOfAgent(a) {
    ofaBadge.textContent = a.online ? 'Online' : 'Offline';
    ofaBadge.classList.toggle('is-online', a.online);
    if (!a.configured) {
      ofaStatus.textContent = 'Not set up yet: download agent_config.json, put it into of-panel and start run_agent.bat.';
    } else if (a.online) {
      ofaStatus.textContent = `Connected, last check-in ${new Date(a.last_seen_at).toLocaleTimeString()}.`;
    } else {
      ofaStatus.textContent = a.last_seen_at
        ? `Not running. Last seen ${new Date(a.last_seen_at).toLocaleString()}. Start of-panel/run_agent.bat.`
        : 'Key issued, the agent has not connected yet. Start of-panel/run_agent.bat.';
    }
  }

  function renderOfParse(s) {
    const j = s.parse;
    const totals = `In the database: ${s.total} creators, ${s.free} free, ${s.messaged} messaged.`;
    const r = j && j.result;
    if (j && j.status === 'pending') {
      ofcRunStatus.textContent = `Queued, waiting for the agent${s.agent.online ? '' : ' (agent offline)'}. ${totals}`;
    } else if (j && j.status === 'running') {
      const p = j.progress;
      const where = p ? `${p.seeds} seed(s) walked, ${p.found} found, ${p.saved} new saved` : 'starting';
      ofcRunStatus.textContent = `${j.stop_requested ? 'Stopping' : 'Running'} on the agent: ${where}. ${totals}`;
    } else if (j && j.status === 'cancelled') {
      ofcRunStatus.textContent = `Cancelled before it started. ${totals}`;
    } else if (r && r.error) {
      ofcRunStatus.textContent = `Last run failed: ${r.error} (${r.added || 0} saved before that). ${totals}`;
    } else if (r) {
      ofcRunStatus.textContent = `${r.stopped ? 'Stopped' : 'Done'} ${new Date(j.finished_at).toLocaleString()}: ${r.added} new from ${r.seeds} seed(s). ${totals}`;
    } else {
      ofcRunStatus.textContent = `Idle. ${totals}`;
    }
    ofcRunBtn.disabled = jobActive(j);
    ofcStopBtn.disabled = !jobActive(j) || j.stop_requested;
  }

  function renderOfSheet(sh) {
    ofcSheetStatus.replaceChildren();
    if (sh.running) {
      ofcSheetStatus.textContent = 'Google Sheet: updating...';
    } else if (sh.last_result && sh.last_result.error) {
      ofcSheetStatus.textContent = `Google Sheet: last update failed: ${sh.last_result.error}`;
    } else if (sh.last_result) {
      const a = document.createElement('a');
      a.href = sh.last_result.web_view_link;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = 'Google Sheet';
      ofcSheetStatus.append(a, ` ("onlyfans" sheet), updated ${new Date(sh.last_finished_at).toLocaleString()}.`);
    }
  }

  async function pollOfc() {
    clearTimeout(ofcTimer);
    const res = await authedFetch('/admin/onlyfans/status');
    if (!res.ok) return;
    const s = await res.json();
    renderOfAgent(s.agent);
    renderOfParse(s);
    renderOfs(s);
    renderOfSheet(s.sheet || {});
    ofaLegacyBtn.hidden = !s.legacy_cookies_saved;
    const busy = jobActive(s.parse) || jobActive(s.mailing) || (s.sheet && s.sheet.running);
    if (ofMailWasActive && !jobActive(s.mailing)) loadOfsAuto().catch(() => {});
    ofMailWasActive = jobActive(s.mailing);
    // Keep watching while something runs, and slowly otherwise (auto-mailing / agent status change by themselves).
    if (document.querySelector('[data-panel="onlyfans"]:not([hidden])')) ofcTimer = setTimeout(pollOfc, busy ? 3000 : 20000);
  }

  document.getElementById('ofa-config-btn').addEventListener('click', async () => {
    if (!confirm('Download a new agent_config.json? The previous file (if any) stops working.')) return;
    const res = await authedFetch('/admin/onlyfans/agent/config', { method: 'POST' });
    if (!res.ok) {
      ofaStatus.textContent = await readError(res);
      return;
    }
    const url = URL.createObjectURL(new Blob([JSON.stringify(await res.json(), null, 2)], { type: 'application/json' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = 'agent_config.json';
    a.click();
    URL.revokeObjectURL(url);
    setTimeout(pollOfc, 500);
  });

  ofaLegacyBtn.addEventListener('click', async () => {
    if (!confirm('Delete the OnlyFans cookies and signing rules saved on the server? The agent uses its local files.')) return;
    await authedFetch('/admin/onlyfans/legacy-cookies', { method: 'DELETE' });
    pollOfc();
  });

  ofcRunBtn.addEventListener('click', async () => {
    ofcRunBtn.disabled = true;
    const limit = Math.max(1, Math.min(5000, parseInt(document.getElementById('ofc-limit').value, 10) || 300));
    const res = await authedFetch('/admin/onlyfans/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ limit }),
    });
    if (!res.ok) {
      ofcRunStatus.textContent = await readError(res);
      ofcRunBtn.disabled = false;
      return;
    }
    pollOfc();
  });

  ofcStopBtn.addEventListener('click', async () => {
    ofcStopBtn.disabled = true;
    await authedFetch('/admin/onlyfans/stop', { method: 'POST' });
    pollOfc();
  });

  document.getElementById('ofc-sheet-btn').addEventListener('click', async () => {
    const res = await authedFetch('/admin/onlyfans/sheet/sync', { method: 'POST' });
    if (!res.ok) {
      ofcSheetStatus.textContent = await readError(res);
      return;
    }
    setTimeout(pollOfc, 500);
  });

  // --- OnlyFans mailing ---

  const ofsStatus = document.getElementById('ofs-status');
  const ofsSendBtn = document.getElementById('ofs-send-btn');
  const ofsStopBtn = document.getElementById('ofs-stop-btn');
  const ofsPreviewBtn = document.getElementById('ofs-preview-btn');
  const ofsMsg = document.getElementById('ofs-msg');
  const ofsAutoOn = document.getElementById('ofs-auto-on');
  const ofsAutoDaily = document.getElementById('ofs-auto-daily');
  const ofsAutoStatus = document.getElementById('ofs-auto-status');

  try { ofsMsg.value = localStorage.getItem('ofs_message') || ''; } catch {}
  ofsMsg.addEventListener('input', () => { try { localStorage.setItem('ofs_message', ofsMsg.value); } catch {} });

  function ofsPayload() {
    const num = (id, def) => parseFloat(document.getElementById(id).value) || def;
    return {
      message: ofsMsg.value.trim(),
      limit: Math.round(num('ofs-limit', 20)),
      delay_min: num('ofs-delay-min', 20),
      delay_max: num('ofs-delay-max', 60),
      retry_errors: document.getElementById('ofs-retry').checked,
    };
  }

  function renderOfs(s) {
    const j = s.mailing;
    const r = j && j.result;
    const p = j && j.progress;
    if (j && j.status === 'pending') {
      ofsStatus.textContent = `Queued${j.trigger === 'auto' ? ' by auto mode' : ''}, waiting for the agent${s.agent.online ? '' : ' (agent offline)'}.`;
    } else if (j && j.status === 'running') {
      const label = j.stop_requested ? 'Stopping' : j.trigger === 'auto' ? 'Auto-sending' : 'Sending';
      if (p) {
        const cur = p.current ? `, now @${p.current}` : '';
        const lastErr = p.last_error ? ` Last error: ${p.last_error}` : '';
        ofsStatus.textContent = `${label} on the agent: ${p.done} of ${p.total} (${p.sent} sent, ${p.errors} failed${cur}).${lastErr}`;
      } else {
        ofsStatus.textContent = `${label} on the agent: starting.`;
      }
    } else if (j && j.status === 'cancelled') {
      ofsStatus.textContent = 'Cancelled before it started.';
    } else if (r) {
      const when = j.finished_at ? new Date(j.finished_at).toLocaleString() : '';
      const head = r.daily_limit ? 'Stopped: OnlyFans daily limit reached' : r.error ? `Stopped with error: ${r.error}` : r.stopped ? 'Stopped' : 'Done';
      const skip = r.skipped ? `, ${r.skipped} skipped (already messaged)` : '';
      ofsStatus.textContent = r.note ? `Done ${when}: ${r.note}.` : `${head} ${when}: ${r.sent} sent, ${r.errors} failed${skip} of ${r.total}.`;
    } else {
      ofsStatus.textContent = 'Idle.';
    }
    ofsSendBtn.disabled = jobActive(j);
    ofsPreviewBtn.disabled = jobActive(j);
    ofsStopBtn.disabled = !jobActive(j) || j.stop_requested;
  }

  const pollOfs = () => pollOfc();

  ofsPreviewBtn.addEventListener('click', async () => {
    const payload = ofsPayload();
    if (!payload.message) payload.message = '-';
    const res = await authedFetch('/admin/onlyfans/send/preview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      ofsStatus.textContent = await readError(res);
      return;
    }
    const data = await res.json();
    const names = data.items.slice(0, 10).map((i) => `@${i.username}`).join(', ');
    ofsStatus.textContent = data.count
      ? `Will message ${data.count} free creator(s): ${names}${data.count > 10 ? ', ...' : ''}`
      : 'No free creators left to message.';
  });

  ofsSendBtn.addEventListener('click', async () => {
    const payload = ofsPayload();
    if (!payload.message) {
      ofsStatus.textContent = 'Write the message first.';
      ofsMsg.focus();
      return;
    }
    if (!confirm(`Subscribe to and message up to ${payload.limit} free OnlyFans creator(s)?`)) return;
    ofsSendBtn.disabled = true;
    const res = await authedFetch('/admin/onlyfans/send/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      ofsStatus.textContent = await readError(res);
      ofsSendBtn.disabled = false;
      return;
    }
    pollOfc();
  });

  ofsStopBtn.addEventListener('click', async () => {
    ofsStopBtn.disabled = true;
    await authedFetch('/admin/onlyfans/send/stop', { method: 'POST' });
    pollOfs();
  });

  function renderOfsAuto(a) {
    ofsAutoOn.checked = a.enabled;
    ofsAutoDaily.value = String(a.daily_limit);
    if (a.enabled) {
      if (a.message && !ofsMsg.value.trim()) ofsMsg.value = a.message;
      const limitNote = a.onlyfans_limit_today ? ' OnlyFans daily limit hit today, resumes tomorrow.' : '';
      ofsAutoStatus.textContent = `On. Sent today ${a.sent_today} of ${a.daily_limit}, ${a.waiting} free creator(s) waiting. Checks every ${a.check_every_minutes} min.${limitNote}`;
    } else {
      ofsAutoStatus.textContent = `Off. ${a.waiting} free creator(s) not messaged yet.`;
    }
  }

  async function loadOfsAuto() {
    const res = await authedFetch('/admin/onlyfans/auto-send');
    if (res.ok) renderOfsAuto(await res.json());
  }

  async function saveOfsAuto() {
    const p = ofsPayload();
    ofsAutoOn.disabled = true;
    const res = await authedFetch('/admin/onlyfans/auto-send', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        enabled: ofsAutoOn.checked,
        message: p.message,
        daily_limit: Math.max(1, Math.min(500, parseInt(ofsAutoDaily.value, 10) || 20)),
        delay_min: p.delay_min,
        delay_max: p.delay_max,
      }),
    });
    ofsAutoOn.disabled = false;
    if (res.ok) {
      renderOfsAuto(await res.json());
      if (ofsAutoOn.checked) setTimeout(pollOfs, 1500);
    } else {
      ofsAutoStatus.textContent = await readError(res);
      ofsAutoOn.checked = !ofsAutoOn.checked;
    }
  }

  ofsAutoOn.addEventListener('change', () => {
    if (ofsAutoOn.checked && !confirm('Turn on OnlyFans auto-mailing? New free creators will be subscribed to and messaged automatically.')) {
      ofsAutoOn.checked = false;
      return;
    }
    saveOfsAuto();
  });
  ofsAutoDaily.addEventListener('change', () => { if (ofsAutoOn.checked) saveOfsAuto(); });

  document.getElementById('of-refresh-btn').addEventListener('click', () => {
    loadOfPanel();
    loadOfModels();
  });
  ofStopBtn.addEventListener('click', async () => {
    ofStopBtn.disabled = true;
    try {
      await fetch(`${OF_BASE}/api/stop`, { method: 'POST' });
    } catch {}
    loadOfPanel();
  });

  // --- Tabs ---

  const tabButtons = document.querySelectorAll('.admin-tab');
  const tabPanels = document.querySelectorAll('[data-panel]');
  let tonplaceLoaded = false;
  let cbLoaded = false;

  function showTab(name) {
    if (![...tabButtons].some((b) => b.dataset.tab === name)) name = 'main';
    tabButtons.forEach((b) => {
      const active = b.dataset.tab === name;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-selected', String(active));
    });
    tabPanels.forEach((p) => { p.hidden = p.dataset.panel !== name; });
    if (history.replaceState) history.replaceState(null, '', name === 'main' ? location.pathname : `#${name}`);
    if (name === 'onlyfans') {
      loadOfPanel();
      loadOfModels();
      ofcLoaded = true;
      pollOfc().catch(() => {});
      loadOfsAuto().catch(() => {});
    }
    if (name === 'chaturbate' && !cbLoaded) {
      cbLoaded = true;
      pollCbStatus().catch(() => {});
      loadCbModels().catch(() => {});
      pollCbSheet().catch(() => {});
    }
    if (name === 'tonplace' && !tonplaceLoaded) {
      tonplaceLoaded = true;
      loadTonplace();
    }
  }
  tabButtons.forEach((b) => b.addEventListener('click', () => showTab(b.dataset.tab)));

  // --- Chaturbate parser (runs on the worker-cabinet backend) ---

  const cbRunBtn = document.getElementById('cb-run-btn');
  const cbStopBtn = document.getElementById('cb-stop-btn');
  const cbRunStatus = document.getElementById('cb-run-status');
  const cbSearch = document.getElementById('cb-search');
  const cbFilterGender = document.getElementById('cb-filter-gender');
  const cbMoreBtn = document.getElementById('cb-more-btn');
  const CB_GENDERS = { f: 'female', m: 'male', c: 'couple', s: 'trans' };
  const CB_PAGE = 100;
  let cbPollTimer = null;
  let cbWasRunning = false;
  let cbOffset = 0;

  function renderCbStatus(s) {
    const r = s.last_result;
    if (s.running) {
      const p = s.progress;
      const where = p
        ? `page ${p.pages}, ${p.found} found, ${p.saved || 0} new saved${p.online_total ? ` (${p.online_total} online now)` : ''}`
        : 'starting';
      cbRunStatus.textContent = s.stopping ? `Stopping... (${where})` : `Running: ${where}.`;
    } else if (r && r.error) {
      cbRunStatus.textContent = `Last run failed: ${r.error}`;
    } else if (r) {
      const when = s.last_finished_at ? new Date(s.last_finished_at).toLocaleString() : '';
      cbRunStatus.textContent = `${r.stopped ? 'Stopped' : 'Done'} ${when}: ${r.found} found, ${r.added} new, ${r.updated} already known.`;
    } else {
      cbRunStatus.textContent = 'Idle.';
    }
    cbRunBtn.disabled = s.running;
    cbStopBtn.disabled = !s.running || s.stopping;
  }

  async function pollCbStatus() {
    clearTimeout(cbPollTimer);
    const res = await authedFetch('/admin/chaturbate/status');
    if (!res.ok) return;
    const s = await res.json();
    renderCbStatus(s);
    if (s.running) {
      cbWasRunning = true;
      cbPollTimer = setTimeout(pollCbStatus, 2000);
    } else if (cbWasRunning) {
      cbWasRunning = false;
      loadCbModels().catch(() => {});
      setTimeout(() => pollCbSheet().catch(() => {}), 1500);
    }
  }

  cbRunBtn.addEventListener('click', async () => {
    const limit = Math.max(1, Math.min(20000, parseInt(document.getElementById('cb-limit').value, 10) || 1000));
    const gender = document.getElementById('cb-gender').value;
    const query = document.getElementById('cb-query').value.trim();
    cbRunBtn.disabled = true;
    const res = await authedFetch('/admin/chaturbate/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ limit, gender, query }),
    });
    if (!res.ok) {
      cbRunStatus.textContent = await readError(res);
      cbRunBtn.disabled = false;
      return;
    }
    renderCbStatus(await res.json());
    pollCbStatus();
  });

  cbStopBtn.addEventListener('click', async () => {
    cbStopBtn.disabled = true;
    await authedFetch('/admin/chaturbate/stop', { method: 'POST' });
    pollCbStatus();
  });

  function cbFilterParams() {
    const params = new URLSearchParams();
    if (cbSearch.value.trim()) params.set('q', cbSearch.value.trim());
    if (cbFilterGender.value) params.set('gender', cbFilterGender.value);
    return params;
  }

  function cbNumCell(value) {
    const td = ofCell(value == null ? '' : value.toLocaleString());
    td.classList.add('num');
    return td;
  }

  async function loadCbModels(append = false) {
    const statusEl = document.getElementById('cb-models-status');
    const body = document.getElementById('cb-models-body');
    cbOffset = append ? cbOffset + CB_PAGE : 0;
    const params = cbFilterParams();
    params.set('limit', String(CB_PAGE));
    params.set('offset', String(cbOffset));
    const res = await authedFetch(`/admin/chaturbate/models?${params}`);
    if (!res.ok) {
      statusEl.textContent = await readError(res);
      return;
    }
    const data = await res.json();
    if (!append) body.replaceChildren();
    for (const m of data.items) {
      const tr = document.createElement('tr');
      const linkTd = document.createElement('td');
      linkTd.className = 'username';
      const a = document.createElement('a');
      a.className = 'ig-link';
      a.href = m.url;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = m.username;
      linkTd.append(a);
      const rank = cbNumCell(m.rank);
      if (m.rank_list) rank.title = `List: ${m.rank_list}`;
      tr.append(
        rank,
        linkTd,
        cbNumCell(m.viewers),
        cbNumCell(m.on_air || null),
        cbNumCell(m.followers),
        ofCell(CB_GENDERS[m.gender] || m.gender || ''),
        cbNumCell(m.age),
        ofCell(m.country || ''),
        ofCell(m.last_seen_at ? new Date(m.last_seen_at).toLocaleString() : ''),
      );
      body.append(tr);
    }
    const shown = cbOffset + data.items.length;
    const filtered = data.total !== data.all_total ? `, ${data.total} match` : '';
    document.getElementById('cb-total').textContent = `(${data.all_total}${filtered})`;
    statusEl.textContent = data.all_total === 0 ? 'No models yet. Run the parser.' : '';
    statusEl.hidden = !statusEl.textContent;
    document.getElementById('cb-models-wrap').hidden = data.total === 0;
    cbMoreBtn.hidden = shown >= data.total;
  }

  let cbSearchTimer = null;
  cbSearch.addEventListener('input', () => {
    clearTimeout(cbSearchTimer);
    cbSearchTimer = setTimeout(() => loadCbModels().catch(() => {}), 300);
  });
  cbFilterGender.addEventListener('change', () => loadCbModels().catch(() => {}));
  cbMoreBtn.addEventListener('click', () => loadCbModels(true).catch(() => {}));

  document.getElementById('cb-csv-btn').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const statusEl = document.getElementById('cb-models-status');
    btn.disabled = true;
    try {
      const res = await authedFetch(`/admin/chaturbate/models.csv?${cbFilterParams()}`);
      if (!res.ok) throw new Error(await readError(res));
      const url = URL.createObjectURL(await res.blob());
      const a = document.createElement('a');
      a.href = url;
      a.download = 'chaturbate_models.csv';
      a.click();
      URL.revokeObjectURL(url);
    } catch (err) {
      statusEl.textContent = err.message;
      statusEl.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });

  const cbSheetStatus = document.getElementById('cb-sheet-status');
  const cbSheetBtn = document.getElementById('cb-sheet-btn');
  let cbSheetTimer = null;

  function renderCbSheet(s) {
    const r = s.last_result;
    const when = s.last_finished_at ? new Date(s.last_finished_at).toLocaleString() : '';
    cbSheetStatus.replaceChildren();
    if (s.running) {
      cbSheetStatus.textContent = 'Updating the sheet...';
    } else if (r && r.error) {
      cbSheetStatus.textContent = `Last sync failed: ${r.error}`;
    } else if (r) {
      cbSheetStatus.append(`Synced ${when}: ${r.rows} models. `);
      if (r.web_view_link) {
        const a = document.createElement('a');
        a.href = r.web_view_link;
        a.target = '_blank';
        a.rel = 'noopener';
        a.textContent = 'Open in Google Drive';
        cbSheetStatus.append(a);
      }
    } else {
      cbSheetStatus.textContent = 'Not synced since the server started.';
    }
    cbSheetBtn.disabled = s.running;
  }

  async function pollCbSheet() {
    clearTimeout(cbSheetTimer);
    const res = await authedFetch('/admin/chaturbate/sheet/status');
    if (!res.ok) return;
    const s = await res.json();
    renderCbSheet(s);
    if (s.running) cbSheetTimer = setTimeout(pollCbSheet, 3000);
  }

  cbSheetBtn.addEventListener('click', async () => {
    cbSheetBtn.disabled = true;
    const res = await authedFetch('/admin/chaturbate/sheet/sync', { method: 'POST' });
    if (!res.ok) {
      cbSheetStatus.textContent = await readError(res);
      cbSheetBtn.disabled = false;
      return;
    }
    renderCbSheet(await res.json());
    pollCbSheet();
  });

  // --- ton.place parser (runs on the worker-cabinet backend) ---

  const tpSessionStatus = document.getElementById('tp-session-status');
  const tpSessionForm = document.getElementById('tp-session-form');
  const tpSessionInput = document.getElementById('tp-session-input');
  const tpSessionError = document.getElementById('tp-session-error');
  const tpRunStatus = document.getElementById('tp-run-status');
  const tpRunBtn = document.getElementById('tp-run-btn');
  const tpStopBtn = document.getElementById('tp-stop-btn');
  const tpTotal = document.getElementById('tp-total');
  let tpPollTimer = null;
  let tpWasRunning = false;

  async function readError(res) {
    try {
      const data = await res.json();
      if (typeof data.detail === 'string') return data.detail;
      if (Array.isArray(data.detail)) return data.detail.map((d) => `${d.loc?.slice(-1)[0]}: ${d.msg}`).join('; ');
      return `HTTP ${res.status}`;
    } catch {
      return `HTTP ${res.status}`;
    }
  }

  function renderTpSession(s) {
    tpSessionStatus.textContent = s.configured
      ? `Session saved for ton.place user ${s.user_id}${s.saved_at ? `, ${new Date(s.saved_at).toLocaleString()}` : ''}. Checking it with ton.place...`
      : 'No session saved yet.';
    if (s.configured) checkTpSession(tpSessionStatus.textContent.replace(' Checking it with ton.place...', ''));
  }

  async function checkTpSession(head) {
    const res = await authedFetch('/admin/tonplace/session/check');
    if (!res.ok) {
      tpSessionStatus.textContent = `${head} Could not check it: ${await readError(res)}`;
      return;
    }
    const c = await res.json();
    tpSessionStatus.textContent = c.ok
      ? `${head} Working: ton.place answered (${c.dialogs} dialog(s) on the first page).`
      : `${head} NOT working: ${c.error}`;
  }

  async function loadTpSession() {
    const res = await authedFetch('/admin/tonplace/session');
    if (res.ok) renderTpSession(await res.json());
  }

  tpSessionForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    tpSessionError.hidden = true;
    const res = await authedFetch('/admin/tonplace/session', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ session: tpSessionInput.value.trim() }),
    });
    if (res.ok) {
      tpSessionInput.value = '';
      renderTpSession(await res.json());
    } else {
      tpSessionError.textContent = await readError(res);
      tpSessionError.hidden = false;
    }
  });

  function renderTpStatus(s) {
    const r = s.last_result;
    if (s.running) {
      const p = s.progress;
      const where = p && p.source
        ? `${p.source === 'im' ? 'messenger suggestions' : 'people search'}, page ${p.pages}, ${p.found} found, ${p.saved || 0} new saved`
        : 'starting';
      const by = s.trigger === 'schedule' ? ' (scheduled)' : '';
      tpRunStatus.textContent = s.stopping ? `Stopping... (${where})` : `Running${by}: ${where}.`;
    } else if (r && r.error) {
      tpRunStatus.textContent = `Last run failed: ${r.error}`;
    } else if (r) {
      const when = s.last_finished_at ? new Date(s.last_finished_at).toLocaleString() : '';
      tpRunStatus.textContent = `${r.stopped ? 'Stopped' : 'Done'} ${when}: ${r.found} found, ${r.added} new, ${r.updated} already known.`;
    } else {
      tpRunStatus.textContent = 'Idle.';
    }
    tpRunBtn.disabled = s.running;
    tpStopBtn.disabled = !s.running || s.stopping;
  }

  async function pollTpStatus() {
    clearTimeout(tpPollTimer);
    const res = await authedFetch('/admin/tonplace/status');
    if (!res.ok) return;
    const s = await res.json();
    renderTpStatus(s);
    if (s.running) {
      tpWasRunning = true;
      tpPollTimer = setTimeout(pollTpStatus, 2000);
    } else if (tpWasRunning) {
      tpWasRunning = false;
      loadTpProfiles();
      loadTpAuto().catch(() => {});
      pollTpSend().catch(() => {});
    } else if (tpSchedOn.checked) {
      // Scheduled runs start by themselves on the server: keep an eye on them.
      tpPollTimer = setTimeout(pollTpStatus, 30000);
    }
  }

  tpRunBtn.addEventListener('click', async () => {
    const sources = [];
    if (document.getElementById('tp-src-search').checked) sources.push('search');
    if (document.getElementById('tp-src-im').checked) sources.push('im');
    const limit = Math.max(1, Math.min(5000, parseInt(document.getElementById('tp-limit').value, 10) || 500));
    tpRunBtn.disabled = true;
    const res = await authedFetch('/admin/tonplace/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ limit, sources }),
    });
    if (!res.ok) {
      tpRunStatus.textContent = await readError(res);
      tpRunBtn.disabled = false;
      return;
    }
    renderTpStatus(await res.json());
    pollTpStatus();
  });

  tpStopBtn.addEventListener('click', async () => {
    tpStopBtn.disabled = true;
    await authedFetch('/admin/tonplace/stop', { method: 'POST' });
    pollTpStatus();
  });

  // Profile counts (the list itself lives in the Google Sheet)
  async function loadTpProfiles() {
    const res = await authedFetch('/admin/tonplace/profiles?limit=1');
    if (!res.ok) return;
    const data = await res.json();
    tpTotal.textContent = `(${data.all_total} profiles, ${data.sent_total} messaged)`;
  }

  // Mailing

  const tpSendStatus = document.getElementById('tp-send-status');
  const tpSendBtn = document.getElementById('tp-send-btn');
  const tpSendStopBtn = document.getElementById('tp-send-stop-btn');
  const tpPreviewBtn = document.getElementById('tp-preview-btn');
  const tpMsg = document.getElementById('tp-msg');
  let tpSendTimer = null;
  let tpSendWasRunning = false;

  try {
    tpMsg.value = localStorage.getItem('tp_message') || '';
  } catch {}
  tpMsg.addEventListener('input', () => {
    try { localStorage.setItem('tp_message', tpMsg.value); } catch {}
  });

  const tpRandomize = document.getElementById('tp-randomize');
  const tpVariantsBtn = document.getElementById('tp-variants-btn');
  const tpVariants = document.getElementById('tp-variants');
  const tpAiHint = document.getElementById('tp-ai-hint');

  async function loadTpAi() {
    const res = await authedFetch('/admin/tonplace/ai');
    if (!res.ok) return;
    const a = await res.json();
    tpAiHint.hidden = a.configured;
    tpAiHint.textContent = a.configured ? '' : 'ChatGPT is not connected: set OPENAI_API_KEY on the server to use randomization.';
    tpRandomize.disabled = !a.configured;
    tpVariantsBtn.disabled = !a.configured;
  }

  tpVariantsBtn.addEventListener('click', async () => {
    const message = tpMsg.value.trim();
    if (!message) {
      tpMsg.focus();
      return;
    }
    tpVariantsBtn.disabled = true;
    tpVariantsBtn.textContent = 'Generating...';
    tpVariants.hidden = true;
    const res = await authedFetch('/admin/tonplace/send/variants', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message, count: 3 }),
    });
    tpVariantsBtn.disabled = false;
    tpVariantsBtn.textContent = 'Show examples';
    if (!res.ok) {
      tpAiHint.hidden = false;
      tpAiHint.textContent = await readError(res);
      return;
    }
    const data = await res.json();
    tpAiHint.hidden = true;
    tpVariants.replaceChildren(...data.variants.map((v) => {
      const li = document.createElement('li');
      li.textContent = v;
      return li;
    }));
    tpVariants.hidden = false;
  });

  function tpSendPayload() {
    const num = (id, def) => parseFloat(document.getElementById(id).value) || def;
    return {
      message: tpMsg.value.trim(),
      limit: Math.round(num('tp-send-limit', 50)),
      delay_min: num('tp-delay-min', 10),
      delay_max: num('tp-delay-max', 30),
      source: document.getElementById('tp-send-source').value,
      retry_errors: document.getElementById('tp-retry-errors').checked,
      randomize: tpRandomize.checked,
    };
  }

  function renderTpSend(s) {
    const r = s.last_result;
    const p = s.progress;
    if (s.running && p) {
      const cur = p.current ? `, now @${p.current}` : '';
      const lastErr = (p.last_error ? ` Last error: ${p.last_error}` : '') + (p.ai_failed ? ` ChatGPT failed ${p.ai_failed} time(s), original text sent: ${p.last_ai_error}` : '');
      tpSendStatus.textContent = `${s.stopping ? 'Stopping' : s.trigger === 'auto' ? 'Auto-sending' : 'Sending'}: ${p.done} of ${p.total} (${p.sent} sent, ${p.errors} failed${cur}).${lastErr}`;
    } else if (r) {
      const when = s.last_finished_at ? new Date(s.last_finished_at).toLocaleString() : '';
      const head = r.error ? `Stopped with error: ${r.error}` : r.stopped ? 'Stopped' : 'Done';
      const skip = r.skipped ? `, ${r.skipped} skipped (already messaged)` : '';
      const ai = r.randomize ? (r.ai_failed ? ` ChatGPT failed ${r.ai_failed} time(s), original text sent: ${r.last_ai_error}` : ' Randomized with ChatGPT.') : '';
      tpSendStatus.textContent = `${head} ${when}: ${r.sent} sent, ${r.errors} failed${skip} of ${r.total}.${ai}`;
    } else {
      tpSendStatus.textContent = 'Idle.';
    }
    tpSendBtn.disabled = s.running;
    tpPreviewBtn.disabled = s.running;
    tpSendStopBtn.disabled = !s.running || s.stopping;
    document.getElementById('tp-reset-btn').disabled = s.running;
  }

  async function pollTpSend() {
    clearTimeout(tpSendTimer);
    const res = await authedFetch('/admin/tonplace/send/status');
    if (!res.ok) return;
    const s = await res.json();
    renderTpSend(s);
    if (s.running) {
      tpSendWasRunning = true;
      tpSendTimer = setTimeout(pollTpSend, 3000);
    } else if (tpSendWasRunning) {
      tpSendWasRunning = false;
      loadTpProfiles();
      loadTpAuto().catch(() => {});
    } else if (tpAutoOn.checked) {
      // Auto-mailing can start by itself on the server: keep an eye on it.
      tpSendTimer = setTimeout(pollTpSend, 30000);
    }
  }

  tpPreviewBtn.addEventListener('click', async () => {
    const payload = tpSendPayload();
    if (!payload.message) payload.message = '-';
    const res = await authedFetch('/admin/tonplace/send/preview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      tpSendStatus.textContent = await readError(res);
      return;
    }
    const data = await res.json();
    const names = data.items.slice(0, 10).map((i) => `@${i.username}`).join(', ');
    tpSendStatus.textContent = data.count
      ? `Will message ${data.count} profile(s): ${names}${data.count > 10 ? ', ...' : ''}`
      : 'Nobody left to message with these settings.';
  });

  tpSendBtn.addEventListener('click', async () => {
    const payload = tpSendPayload();
    if (!payload.message) {
      tpSendStatus.textContent = 'Write the message first.';
      tpMsg.focus();
      return;
    }
    if (!confirm(`Send this message to up to ${payload.limit} ton.place profile(s)?`)) return;
    tpSendBtn.disabled = true;
    const res = await authedFetch('/admin/tonplace/send/run', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      tpSendStatus.textContent = await readError(res);
      tpSendBtn.disabled = false;
      return;
    }
    renderTpSend(await res.json());
    pollTpSend();
  });

  const tpResetBtn = document.getElementById('tp-reset-btn');
  tpResetBtn.addEventListener('click', async () => {
    const auto = tpAutoOn.checked ? ' Auto-mailing is ON: it will start messaging them again within 15 minutes.' : '';
    if (!confirm('Forget who was already messaged? Everyone in the list will be messaged again by the next mailing. Profiles you marked by hand in the sheet stay excluded. This cannot be undone.' + auto)) return;
    tpResetBtn.disabled = true;
    tpSendStatus.textContent = 'Resetting the sent list and rewriting the Google Sheet...';
    const res = await authedFetch('/admin/tonplace/send/reset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ keep_hand_marks: true }),
    });
    tpResetBtn.disabled = false;
    if (!res.ok) {
      tpSendStatus.textContent = await readError(res);
      return;
    }
    const r = await res.json();
    tpSendStatus.textContent = `Sent list cleared: ${r.deleted} record(s) removed${r.sheet ? ', Google Sheet rewritten' : ''}. The next mailing starts from the top.`;
    loadTpProfiles();
    loadTpAuto().catch(() => {});
    pollTpSheet().catch(() => {});
  });

  tpSendStopBtn.addEventListener('click', async () => {
    tpSendStopBtn.disabled = true;
    await authedFetch('/admin/tonplace/send/stop', { method: 'POST' });
    pollTpSend();
  });

  // Auto mode: parser schedule

  const tpSchedOn = document.getElementById('tp-sched-on');
  const tpSchedEvery = document.getElementById('tp-sched-every');
  const tpSchedHour = document.getElementById('tp-sched-hour');
  const tpSchedStatus = document.getElementById('tp-sched-status');
  for (let h = 0; h < 24; h++) {
    const o = document.createElement('option');
    o.value = String(h);
    o.textContent = `${String(h).padStart(2, '0')}:00`;
    tpSchedHour.append(o);
  }

  function renderTpSched(s) {
    tpSchedOn.checked = s.enabled;
    tpSchedEvery.value = String(s.every_hours);
    tpSchedHour.value = String(s.start_hour);
    tpSchedStatus.textContent = s.active && s.next_run_at
      ? `On. Next run ${new Date(s.next_run_at).toLocaleString()} (limit ${s.limit}, ${s.sources.join(' + ')}).`
      : 'Off.';
  }

  async function saveTpSched() {
    const sources = [];
    if (document.getElementById('tp-src-search').checked) sources.push('search');
    if (document.getElementById('tp-src-im').checked) sources.push('im');
    tpSchedOn.disabled = true;
    const res = await authedFetch('/admin/tonplace/schedule', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        enabled: tpSchedOn.checked,
        every_hours: parseInt(tpSchedEvery.value, 10),
        start_hour: parseInt(tpSchedHour.value, 10),
        limit: Math.max(1, Math.min(5000, parseInt(document.getElementById('tp-limit').value, 10) || 500)),
        sources,
      }),
    });
    tpSchedOn.disabled = false;
    if (res.ok) {
      renderTpSched(await res.json());
    } else {
      tpSchedStatus.textContent = await readError(res);
      tpSchedOn.checked = !tpSchedOn.checked;
    }
  }

  async function loadTpSched() {
    const res = await authedFetch('/admin/tonplace/schedule');
    if (res.ok) renderTpSched(await res.json());
  }

  tpSchedOn.addEventListener('change', saveTpSched);
  tpSchedEvery.addEventListener('change', () => { if (tpSchedOn.checked) saveTpSched(); });
  tpSchedHour.addEventListener('change', () => { if (tpSchedOn.checked) saveTpSched(); });

  // Auto mode: mailing

  const tpAutoOn = document.getElementById('tp-auto-on');
  const tpAutoDaily = document.getElementById('tp-auto-daily');
  const tpAutoStatus = document.getElementById('tp-auto-status');

  function renderTpAuto(a) {
    tpAutoOn.checked = a.enabled;
    tpAutoDaily.value = String(a.daily_limit);
    if (a.enabled) {
      if (a.message && !tpMsg.value.trim()) tpMsg.value = a.message;
      tpRandomize.checked = !!a.randomize;
      tpAutoStatus.textContent = `On. Sent today ${a.sent_today} of ${a.daily_limit}, ${a.waiting} new profile(s) waiting. Checks every ${a.check_every_minutes} min.`;
    } else {
      tpAutoStatus.textContent = `Off. ${a.waiting} profile(s) not messaged yet.`;
    }
  }

  async function saveTpAuto() {
    const p = tpSendPayload();
    tpAutoOn.disabled = true;
    const res = await authedFetch('/admin/tonplace/auto-send', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        enabled: tpAutoOn.checked,
        message: p.message,
        daily_limit: Math.max(1, Math.min(1000, parseInt(tpAutoDaily.value, 10) || 50)),
        delay_min: p.delay_min,
        delay_max: p.delay_max,
        source: p.source,
        randomize: p.randomize,
      }),
    });
    tpAutoOn.disabled = false;
    if (res.ok) {
      renderTpAuto(await res.json());
      if (tpAutoOn.checked) setTimeout(pollTpSend, 1500);
    } else {
      tpAutoStatus.textContent = await readError(res);
      tpAutoOn.checked = !tpAutoOn.checked;
    }
  }

  async function loadTpAuto() {
    const res = await authedFetch('/admin/tonplace/auto-send');
    if (res.ok) renderTpAuto(await res.json());
  }

  tpAutoOn.addEventListener('change', () => {
    if (tpAutoOn.checked && !confirm('Turn on auto-mailing? New profiles will be messaged automatically with the text above.')) {
      tpAutoOn.checked = false;
      return;
    }
    saveTpAuto();
  });
  tpAutoDaily.addEventListener('change', () => { if (tpAutoOn.checked) saveTpAuto(); });
  tpRandomize.addEventListener('change', () => { if (tpAutoOn.checked) saveTpAuto(); });

  // Auto-reply

  const tpReplyMsg = document.getElementById('tp-reply-msg');
  const tpReplyRandomize = document.getElementById('tp-reply-randomize');
  const tpReplyOn = document.getElementById('tp-reply-on');
  const tpReplyStatus = document.getElementById('tp-reply-status');
  const tpReplySaveBtn = document.getElementById('tp-reply-save-btn');
  let tpReplyTimer = null;

  function renderTpReply(a) {
    tpReplyOn.checked = a.enabled;
    if (a.message && !tpReplyMsg.value.trim()) tpReplyMsg.value = a.message;
    tpReplyRandomize.checked = !!a.randomize;
    document.getElementById('tp-reply-delay-min').value = String(a.delay_min);
    document.getElementById('tp-reply-delay-max').value = String(a.delay_max);
    const r = a.last_result;
    let last = '';
    if (a.running) {
      last = a.progress ? ` Replying: ${a.progress.done} of ${a.progress.total}...` : ' Checking the inbox now...';
    } else if (r && r.error) {
      last = ` Last check failed: ${r.error}`;
    } else if (r && r.status === 'ok') {
      const when = a.last_checked_at ? new Date(a.last_checked_at).toLocaleTimeString() : '';
      const err = r.errors ? `, ${r.errors} failed (${r.last_error})` : '';
      last = ` Last ${r.full_scan ? 'full inbox check' : 'check'} ${when}: ${r.incoming} new answer(s) from mailed profiles, ${r.replied} replied${err}.`;
    }
    const head = a.enabled
      ? `On, checks every ${a.check_every_minutes} min${a.next_check_at ? `, next at ${new Date(a.next_check_at).toLocaleTimeString()}` : ''}.`
      : 'Off.';
    tpReplyStatus.textContent = `${head} Replied today ${a.replied_today}, total ${a.replied_total}.${last}`;
  }

  function tpReplyPayload(enabled) {
    const num = (id, def) => parseFloat(document.getElementById(id).value) || def;
    return {
      enabled,
      message: tpReplyMsg.value.trim(),
      randomize: tpReplyRandomize.checked,
      delay_min: num('tp-reply-delay-min', 5),
      delay_max: num('tp-reply-delay-max', 15),
    };
  }

  async function saveTpReply(enabled) {
    const res = await authedFetch('/admin/tonplace/auto-reply', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(tpReplyPayload(enabled)),
    });
    if (!res.ok) {
      tpReplyStatus.textContent = await readError(res);
      return false;
    }
    renderTpReply(await res.json());
    return true;
  }

  async function loadTpReply() {
    clearTimeout(tpReplyTimer);
    const res = await authedFetch('/admin/tonplace/auto-reply');
    if (res.ok) {
      const a = await res.json();
      renderTpReply(a);
      if (a.enabled || a.running) tpReplyTimer = setTimeout(loadTpReply, a.running ? 3000 : 60000);
    }
  }

  tpReplySaveBtn.addEventListener('click', async () => {
    tpReplySaveBtn.disabled = true;
    if (await saveTpReply(tpReplyOn.checked)) tpReplyStatus.textContent = 'Saved. ' + tpReplyStatus.textContent;
    tpReplySaveBtn.disabled = false;
  });

  async function runTpReplyCheck(all) {
    if (!tpReplyMsg.value.trim()) {
      tpReplyStatus.textContent = 'Write the reply message first.';
      tpReplyMsg.focus();
      return;
    }
    const question = all
      ? 'Go through the WHOLE inbox now and send the reply to everyone from the mailing who answered and has not got it yet?'
      : 'Check the newest dialogs now and send the reply to everyone from the mailing who answered?';
    if (!confirm(question)) return;
    tpReplyAllBtn.disabled = true;
    if (await saveTpReply(tpReplyOn.checked)) {
      tpReplyStatus.textContent = 'Checking the inbox...';
      const res = await authedFetch('/admin/tonplace/auto-reply/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ all }),
      });
      if (res.ok) {
        renderTpReply(await res.json());
        loadTpReply().catch(() => {});
      } else {
        tpReplyStatus.textContent = await readError(res);
      }
    }
    tpReplyAllBtn.disabled = false;
  }

  const tpReplyAllBtn = document.getElementById('tp-reply-all-btn');
  tpReplyAllBtn.addEventListener('click', () => runTpReplyCheck(true));

  tpReplyOn.addEventListener('change', async () => {
    if (tpReplyOn.checked && !confirm('Turn on auto-reply? Everyone from the mailing who answers will get the reply message automatically.')) {
      tpReplyOn.checked = false;
      return;
    }
    tpReplyOn.disabled = true;
    if (!(await saveTpReply(tpReplyOn.checked))) tpReplyOn.checked = !tpReplyOn.checked;
    tpReplyOn.disabled = false;
    loadTpReply().catch(() => {});
  });

  // Google Sheet

  const tpSheetStatus = document.getElementById('tp-sheet-status');
  const tpSheetBtn = document.getElementById('tp-sheet-btn');
  let tpSheetTimer = null;

  function renderTpSheet(s) {
    const r = s.last_result;
    tpSheetStatus.replaceChildren();
    if (s.running) {
      tpSheetStatus.textContent = 'Google Sheet: updating...';
    } else if (r && r.error) {
      tpSheetStatus.textContent = `Google Sheet: last update failed: ${r.error}`;
    } else if (r) {
      const a = document.createElement('a');
      a.href = r.web_view_link;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = 'the sheet';
      tpSheetStatus.append('Open ', a, `, updated ${new Date(s.last_finished_at).toLocaleString()}.`);
      loadTpProfiles().catch(() => {});
    } else {
      tpSheetStatus.textContent = 'Not synced since the last server restart. Press "Sync Google Sheet now" to get the link.';
    }
    tpSheetBtn.disabled = s.running;
  }

  async function pollTpSheet() {
    clearTimeout(tpSheetTimer);
    const res = await authedFetch('/admin/tonplace/sheet/status');
    if (!res.ok) return;
    const s = await res.json();
    renderTpSheet(s);
    tpSheetTimer = setTimeout(pollTpSheet, s.running ? 3000 : 30000);
  }

  tpSheetBtn.addEventListener('click', async () => {
    tpSheetBtn.disabled = true;
    const res = await authedFetch('/admin/tonplace/sheet/sync', { method: 'POST' });
    if (!res.ok) {
      tpSheetStatus.textContent = await readError(res);
      tpSheetBtn.disabled = false;
      return;
    }
    renderTpSheet(await res.json());
    pollTpSheet();
  });

  // Telegram daily report

  const tpTgOn = document.getElementById('tp-tg-on');
  const tpTgHour = document.getElementById('tp-tg-hour');
  const tpTgStatus = document.getElementById('tp-tg-status');
  const tpTgSendBtn = document.getElementById('tp-tg-send-btn');
  for (let h = 0; h < 24; h++) {
    const o = document.createElement('option');
    o.value = String(h);
    o.textContent = `${String(h).padStart(2, '0')}:00`;
    tpTgHour.append(o);
  }

  function renderTpTg(t) {
    tpTgOn.checked = t.enabled;
    tpTgHour.value = String(t.hour);
    if (!t.configured) {
      tpTgStatus.textContent = 'The bot is not connected yet: TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID must be set on the server.';
    } else if (t.enabled && t.next_run_at) {
      tpTgStatus.textContent = `On. Next report ${new Date(t.next_run_at).toLocaleString()}.`;
    } else {
      tpTgStatus.textContent = 'Bot connected. Daily report is off.';
    }
    tpTgOn.disabled = !t.configured;
    tpTgSendBtn.disabled = !t.configured;
  }

  async function saveTpTg() {
    tpTgOn.disabled = true;
    const res = await authedFetch('/admin/tonplace/telegram', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled: tpTgOn.checked, hour: parseInt(tpTgHour.value, 10) }),
    });
    tpTgOn.disabled = false;
    if (res.ok) {
      renderTpTg(await res.json());
    } else {
      tpTgStatus.textContent = await readError(res);
      tpTgOn.checked = !tpTgOn.checked;
    }
  }

  async function loadTpTg() {
    const res = await authedFetch('/admin/tonplace/telegram');
    if (res.ok) renderTpTg(await res.json());
  }

  tpTgOn.addEventListener('change', saveTpTg);
  tpTgHour.addEventListener('change', () => { if (tpTgOn.checked) saveTpTg(); });
  tpTgSendBtn.addEventListener('click', async () => {
    tpTgSendBtn.disabled = true;
    const res = await authedFetch('/admin/tonplace/telegram/send', { method: 'POST' });
    tpTgSendBtn.disabled = false;
    if (res.ok) {
      const { stats } = await res.json();
      tpTgStatus.textContent = `Sent to Telegram: ${stats.new_profiles} new models, ${stats.sent} messages today.`;
    } else {
      tpTgStatus.textContent = await readError(res);
    }
  });

  function loadTonplace() {
    loadTpTg().catch(() => {});
    loadTpSched().catch(() => {});
    loadTpAuto().catch(() => {});
    loadTpAi().catch(() => {});
    loadTpReply().catch(() => {});
    pollTpSheet().catch(() => {});
    loadTpSession().catch(() => {});
    pollTpStatus().catch(() => {});
    pollTpSend().catch(() => {});
    loadTpProfiles().catch(() => {});
  }

  async function init() {
    try {
      const res = await authedFetch('/auth/me');
      if (!res.ok) throw new Error();
      const me = await res.json();
      if (!me.is_admin) {
        deniedEl.hidden = false;
        return;
      }
      contentEl.hidden = false;
      await loadLinks().catch(() => {});
      await pollImportStatus();
      await pollExportStatus();
      await loadSchedule().catch(() => {});
      loadOfPanel();
      showTab(location.hash.slice(1));
    } catch {
      deniedEl.hidden = false;
    }
  }

  init();
</script>
