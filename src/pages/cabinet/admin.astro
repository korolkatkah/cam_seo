---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Admin Panel | EWO"
  description="Assign Instagram outreach tasks to workers and review their reports."
  lang="en"
  noindex={true}
>

<div class="cabinet-wrap container">
  <div class="cabinet-header">
    <h1>Admin Panel</h1>
    <button id="logout-btn" class="ghost-btn">Log out</button>
  </div>

  <p id="denied" class="cabinet-error" hidden>Your account is not an admin.</p>

  <section id="admin-content" hidden>
    <div class="glass-card assign-card">
      <div class="targets-header">
        <h2 class="section-title">Tracking links</h2>
        <button id="refresh-links-btn" class="ghost-btn">Refresh</button>
      </div>
      <p class="bulk-hint">One link per worker for the EWOMODELS mini-landing. Every visit and button click is counted under the worker whose link was opened.</p>
      <div class="targets-table-wrap links-table-wrap">
        <table class="targets-table">
          <thead>
            <tr>
              <th>Worker</th><th>Link</th><th class="num-h">Visits</th><th class="num-h">Agency</th><th class="num-h">Traffic</th><th class="num-h">Analytics</th><th class="num-h">Promo</th><th class="num-h">Clicks</th><th>Last activity</th><th></th>
            </tr>
          </thead>
          <tbody id="links-body"></tbody>
        </table>
      </div>
      <form id="link-form" class="link-form">
        <label>
          Ref (in the link)
          <input type="text" id="link-ref" required minlength="2" maxlength="32" pattern="[a-zA-Z0-9_\-]{2,32}" placeholder="anna" />
        </label>
        <label>
          Worker name (optional)
          <input type="text" id="link-label" maxlength="255" placeholder="Anna K." />
        </label>
        <button type="submit">Create link</button>
      </form>
      <p id="link-error" class="cabinet-error" hidden></p>
      <p id="link-success" class="cabinet-success" hidden></p>
    </div>

    <div class="glass-card import-card">
      <h2>Instagram targets database</h2>
      <div class="progress" id="import-progress" hidden aria-hidden="true">
        <div class="progress__fill" id="import-progress-fill"></div>
      </div>
      <label class="category-field">
        Category to parse
        <input type="text" id="import-category" placeholder="https://ru.stripchat.com/girls/young" autocomplete="off" spellcheck="false" />
      </label>
      <p class="bulk-hint category-hint">Paste a Stripchat category link (girls, men or trans sections). Leave empty for the default: girls/young (Young 22+).</p>
      <p id="import-category-error" class="cabinet-error" hidden></p>
      <p class="import-status" id="import-status" role="status" aria-live="polite">Idle.</p>
      <div class="import-actions">
        <button id="run-import-btn" class="import-btn">Run import now</button>
        <button id="stop-import-btn" class="import-btn export-btn stop-btn" disabled title="Available while an import is running">Stop import</button>
      </div>

      <p class="import-status" id="export-status" style="margin-top:1rem;">Idle.</p>
      <button id="run-export-btn" class="import-btn export-btn">Export to Google Sheet</button>
      <p id="export-link" class="import-status" hidden></p>
    </div>
  </section>
</div>

<style>
  .cabinet-wrap {
    padding: 3rem 1.5rem;
    max-width: 780px;
  }
  .cabinet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .cabinet-header h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--fg);
    margin: 0;
  }
  .ghost-btn {
    font: inherit;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .ghost-btn:hover { color: var(--fg); }
  .cabinet-error { color: #c0392b; font-size: 0.85rem; }
  .cabinet-success { color: #1e6b34; font-size: 0.85rem; }

  .assign-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .assign-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .assign-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .assign-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .assign-form input,
  .assign-form textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
    resize: vertical;
  }
  .assign-form button {
    align-self: flex-start;
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .assign-form button:hover { opacity: 0.85; }
  .bulk-hint {
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin: -0.5rem 0 0.9rem;
  }
  .links-table-wrap { margin-bottom: 1.25rem; }
  /* Rows are built in JS, so their selectors must be :global (Astro scopes styles to the template). */
  .targets-table th.num-h { text-align: right; }
  :global(.targets-table td.num) { text-align: right; font-variant-numeric: tabular-nums; }
  :global(.targets-table td.total) { font-weight: 700; color: var(--fg); }
  :global(.link-cell) { display: flex; align-items: center; gap: 0.5rem; }
  :global(.link-cell code) { font-size: 0.78rem; color: var(--fg-muted); white-space: nowrap; }
  :global(.copy-btn) {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  :global(.copy-btn:hover) { color: var(--fg); }
  .link-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.9rem;
  }
  .link-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    flex: 1 1 180px;
  }
  .link-form input {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
  }
  .link-form button {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .link-form button:hover { opacity: 0.85; }

  .import-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .import-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--fg);
  }
  .import-status {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin: 0 0 1rem;
  }
  .progress {
    height: 8px;
    border-radius: 999px;
    background: var(--bg-subtle);
    overflow: hidden;
    margin: 0 0 0.75rem;
  }
  .progress__fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--accent);
    transition: width 0.6s ease;
  }
  .progress__fill.is-indeterminate {
    width: 35%;
    animation: progress-slide 1.2s ease-in-out infinite alternate;
  }
  @keyframes progress-slide {
    from { margin-left: 0; }
    to { margin-left: 65%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .progress__fill.is-indeterminate { animation: none; margin-left: 0; width: 100%; opacity: 0.4; }
  }
  .import-btn {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .import-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .category-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-bottom: 0.4rem;
  }
  .category-field input {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
  }
  .category-field input:disabled { opacity: 0.6; }
  .category-hint { margin: 0 0 0.75rem; }
  .stop-btn { color: #a12a2a; border-color: rgba(161, 42, 42, 0.35); }
  :global(.undo-btn) {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: #a12a2a;
    cursor: pointer;
  }
  .import-btn:hover { opacity: 0.85; }
  .import-btn:disabled { opacity: 0.5; cursor: default; }
  .export-btn {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--bg-subtle);
  }
  #export-link a { color: var(--fg); font-weight: 600; }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--fg);
    margin: 0 0 1rem;
  }
  .targets-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .targets-header .section-title { margin: 0; }
  .targets-table-wrap {
    overflow-x: auto;
    margin-bottom: 2.5rem;
    border: 1px solid var(--bg-subtle);
    border-radius: 12px;
  }
  .targets-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .targets-table th,
  .targets-table td {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--bg-subtle);
    white-space: nowrap;
  }
  .targets-table th {
    color: var(--fg-muted);
    font-weight: 600;
    background: var(--bg-raised);
  }
  .targets-table tr:last-child td { border-bottom: none; }
  .targets-table td.username { font-weight: 600; color: var(--fg); }
  .ig-link { color: var(--fg); font-weight: 600; text-decoration: none; }
  .ig-link:hover { text-decoration: underline; }
  .targets-table td.source a { color: var(--fg-muted); text-decoration: none; }
  .targets-table td.source a:hover { text-decoration: underline; }
</style>

</Base>

<script>
  const API_BASE = 'https://worker-cabinet-production.up.railway.app';
  const token = localStorage.getItem('cabinet_token');
  if (!token) {
    window.location.href = '/cabinet/login';
  }

  const deniedEl = document.getElementById('denied');
  const contentEl = document.getElementById('admin-content');

  document.getElementById('logout-btn').addEventListener('click', () => {
    localStorage.removeItem('cabinet_token');
    window.location.href = '/cabinet/login';
  });

  async function authedFetch(path, options = {}) {
    const res = await fetch(`${API_BASE}${path}`, {
      ...options,
      headers: { ...(options.headers || {}), Authorization: `Bearer ${token}` },
    });
    if (res.status === 401) {
      localStorage.removeItem('cabinet_token');
      window.location.href = '/cabinet/login';
      throw new Error('Session expired');
    }
    return res;
  }

  // --- Instagram targets database + manual import ---

  const importStatusEl = document.getElementById('import-status');
  const runImportBtn = document.getElementById('run-import-btn');
  const stopImportBtn = document.getElementById('stop-import-btn');
  const categoryInput = document.getElementById('import-category');
  const categoryErrorEl = document.getElementById('import-category-error');
  let pollTimer = null;

  try {
    categoryInput.value = localStorage.getItem('import_category') || '';
  } catch {}

  const progressEl = document.getElementById('import-progress');
  const progressFillEl = document.getElementById('import-progress-fill');
  let lastImportState = null;

  function fmtDuration(ms) {
    const total = Math.max(0, Math.round(ms / 1000));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const sec = total % 60;
    if (h) return `${h}h ${m}m`;
    if (m) return `${m}m ${String(sec).padStart(2, '0')}s`;
    return `${sec}s`;
  }

  function setProgress(pct) {
    progressEl.hidden = false;
    if (pct === null) {
      progressFillEl.classList.add('is-indeterminate');
      progressFillEl.style.width = '';
    } else {
      progressFillEl.classList.remove('is-indeterminate');
      progressFillEl.style.width = `${pct}%`;
    }
  }

  function renderImportStatus(state) {
    lastImportState = state;
    stopImportBtn.disabled = !state.running || !!state.stopping;
    stopImportBtn.textContent = state.stopping ? 'Stopping...' : 'Stop import';
    categoryInput.disabled = !!state.running;
    const categoryNote = state.category ? ` · category ${state.category}` : '';
    if (state.running) {
      const p = state.progress || {};
      const elapsed = state.last_started_at ? Date.now() - new Date(state.last_started_at).getTime() : 0;
      if (p.phase === 'checking_profiles' && p.total) {
        const pct = Math.round((p.checked / p.total) * 100);
        setProgress(pct);
        const eta = p.checked >= 10 ? ` · about ${fmtDuration((elapsed / p.checked) * (p.total - p.checked))} left` : '';
        const current = p.current ? ` · checking ${p.current}` : '';
        importStatusEl.textContent =
          `Importing${categoryNote}: ${p.checked} of ${p.total} profiles (${pct}%) · ${p.saved} new · ${p.skipped} skipped · ${fmtDuration(elapsed)} elapsed${eta}${current}`;
      } else if (p.phase === 'fetching_list') {
        setProgress(null);
        importStatusEl.textContent = `Importing${categoryNote}: fetching the model list (page ${p.page || 0} of ${p.pages || '?'}) · ${fmtDuration(elapsed)} elapsed`;
      } else {
        setProgress(null);
        importStatusEl.textContent = `Importing${categoryNote}: starting... · ${fmtDuration(elapsed)} elapsed`;
      }
      if (state.stopping) {
        importStatusEl.textContent = `Stopping after the current profile... ${importStatusEl.textContent}`;
      }
      return;
    }
    progressEl.hidden = true;
    if (state.last_result?.error) {
      importStatusEl.textContent = `Last run failed: ${state.last_result.error}`;
    } else if (state.last_result) {
      const { fetched = 0, saved = 0, skipped = 0, stopped = false } = state.last_result;
      const at = state.last_finished_at ? ` (finished ${new Date(state.last_finished_at).toLocaleString()})` : '';
      const verb = stopped ? 'stopped by you after' : 'checked';
      const lastCategory = state.last_result.category ? ` [${state.last_result.category}]` : '';
      importStatusEl.textContent = `Last run${at}${lastCategory}: ${verb} ${fetched} profiles, ${saved} new, ${skipped} skipped.`;
    } else {
      importStatusEl.textContent = 'Idle. No import has run since the server started.';
    }
  }

  // Keep the elapsed timer moving between the 4-second polls.
  setInterval(() => {
    if (lastImportState?.running) renderImportStatus(lastImportState);
  }, 1000);

  async function pollImportStatus() {
    const res = await authedFetch('/admin/import/status');
    if (!res.ok) return;
    const state = await res.json();
    renderImportStatus(state);
    runImportBtn.disabled = state.running;
    runImportBtn.textContent = state.running ? 'Running...' : 'Run import now';
    // The sheet is refreshed while the import runs, so show its progress too.
    await pollExportStatus();

    if (state.running) {
      if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
    } else if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  runImportBtn.addEventListener('click', async () => {
    categoryErrorEl.hidden = true;
    const category = categoryInput.value.trim();
    try {
      localStorage.setItem('import_category', category);
    } catch {}

    runImportBtn.disabled = true;
    runImportBtn.textContent = 'Checking category...';
    try {
      const res = await authedFetch('/admin/import/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category: category || null }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok) {
        // A bad category is refused before anything starts: show why and let the admin fix it.
        categoryErrorEl.textContent = data?.detail || 'Could not start the import.';
        categoryErrorEl.hidden = false;
        runImportBtn.disabled = false;
        runImportBtn.textContent = 'Run import now';
        return;
      }
      renderImportStatus(data);
      runImportBtn.textContent = 'Running...';
      if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
    } catch (err) {
      categoryErrorEl.textContent = err instanceof Error ? err.message : 'Could not start the import.';
      categoryErrorEl.hidden = false;
      runImportBtn.disabled = false;
      runImportBtn.textContent = 'Run import now';
    }
  });

  stopImportBtn.addEventListener('click', async () => {
    if (!confirm('Stop the import? Accounts found so far are kept, the sheet is updated, and you can run it again later.')) return;
    stopImportBtn.disabled = true;
    stopImportBtn.textContent = 'Stopping...';
    try {
      const res = await authedFetch('/admin/import/stop', { method: 'POST' });
      if (res.ok) renderImportStatus(await res.json());
    } catch {
      stopImportBtn.disabled = false;
      stopImportBtn.textContent = 'Stop import';
    }
    if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
  });

  // --- Google Drive export ---

  const exportStatusEl = document.getElementById('export-status');
  const runExportBtn = document.getElementById('run-export-btn');
  const exportLinkEl = document.getElementById('export-link');
  let exportPollTimer = null;

  function formatExportStatus(state) {
    const rows = state.last_result?.rows;
    const last = state.last_result && !state.last_result.error
      ? ` Last update${state.last_finished_at ? ` ${new Date(state.last_finished_at).toLocaleTimeString()}` : ''}${rows != null ? `, ${rows} rows` : ''}${state.last_result.added ? ` (+${state.last_result.added} new)` : ''}${state.last_result.marked ? `, ${state.last_result.marked} marks updated` : ''}.`
      : '';
    if (state.running) return `Sheet: updating...${last}`;
    if (state.last_result?.error) return `Last export failed: ${state.last_result.error}`;
    if (state.last_result) return `Sheet up to date.${last}`;
    return 'Sheet: no export yet.';
  }

  async function pollExportStatus() {
    const res = await authedFetch('/admin/export/status');
    if (!res.ok) return;
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.disabled = state.running;
    runExportBtn.textContent = state.running ? 'Exporting...' : 'Export to Google Sheet';

    if (state.last_result?.web_view_link) {
      exportLinkEl.innerHTML = `<a href="${state.last_result.web_view_link}" target="_blank" rel="noopener">Open spreadsheet →</a>`;
      exportLinkEl.hidden = false;
    }

    if (state.running) {
      if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
    } else if (exportPollTimer) {
      clearInterval(exportPollTimer);
      exportPollTimer = null;
    }
  }

  runExportBtn.addEventListener('click', async () => {
    runExportBtn.disabled = true;
    const res = await authedFetch('/admin/export/run', { method: 'POST' });
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.textContent = 'Exporting...';
    if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
  });

  // --- Tracking links (per-worker /links?ref=... with click counters) ---

  const linksBody = document.getElementById('links-body');

  function textCell(text, className) {
    const td = document.createElement('td');
    if (className) td.className = className;
    td.textContent = text;
    return td;
  }

  async function loadLinks() {
    const res = await authedFetch('/admin/links');
    if (!res.ok) return;
    const data = await res.json();
    linksBody.innerHTML = '';
    for (const item of data.items) {
      const tr = document.createElement('tr');

      const nameTd = document.createElement('td');
      nameTd.className = 'username';
      nameTd.textContent = item.ref === 'direct' ? item.label : item.label ? `${item.label} (${item.ref})` : item.ref;

      const linkTd = document.createElement('td');
      const cell = document.createElement('div');
      cell.className = 'link-cell';
      const code = document.createElement('code');
      code.textContent = item.url.replace('https://', '');
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy-btn';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(item.url);
          copyBtn.textContent = 'Copied';
        } catch {
          copyBtn.textContent = 'Failed';
        }
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
      });
      cell.append(code, copyBtn);
      linkTd.appendChild(cell);

      const actionTd = document.createElement('td');
      if (item.ref !== 'direct') {
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'undo-btn';
        delBtn.textContent = 'Delete';
        delBtn.addEventListener('click', async () => {
          const stats = `${item.visits} visits and ${item.total_clicks} clicks`;
          if (!confirm(`Delete the link "${item.ref}"? Its statistics (${stats}) are deleted too. This cannot be undone.`)) return;
          delBtn.disabled = true;
          const r = await authedFetch(`/admin/links/${encodeURIComponent(item.ref)}`, { method: 'DELETE' });
          if (r.ok) await loadLinks();
          else delBtn.disabled = false;
        });
        actionTd.appendChild(delBtn);
      }

      const last = item.last_event_at ? new Date(item.last_event_at).toLocaleString() : '—';
      tr.append(
        nameTd,
        linkTd,
        textCell(item.visits, 'num'),
        textCell(item.clicks.agency, 'num'),
        textCell(item.clicks.traffic, 'num'),
        textCell(item.clicks.analytics, 'num'),
        textCell(item.clicks.promo ?? 0, 'num'),
        textCell(item.total_clicks, 'num total'),
        textCell(last),
        actionTd,
      );
      linksBody.appendChild(tr);
    }
  }

  document.getElementById('refresh-links-btn').addEventListener('click', loadLinks);

  document.getElementById('link-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const linkError = document.getElementById('link-error');
    const linkSuccess = document.getElementById('link-success');
    linkError.hidden = true;
    linkSuccess.hidden = true;

    const ref = document.getElementById('link-ref').value;
    const label = document.getElementById('link-label').value || null;

    try {
      const res = await authedFetch('/admin/links', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ref, label }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(typeof data?.detail === 'string' ? data.detail : 'Failed to create link');
      }
      const created = await res.json();
      linkSuccess.textContent = `Created: ${created.url}`;
      linkSuccess.hidden = false;
      document.getElementById('link-form').reset();
      await loadLinks();
    } catch (err) {
      linkError.textContent = err instanceof Error ? err.message : 'Failed to create link';
      linkError.hidden = false;
    }
  });

  async function init() {
    try {
      const res = await authedFetch('/auth/me');
      if (!res.ok) throw new Error();
      const me = await res.json();
      if (!me.is_admin) {
        deniedEl.hidden = false;
        return;
      }
      contentEl.hidden = false;
      await loadLinks().catch(() => {});
      await pollImportStatus();
      await pollExportStatus();
    } catch {
      deniedEl.hidden = false;
    }
  }

  init();
</script>
