---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Admin Panel | EWO"
  description="Assign Instagram outreach tasks to workers and review their reports."
  lang="en"
  noindex={true}
>

<div class="cabinet-wrap container">
  <div class="cabinet-header">
    <h1>Admin Panel</h1>
    <button id="logout-btn" class="ghost-btn">Log out</button>
  </div>

  <p id="denied" class="cabinet-error" hidden>Your account is not an admin.</p>

  <section id="admin-content" hidden>
    <div class="glass-card assign-card">
      <div class="targets-header">
        <h2 class="section-title">Tracking links</h2>
        <button id="refresh-links-btn" class="ghost-btn">Refresh</button>
      </div>
      <p class="bulk-hint">One link per worker for the EWOMODELS mini-landing. Every visit and button click is counted under the worker whose link was opened.</p>
      <div class="targets-table-wrap links-table-wrap">
        <table class="targets-table">
          <thead>
            <tr>
              <th>Worker</th><th>Link</th><th>Visits</th><th>Agency</th><th>Traffic</th><th>Analytics</th><th>Clicks</th><th>Last activity</th>
            </tr>
          </thead>
          <tbody id="links-body"></tbody>
        </table>
      </div>
      <form id="link-form" class="link-form">
        <label>
          Ref (in the link)
          <input type="text" id="link-ref" required minlength="2" maxlength="32" pattern="[a-zA-Z0-9_\-]{2,32}" placeholder="anna" />
        </label>
        <label>
          Worker name (optional)
          <input type="text" id="link-label" maxlength="255" placeholder="Anna K." />
        </label>
        <button type="submit">Create link</button>
      </form>
      <p id="link-error" class="cabinet-error" hidden></p>
      <p id="link-success" class="cabinet-success" hidden></p>
    </div>

    <div class="glass-card assign-card">
      <h2>Assign a task</h2>
      <form id="assign-form" class="assign-form">
        <label>
          Worker email
          <input type="email" id="worker-email" required placeholder="worker@example.com" />
        </label>
        <label>
          Instagram username
          <input type="text" id="target-username" required placeholder="some_model_acc" />
        </label>
        <label>
          Message text (optional)
          <textarea id="message-text" rows="2"></textarea>
        </label>
        <button type="submit">Assign</button>
        <p id="assign-error" class="cabinet-error" hidden></p>
        <p id="assign-success" class="cabinet-success" hidden>Task assigned.</p>
      </form>
    </div>

    <div class="glass-card assign-card">
      <h2>Bulk assign</h2>
      <p class="bulk-hint">Hands the worker the next N accounts from the database that haven't been assigned to anyone yet — no need to type usernames one by one.</p>
      <form id="bulk-form" class="assign-form">
        <label>
          Worker email
          <input type="email" id="bulk-worker-email" required placeholder="worker@example.com" />
        </label>
        <label>
          How many accounts
          <input type="number" id="bulk-count" required min="1" max="500" value="20" />
        </label>
        <label>
          Message text (optional)
          <textarea id="bulk-message-text" rows="2"></textarea>
        </label>
        <button type="submit">Assign batch</button>
        <p id="bulk-error" class="cabinet-error" hidden></p>
        <p id="bulk-success" class="cabinet-success" hidden></p>
      </form>
    </div>

    <div class="glass-card import-card">
      <h2>Instagram targets database</h2>
      <p class="import-status" id="import-status">Idle.</p>
      <button id="run-import-btn" class="import-btn">Run import now</button>

      <p class="import-status" id="export-status" style="margin-top:1rem;">Idle.</p>
      <button id="run-export-btn" class="import-btn export-btn">Export to Google Sheet</button>
      <p id="export-link" class="import-status" hidden></p>
    </div>

    <div class="targets-header">
      <h2 class="section-title">Instagram targets (<span id="targets-total">0</span>)</h2>
      <button id="refresh-targets-btn" class="ghost-btn">Refresh</button>
    </div>
    <div class="targets-table-wrap">
      <table class="targets-table">
        <thead>
          <tr><th>Username</th><th>Source</th><th>Added</th></tr>
        </thead>
        <tbody id="targets-body"></tbody>
      </table>
    </div>
    <p id="targets-empty" hidden>No targets scraped yet.</p>

    <h2 class="section-title">All tasks</h2>
    <div class="filter-row">
      <button data-filter="reported" class="filter-btn is-active">Awaiting review</button>
      <button data-filter="">All</button>
      <button data-filter="pending">Pending</button>
      <button data-filter="approved">Approved</button>
      <button data-filter="rejected">Rejected</button>
    </div>
    <p id="empty-state" hidden>No tasks in this view.</p>
    <div id="task-list"></div>
  </section>
</div>

<template id="task-row-template">
  <div class="task-row">
    <div class="task-row__main">
      <div>
        <span class="task-row__worker" data-field="worker"></span>
        <span class="task-row__target">→ <a class="ig-link" data-field="target" target="_blank" rel="noopener"></a></span>
      </div>
      <span class="task-row__status" data-field="status"></span>
    </div>
    <p class="task-row__message" data-field="message"></p>
    <p class="task-row__screenshot" data-field="screenshot" hidden></p>
    <div class="task-row__actions" data-field="review-actions" hidden>
      <input type="text" data-field="note" placeholder="Note (optional)" />
      <button data-field="approve-btn" class="approve-btn">Approve</button>
      <button data-field="reject-btn" class="reject-btn">Reject</button>
    </div>
    <p class="task-row__note" data-field="existing-note" hidden></p>
  </div>
</template>

<style>
  .cabinet-wrap {
    padding: 3rem 1.5rem;
    max-width: 780px;
  }
  .cabinet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .cabinet-header h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--fg);
    margin: 0;
  }
  .ghost-btn {
    font: inherit;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .ghost-btn:hover { color: var(--fg); }
  .cabinet-error { color: #c0392b; font-size: 0.85rem; }
  .cabinet-success { color: #1e6b34; font-size: 0.85rem; }

  .assign-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .assign-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .assign-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .assign-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .assign-form input,
  .assign-form textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
    resize: vertical;
  }
  .assign-form button {
    align-self: flex-start;
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .assign-form button:hover { opacity: 0.85; }
  .bulk-hint {
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin: -0.5rem 0 0.9rem;
  }
  .links-table-wrap { margin-bottom: 1.25rem; }
  .targets-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .targets-table th.num-h { text-align: right; }
  .targets-table td.total { font-weight: 700; color: var(--fg); }
  .link-cell { display: flex; align-items: center; gap: 0.5rem; }
  .link-cell code { font-size: 0.78rem; color: var(--fg-muted); white-space: nowrap; }
  .copy-btn {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .copy-btn:hover { color: var(--fg); }
  .link-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.9rem;
  }
  .link-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    flex: 1 1 180px;
  }
  .link-form input {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
  }
  .link-form button {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .link-form button:hover { opacity: 0.85; }

  .import-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .import-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--fg);
  }
  .import-status {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin: 0 0 1rem;
  }
  .import-btn {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .import-btn:hover { opacity: 0.85; }
  .import-btn:disabled { opacity: 0.5; cursor: default; }
  .export-btn {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--bg-subtle);
  }
  #export-link a { color: var(--fg); font-weight: 600; }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--fg);
    margin: 0 0 1rem;
  }
  .targets-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .targets-header .section-title { margin: 0; }
  .targets-table-wrap {
    overflow-x: auto;
    margin-bottom: 2.5rem;
    border: 1px solid var(--bg-subtle);
    border-radius: 12px;
  }
  .targets-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .targets-table th,
  .targets-table td {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--bg-subtle);
    white-space: nowrap;
  }
  .targets-table th {
    color: var(--fg-muted);
    font-weight: 600;
    background: var(--bg-raised);
  }
  .targets-table tr:last-child td { border-bottom: none; }
  .targets-table td.username { font-weight: 600; color: var(--fg); }
  .ig-link { color: var(--fg); font-weight: 600; text-decoration: none; }
  .ig-link:hover { text-decoration: underline; }
  .targets-table td.source a { color: var(--fg-muted); text-decoration: none; }
  .targets-table td.source a:hover { text-decoration: underline; }
  .filter-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .filter-btn {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .filter-btn.is-active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  #task-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .task-row {
    background: var(--bg-raised);
    border: 1px solid var(--bg-subtle);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .task-row__main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .task-row__worker {
    font-weight: 700;
    color: var(--fg);
  }
  .task-row__target {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .task-row__status {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--bg-subtle);
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .task-row__status--reported { background: #fff3cd; color: #7a5c00; }
  .task-row__status--approved { background: #d4edda; color: #1e6b34; }
  .task-row__status--rejected { background: #f8d7da; color: #a12a2a; }
  .task-row__message {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 0 0 0.6rem;
  }
  .task-row__screenshot a {
    color: var(--fg);
    font-size: 0.85rem;
  }
  .task-row__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .task-row__actions input {
    font: inherit;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
    flex: 1 1 180px;
  }
  .task-row__actions button {
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
  }
  .approve-btn { background: #1e6b34; color: #fff; }
  .reject-btn { background: #a12a2a; color: #fff; }
  .task-row__note {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
</style>

</Base>

<script>
  const API_BASE = 'https://worker-cabinet-production.up.railway.app';
  const token = localStorage.getItem('cabinet_token');
  if (!token) {
    window.location.href = '/cabinet/login';
  }

  const deniedEl = document.getElementById('denied');
  const contentEl = document.getElementById('admin-content');
  const listEl = document.getElementById('task-list');
  const emptyEl = document.getElementById('empty-state');
  const template = document.getElementById('task-row-template');
  let currentFilter = 'reported';

  document.getElementById('logout-btn').addEventListener('click', () => {
    localStorage.removeItem('cabinet_token');
    window.location.href = '/cabinet/login';
  });

  async function authedFetch(path, options = {}) {
    const res = await fetch(`${API_BASE}${path}`, {
      ...options,
      headers: { ...(options.headers || {}), Authorization: `Bearer ${token}` },
    });
    if (res.status === 401) {
      localStorage.removeItem('cabinet_token');
      window.location.href = '/cabinet/login';
      throw new Error('Session expired');
    }
    return res;
  }

  function renderTask(task) {
    const node = template.content.cloneNode(true);
    const row = node.querySelector('.task-row');
    row.querySelector('[data-field="worker"]').textContent = task.worker_email;
    const targetLink = row.querySelector('[data-field="target"]');
    targetLink.textContent = `@${task.target_username}`;
    targetLink.href = `https://www.instagram.com/${encodeURIComponent(task.target_username)}/`;
    row.querySelector('[data-field="message"]').textContent = task.message_text || '';

    const statusEl = row.querySelector('[data-field="status"]');
    statusEl.textContent = task.status;
    statusEl.classList.add(`task-row__status--${task.status}`);

    if (task.proof_screenshot_path) {
      const p = row.querySelector('[data-field="screenshot"]');
      p.hidden = false;
      p.textContent = `Screenshot attached: ${task.proof_screenshot_path}`;
    }

    if (task.status === 'reported') {
      const actions = row.querySelector('[data-field="review-actions"]');
      actions.hidden = false;
      const noteInput = row.querySelector('[data-field="note"]');
      const approveBtn = row.querySelector('[data-field="approve-btn"]');
      const rejectBtn = row.querySelector('[data-field="reject-btn"]');

      const review = async (approve) => {
        approveBtn.disabled = true;
        rejectBtn.disabled = true;
        try {
          const res = await authedFetch(`/tasks/${task.id}/review`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ approve, note: noteInput.value || null }),
          });
          if (!res.ok) throw new Error('Review failed');
          await loadTasks();
        } catch {
          approveBtn.disabled = false;
          rejectBtn.disabled = false;
        }
      };
      approveBtn.addEventListener('click', () => review(true));
      rejectBtn.addEventListener('click', () => review(false));
    } else if (task.review_note) {
      const noteEl = row.querySelector('[data-field="existing-note"]');
      noteEl.hidden = false;
      noteEl.textContent = `Note: ${task.review_note}`;
    }

    listEl.appendChild(row);
  }

  async function loadTasks() {
    listEl.innerHTML = '';
    const qs = currentFilter ? `?status_filter=${currentFilter}` : '';
    const res = await authedFetch(`/tasks/all${qs}`);
    if (!res.ok) return;
    const tasks = await res.json();
    emptyEl.hidden = tasks.length > 0;
    tasks.forEach(renderTask);
  }

  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentFilter = btn.dataset.filter;
      loadTasks();
    });
  });

  document.getElementById('assign-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const assignError = document.getElementById('assign-error');
    const assignSuccess = document.getElementById('assign-success');
    assignError.hidden = true;
    assignSuccess.hidden = true;

    const worker_email = document.getElementById('worker-email').value;
    const target_username = document.getElementById('target-username').value;
    const message_text = document.getElementById('message-text').value || null;

    try {
      const res = await authedFetch('/tasks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ worker_email, target_username, message_text }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(data?.detail || 'Failed to assign task');
      }
      assignSuccess.hidden = false;
      document.getElementById('assign-form').reset();
      await loadTasks();
    } catch (err) {
      assignError.textContent = err instanceof Error ? err.message : 'Failed to assign task';
      assignError.hidden = false;
    }
  });

  // --- Instagram targets database + manual import ---

  const importStatusEl = document.getElementById('import-status');
  const runImportBtn = document.getElementById('run-import-btn');
  const targetsBody = document.getElementById('targets-body');
  const targetsTotalEl = document.getElementById('targets-total');
  const targetsEmptyEl = document.getElementById('targets-empty');
  let pollTimer = null;

  function formatStatus(state) {
    if (state.running) return 'Import running...';
    if (state.last_result?.error) return `Last run failed: ${state.last_result.error}`;
    if (state.last_result) {
      const { fetched = 0, saved = 0, skipped = 0 } = state.last_result;
      return `Last run: fetched ${fetched}, saved ${saved} new, skipped ${skipped}.`;
    }
    return 'Idle.';
  }

  async function loadTargets() {
    const res = await authedFetch('/admin/targets?limit=100');
    if (!res.ok) return;
    const data = await res.json();
    targetsTotalEl.textContent = data.total;
    targetsBody.innerHTML = '';
    targetsEmptyEl.hidden = data.items.length > 0;
    for (const t of data.items) {
      const tr = document.createElement('tr');

      const userTd = document.createElement('td');
      userTd.className = 'username';
      const userLink = document.createElement('a');
      userLink.className = 'ig-link';
      userLink.textContent = `@${t.username}`;
      userLink.href = `https://www.instagram.com/${encodeURIComponent(t.username)}/`;
      userLink.target = '_blank';
      userLink.rel = 'noopener';
      userTd.appendChild(userLink);

      const sourceTd = document.createElement('td');
      sourceTd.className = 'source';
      if (t.source) {
        const sourceLink = document.createElement('a');
        sourceLink.textContent = t.source;
        sourceLink.href = t.source;
        sourceLink.target = '_blank';
        sourceLink.rel = 'noopener';
        sourceTd.appendChild(sourceLink);
      }

      const addedTd = document.createElement('td');
      addedTd.textContent = new Date(t.created_at).toLocaleString();

      tr.append(userTd, sourceTd, addedTd);
      targetsBody.appendChild(tr);
    }
  }

  async function pollImportStatus() {
    const res = await authedFetch('/admin/import/status');
    if (!res.ok) return;
    const state = await res.json();
    importStatusEl.textContent = formatStatus(state);
    runImportBtn.disabled = state.running;
    runImportBtn.textContent = state.running ? 'Running...' : 'Run import now';

    if (state.running) {
      if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
    } else if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
      await loadTargets();
    }
  }

  runImportBtn.addEventListener('click', async () => {
    runImportBtn.disabled = true;
    const res = await authedFetch('/admin/import/run', { method: 'POST' });
    const state = await res.json();
    importStatusEl.textContent = formatStatus(state);
    runImportBtn.textContent = 'Running...';
    if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
  });

  document.getElementById('refresh-targets-btn').addEventListener('click', loadTargets);

  // --- Google Drive export ---

  const exportStatusEl = document.getElementById('export-status');
  const runExportBtn = document.getElementById('run-export-btn');
  const exportLinkEl = document.getElementById('export-link');
  let exportPollTimer = null;

  function formatExportStatus(state) {
    if (state.running) return 'Export running...';
    if (state.last_result?.error) return `Last export failed: ${state.last_result.error}`;
    if (state.last_result) return 'Last export: done.';
    return 'Idle.';
  }

  async function pollExportStatus() {
    const res = await authedFetch('/admin/export/status');
    if (!res.ok) return;
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.disabled = state.running;
    runExportBtn.textContent = state.running ? 'Exporting...' : 'Export to Google Sheet';

    if (state.last_result?.web_view_link) {
      exportLinkEl.innerHTML = `<a href="${state.last_result.web_view_link}" target="_blank" rel="noopener">Open spreadsheet →</a>`;
      exportLinkEl.hidden = false;
    }

    if (state.running) {
      if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
    } else if (exportPollTimer) {
      clearInterval(exportPollTimer);
      exportPollTimer = null;
    }
  }

  runExportBtn.addEventListener('click', async () => {
    runExportBtn.disabled = true;
    const res = await authedFetch('/admin/export/run', { method: 'POST' });
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.textContent = 'Exporting...';
    if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
  });

  document.getElementById('bulk-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const bulkError = document.getElementById('bulk-error');
    const bulkSuccess = document.getElementById('bulk-success');
    bulkError.hidden = true;
    bulkSuccess.hidden = true;

    const worker_email = document.getElementById('bulk-worker-email').value;
    const count = parseInt(document.getElementById('bulk-count').value, 10);
    const message_text = document.getElementById('bulk-message-text').value || null;

    try {
      const res = await authedFetch('/tasks/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ worker_email, count, message_text }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(data?.detail || 'Failed to bulk-assign');
      }
      const data = await res.json();
      bulkSuccess.textContent = `Assigned ${data.assigned} of ${data.requested} requested (database had ${data.assigned} unassigned accounts left).`;
      bulkSuccess.hidden = false;
      document.getElementById('bulk-form').reset();
      document.getElementById('bulk-count').value = 20;
      await loadTasks();
      await loadTargets();
    } catch (err) {
      bulkError.textContent = err instanceof Error ? err.message : 'Failed to bulk-assign';
      bulkError.hidden = false;
    }
  });

  // --- Tracking links (per-worker /links?ref=... with click counters) ---

  const linksBody = document.getElementById('links-body');

  function textCell(text, className) {
    const td = document.createElement('td');
    if (className) td.className = className;
    td.textContent = text;
    return td;
  }

  async function loadLinks() {
    const res = await authedFetch('/admin/links');
    if (!res.ok) return;
    const data = await res.json();
    linksBody.innerHTML = '';
    for (const item of data.items) {
      const tr = document.createElement('tr');

      const nameTd = document.createElement('td');
      nameTd.className = 'username';
      nameTd.textContent = item.ref === 'direct' ? item.label : item.label ? `${item.label} (${item.ref})` : item.ref;

      const linkTd = document.createElement('td');
      const cell = document.createElement('div');
      cell.className = 'link-cell';
      const code = document.createElement('code');
      code.textContent = item.url.replace('https://', '');
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy-btn';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(item.url);
          copyBtn.textContent = 'Copied';
        } catch {
          copyBtn.textContent = 'Failed';
        }
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
      });
      cell.append(code, copyBtn);
      linkTd.appendChild(cell);

      const last = item.last_event_at ? new Date(item.last_event_at).toLocaleString() : '—';
      tr.append(
        nameTd,
        linkTd,
        textCell(item.visits, 'num'),
        textCell(item.clicks.agency, 'num'),
        textCell(item.clicks.traffic, 'num'),
        textCell(item.clicks.analytics, 'num'),
        textCell(item.total_clicks, 'num total'),
        textCell(last),
      );
      linksBody.appendChild(tr);
    }
  }

  document.getElementById('refresh-links-btn').addEventListener('click', loadLinks);

  document.getElementById('link-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const linkError = document.getElementById('link-error');
    const linkSuccess = document.getElementById('link-success');
    linkError.hidden = true;
    linkSuccess.hidden = true;

    const ref = document.getElementById('link-ref').value;
    const label = document.getElementById('link-label').value || null;

    try {
      const res = await authedFetch('/admin/links', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ref, label }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(typeof data?.detail === 'string' ? data.detail : 'Failed to create link');
      }
      const created = await res.json();
      linkSuccess.textContent = `Created: ${created.url}`;
      linkSuccess.hidden = false;
      document.getElementById('link-form').reset();
      await loadLinks();
    } catch (err) {
      linkError.textContent = err instanceof Error ? err.message : 'Failed to create link';
      linkError.hidden = false;
    }
  });

  async function init() {
    try {
      const res = await authedFetch('/auth/me');
      if (!res.ok) throw new Error();
      const me = await res.json();
      if (!me.is_admin) {
        deniedEl.hidden = false;
        return;
      }
      contentEl.hidden = false;
      await loadLinks().catch(() => {});
      await loadTasks();
      await loadTargets();
      await pollImportStatus();
      await pollExportStatus();
    } catch {
      deniedEl.hidden = false;
    }
  }

  init();
</script>
