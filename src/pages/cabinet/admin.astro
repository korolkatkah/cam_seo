---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Admin Panel | EWO"
  description="Assign Instagram outreach tasks to workers and review their reports."
  lang="en"
  noindex={true}
>

<div class="cabinet-wrap container">
  <div class="cabinet-header">
    <h1>Admin Panel</h1>
    <button id="logout-btn" class="ghost-btn">Log out</button>
  </div>

  <p id="denied" class="cabinet-error" hidden>Your account is not an admin.</p>

  <section id="admin-content" hidden>
    <div class="glass-card assign-card">
      <div class="targets-header">
        <h2 class="section-title">Tracking links</h2>
        <button id="refresh-links-btn" class="ghost-btn">Refresh</button>
      </div>
      <p class="bulk-hint">One link per worker for the EWOMODELS mini-landing. Every visit and button click is counted under the worker whose link was opened.</p>
      <div class="targets-table-wrap links-table-wrap">
        <table class="targets-table">
          <thead>
            <tr>
              <th>Worker</th><th>Link</th><th class="num-h">Visits</th><th class="num-h">Agency</th><th class="num-h">Traffic</th><th class="num-h">Analytics</th><th class="num-h">Clicks</th><th>Last activity</th>
            </tr>
          </thead>
          <tbody id="links-body"></tbody>
        </table>
      </div>
      <form id="link-form" class="link-form">
        <label>
          Ref (in the link)
          <input type="text" id="link-ref" required minlength="2" maxlength="32" pattern="[a-zA-Z0-9_\-]{2,32}" placeholder="anna" />
        </label>
        <label>
          Worker name (optional)
          <input type="text" id="link-label" maxlength="255" placeholder="Anna K." />
        </label>
        <button type="submit">Create link</button>
      </form>
      <p id="link-error" class="cabinet-error" hidden></p>
      <p id="link-success" class="cabinet-success" hidden></p>
    </div>

    <div class="glass-card assign-card">
      <h2>Assign a task</h2>
      <form id="assign-form" class="assign-form">
        <label>
          Worker email
          <input type="email" id="worker-email" required placeholder="worker@example.com" />
        </label>
        <label>
          Instagram username
          <input type="text" id="target-username" required placeholder="some_model_acc" />
        </label>
        <label>
          Message text (optional)
          <textarea id="message-text" rows="2"></textarea>
        </label>
        <button type="submit">Assign</button>
        <p id="assign-error" class="cabinet-error" hidden></p>
        <p id="assign-success" class="cabinet-success" hidden>Task assigned.</p>
      </form>
    </div>

    <div class="glass-card assign-card">
      <h2>Bulk assign</h2>
      <p class="bulk-hint">Hands the worker the next N accounts from the database that haven't been assigned to anyone yet — no need to type usernames one by one.</p>
      <form id="bulk-form" class="assign-form">
        <label>
          Worker email
          <input type="email" id="bulk-worker-email" required placeholder="worker@example.com" />
        </label>
        <label>
          How many accounts
          <input type="number" id="bulk-count" required min="1" max="500" value="20" />
        </label>
        <label>
          Message text (optional)
          <textarea id="bulk-message-text" rows="2"></textarea>
        </label>
        <button type="submit">Assign batch</button>
        <p id="bulk-error" class="cabinet-error" hidden></p>
        <p id="bulk-success" class="cabinet-success" hidden></p>
      </form>
    </div>

    <div class="glass-card import-card">
      <h2>Instagram targets database</h2>
      <div class="progress" id="import-progress" hidden aria-hidden="true">
        <div class="progress__fill" id="import-progress-fill"></div>
      </div>
      <p class="import-status" id="import-status" role="status" aria-live="polite">Idle.</p>
      <div class="import-actions">
        <button id="run-import-btn" class="import-btn">Run import now</button>
        <button id="stop-import-btn" class="import-btn export-btn stop-btn" disabled title="Available while an import is running">Stop import</button>
      </div>

      <p class="import-status" id="export-status" style="margin-top:1rem;">Idle.</p>
      <button id="run-export-btn" class="import-btn export-btn">Export to Google Sheet</button>
      <p id="export-link" class="import-status" hidden></p>
    </div>

    <div class="glass-card assign-card">
      <h2>Already handed out</h2>
      <p class="bulk-hint">Paste the accounts you gave to someone outside the cabinet (links, @names or plain names, any separator). They are marked in the Google Sheet, grouped together at the top, and skipped by "Bulk assign".</p>
      <form id="handout-form" class="assign-form">
        <label>
          Given to
          <input type="text" id="handout-to" required maxlength="255" placeholder="Worker name or email" />
        </label>
        <label>
          Accounts
          <textarea id="handout-accounts" rows="6" required placeholder="https://www.instagram.com/some_account/"></textarea>
        </label>
        <label class="check-row">
          <input type="checkbox" id="handout-create" checked />
          Add accounts that are not in the database yet
        </label>
        <button type="submit">Mark as handed out</button>
        <p id="handout-error" class="cabinet-error" hidden></p>
        <p id="handout-success" class="cabinet-success" hidden></p>
      </form>
      <div class="targets-table-wrap handout-table-wrap" id="handout-summary-wrap" hidden>
        <table class="targets-table">
          <thead>
            <tr><th>Given to</th><th class="num-h">Accounts</th><th>Last added</th><th></th></tr>
          </thead>
          <tbody id="handout-body"></tbody>
        </table>
      </div>
    </div>

    <h2 class="section-title">All tasks</h2>
    <div class="filter-row">
      <button data-filter="reported" class="filter-btn is-active">Awaiting review</button>
      <button data-filter="">All</button>
      <button data-filter="pending">Pending</button>
      <button data-filter="approved">Approved</button>
      <button data-filter="rejected">Rejected</button>
    </div>
    <p id="empty-state" hidden>No tasks in this view.</p>
    <div id="task-list"></div>
  </section>
</div>

<template id="task-row-template">
  <div class="task-row">
    <div class="task-row__main">
      <div>
        <span class="task-row__worker" data-field="worker"></span>
        <span class="task-row__target">→ <a class="ig-link" data-field="target" target="_blank" rel="noopener"></a></span>
      </div>
      <span class="task-row__status" data-field="status"></span>
    </div>
    <p class="task-row__message" data-field="message"></p>
    <p class="task-row__screenshot" data-field="screenshot" hidden></p>
    <div class="task-row__actions" data-field="review-actions" hidden>
      <input type="text" data-field="note" placeholder="Note (optional)" />
      <button data-field="approve-btn" class="approve-btn">Approve</button>
      <button data-field="reject-btn" class="reject-btn">Reject</button>
    </div>
    <p class="task-row__note" data-field="existing-note" hidden></p>
  </div>
</template>

<style>
  .cabinet-wrap {
    padding: 3rem 1.5rem;
    max-width: 780px;
  }
  .cabinet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .cabinet-header h1 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--fg);
    margin: 0;
  }
  .ghost-btn {
    font: inherit;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .ghost-btn:hover { color: var(--fg); }
  .cabinet-error { color: #c0392b; font-size: 0.85rem; }
  .cabinet-success { color: #1e6b34; font-size: 0.85rem; }

  .assign-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .assign-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .assign-form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .assign-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .assign-form input,
  .assign-form textarea {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
    resize: vertical;
  }
  .assign-form button {
    align-self: flex-start;
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .assign-form button:hover { opacity: 0.85; }
  .bulk-hint {
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin: -0.5rem 0 0.9rem;
  }
  .links-table-wrap { margin-bottom: 1.25rem; }
  /* Rows are built in JS, so their selectors must be :global (Astro scopes styles to the template). */
  .targets-table th.num-h { text-align: right; }
  :global(.targets-table td.num) { text-align: right; font-variant-numeric: tabular-nums; }
  :global(.targets-table td.total) { font-weight: 700; color: var(--fg); }
  :global(.link-cell) { display: flex; align-items: center; gap: 0.5rem; }
  :global(.link-cell code) { font-size: 0.78rem; color: var(--fg-muted); white-space: nowrap; }
  :global(.copy-btn) {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  :global(.copy-btn:hover) { color: var(--fg); }
  .link-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.9rem;
  }
  .link-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    flex: 1 1 180px;
  }
  .link-form input {
    font: inherit;
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
  }
  .link-form button {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .link-form button:hover { opacity: 0.85; }

  .import-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }
  .import-card h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    color: var(--fg);
  }
  .import-status {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin: 0 0 1rem;
  }
  .progress {
    height: 8px;
    border-radius: 999px;
    background: var(--bg-subtle);
    overflow: hidden;
    margin: 0 0 0.75rem;
  }
  .progress__fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--accent);
    transition: width 0.6s ease;
  }
  .progress__fill.is-indeterminate {
    width: 35%;
    animation: progress-slide 1.2s ease-in-out infinite alternate;
  }
  @keyframes progress-slide {
    from { margin-left: 0; }
    to { margin-left: 65%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .progress__fill.is-indeterminate { animation: none; margin-left: 0; width: 100%; opacity: 0.4; }
  }
  .import-btn {
    font: inherit;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .import-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .stop-btn { color: #a12a2a; border-color: rgba(161, 42, 42, 0.35); }
  .assign-form .check-row {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }
  .handout-table-wrap { margin: 1.25rem 0 0; }
  :global(.undo-btn) {
    font: inherit;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: #a12a2a;
    cursor: pointer;
  }
  .import-btn:hover { opacity: 0.85; }
  .import-btn:disabled { opacity: 0.5; cursor: default; }
  .export-btn {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--bg-subtle);
  }
  #export-link a { color: var(--fg); font-weight: 600; }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--fg);
    margin: 0 0 1rem;
  }
  .targets-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .targets-header .section-title { margin: 0; }
  .targets-table-wrap {
    overflow-x: auto;
    margin-bottom: 2.5rem;
    border: 1px solid var(--bg-subtle);
    border-radius: 12px;
  }
  .targets-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .targets-table th,
  .targets-table td {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--bg-subtle);
    white-space: nowrap;
  }
  .targets-table th {
    color: var(--fg-muted);
    font-weight: 600;
    background: var(--bg-raised);
  }
  .targets-table tr:last-child td { border-bottom: none; }
  .targets-table td.username { font-weight: 600; color: var(--fg); }
  .ig-link { color: var(--fg); font-weight: 600; text-decoration: none; }
  .ig-link:hover { text-decoration: underline; }
  .targets-table td.source a { color: var(--fg-muted); text-decoration: none; }
  .targets-table td.source a:hover { text-decoration: underline; }
  .filter-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .filter-btn {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--bg-subtle);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .filter-btn.is-active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  #task-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .task-row {
    background: var(--bg-raised);
    border: 1px solid var(--bg-subtle);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .task-row__main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .task-row__worker {
    font-weight: 700;
    color: var(--fg);
  }
  .task-row__target {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .task-row__status {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--bg-subtle);
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .task-row__status--reported { background: #fff3cd; color: #7a5c00; }
  .task-row__status--approved { background: #d4edda; color: #1e6b34; }
  .task-row__status--rejected { background: #f8d7da; color: #a12a2a; }
  .task-row__message {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 0 0 0.6rem;
  }
  .task-row__screenshot a {
    color: var(--fg);
    font-size: 0.85rem;
  }
  .task-row__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .task-row__actions input {
    font: inherit;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
    flex: 1 1 180px;
  }
  .task-row__actions button {
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
  }
  .approve-btn { background: #1e6b34; color: #fff; }
  .reject-btn { background: #a12a2a; color: #fff; }
  .task-row__note {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
</style>

</Base>

<script>
  const API_BASE = 'https://worker-cabinet-production.up.railway.app';
  const token = localStorage.getItem('cabinet_token');
  if (!token) {
    window.location.href = '/cabinet/login';
  }

  const deniedEl = document.getElementById('denied');
  const contentEl = document.getElementById('admin-content');
  const listEl = document.getElementById('task-list');
  const emptyEl = document.getElementById('empty-state');
  const template = document.getElementById('task-row-template');
  let currentFilter = 'reported';

  document.getElementById('logout-btn').addEventListener('click', () => {
    localStorage.removeItem('cabinet_token');
    window.location.href = '/cabinet/login';
  });

  async function authedFetch(path, options = {}) {
    const res = await fetch(`${API_BASE}${path}`, {
      ...options,
      headers: { ...(options.headers || {}), Authorization: `Bearer ${token}` },
    });
    if (res.status === 401) {
      localStorage.removeItem('cabinet_token');
      window.location.href = '/cabinet/login';
      throw new Error('Session expired');
    }
    return res;
  }

  function renderTask(task) {
    const node = template.content.cloneNode(true);
    const row = node.querySelector('.task-row');
    row.querySelector('[data-field="worker"]').textContent = task.worker_email;
    const targetLink = row.querySelector('[data-field="target"]');
    targetLink.textContent = `@${task.target_username}`;
    targetLink.href = `https://www.instagram.com/${encodeURIComponent(task.target_username)}/`;
    row.querySelector('[data-field="message"]').textContent = task.message_text || '';

    const statusEl = row.querySelector('[data-field="status"]');
    statusEl.textContent = task.status;
    statusEl.classList.add(`task-row__status--${task.status}`);

    if (task.proof_screenshot_path) {
      const p = row.querySelector('[data-field="screenshot"]');
      p.hidden = false;
      p.textContent = `Screenshot attached: ${task.proof_screenshot_path}`;
    }

    if (task.status === 'reported') {
      const actions = row.querySelector('[data-field="review-actions"]');
      actions.hidden = false;
      const noteInput = row.querySelector('[data-field="note"]');
      const approveBtn = row.querySelector('[data-field="approve-btn"]');
      const rejectBtn = row.querySelector('[data-field="reject-btn"]');

      const review = async (approve) => {
        approveBtn.disabled = true;
        rejectBtn.disabled = true;
        try {
          const res = await authedFetch(`/tasks/${task.id}/review`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ approve, note: noteInput.value || null }),
          });
          if (!res.ok) throw new Error('Review failed');
          await loadTasks();
        } catch {
          approveBtn.disabled = false;
          rejectBtn.disabled = false;
        }
      };
      approveBtn.addEventListener('click', () => review(true));
      rejectBtn.addEventListener('click', () => review(false));
    } else if (task.review_note) {
      const noteEl = row.querySelector('[data-field="existing-note"]');
      noteEl.hidden = false;
      noteEl.textContent = `Note: ${task.review_note}`;
    }

    listEl.appendChild(row);
  }

  async function loadTasks() {
    listEl.innerHTML = '';
    const qs = currentFilter ? `?status_filter=${currentFilter}` : '';
    const res = await authedFetch(`/tasks/all${qs}`);
    if (!res.ok) return;
    const tasks = await res.json();
    emptyEl.hidden = tasks.length > 0;
    tasks.forEach(renderTask);
  }

  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentFilter = btn.dataset.filter;
      loadTasks();
    });
  });

  document.getElementById('assign-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const assignError = document.getElementById('assign-error');
    const assignSuccess = document.getElementById('assign-success');
    assignError.hidden = true;
    assignSuccess.hidden = true;

    const worker_email = document.getElementById('worker-email').value;
    const target_username = document.getElementById('target-username').value;
    const message_text = document.getElementById('message-text').value || null;

    try {
      const res = await authedFetch('/tasks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ worker_email, target_username, message_text }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(data?.detail || 'Failed to assign task');
      }
      assignSuccess.hidden = false;
      document.getElementById('assign-form').reset();
      await loadTasks();
    } catch (err) {
      assignError.textContent = err instanceof Error ? err.message : 'Failed to assign task';
      assignError.hidden = false;
    }
  });

  // --- Instagram targets database + manual import ---

  const importStatusEl = document.getElementById('import-status');
  const runImportBtn = document.getElementById('run-import-btn');
  const stopImportBtn = document.getElementById('stop-import-btn');
  let pollTimer = null;

  const progressEl = document.getElementById('import-progress');
  const progressFillEl = document.getElementById('import-progress-fill');
  let lastImportState = null;

  function fmtDuration(ms) {
    const total = Math.max(0, Math.round(ms / 1000));
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const sec = total % 60;
    if (h) return `${h}h ${m}m`;
    if (m) return `${m}m ${String(sec).padStart(2, '0')}s`;
    return `${sec}s`;
  }

  function setProgress(pct) {
    progressEl.hidden = false;
    if (pct === null) {
      progressFillEl.classList.add('is-indeterminate');
      progressFillEl.style.width = '';
    } else {
      progressFillEl.classList.remove('is-indeterminate');
      progressFillEl.style.width = `${pct}%`;
    }
  }

  function renderImportStatus(state) {
    lastImportState = state;
    stopImportBtn.disabled = !state.running || !!state.stopping;
    stopImportBtn.textContent = state.stopping ? 'Stopping...' : 'Stop import';
    if (state.running) {
      const p = state.progress || {};
      const elapsed = state.last_started_at ? Date.now() - new Date(state.last_started_at).getTime() : 0;
      if (p.phase === 'checking_profiles' && p.total) {
        const pct = Math.round((p.checked / p.total) * 100);
        setProgress(pct);
        const eta = p.checked >= 10 ? ` · about ${fmtDuration((elapsed / p.checked) * (p.total - p.checked))} left` : '';
        const current = p.current ? ` · checking ${p.current}` : '';
        importStatusEl.textContent =
          `Importing: ${p.checked} of ${p.total} profiles (${pct}%) · ${p.saved} new · ${p.skipped} skipped · ${fmtDuration(elapsed)} elapsed${eta}${current}`;
      } else if (p.phase === 'fetching_list') {
        setProgress(null);
        importStatusEl.textContent = `Importing: fetching the model list (page ${p.page || 0} of ${p.pages || '?'}) · ${fmtDuration(elapsed)} elapsed`;
      } else {
        setProgress(null);
        importStatusEl.textContent = `Importing: starting... · ${fmtDuration(elapsed)} elapsed`;
      }
      if (state.stopping) {
        importStatusEl.textContent = `Stopping after the current profile... ${importStatusEl.textContent}`;
      }
      return;
    }
    progressEl.hidden = true;
    if (state.last_result?.error) {
      importStatusEl.textContent = `Last run failed: ${state.last_result.error}`;
    } else if (state.last_result) {
      const { fetched = 0, saved = 0, skipped = 0, stopped = false } = state.last_result;
      const at = state.last_finished_at ? ` (finished ${new Date(state.last_finished_at).toLocaleString()})` : '';
      const verb = stopped ? 'stopped by you after' : 'checked';
      importStatusEl.textContent = `Last run${at}: ${verb} ${fetched} profiles, ${saved} new, ${skipped} skipped.`;
    } else {
      importStatusEl.textContent = 'Idle. No import has run since the server started.';
    }
  }

  // Keep the elapsed timer moving between the 4-second polls.
  setInterval(() => {
    if (lastImportState?.running) renderImportStatus(lastImportState);
  }, 1000);

  async function pollImportStatus() {
    const res = await authedFetch('/admin/import/status');
    if (!res.ok) return;
    const state = await res.json();
    renderImportStatus(state);
    runImportBtn.disabled = state.running;
    runImportBtn.textContent = state.running ? 'Running...' : 'Run import now';
    // The sheet is refreshed while the import runs, so show its progress too.
    await pollExportStatus();

    if (state.running) {
      if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
    } else if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  runImportBtn.addEventListener('click', async () => {
    runImportBtn.disabled = true;
    const res = await authedFetch('/admin/import/run', { method: 'POST' });
    const state = await res.json();
    renderImportStatus(state);
    runImportBtn.textContent = 'Running...';
    if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
  });

  stopImportBtn.addEventListener('click', async () => {
    if (!confirm('Stop the import? Accounts found so far are kept, the sheet is updated, and you can run it again later.')) return;
    stopImportBtn.disabled = true;
    stopImportBtn.textContent = 'Stopping...';
    try {
      const res = await authedFetch('/admin/import/stop', { method: 'POST' });
      if (res.ok) renderImportStatus(await res.json());
    } catch {
      stopImportBtn.disabled = false;
      stopImportBtn.textContent = 'Stop import';
    }
    if (!pollTimer) pollTimer = setInterval(pollImportStatus, 4000);
  });

  // --- Accounts handed out outside the cabinet ---

  const handoutBody = document.getElementById('handout-body');
  const handoutWrap = document.getElementById('handout-summary-wrap');

  async function loadHandouts() {
    const res = await authedFetch('/admin/handouts');
    if (!res.ok) return;
    const data = await res.json();
    handoutBody.innerHTML = '';
    handoutWrap.hidden = data.items.length === 0;
    for (const item of data.items) {
      const undoBtn = document.createElement('button');
      undoBtn.type = 'button';
      undoBtn.className = 'undo-btn';
      undoBtn.textContent = 'Take back';
      undoBtn.addEventListener('click', async () => {
        if (!confirm(`Take back all ${item.count} accounts given to "${item.given_to}"? They become free again.`)) return;
        undoBtn.disabled = true;
        const r = await authedFetch(`/admin/handouts?given_to=${encodeURIComponent(item.given_to)}`, { method: 'DELETE' });
        if (r.ok) await loadHandouts();
        else undoBtn.disabled = false;
      });
      const actionTd = document.createElement('td');
      actionTd.appendChild(undoBtn);

      const tr = document.createElement('tr');
      tr.append(
        textCell(item.given_to, 'username'),
        textCell(item.count, 'num'),
        textCell(item.last_at ? new Date(item.last_at).toLocaleString() : '—'),
        actionTd,
      );
      handoutBody.appendChild(tr);
    }
  }

  document.getElementById('handout-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorEl = document.getElementById('handout-error');
    const successEl = document.getElementById('handout-success');
    errorEl.hidden = true;
    successEl.hidden = true;
    const submitBtn = e.target.querySelector('button[type="submit"]');
    submitBtn.disabled = true;

    try {
      const res = await authedFetch('/admin/handouts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          given_to: document.getElementById('handout-to').value,
          accounts: document.getElementById('handout-accounts').value,
          create_missing: document.getElementById('handout-create').checked,
        }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(typeof data?.detail === 'string' ? data.detail : 'Failed to mark accounts');
      }
      const d = await res.json();
      const parts = [`Marked ${d.marked} of ${d.found} accounts as given to ${d.given_to}.`];
      if (d.created_new_accounts) parts.push(`Added ${d.created_new_accounts} account(s) that were not in the database.`);
      if (d.already_marked) parts.push(`Already marked before: ${d.already_marked}.`);
      if (d.already_assigned_to_worker) parts.push(`Left as they are (already a worker task): ${d.already_assigned_to_worker}.`);
      if (d.not_in_database.length) parts.push(`Not in the database: ${d.not_in_database.slice(0, 10).join(', ')}${d.not_in_database.length > 10 ? '...' : ''}.`);
      parts.push('The Google Sheet updates within a minute.');
      successEl.textContent = parts.join(' ');
      successEl.hidden = false;
      document.getElementById('handout-form').reset();
      document.getElementById('handout-create').checked = true;
      await loadHandouts();
      setTimeout(pollExportStatus, 20000);
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Failed to mark accounts';
      errorEl.hidden = false;
    } finally {
      submitBtn.disabled = false;
    }
  });

  // --- Google Drive export ---

  const exportStatusEl = document.getElementById('export-status');
  const runExportBtn = document.getElementById('run-export-btn');
  const exportLinkEl = document.getElementById('export-link');
  let exportPollTimer = null;

  function formatExportStatus(state) {
    const rows = state.last_result?.rows;
    const last = state.last_result && !state.last_result.error
      ? ` Last update${state.last_finished_at ? ` ${new Date(state.last_finished_at).toLocaleTimeString()}` : ''}${rows != null ? `, ${rows} rows` : ''}${state.last_result.added ? ` (+${state.last_result.added} new)` : ''}${state.last_result.marked ? `, ${state.last_result.marked} marks updated` : ''}.`
      : '';
    if (state.running) return `Sheet: updating...${last}`;
    if (state.last_result?.error) return `Last export failed: ${state.last_result.error}`;
    if (state.last_result) return `Sheet up to date.${last}`;
    return 'Sheet: no export yet.';
  }

  async function pollExportStatus() {
    const res = await authedFetch('/admin/export/status');
    if (!res.ok) return;
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.disabled = state.running;
    runExportBtn.textContent = state.running ? 'Exporting...' : 'Export to Google Sheet';

    if (state.last_result?.web_view_link) {
      exportLinkEl.innerHTML = `<a href="${state.last_result.web_view_link}" target="_blank" rel="noopener">Open spreadsheet →</a>`;
      exportLinkEl.hidden = false;
    }

    if (state.running) {
      if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
    } else if (exportPollTimer) {
      clearInterval(exportPollTimer);
      exportPollTimer = null;
    }
  }

  runExportBtn.addEventListener('click', async () => {
    runExportBtn.disabled = true;
    const res = await authedFetch('/admin/export/run', { method: 'POST' });
    const state = await res.json();
    exportStatusEl.textContent = formatExportStatus(state);
    runExportBtn.textContent = 'Exporting...';
    if (!exportPollTimer) exportPollTimer = setInterval(pollExportStatus, 4000);
  });

  document.getElementById('bulk-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const bulkError = document.getElementById('bulk-error');
    const bulkSuccess = document.getElementById('bulk-success');
    bulkError.hidden = true;
    bulkSuccess.hidden = true;

    const worker_email = document.getElementById('bulk-worker-email').value;
    const count = parseInt(document.getElementById('bulk-count').value, 10);
    const message_text = document.getElementById('bulk-message-text').value || null;

    try {
      const res = await authedFetch('/tasks/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ worker_email, count, message_text }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(data?.detail || 'Failed to bulk-assign');
      }
      const data = await res.json();
      bulkSuccess.textContent = `Assigned ${data.assigned} of ${data.requested} requested (database had ${data.assigned} unassigned accounts left).`;
      bulkSuccess.hidden = false;
      document.getElementById('bulk-form').reset();
      document.getElementById('bulk-count').value = 20;
      await loadTasks();
    } catch (err) {
      bulkError.textContent = err instanceof Error ? err.message : 'Failed to bulk-assign';
      bulkError.hidden = false;
    }
  });

  // --- Tracking links (per-worker /links?ref=... with click counters) ---

  const linksBody = document.getElementById('links-body');

  function textCell(text, className) {
    const td = document.createElement('td');
    if (className) td.className = className;
    td.textContent = text;
    return td;
  }

  async function loadLinks() {
    const res = await authedFetch('/admin/links');
    if (!res.ok) return;
    const data = await res.json();
    linksBody.innerHTML = '';
    for (const item of data.items) {
      const tr = document.createElement('tr');

      const nameTd = document.createElement('td');
      nameTd.className = 'username';
      nameTd.textContent = item.ref === 'direct' ? item.label : item.label ? `${item.label} (${item.ref})` : item.ref;

      const linkTd = document.createElement('td');
      const cell = document.createElement('div');
      cell.className = 'link-cell';
      const code = document.createElement('code');
      code.textContent = item.url.replace('https://', '');
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy-btn';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(item.url);
          copyBtn.textContent = 'Copied';
        } catch {
          copyBtn.textContent = 'Failed';
        }
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
      });
      cell.append(code, copyBtn);
      linkTd.appendChild(cell);

      const last = item.last_event_at ? new Date(item.last_event_at).toLocaleString() : '—';
      tr.append(
        nameTd,
        linkTd,
        textCell(item.visits, 'num'),
        textCell(item.clicks.agency, 'num'),
        textCell(item.clicks.traffic, 'num'),
        textCell(item.clicks.analytics, 'num'),
        textCell(item.total_clicks, 'num total'),
        textCell(last),
      );
      linksBody.appendChild(tr);
    }
  }

  document.getElementById('refresh-links-btn').addEventListener('click', loadLinks);

  document.getElementById('link-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const linkError = document.getElementById('link-error');
    const linkSuccess = document.getElementById('link-success');
    linkError.hidden = true;
    linkSuccess.hidden = true;

    const ref = document.getElementById('link-ref').value;
    const label = document.getElementById('link-label').value || null;

    try {
      const res = await authedFetch('/admin/links', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ref, label }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(typeof data?.detail === 'string' ? data.detail : 'Failed to create link');
      }
      const created = await res.json();
      linkSuccess.textContent = `Created: ${created.url}`;
      linkSuccess.hidden = false;
      document.getElementById('link-form').reset();
      await loadLinks();
    } catch (err) {
      linkError.textContent = err instanceof Error ? err.message : 'Failed to create link';
      linkError.hidden = false;
    }
  });

  async function init() {
    try {
      const res = await authedFetch('/auth/me');
      if (!res.ok) throw new Error();
      const me = await res.json();
      if (!me.is_admin) {
        deniedEl.hidden = false;
        return;
      }
      contentEl.hidden = false;
      await loadLinks().catch(() => {});
      await loadHandouts().catch(() => {});
      await loadTasks();
      await pollImportStatus();
      await pollExportStatus();
    } catch {
      deniedEl.hidden = false;
    }
  }

  init();
</script>
