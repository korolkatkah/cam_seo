---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Worker Registration | EWO"
  description="Create your EWO worker cabinet account."
  lang="en"
  noindex={true}
>

<div class="cabinet-wrap">
  <form id="register-form" class="cabinet-card">
    <h1>Worker Registration</h1>
    <label>
      Email
      <input type="email" id="email" required autocomplete="username" />
    </label>
    <label>
      Password
      <input type="password" id="password" required autocomplete="new-password" minlength="8" />
    </label>
    <button type="submit">Create account</button>
    <p id="error" class="cabinet-error" hidden></p>
    <p class="cabinet-alt-link">Already have an account? <a href="/cabinet/login">Log in</a></p>
  </form>
</div>

<style>
  .cabinet-wrap {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }
  .cabinet-card {
    width: 100%;
    max-width: 380px;
    background: var(--bg-raised);
    border: 1px solid var(--bg-subtle);
    border-radius: 14px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .cabinet-card h1 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin: 0 0 0.25rem;
    color: var(--fg);
  }
  .cabinet-card label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .cabinet-card input {
    font: inherit;
    padding: 0.65rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--bg-subtle);
    background: var(--bg);
    color: var(--fg);
  }
  .cabinet-card button {
    margin-top: 0.5rem;
    font: inherit;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
  }
  .cabinet-card button:hover {
    opacity: 0.85;
  }
  .cabinet-error {
    color: #c0392b;
    font-size: 0.85rem;
    margin: 0;
  }
  .cabinet-alt-link {
    margin: 0;
    font-size: 0.85rem;
    color: var(--fg-muted);
    text-align: center;
  }
  .cabinet-alt-link a {
    color: var(--fg);
    font-weight: 600;
  }
</style>

</Base>

<script>
  const API_BASE = 'https://worker-cabinet-production.up.railway.app';

  const form = document.getElementById('register-form');
  const errorEl = document.getElementById('error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;

    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;

    try {
      const res = await fetch(`${API_BASE}/auth/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => null);
        throw new Error(data?.detail || 'Registration failed');
      }
      const data = await res.json();
      localStorage.setItem('cabinet_token', data.access_token);
      window.location.href = '/cabinet';
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Registration failed';
      errorEl.hidden = false;
    }
  });
</script>
