---
import Base from '@/layouts/Base.astro';
import { servicesCatalog, uiLabels } from '@/data/services-catalog';
const site = 'https://www.ewohub.com';
const slug = 'services-catalog';
const lang = 'en';
const ui = uiLabels[lang];

const badgeColor: Record<string, string> = {
  ok: '#3f7d52',
  thin: '#7a6a3a',
  warn: '#b5482c',
  none: 'var(--fg-faint)',
};
---

<Base
  title="Webcam Industry Services Catalog"
  description="Real software, ad networks, agencies and marketplaces for webcam studios and models — organized by topic, sourced from live web research."
  lang={lang}
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>

  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag art-tag--blue">Catalog</span>
      </div>
      <h1 class="art-title">Webcam Industry <span class="art-grad">Services Catalog</span></h1>
      <p class="art-lead">
        Real software, ad networks, agencies and marketplaces used by webcam studios and models —
        organized by topic and sourced from live web research, not guesswork.
      </p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">

      <p class="art-intro">
        Entries are verified against live search results where possible. A few flagged
        <span style="color:#b5482c;font-weight:700;">⚠</span> sell grey-market bot traffic —
        treat those as a warning, not a recommendation. Listing here is not an EWO endorsement.
      </p>

      <div style="display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:2rem;">
        {servicesCatalog.map((cat) => (
          <a href={`#${cat.id}`} class="art-tag" style="text-decoration:none;">{cat.name[lang]}</a>
        ))}
      </div>

      {servicesCatalog.map((cat) => (
        <section class="section" id={cat.id}>
          <h2>{cat.name[lang]}</h2>
          <p style="color:var(--fg-muted);margin:-0.5rem 0 1.5rem;max-width:70ch;">{cat.desc[lang]}</p>

          {cat.topics.map((topic) => (
            <details class="glass-card" style="margin-bottom:.9rem;padding:0;overflow:hidden;">
              <summary style="cursor:pointer;list-style:none;padding:1rem 1.25rem;display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;font-weight:700;">
                <span>{topic.label[lang]}</span>
                <span style="font-family:monospace;font-size:.78rem;color:var(--fg-faint);font-weight:400;">/{topic.slug}</span>
                <span style={`margin-left:auto;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:.15rem .55rem;border-radius:999px;color:${badgeColor[topic.badge]};background:rgba(0,0,0,0.05);`}>
                  {topic.badge === 'none' ? ui.legendNone : `${topic.services.length} · ${topic.badge === 'ok' ? ui.legendOk : topic.badge === 'warn' ? ui.legendWarn : ui.legendThin}`}
                </span>
              </summary>
              <div style="padding:0 1.25rem 1.1rem;border-top:1px solid rgba(0,0,0,0.08);">
                {topic.note && (
                  <p style="font-size:.85rem;color:var(--fg-muted);background:var(--bg-subtle);border-radius:8px;padding:.6rem .8rem;margin:.9rem 0;">{topic.note[lang]}</p>
                )}
                {topic.services.map((svc) => (
                  <div style="padding:.65rem 0;border-bottom:1px solid rgba(0,0,0,0.06);display:grid;grid-template-columns:minmax(150px,220px) 1fr;gap:.15rem 1rem;">
                    <div>
                      <div style="font-weight:700;">{svc.name}{svc.flag && <span style={`margin-left:.4rem;font-size:.68rem;padding:.05rem .4rem;border-radius:5px;font-weight:700;color:${badgeColor[svc.flag]};background:rgba(0,0,0,0.05);`}>{svc.flag === 'warn' ? ui.flagWarn : ui.flagThin}</span>}</div>
                      {/\s/.test(svc.url) ? (
                        <span style="font-family:monospace;font-size:.78rem;color:var(--fg-faint);word-break:break-all;">{svc.url}</span>
                      ) : (
                        <a href={svc.url.startsWith('http') ? svc.url : `https://${svc.url}`} target="_blank" rel="noopener noreferrer nofollow" style="font-family:monospace;font-size:.78rem;color:var(--fg-faint);word-break:break-all;text-decoration:underline;text-underline-offset:2px;">{svc.url}</a>
                      )}
                    </div>
                    <div style="color:var(--fg-muted);font-size:.92rem;">{svc.desc}</div>
                  </div>
                ))}
              </div>
            </details>
          ))}
        </section>
      ))}

      <section class="art-cta section">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Studios</span>
          <h2>Building a promotion stack and not sure where to start?</h2>
          <p>Tell EWO support what you're trying to solve — traffic, recruiting, payouts — and we'll point you to the right approach instead of a random tool from a list.</p>
          <div class="art-cta__actions">
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" class="art-cta__btn art-cta__btn--primary">Talk to Support →</a>
            <a href="/studio-directory" class="art-cta__btn art-cta__btn--ghost">Browse Studios Catalog</a>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Related Articles</h2>
        <div class="related-grid">
          <a href="/studio-directory" class="related-card">
            <span class="related-card__icon">📇</span>
            <span>Webcam Studios Catalog</span>
          </a>
          <a href="/studio-traffic" class="related-card">
            <span class="related-card__icon">🖥️</span>
            <span>Studio Traffic Analytics</span>
          </a>
          <a href="/webcam-model-income-guide" class="related-card">
            <span class="related-card__icon">💰</span>
            <span>Webcam Model Income Guide</span>
          </a>
          <a href="/for-models" class="related-card">
            <span class="related-card__icon">🎯</span>
            <span>Work as a Model with EWO</span>
          </a>
        </div>
      </section>

    </div>
  </div>

</Base>
