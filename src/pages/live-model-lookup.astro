---
import Base from '@/layouts/Base.astro';
import LiveLookupTool from '@/components/LiveLookupTool.astro';
const site = 'https://www.ewohub.com';
const slug = 'live-model-lookup';
---
<Base
  title="Today's Leaderboard — Chaturbate & Stripchat"
  description="See today's top rooms and who led the traffic each hour on Chaturbate and Stripchat. Updated automatically, no login required."
  lang="en"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
  ]}
>
  <LiveLookupTool lang="en" />
</Base>
