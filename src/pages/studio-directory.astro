---
import Base from '@/layouts/Base.astro';
import { studioDirectory, countryNames } from '@/data/studios';
const site = 'https://www.ewohub.com';
const slug = 'studio-directory';
const lang = 'en';
---

<Base
  title="Webcam Studios Catalog by Country"
  description="A verified, country-by-country catalog of webcam studios — real addresses and active websites only. Get matched with the right one through EWO support on Telegram."
  lang={lang}
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>

  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag art-tag--blue">Catalog</span>
      </div>
      <h1 class="art-title">Webcam Studios <span class="art-grad">Catalog</span> by Country</h1>
      <p class="art-lead">
        A running list of webcam studios we could independently verify — a real address, an active,
        studio-owned website, not just a listing on someone else's aggregator. Organized by country,
        growing as we confirm more.
      </p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">

      <section class="section" style="margin-bottom:0;">
        <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" style="display:block;border-radius:20px;overflow:hidden;aspect-ratio:3.6/1;">
          <img src="/images/studio-catalog-banner.png" alt="Not sure where to sign? Get matched with a top-rated studio" style="width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block;" loading="lazy">
        </a>
      </section>

      <p class="art-intro">
        Studios listed here are compiled from public sources — official studio websites, industry
        coverage, and studio-run pages — and reflect what each studio publishes about itself, not an
        EWO endorsement. Coverage starts where verifiable studio culture is strongest and will expand
        over time.
      </p>

      {studioDirectory.map((entry) => (
        <section class="section" id={entry.key}>
          <h2>{countryNames[entry.key][lang]}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-top:1.25rem;">
            {entry.studios.map((s) => (
              <div class="glass-card">
                <h3 style="font-size:1.05rem;font-weight:700;color:var(--fg);margin-bottom:.25rem;">{s.name}</h3>
                <p style="font-size:.8rem;color:var(--fg-faint);margin-bottom:.625rem;">{s.city}</p>
                <p style="font-size:.875rem;color:var(--fg-muted);line-height:1.6;margin-bottom:.875rem;">{s.blurb[lang]}</p>
                <a href={s.website} target="_blank" rel="noopener noreferrer nofollow" style="font-size:.85rem;font-weight:600;color:var(--fg);">Visit website →</a>
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="section">
        <div class="highlight-box">
          <p>
            Before signing with any studio — including ones listed here — read our
            <a href="/how-to-choose-a-webcam-studio">studio red-flags checklist</a>. Details change
            often and are the studio's own claims, not verified by EWO. Run a studio and want to be
            listed, corrected, or removed? <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Contact us on Telegram</a>.
          </p>
        </div>
      </section>

      <section class="art-cta section">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Models</span>
          <h2>Want a second opinion before you sign?</h2>
          <p>Tell our support team your country and situation — we'll help you weigh a studio offer, or talk through streaming independently with EWO driving your traffic instead.</p>
          <div class="art-cta__actions">
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" class="art-cta__btn art-cta__btn--primary">Talk to Support →</a>
            <a href="/how-to-choose-a-webcam-studio" class="art-cta__btn art-cta__btn--ghost">Read the red-flags checklist</a>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Related Articles</h2>
        <div class="related-grid">
          <a href="/how-to-choose-a-webcam-studio" class="related-card">
            <span class="related-card__icon">🚩</span>
            <span>How to Choose a Webcam Studio</span>
          </a>
          <a href="/studio-scaling" class="related-card">
            <span class="related-card__icon">📈</span>
            <span>Webcam Studio Scaling</span>
          </a>
          <a href="/studio-traffic" class="related-card">
            <span class="related-card__icon">🖥️</span>
            <span>Studio Traffic Analytics</span>
          </a>
          <a href="/webcam-model-income-guide" class="related-card">
            <span class="related-card__icon">💰</span>
            <span>Webcam Model Income Guide</span>
          </a>
          <a href="/for-models" class="related-card">
            <span class="related-card__icon">🎯</span>
            <span>Work as a Model with EWO</span>
          </a>
        </div>
      </section>

    </div>
  </div>

</Base>
