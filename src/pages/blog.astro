---
import Base from '@/layouts/Base.astro';
const site = 'https://ewohub.com';

const filterAllLabel = 'All';

const articles = [
  {
    href: '/model-promotion',
    title: 'Model Promotion Services',
    desc: 'How our marketing and audience-growth service works for webcam models already streaming.',
    tag: 'Promotion',
    mins: '6 min read',
  },
  {
    href: '/why-low-viewers-webcam',
    title: 'Why Your Webcam Room Has Low Viewers',
    desc: '8 real reasons your viewer count is low and exactly what to do about each one.',
    tag: 'Growth',
    mins: '8 min read',
  },
  {
    href: '/how-cam-algorithm-ranks-rooms',
    title: 'How Cam Algorithms Rank Rooms',
    desc: 'What actually determines your visibility on cam platforms and how to work with it.',
    tag: 'Algorithm',
    mins: '6 min read',
  },
  {
    href: '/stripscore-cam-rank-explained',
    title: 'What Is Stripscore? Cam Rank Explained',
    desc: 'Stripscore, cam rank, room rank — what these terms mean and how the concept differs across Chaturbate, Stripchat, BongaCams, and LiveJasmin.',
    tag: 'Stripchat',
    mins: '5 min read',
  },
  {
    href: '/how-stripscore-works',
    title: 'How StripScore Actually Works',
    desc: 'A breakdown of what actually feeds StripScore — viewer count, retention, chat activity, tips, follows, consistency — how it decays, and what to do about it.',
    tag: 'Stripchat',
    mins: '7 min read',
  },
  {
    href: '/stripchat-goals-tip-menu-structure',
    title: 'Goals & Tip Menus: Structured for Tips',
    desc: 'How to size goals, price a tip menu, and sequence both across a session so they actually convert — not just sit there as decoration.',
    tag: 'Stripchat',
    mins: '6 min read',
  },
  {
    href: '/stripchat-ai-model-recommendations',
    title: 'Stripchat AI Model Recommendations',
    desc: "How Stripchat's AI-driven 'Recommended for You' feed works and how to optimize your room to show up in it.",
    tag: 'Stripchat',
    mins: '6 min read',
  },
  {
    href: '/stripchat-popular-new-model-visibility',
    title: "Why the Same Models Always Show Up in Stripchat's Popular",
    desc: "The documented bias toward already-large rooms, what Stripchat has done about it, and the concrete paths a newcomer has to real visibility.",
    tag: 'Stripchat',
    mins: '7 min read',
  },
  {
    href: '/best-streaming-times-by-region',
    title: 'Best Streaming Times by Region',
    desc: 'Peak hour data by region — maximize your audience reach every single session.',
    tag: 'Strategy',
    mins: '5 min read',
  },
  {
    href: '/webcam-model-income-guide',
    title: 'Webcam Model Income Guide',
    desc: 'A clear breakdown of how webcam earnings work, what affects your income, and how to grow it.',
    tag: 'Income',
    mins: '10 min read',
  },
  {
    href: '/webcam-earnings-by-platform',
    title: 'Webcam Earnings by Platform',
    desc: 'Chaturbate vs Stripchat vs BongaCams vs LiveJasmin — real payout rates, token values, and which platform actually pays more.',
    tag: 'Income',
    mins: '8 min read',
  },
  {
    href: '/new-model-growth',
    title: 'New Model Growth Strategy',
    desc: 'How to build your first consistent audience from scratch as a new webcam model.',
    tag: 'Beginner',
    mins: '7 min read',
  },
  {
    href: '/platforms-we-work-with',
    title: 'Webcam Platforms We Work With',
    desc: 'What Chaturbate, Stripchat, LiveJasmin, and BongaCams differ on — and how our strategy adapts to each.',
    tag: 'Platforms',
    mins: '8 min read',
  },
  {
    href: '/raise-your-room-ranking-score',
    title: "How to Raise Your Room's Ranking Score",
    desc: 'Why bot traffic and fake-viewer services backfire, and the legitimate playbook that actually holds.',
    tag: 'Ranking',
    mins: '6 min read',
  },
  {
    href: '/stripchat-promo',
    title: 'Stripchat Traffic Bot Review',
    desc: "An honest review of Stripchat_traffic_bot: how it works, what it costs, and how to get the most out of it.",
    tag: 'Stripchat',
    mins: '6 min read',
  },
  {
    href: '/stripchat-vr-shows-worth-it',
    title: 'VR Shows on Stripchat: Is the Equipment Worth It?',
    desc: 'The real cost of VR camera equipment, four numbers to check before buying, and how studios should think about equipping a shared room.',
    tag: 'Stripchat',
    mins: '7 min read',
  },
  {
    href: '/stripchat-model-news-studio-admin',
    title: "Model News for Studio Admins: What Actually Changed",
    desc: "Stripchat's January 2026 update gave Studio Admin accounts access to Model News, extended the new-model promotion window, and split contests by category.",
    tag: 'Stripchat',
    mins: '7 min read',
  },
  {
    href: '/how-to-choose-a-webcam-studio',
    title: 'How to Choose a Webcam Studio: Splits, Contracts, and Red Flags',
    desc: 'What actually determines a good studio deal — how splits are calculated, exclusivity terms, deductions, payout methods, and the red flags that predict a bad contract.',
    tag: 'Studios',
    mins: '9 min read',
  },
];

const tags = [...new Set(articles.map(a => a.tag))];
---

<Base
  title="Blog — Webcam Growth Guides & Strategies"
  description="Expert guides for webcam models and studios. Learn how cam algorithms work, how to grow your audience, and maximize your earnings."
  lang="en"
  hreflang={[
    { lang: 'en', url: `${site}/blog` },
    { lang: 'de', url: `${site}/de/blog` },
    { lang: 'es', url: `${site}/es/blog` },
    { lang: 'ro', url: `${site}/ro/blog` },
    { lang: 'uk', url: `${site}/uk/blog` },
    { lang: 'ru', url: `${site}/ru/blog` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Blog</span>
      </div>
      <h1 class="art-title">Guides &amp; <span class="art-grad">Strategies</span></h1>
      <p class="art-lead">Practical knowledge for webcam models and studios who want to grow — without fake traffic or shortcuts.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="blog-filter-bar" role="group" aria-label="Filter articles by category">
        <button class="blog-filter-btn is-active" data-filter="all">{filterAllLabel}</button>
        {tags.map(tag => (
          <button class="blog-filter-btn" data-filter={tag}>{tag}</button>
        ))}
      </div>
      <div class="related-grid" id="blog-grid">
        {articles.map(({ href, title, desc, tag, mins }) => (
          <a href={href} class="related-card" data-tag={tag}>
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
              <span class="art-tag">{mins}</span>
            </div>
            <h3>{title}</h3>
            <p>{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>

<script>
  (function () {
    var buttons = document.querySelectorAll('.blog-filter-btn');
    var cards = document.querySelectorAll('#blog-grid .related-card');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var filter = btn.dataset.filter;
        cards.forEach(function (card) {
          if (filter === 'all' || card.dataset.tag === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  })();
</script>
