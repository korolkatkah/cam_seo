<Base
  title="Blog — Webcam Growth Guides & Strategies"
  description="Expert guides for webcam models and studios. Learn how cam algorithms work, how to grow your audience, and maximize your earnings."
  lang="en"
  hreflang={[
    { lang: 'en', url: `${site}/blog` },
    { lang: 'de', url: `${site}/de/blog` },
    { lang: 'es', url: `${site}/es/blog` },
    { lang: 'ro', url: `${site}/ro/blog` },
    { lang: 'uk', url: `${site}/uk/blog` },
    { lang: 'ru', url: `${site}/ru/blog` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Blog</span>
      </div>
      <h1 class="art-title">Guides &amp; <span class="art-grad">Strategies</span></h1>
      <p class="art-lead">Practical knowledge for webcam models and studios who want to grow — without fake traffic or shortcuts.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="related-grid">
        {articles.map(({ href, title, desc, tag, mins }) => (
          <a href={href} class="related-card">
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
              <span class="art-tag">{mins}</span>
            </div>
            <h3>{title}</h3>
            <p>{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>
