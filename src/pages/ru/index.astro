---
import Base from '@/layouts/Base.astro';
import TrendsBlock from '@/components/TrendsBlock.astro';
import LiveIndicator from '@/components/LiveIndicator.astro';
const site = 'https://ewohub.com';
const title = 'Платформа Продвижения для Вебкам-Моделей и Студий';
const description = 'EWO — глобальный сервис для вебкам-моделей и студий. Рост трафика, продвижение и полный менеджмент. 1000+ клиентов, 10+ лет опыта, 20+ стран.';
const hreflang = [
  { lang: 'en', url: `${site}/` },
  { lang: 'de', url: `${site}/de` },
  { lang: 'es', url: `${site}/es` },
  { lang: 'ro', url: `${site}/ro` },
  { lang: 'uk', url: `${site}/uk` },
  { lang: 'ru', url: `${site}/ru` },
];
---
<Base title={title} description={description} lang="ru" hreflang={hreflang}>
  <Fragment slot="head">
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              wine: { bg: '#fafaf8', raised: '#f4f4f2', subtle: '#f0f0ee' },
              
              accent: { DEFAULT: '#1a1a1a', dark: '#444444' },
              
            },
            fontFamily: { sans: ['Nunito', 'Inter', 'system-ui', 'sans-serif'] },
          }
        }
      }
    </script>
    <style>
      .glow-orb { position:absolute; border-radius:50%; filter:blur(80px); pointer-events:none; opacity:0.3; }

      .card-glass {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(0,0,0,0.08);
        backdrop-filter: blur(12px);
        transition: border-color 0.3s, background 0.3s;
      }
      .card-glass:hover { border-color: rgba(0,0,0,0.16); background: rgba(0,0,0,0.05); }

      .btn-primary {
        background: #0a0a0a;
        transition: opacity 0.2s, transform 0.2s;
        min-height: 48px; display: inline-flex; align-items: center; justify-content: center;
      }
      .btn-primary:active { opacity: 0.85; transform: scale(0.98); }

      .btn-ghost {
        border: 1px solid rgba(0,0,0,0.1);
        transition: border-color 0.2s, background 0.2s;
        min-height: 48px; display: inline-flex; align-items: center; justify-content: center;
      }
      .btn-ghost:active { background: rgba(0,0,0,0.05); }

      .stat-num { background: linear-gradient(135deg, #0a0a0a, #555555); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

      .hero-grid-line {
        position:absolute; inset:0;
        background-image: linear-gradient(rgba(0,0,0,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 100%);
      }

      .tag-pill {
        background: rgba(0,0,0,0.07); border: 1px solid rgba(0,0,0,0.13);
        color: #1a1a1a; font-size: 11px; padding: 4px 12px;
        border-radius: 99px; display: inline-flex; align-items: center; gap: 6px; font-weight: 600;
      }

      .live-dot { width:7px; height:7px; background:#34d399; border-radius:50%; animation:pulse-dot 2s infinite; flex-shrink:0; }
      @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.4)} }

      .avatar-placeholder { background: linear-gradient(135deg,#e8e8e6,#d8d8d6); border: 1px solid rgba(0,0,0,0.12); display:flex; align-items:center; justify-content:center; }

      .divider { height:1px; background:linear-gradient(90deg,transparent,rgba(0,0,0,0.12),transparent); }

      .features-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
      @media (min-width: 640px) { .features-grid { grid-template-columns: 1fr 1fr; } }
      @media (min-width: 1024px) { .features-grid { grid-template-columns: 1fr 1fr 1fr; } }

      .heading-xl { font-family:'Josefin Sans',sans-serif; font-weight:700; font-style:normal; font-size:clamp(40px,10vw,88px); line-height:1.05; letter-spacing:-0.01em; color:#0a0a0a; }
      .heading-lg { font-family:'Josefin Sans',sans-serif; font-weight:700; font-style:normal; font-size:clamp(26px,5vw,44px); color:#0a0a0a; letter-spacing:-0.01em; }
      .grad-text { background:linear-gradient(90deg, #0a0a0a, #555555); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

      .section-pad { padding: 64px 20px; }
      @media (min-width: 768px) { .section-pad { padding: 96px 24px; } }

      .cta-box { padding: 40px 24px; }
      @media (min-width: 768px) { .cta-box { padding: 56px 48px; } }

      
    </style>
  </Fragment>

  <!-- HERO -->
  <section class="relative min-h-[85dvh] flex items-center justify-center overflow-hidden">
    <div class="hero-grid-line"></div>
    <div class="glow-orb w-80 h-80 top-10 left-0 -translate-x-1/3" style="background:rgba(0,0,0,0.04);"></div>
    <div class="glow-orb w-72 h-72 top-20 right-0 translate-x-1/3" style="background:rgba(0,0,0,0.04);"></div>
    <div class="glow-orb w-64 h-64 bottom-0 left-1/2 -translate-x-1/2 opacity-15" style="background:rgba(0,0,0,0.04);"></div>

    <svg class="absolute top-20 right-6 opacity-15 hidden sm:block" width="100" height="100" viewBox="0 0 120 120" fill="none">
      <circle cx="60" cy="60" r="50" stroke="#555555" stroke-width="1" stroke-dasharray="4 8"/>
      <circle cx="60" cy="60" r="30" stroke="#555555" stroke-width="0.5" stroke-dasharray="2 6"/>
      <line x1="60" y1="10" x2="60" y2="110" stroke="#555555" stroke-width="0.5" opacity="0.5"/>
      <line x1="10" y1="60" x2="110" y2="60" stroke="#555555" stroke-width="0.5" opacity="0.5"/>
    </svg>

    <div class="relative z-10 text-center px-5 max-w-4xl mx-auto w-full py-16">
      <div class="tag-pill mb-5 sm:mb-7">
        <span class="live-dot"></span>
        Глобальный сервис для вебкам-моделей и студий
      </div>

      <h1 class="heading-xl mb-5 sm:mb-6">
        ТРАФИК. МЕНЕДЖМЕНТ.<br>
        <span class="grad-text">ДЛЯ ВЕБКАМ-МОДЕЛЕЙ.</span>
      </h1>

      <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-sm sm:max-w-none mx-auto">
        <a href="/ru/for-models" class="btn-primary px-7 py-3.5 rounded-2xl text-white font-bold text-base w-full sm:w-auto">
          Для Моделей →
        </a>
        <a href="/ru/studio-traffic" class="btn-ghost px-7 py-3.5 rounded-2xl font-semibold text-base flex items-center gap-2 justify-center w-full sm:w-auto" style="color:#0a0a0a;">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.2"/><path d="M6.5 5.5l4 2.5-4 2.5V5.5z" fill="currentColor"/></svg>
          Для Студий
        </a>
      </div>

      <div class="mt-10 flex items-center justify-center gap-2 flex-wrap">
        <div class="flex -space-x-2">
          <div class="w-8 h-8 rounded-full avatar-placeholder"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div>
          <div class="w-8 h-8 rounded-full avatar-placeholder" style="background:linear-gradient(135deg,#d8d8e8,#4c1d95)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div>
          <div class="w-8 h-8 rounded-full avatar-placeholder" style="background:linear-gradient(135deg,#d8e4f0,#1e40af)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div>
          <div class="w-8 h-8 rounded-full avatar-placeholder" style="background:linear-gradient(135deg,#3b0764,#6b21a8)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="opacity:.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div>
        </div>
        <span class="text-sm" style="color:rgba(10,10,10,0.45);">Нам доверяют <span class="font-semibold" style="color:#0a0a0a;">1000+</span> моделей и студий</span>
      </div>
    </div>
  </section>

  <TrendsBlock lang="ru" />

  <div class="divider"></div>

  <!-- POPULAR SERVICES -->
  <section class="section-pad relative">
    <div class="max-w-6xl mx-auto px-5 sm:px-6">
      <div class="text-center mb-10 px-1">
        <div class="tag-pill mb-4">Популярные услуги</div>
        <h2 class="heading-lg mb-3">В тренде сейчас</h2>
        <p class="text-sm sm:text-base max-w-lg mx-auto" style="color:rgba(10,10,10,0.45);">Услуга продвижения, о которой наши клиенты спрашивают больше всего в этом месяце.</p>
      </div>

      <a href="/ru/stripchat_promo" class="card-glass rounded-2xl overflow-hidden flex flex-col md:flex-row items-stretch" style="text-decoration:none;">
        <div class="md:w-2/5 shrink-0" style="min-height:220px;">
          <img src="/images/stripchat-traffic-promo-banner.webp" alt="Stripchat traffic promo — получи больше зрителей и подними свой stripscore" class="w-full h-full object-cover" loading="lazy">
        </div>
        <div class="p-6 sm:p-8 flex flex-col justify-center md:w-3/5">
          <span class="tag-pill mb-4 w-fit">Stripchat</span>
          <h3 class="font-bold text-xl sm:text-2xl mb-3" style="color:#0a0a0a;">Stripchat Traffic Promo</h3>
          <p class="text-sm sm:text-base leading-relaxed mb-5" style="color:rgba(10,10,10,0.45);">Размести свою комнату в категории Popular на Stripchat, подними свой stripscore и получи реальных зрителей. Посмотри, как работает продвижение, цены и план действий, чтобы получить максимум.</p>
          <span class="text-sm font-semibold inline-flex items-center gap-1" style="color:#1a1a1a;">Читать полный обзор →</span>
        </div>
      </a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CTA -->
  <section class="section-pad relative">
    <div class="glow-orb w-80 h-80 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-20" style="background:rgba(0,0,0,0.04);"></div>
    <div class="max-w-2xl mx-auto px-5 sm:px-6 text-center relative z-10">
      <div class="card-glass rounded-3xl cta-box" style="border:1px solid rgba(0,0,0,0.09); background:rgba(250,250,248,0.85);">
        <svg class="mx-auto mb-6 opacity-30" width="52" height="52" viewBox="0 0 60 60" fill="none">
          <circle cx="30" cy="30" r="25" stroke="#555555" stroke-width="1" stroke-dasharray="4 6"/>
          <circle cx="30" cy="30" r="12" stroke="#555555" stroke-width="0.8"/>
          <circle cx="30" cy="30" r="4" fill="#555555"/>
        </svg>
        <h2 class="heading-lg mb-4">Готова расти?</h2>
        <p class="mb-8 text-sm sm:text-base max-w-sm mx-auto" style="color:rgba(10,10,10,0.5);">Расскажи нам, где ты сейчас и куда хочешь попасть. Мы построим план.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://t.me/+tBjfmjh9vHo1YzQy" target="_blank" rel="noopener" class="btn-primary px-7 py-3.5 rounded-2xl text-white font-bold w-full sm:w-auto">Связаться</a>
          <a href="/ru/platforms-we-work-with" class="btn-ghost px-7 py-3.5 rounded-2xl font-semibold w-full sm:w-auto" style="color:#0a0a0a;">Платформы, с Которыми Мы Работаем</a>
        </div>
      </div>
    </div>
  </section>
</Base>

