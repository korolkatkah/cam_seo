---
import Base from '@/layouts/Base.astro';
import { studioDirectory, countryNames } from '@/data/studios';
const site = 'https://www.ewohub.com';
const slug = 'studio-directory';
const lang = 'ru';
---

<Base
  title="Каталог Вебкам-Студий по Странам"
  description="Проверенный каталог вебкам-студий по странам — только реальные адреса и активные сайты. Получите помощь поддержки EWO в Telegram в выборе подходящей студии."
  lang={lang}
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>

  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag art-tag--blue">Каталог</span>
      </div>
      <h1 class="art-title">Каталог Вебкам-Студий <span class="art-grad">по Странам</span></h1>
      <p class="art-lead">
        Список вебкам-студий, которые мы смогли независимо проверить — реальный адрес, активный сайт,
        принадлежащий самой студии, а не просто запись в чужом агрегаторе. Упорядочено по странам,
        пополняется со временем.
      </p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">

      <section class="section" style="margin-bottom:0;">
        <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" style="display:block;border-radius:20px;overflow:hidden;line-height:0;">
          <img src="/images/studio-catalog-banner.png" alt="Not sure where to sign? Get matched with a top-rated studio" style="width:100%;height:auto;display:block;" loading="lazy">
        </a>
      </section>

      <p class="art-intro">
        Студии здесь собраны из публичных источников — официальных сайтов студий, отраслевых материалов
        и собственных страниц студий — и отражают то, что каждая студия публикует о себе, а не
        рекомендацию EWO. Покрытие начинается там, где студийную культуру проще всего проверить, и будет
        расширяться со временем.
      </p>

      {studioDirectory.map((entry) => (
        <section class="section" id={entry.key}>
          <h2>{countryNames[entry.key][lang]}</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-top:1.25rem;">
            {entry.studios.map((s) => (
              <div class="glass-card">
                <h3 style="font-size:1.05rem;font-weight:700;color:var(--fg);margin-bottom:.25rem;">{s.name}</h3>
                <p style="font-size:.8rem;color:var(--fg-faint);margin-bottom:.625rem;">{s.city}</p>
                <p style="font-size:.875rem;color:var(--fg-muted);line-height:1.6;margin-bottom:.875rem;">{s.blurb[lang]}</p>
                <a href={s.website} target="_blank" rel="noopener noreferrer nofollow" style="font-size:.85rem;font-weight:600;color:var(--fg);">Visit website →</a>
              </div>
            ))}
          </div>
        </section>
      ))}

      <section class="section">
        <div class="highlight-box">
          <p>
            Перед тем как подписывать договор с любой студией — включая указанные здесь — прочитайте
            наш <a href="/ru/how-to-choose-a-webcam-studio">чек-лист тревожных сигналов для студий</a>.
            Детали часто меняются и являются утверждениями самой студии, не проверенными EWO. Управляете
            студией и хотите добавить, исправить или убрать запись?
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer">Свяжитесь с нами в Telegram</a>.
          </p>
        </div>
      </section>

      <section class="art-cta section">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Модели</span>
          <h2>Нужно второе мнение перед подписанием?</h2>
          <p>Расскажите нашей команде поддержки свою страну и ситуацию — мы поможем оценить предложение студии или обсудим независимый стриминг с EWO, который приводит трафик.</p>
          <div class="art-cta__actions">
            <a href="https://t.me/ewo_agency" target="_blank" rel="noopener noreferrer" class="art-cta__btn art-cta__btn--primary">Написать в Поддержку →</a>
            <a href="/ru/how-to-choose-a-webcam-studio" class="art-cta__btn art-cta__btn--ghost">Прочитать чек-лист тревожных сигналов</a>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>Похожие Статьи</h2>
        <div class="related-grid">
          <a href="/ru/how-to-choose-a-webcam-studio" class="related-card">
            <span class="related-card__icon">🚩</span>
            <span>Как Выбрать Вебкам-Студию</span>
          </a>
          <a href="/ru/studio-scaling" class="related-card">
            <span class="related-card__icon">📈</span>
            <span>Масштабирование Студий</span>
          </a>
          <a href="/ru/studio-traffic" class="related-card">
            <span class="related-card__icon">🖥️</span>
            <span>Аналитика Трафика для Студий</span>
          </a>
          <a href="/ru/webcam-model-income-guide" class="related-card">
            <span class="related-card__icon">💰</span>
            <span>Гид по Доходу для Моделей</span>
          </a>
          <a href="/ru/for-models" class="related-card">
            <span class="related-card__icon">🎯</span>
            <span>Работай Моделью с EWO</span>
          </a>
        </div>
      </section>

    </div>
  </div>

</Base>
