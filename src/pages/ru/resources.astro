---
import Base from '@/layouts/Base.astro';
const site = 'https://www.ewohub.com';
const slug = 'resources';

const dateLocale = 'ru-RU';
function fmtDate(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}

// На этой странице появляются только статьи с category: 'guides'.
// Всё остальное живёт на /blog — эта страница исключительно кураторская лента Гайдов.
const articles = [
  {
    href: '/ru/stripchat-first-14-days-guide',
    title: 'Твои первые 14 дней на Stripchat',
    desc: 'Пошагово: регистрация, настройка профиля и как выжать максимум из 14-дневного окна видимости "New".',
    tag: 'Stripchat',
    category: 'guides',
    date: '2026-07-22',
  },
].filter(a => a.category === 'guides');

const filterAllLabel = 'Все';
const tags = [...new Set(articles.map(a => a.tag))];
---
<Base
  title="Гайды — Пошаговые гайды для вебкам-моделей"
  description="Практические пошаговые гайды для вебкам-моделей — регистрация, механика платформы и как начать правильно."
  lang="ru"
  hreflang={[
    { lang: 'en', url: `${site}/${slug}` },
    { lang: 'de', url: `${site}/de/${slug}` },
    { lang: 'es', url: `${site}/es/${slug}` },
    { lang: 'ro', url: `${site}/ro/${slug}` },
    { lang: 'uk', url: `${site}/uk/${slug}` },
    { lang: 'ru', url: `${site}/ru/${slug}` },
    { lang: 'fr', url: `${site}/fr/${slug}` },
    { lang: 'pt', url: `${site}/pt/${slug}` },
  ]}
>
  <section class="art-hero">
    <div class="art-orb art-orb--1"></div>
    <div class="art-orb art-orb--2"></div>
    <div class="art-grid"></div>
    <div class="art-hero__inner container">
      <div class="art-meta">
        <span class="art-tag">Бесплатные ресурсы</span>
      </div>
      <h1 class="art-title">Пошаговые <span class="art-grad">гайды</span></h1>
      <p class="art-lead">Практические пошаговые гайды для вебкам-моделей — без воды, без апселла.</p>
    </div>
  </section>

  <div class="art-body">
    <div class="container">
      <div class="blog-filter-bar" role="group" aria-label="Filter guides by category">
        <button class="blog-filter-btn is-active" data-filter="all">{filterAllLabel}</button>
        {tags.map(tag => (
          <button class="blog-filter-btn" data-filter={tag}>{tag}</button>
        ))}
      </div>
      <div class="related-grid" id="resources-grid">
        {articles.map(({ href, title, desc, tag, date }) => (
          <a href={href} class="glass-card" data-tag={tag} style="text-decoration:none;display:flex;flex-direction:column;gap:.625rem;">
            <div class="art-meta">
              <span class="art-tag">{tag}</span>
            </div>
            <h3 style="font-size:1.1rem;font-weight:700;margin:0;">{title}</h3>
            <p style="margin:0;font-size:.9375rem;">{desc}</p>
            <span style="font-size:.875rem;font-weight:600;color:var(--accent);margin-top:auto;">Читать статью →</span>
            <time class="card-date" datetime={date}>{fmtDate(date)}</time>
          </a>
        ))}
      </div>

      <section class="art-cta" style="margin-top:4rem;">
        <div class="art-cta__orb"></div>
        <div class="art-cta__inner">
          <span class="art-cta__badge">Ищете что-то другое?</span>
          <h2>Посмотрите полный каталог статей</h2>
          <p>Разбор доходов, сравнение платформ, глубокие разборы алгоритмов и многое другое — в блоге.</p>
          <div class="art-cta__actions">
            <a href="/ru/blog" class="art-cta__btn--primary btn btn-primary">Перейти в блог →</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  (function () {
    var buttons = document.querySelectorAll('.blog-filter-btn');
    var cards = document.querySelectorAll('#resources-grid .glass-card');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        var filter = btn.dataset.filter;
        cards.forEach(function (card) {
          if (filter === 'all' || card.dataset.tag === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });
  })();
</script>
